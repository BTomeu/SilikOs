# ======================================================================================================================
# CI ONLY (tests/install/rollback.ks.in). NEVER PART OF THE SHIPPED KICKSTART OR OF THE ISO.
# The rollback test (tests/install/rollback.sh, docs/ROLLBACK.md section 5) needs an unattended installation, which
# has to select and erase a disk; the shipped kickstart never does. These lines are appended to a copy of
# kickstart/silikos.ks and given to the installer from a separate disk image, for a throw-away virtual machine whose
# only disk is vda. `autopart` names NO scheme on purpose: what it makes is the default of the installer's product
# configuration on the ISO (installer/product: LVM thin), which is what a person gets from "Automatic".
# ======================================================================================================================
text
ignoredisk --only-use=vda
zerombr
clearpart --all --initlabel --drives=vda
autopart
lang en_US.UTF-8
keyboard us
timezone UTC --utc
rootpw --plaintext silikos-ci
user --name=tester --password=silikos-ci --plaintext --groups=wheel
firstboot --disable
poweroff

%post --log=/root/silikos-ci-post.log
install -m 0755 /dev/stdin /usr/local/sbin/silikos-ci-rollback <<'CHECK'
@CHECK@
CHECK
cat > /etc/systemd/system/silikos-ci-rollback.service <<'UNIT'
[Unit]
Description=SilikOS CI: the rollback test, one stage at each start, reported on the serial port
After=multi-user.target silikos-rollback-finish.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/silikos-ci-rollback
StandardOutput=journal
TimeoutStartSec=50min
[Install]
WantedBy=multi-user.target
UNIT
systemctl enable silikos-ci-rollback.service
%end
