# ======================================================================================================================
# CI ONLY (tests/install/sealed.ks.in). NEVER PART OF THE SHIPPED KICKSTART OR OF THE ISO.
# The encrypted installation of tests/install/sealed.sh (docs/DISK.md): an unattended installation has to select and
# erase a disk and to name a passphrase; the shipped kickstart never does. These lines are appended to a copy of
# kickstart/silikos.ks (its package set made small, its boot loader line replaced by the one below) and given to the
# installer from a separate disk image, for a throw-away virtual machine whose only disk is vda.
# `autopart --encrypted` names no scheme, no LUKS version and no key derivation on purpose: what it makes is what a
# person gets from "Automatic" with "Encrypt my data" ticked on this ISO, and the test looks at it (LUKS2, argon2id).
# @PASSPHRASE@ and @PIN@ are the test's own, written by sealed.sh; they protect nothing.
# The console is the serial port and plymouth is off, so that the disk's passphrase and the TPM's PIN are asked and
# typed there (sealed-console.py).
# ======================================================================================================================
text
ignoredisk --only-use=vda
zerombr
clearpart --all --initlabel --drives=vda
autopart --encrypted --passphrase=@PASSPHRASE@
bootloader --append="vsyscall=xonly console=ttyS0,115200 plymouth.enable=0 rd.plymouth=0 quiet"
lang en_US.UTF-8
keyboard us
timezone UTC --utc
rootpw --plaintext silikos-ci
user --name=tester --password=silikos-ci --plaintext --groups=wheel
firstboot --disable
poweroff

%post --log=/root/silikos-ci-post.log
( umask 077; printf '%s' '@PASSPHRASE@' > /root/sealed-pass; printf '%s\n' '@PIN@' > /root/sealed-pin )
install -m 0755 /dev/stdin /usr/local/sbin/silikos-ci-sealed <<'CHECK'
@CHECK@
CHECK
cat > /etc/systemd/system/silikos-ci-sealed.service <<'UNIT'
[Unit]
Description=SilikOS CI: the encrypted disk, Secure Boot and the TPM, one stage at each start, reported on the serial port
After=multi-user.target network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/silikos-ci-sealed
StandardOutput=journal
TimeoutStartSec=25min
[Install]
WantedBy=multi-user.target
UNIT
systemctl enable silikos-ci-sealed.service
%end
