# ======================================================================================================================
# CI ONLY (tests/install/hardened.ks.in). NEVER PART OF THE SHIPPED KICKSTART OR OF THE ISO.
# The test of the hardened level (tests/install/hardened.sh, docs/HARDENED.md) needs an unattended installation, which
# has to select and erase a disk; the shipped kickstart never does. These lines are appended to a copy of
# kickstart/silikos.ks and given to the installer from a separate disk image, for a throw-away virtual machine whose
# only disk is vda. As tests/install/ci.ks.in: plain partitions, a test user whose session starts by itself (so that
# "the desktop still starts" can be seen), no encryption and no Secure Boot: the level must then say
# "hardened, except" and not pretend.
# ======================================================================================================================
text
ignoredisk --only-use=vda
zerombr
clearpart --all --initlabel --drives=vda
autopart --type=plain --nohome
lang en_US.UTF-8
keyboard us
timezone UTC --utc
rootpw --plaintext silikos-ci
user --name=tester --password=silikos-ci --plaintext --groups=wheel
firstboot --disable
poweroff

%post --log=/root/silikos-ci-post.log
sed -i 's/^\[daemon\]/[daemon]\nAutomaticLoginEnable=True\nAutomaticLogin=tester/' /etc/gdm/custom.conf
install -d -o tester -g tester /home/tester/.config
echo yes > /home/tester/.config/gnome-initial-setup-done
chown tester:tester /home/tester/.config/gnome-initial-setup-done
install -m 0755 /dev/stdin /usr/local/sbin/silikos-ci-hardened <<'CHECK'
@CHECK@
CHECK
cat > /etc/systemd/system/silikos-ci-hardened.service <<'UNIT'
[Unit]
Description=SilikOS CI: the hardened level, one stage at each start, reported on the serial port
After=graphical.target network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/silikos-ci-hardened
StandardOutput=journal
TimeoutStartSec=30min
[Install]
WantedBy=graphical.target
UNIT
systemctl enable silikos-ci-hardened.service
%end
