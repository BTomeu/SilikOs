# SilikOS desktop defaults (dconf system database "local"; a user's own settings win).
# The Silik layout (the shell extension silik-shell: command line, rail, status bar) and the Silik look: the GTK theme and the shell theme "SilikOS" (one ink on paper, ink title bars, inverse-video
# selection, Cascadia Mono), the SilikVolt mark as the background, and the COMMAND bar on Super+Space.

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/silikos/silikos-light.svg'
picture-options='zoom'
primary-color='#f1f0ec'
color-shading-type='solid'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/silikos/silikos-dark.svg'
picture-options='zoom'
primary-color='#131416'

[org/gnome/desktop/interface]
gtk-theme='SilikOS'
font-name='Cascadia Mono 10'
monospace-font-name='Cascadia Mono 11'
enable-hot-corners=false
clock-show-weekday=true
show-battery-percentage=true

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'
titlebar-font='Cascadia Mono Semi-Bold 10'

[org/gnome/desktop/wm/keybindings]
switch-input-source=['XF86Keyboard']
switch-input-source-backward=['<Shift>XF86Keyboard']

[org/gnome/shell/extensions/user-theme]
name='SilikOS'

[org/gnome/shell]
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com', 'silik-shell@silikvolt.com']
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'firefox.desktop', 'org.gnome.gedit.desktop', 'virt-manager.desktop', 'gnome-control-center.desktop']

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/silik-command/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/silik-command]
name='SilikOS COMMAND'
command='silik-command'
binding='<Super>space'
