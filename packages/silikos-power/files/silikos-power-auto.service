# silik power auto: one power profile on mains power, another on battery (/etc/silikos/power.conf). Enabled by
# `silik power auto` (and by the SilikOS kickstart on a new installation), disabled by a profile chosen by hand. It
# runs at boot and again when 80-silikos-power.rules sees the mains plugged or unplugged (try-restart: only while it
# is on). `silik power apply` prints what it sets: journalctl -u silikos-power-auto
[Unit]
Description=SilikOS power profile for the power source (silik power auto)
After=dbus.service tuned.service tuned-ppd.service upower.service
ConditionPathExists=/usr/bin/silik

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/silik power apply
# Confined (owner, 13/11/2026: "audit it"): `systemd-analyze security` gave this unit 9.6, a root program with the
# whole machine in reach. It needs the system bus (tuned-ppd or tuned) and to read /sys: nothing else is left to it. (NoNewPrivileges is left
# out on purpose: under SELinux it changes which domain the program runs in, and that was not run [A].)
CapabilityBoundingSet=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
ProtectKernelTunables=yes

[Install]
WantedBy=multi-user.target
