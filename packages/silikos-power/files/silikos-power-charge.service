# silik power charge: the battery's charge limit of /etc/silikos/power.conf (charge_limit = N), written again at each
# start: a laptop's firmware often forgets it when it is switched off. Enabled by `silik power charge N`, never by
# the package. 80-silikos-power.rules runs it again when a battery appears (try-restart: only while it is on).
# `silik power charge apply` prints what it writes: journalctl -u silikos-power-charge
[Unit]
Description=SilikOS battery charge limit (silik power charge)
ConditionPathExists=/usr/bin/silik
ConditionPathExists=/etc/silikos/power.conf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/silik power charge apply
# Confined (owner, 13/11/2026: "audit it"): `systemd-analyze security` gave this unit 9.6, a root program with the
# whole machine in reach. It needs to read /etc/silikos/power.conf and write the battery's one file of /sys: nothing else is left to it. (NoNewPrivileges is left
# out on purpose: under SELinux it changes which domain the program runs in, and that was not run [A].)
CapabilityBoundingSet=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
