# bash completion for silik
_silik() {
  local cur=${COMP_WORDS[COMP_CWORD]} g=${COMP_WORDS[1]}
  # look: a look, --accent and its accents, at any place after the word look
  if [ "$g" = look ] && [ "$COMP_CWORD" -ge 2 ]; then
    if [ "${COMP_WORDS[COMP_CWORD-1]}" = --accent ]; then COMPREPLY=($(compgen -W "ink cobalt pcb silicon" -- "$cur"))
    else COMPREPLY=($(compgen -W "silik bar island --accent --json" -- "$cur")); fi
    return
  fi
  case $COMP_CWORD in
    1) COMPREPLY=($(compgen -W "status update identity look session eda dev win hw secure --dry-run --version" -- "$cur"));;
    2) case $g in
         eda) COMPREPLY=($(compgen -W "list create setup enter run import-vm rm check kernel-arg tools try bench tune" -- "$cur"));;
         win) COMPREPLY=($(compgen -W "list open create run install stop rm sync apps vm" -- "$cur"));;
         hw)  COMPREPLY=($(compgen -W "probe nvidia" -- "$cur"));;
         dev) COMPREPLY=($(compgen -W "tools try install" -- "$cur"));;
         identity) COMPREPLY=($(compgen -W "show silikos base" -- "$cur"));;
         session) COMPREPLY=($(compgen -W "lock logout off" -- "$cur"));;
         secure) COMPREPLY=($(compgen -W "status apply" -- "$cur"));;
       esac;;
    3) case "$g ${COMP_WORDS[2]}" in
         "eda setup"|"eda enter"|"eda run"|"eda rm") COMPREPLY=($(compgen -W "$(silik -q eda list 2>/dev/null | awk '{print $1}')" -- "$cur"));;
         "win run"|"win install"|"win stop"|"win rm") COMPREPLY=($(compgen -W "$(silik -q win list 2>/dev/null) --no-net --no-sandbox" -- "$cur"));;
         "win open") COMPREPLY=($(compgen -W "--prefix --no-net --no-sandbox" -- "$cur") $(compgen -f -- "$cur"));;
         "win vm") COMPREPLY=($(compgen -W "create start stop app" -- "$cur"));;
         "hw nvidia") COMPREPLY=($(compgen -W "install status" -- "$cur"));;
         "eda try") COMPREPLY=($(compgen -W "all sim schematic layout postlayout gds digital waves gates verilate vhdl lint synth device" -- "$cur"));;
         "eda tune") COMPREPLY=($(compgen -W "--threads --undo" -- "$cur"));;
         "dev try") COMPREPLY=($(compgen -W "all build libc cxx debug probe dfu stlink" -- "$cur"));;
         "dev install") COMPREPLY=($(compgen -f -- "$cur"));;
       esac;;
  esac
}
complete -F _silik silik
