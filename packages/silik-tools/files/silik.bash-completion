# bash completion for silik
# Names that silik lists (boxes, Wine prefixes, vendors' tools) are completed by comparing text, never handed to
# `compgen -W`, which expands its list as the shell would: a folder named with $(...) in it ran its command at the
# TAB key (the audit of 13/11/2026, run). A name with anything but letters, digits, dot, dash and underscore is left out.
#   _silik_names CUR "FIXED WORDS" < names, one a line
_silik_names() {
  local cur=$1 n; COMPREPLY=()
  while IFS= read -r n; do
    case $n in ''|*[!A-Za-z0-9._-]*) continue;; esac
    [[ $n == "$cur"* ]] && COMPREPLY+=("$n")
  done
  for n in $2; do [[ $n == "$cur"* ]] && COMPREPLY+=("$n"); done
}
_silik() {
  local cur=${COMP_WORDS[COMP_CWORD]} g=${COMP_WORDS[1]}
  # look: a look, --accent and its accents, --glass and its modes, --wallpaper and its sheets, at any place after the word look
  if [ "$g" = look ] && [ "$COMP_CWORD" -ge 2 ]; then
    if [ "${COMP_WORDS[COMP_CWORD-1]}" = --accent ]; then COMPREPLY=($(compgen -W "ink steel steel-vivid cobalt cobalt-vivid silicon silicon-vivid volt volt-vivid spark" -- "$cur"))
    elif [ "${COMP_WORDS[COMP_CWORD-1]}" = --glass ]; then COMPREPLY=($(compgen -W "off on clear crystal crystal-thin" -- "$cur"))
    elif [ "${COMP_WORDS[COMP_CWORD-1]}" = --glass-saver ]; then COMPREPLY=($(compgen -W "on off" -- "$cur"))
    elif [ "${COMP_WORDS[COMP_CWORD-1]}" = --wallpaper ]; then COMPREPLY=($(compgen -W "wafer wafer-dark plain plain-dark grid grid-dark scope scope-dark pcb pcb-dark mesh mesh-dark schematic schematic-dark cells cells-dark" -- "$cur"))
    else COMPREPLY=($(compgen -W "silik bar island --accent --glass --glass-saver --wallpaper --json" -- "$cur")); fi
    return
  fi
  # speed apply / undo: the items of the profile, in any number; bench: its switches, then files
  if [ "$g" = speed ] && [ "$COMP_CWORD" -ge 3 ] && { [ "${COMP_WORDS[2]}" = apply ] || [ "${COMP_WORDS[2]}" = undo ]; }; then
    COMPREPLY=($(compgen -W "kdump modem storage-arrays multipath rpcbind makecache locate indexer software" -- "$cur")); return
  fi
  if [ "$g" = bench ] && [ "$COMP_CWORD" -ge 3 ]; then
    if [ "${COMP_WORDS[2]}" = compare ]; then COMPREPLY=($(compgen -W "--json" -- "$cur") $(compgen -f -- "$cur"))
    else COMPREPLY=($(compgen -W "--json --label --wait --top" -- "$cur")); fi
    return
  fi
  # doctor: its areas, in any number
  if [ "$g" = doctor ] && [ "$COMP_CWORD" -ge 2 ]; then
    COMPREPLY=($(compgen -W "system security graphics hardware power bench eda windows network --json --verbose" -- "$cur")); return
  fi
  # hw check --from FILE; hw driver add NAME; hw nvidia install --source WHICH
  if [ "$g" = hw ] && [ "$COMP_CWORD" -ge 4 ]; then
    case "${COMP_WORDS[2]} ${COMP_WORDS[COMP_CWORD-1]}" in
      "check --from") COMPREPLY=($(compgen -f -- "$cur"));;
      "check --arch") COMPREPLY=($(compgen -W "x86_64 aarch64" -- "$cur"));;
      check*) COMPREPLY=($(compgen -W "--from --arch --json --all" -- "$cur"));;
      "driver add") COMPREPLY=($(compgen -W "wl r8127 rtw88_usb rtw89_usb" -- "$cur"));;
      "nvidia --source") COMPREPLY=($(compgen -W "nvidia almalinux" -- "$cur"));;
      nvidia*) COMPREPLY=($(compgen -W "--source" -- "$cur"));;
    esac
    return
  fi
  # vendor check / prepare: the tools of the vendors' data, in any number; vendor lib: library names (none to offer)
  if [ "$g" = vendor ] && [ "$COMP_CWORD" -ge 3 ]; then
    case ${COMP_WORDS[2]} in
      check|prepare) _silik_names "$cur" "--all --json" < <(silik -q vendor list --json 2>/dev/null | sed -n 's/^  "tool": "\(.*\)",$/\1/p');;
      list) COMPREPLY=($(compgen -W "--json" -- "$cur"));;
    esac
    return
  fi
  # manifest: a file, and each command's switches
  if [ "$g" = manifest ] && [ "$COMP_CWORD" -ge 3 ]; then
    case ${COMP_WORDS[2]} in
      export) COMPREPLY=($(compgen -W "--with-host" -- "$cur") $(compgen -f -- "$cur"));;
      diff) COMPREPLY=($(compgen -W "--json" -- "$cur") $(compgen -f -- "$cur"));;
      apply) COMPREPLY=($(compgen -W "--prune --kernel" -- "$cur") $(compgen -f -- "$cur"));;
    esac
    return
  fi
  # the plugins (/usr/share/silikos/python/plugins/NAME.py): their groups, and each one's words from its head
  local pd=${SILIK_PLUGIN_DIR:-/usr/share/silikos/python/plugins} pl=
  [ -d "$pd" ] && pl=$(sed -n 's/^# silik-plugin: \([a-z][a-z0-9-]*\)$/\1/p' "$pd"/*.py 2>/dev/null | tr '\n' ' ')
  if [ "$COMP_CWORD" -eq 2 ] && [ -n "$g" ] && [ -f "$pd/$g.py" ] && [[ " $pl " == *" $g "* ]]; then
    COMPREPLY=($(compgen -W "$(sed -n 's/^# words: //p' "$pd/$g.py" | head -1)" -- "$cur")); return
  fi
  # update: channel and its channels, --auto and its choices
  if [ "$g" = update ] && [ "$COMP_CWORD" -ge 2 ]; then
    case ${COMP_WORDS[COMP_CWORD-1]} in
      channel) COMPREPLY=($(compgen -W "stable next off" -- "$cur")) ;;
      --auto) COMPREPLY=($(compgen -W "all security off" -- "$cur")) ;;
      update) COMPREPLY=($(compgen -W "channel --auto" -- "$cur")) ;;
    esac
    return
  fi
  case $COMP_CWORD in
    1) COMPREPLY=($(compgen -W "status update identity look session eda dev win power speed bench hw secure doctor vendor manifest snapshot rollback $pl --dry-run --version" -- "$cur"));;
    2) case $g in
         eda) COMPREPLY=($(compgen -W "list create setup enter run import-vm rm check kernel-arg tools try bench tune" -- "$cur"));;
         win) COMPREPLY=($(compgen -W "list open create run install stop rm sync apps routes vm" -- "$cur"));;
         hw)  COMPREPLY=($(compgen -W "probe check nvidia driver" -- "$cur"));;
         dev) COMPREPLY=($(compgen -W "tools try install can serial ccache" -- "$cur"));;
         power) COMPREPLY=($(compgen -W "show performance balanced saver auto apply check charge profiles zram trim --json" -- "$cur"));;
         speed) COMPREPLY=($(compgen -W "show apply undo --json" -- "$cur"));;
         bench) COMPREPLY=($(compgen -W "system compare" -- "$cur"));;
         identity) COMPREPLY=($(compgen -W "show silikos base" -- "$cur"));;
         session) COMPREPLY=($(compgen -W "lock logout off" -- "$cur"));;
         secure) COMPREPLY=($(compgen -W "status apply" -- "$cur"));;
         vendor) COMPREPLY=($(compgen -W "list check prepare lib" -- "$cur"));;
         manifest) COMPREPLY=($(compgen -W "export diff apply" -- "$cur"));;
         snapshot) COMPREPLY=($(compgen -W "status list create delete setup --json" -- "$cur"));;
         rollback) COMPREPLY=($(compgen -W "finish --packages --yes" -- "$cur"));;
         update) COMPREPLY=($(compgen -W "--auto --no-snapshot" -- "$cur"));;
       esac;;
    3) case "$g ${COMP_WORDS[2]}" in
         "eda setup"|"eda enter"|"eda run"|"eda rm") _silik_names "$cur" "" < <(silik -q eda list 2>/dev/null | awk '$1 != "no" {print $1}');;
         "win run"|"win install"|"win stop"|"win rm") _silik_names "$cur" "--no-net --no-sandbox" < <(silik -q win list 2>/dev/null | grep -v '^no ');;
         "win open") COMPREPLY=($(compgen -W "--prefix --no-net --no-sandbox" -- "$cur") $(compgen -f -- "$cur"));;
         "win vm") COMPREPLY=($(compgen -W "create start stop app usb" -- "$cur"));;
         "hw nvidia") COMPREPLY=($(compgen -W "install status --source" -- "$cur"));;
         "hw check") COMPREPLY=($(compgen -W "--from --arch --json --all" -- "$cur") $(compgen -f -- "$cur"));;
         "hw driver") COMPREPLY=($(compgen -W "list add" -- "$cur"));;
         "eda try") COMPREPLY=($(compgen -W "all sim schematic layout postlayout gds digital waves gates verilate vhdl lint synth device" -- "$cur"));;
         "eda tune") COMPREPLY=($(compgen -W "--threads --undo" -- "$cur"));;
         "dev try") COMPREPLY=($(compgen -W "all build libc cxx debug probe dfu stlink" -- "$cur"));;
         "dev install") COMPREPLY=($(compgen -f -- "$cur"));;
         "dev can") COMPREPLY=($(compgen -W "list up down --fd --listen" -- "$cur"));;
         "dev ccache"|"power zram"|"power trim") COMPREPLY=($(compgen -W "on off" -- "$cur"));;
         "power auto") COMPREPLY=($(compgen -W "--ac --battery" -- "$cur"));;
         "power check") COMPREPLY=($(compgen -W "--battery --json" -- "$cur"));;
         "power charge") COMPREPLY=($(compgen -W "80 100 apply" -- "$cur"));;
         "power profiles") COMPREPLY=($(compgen -W "silikos base" -- "$cur"));;
         "snapshot status"|"snapshot list") COMPREPLY=($(compgen -W "--json" -- "$cur"));;
         "snapshot delete") COMPREPLY=($(compgen -W "--yes" -- "$cur"));;
         "update --auto") COMPREPLY=($(compgen -W "all security off" -- "$cur"));;
       esac;;
  esac
}
complete -F _silik silik
