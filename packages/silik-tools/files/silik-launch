#!/usr/bin/python3 -IS
# SilikOS — /usr/bin/silik. The command itself is /usr/share/silikos/python/silik_main.py (packages/silik-tools/files/silik),
# imported from here so that Python takes it compiled from its __pycache__ (made when the package is built): a script
# run directly is compiled again at every start, 20-30 ms for this one (docs/STATUS.md).
# (-I: Python takes nothing from the environment or the user's own folders, as a command run with sudo should; -S: the
# site module is not imported: silik is standard library only, and that import is 2-3 ms of each start)
import sys

sys.path.insert(0, "/usr/share/silikos/python")
import silik_main  # noqa: E402

sys.exit(silik_main.main())
