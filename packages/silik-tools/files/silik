def hw_known(path=None):
    """the USB devices SilikOS knows: hardware.tsv (silik-tools) as [{id, kind, name, driver, use, el9, verified, date,
    source}]; [] when the file is absent"""
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "hardware.tsv")
    for p in [path] if path else [os.environ.get("SILIK_HARDWARE"), HARDWARE, here]:
        if not p or not os.path.isfile(p):
            continue
        rows, head = [], None
        for l in read(p).splitlines():
            if not l.strip() or l.startswith("#"):
                continue
            f = l.split("\t")
            if head is None:
                head = f
            elif len(f) == len(head):
                rows.append(dict(zip(head, f)))
        return rows
    return []


def hw_match(table, vid, pid, product=""):
    """the row of TABLE for a USB device: its VID:PID, else its vendor's VID:*, else a product name pattern; or None"""
    import fnmatch
    vp = "%s:%s" % (vid.lower(), pid.lower())
    for want in (lambda r: r["id"] == vp, lambda r: r["id"] == vid.lower() + ":*",
                 lambda r: r["id"].startswith("product=") and product and fnmatch.fnmatchcase(product, r["id"][8:])):
        for r in table:
            if want(r):
                return r
    return None


def usb_sysfs(root="/sys/bus/usb/devices", dev="/dev/bus/usb"):
    """the plugged USB devices, from sysfs (no lsusb): [{vid, pid, product, maker, node, access, drivers, nets, ttys}];
    access: True / False for the device node as this user may open it (read and write), None when there is no node;
    None when sysfs has no USB devices to read"""
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return None
    out = []
    for n in names:
        d = os.path.join(root, n)
        vid = sys_read(os.path.join(d, "idVendor"))
        if ":" in n or not vid or vid == "1d6b":          # (interfaces; the root hubs)
            continue
        bus, num = sys_read(os.path.join(d, "busnum")), sys_read(os.path.join(d, "devnum"))
        node = "%s/%03d/%03d" % (dev, int(bus), int(num)) if bus.isdigit() and num.isdigit() else ""
        drivers, nets, ttys = [], [], []
        for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            if not f.startswith(n + ":"):
                continue
            i = os.path.join(d, f)
            if os.path.exists(os.path.join(i, "driver")):
                drivers.append(os.path.basename(os.path.realpath(os.path.join(i, "driver"))))
            for sub in ("net", "tty"):
                try:
                    (nets if sub == "net" else ttys).extend(sorted(os.listdir(os.path.join(i, sub))))
                except OSError:
                    pass
            try:
                ttys.extend(t for t in sorted(os.listdir(i)) if re.match(r"^tty(USB|ACM)\d+$", t) and t not in ttys)
            except OSError:
                pass
        out.append({"vid": vid, "pid": sys_read(os.path.join(d, "idProduct")), "product": sys_read(os.path.join(d, "product")),
                    "maker": sys_read(os.path.join(d, "manufacturer")), "node": node,
                    "access": os.access(node, os.R_OK | os.W_OK) if node and os.path.exists(node) else None,
                    "drivers": sorted(set(drivers)), "nets": nets, "ttys": ttys,
                    "tty_access": {"/dev/" + t: os.access("/dev/" + t, os.R_OK | os.W_OK) if os.path.exists("/dev/" + t) else None for t in ttys}})
    return out


def can_parse(text):
    """the CAN interfaces of `ip -details -statistics -json link show` (every link of type can: adapters, vcan,
    slcan): [{name, kind, up, state, bitrate, dbitrate, berr, ctrl, xstats, rx_err, tx_err}]; None when it is not JSON"""
    try:
        links = json.loads(text) if text.strip() else []
    except ValueError:
        return None
    out = []
    for l in links if isinstance(links, list) else []:
        if l.get("link_type") != "can":
            continue
        li = l.get("linkinfo") or {}
        info, st64 = li.get("info_data") or {}, l.get("stats64") or {}
        out.append({"name": l.get("ifname", "?"), "kind": li.get("info_kind", ""), "up": "UP" in (l.get("flags") or []),
                    "state": info.get("state"), "bitrate": (info.get("bittiming") or {}).get("bitrate"),
                    "dbitrate": (info.get("data_bittiming") or {}).get("bitrate"), "berr": info.get("berr_counter"),
                    "ctrl": info.get("ctrlmode") or [], "xstats": li.get("info_xstats") or {},
                    "rx_err": (st64.get("rx") or {}).get("errors"), "tx_err": (st64.get("tx") or {}).get("errors")})
    return out


