    elif no:
        doc_row(rows, "system", "rollback", "rollback", "warn", no[0].replace("snapshots are not available", "no snapshot before updates"), no[1][:2])
    elif r["flag"] is not None:
        doc_row(rows, "system", "rollback", "rollback", "warn", "the last update was made without a snapshot: %s" % (r["flag"].strip() or "the reason was not noted"),
                ["silik snapshot status", SNAP_PACKAGES])
    else:
        doc_row(rows, "system", "rollback", "rollback", "ok", "a snapshot of / is made before each update (LVM thin, snapm); silik rollback goes back")


# ------------------------------------------------------------------ doctor
# `silik doctor [AREA...]`: one read-only look at the whole workstation, area by area, with the judgement of `silik
# secure status`: ok / warn / bad / unknown (unknown when the subject cannot be seen, never ok) and, on every row that
# is not ok, the command that fixes it (on an unknown row: the one that lets it be seen). As there, doc_probe_*
# read the system (the areas at once, in threads: the slow parts are other programs) and doc_check_* judge what was
# read and run nothing, so the tests feed them made-up systems and command outputs. Nothing is changed; the read-only
# commands it ran are listed with --verbose and in --json.
DOCTOR_AREAS = ("system", "security", "graphics", "hardware", "bench", "eda", "windows", "network")
DOCTOR_ALIASES = {"sys": "system", "secure": "security", "gpu": "graphics", "hw": "hardware", "drivers": "hardware", "dev": "bench", "can": "bench",
                  "win": "windows", "net": "network"}
