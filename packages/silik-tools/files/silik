# ------------------------------------------------------------------ doctor
# `silik doctor [AREA...]`: one read-only look at the whole workstation, area by area, with the judgement of `silik
# secure status`: ok / warn / bad / unknown (unknown when the subject cannot be seen, never ok) and, on every row that
# is not ok, the command that fixes it (on an unknown row: the one that lets it be seen). As there, doc_probe_*
# read the system (the areas at once, in threads: the slow parts are other programs) and doc_check_* judge what was
# read and run nothing, so the tests feed them made-up systems and command outputs. Nothing is changed; the read-only
# commands it ran are listed with --verbose and in --json.
DOCTOR_AREAS = ("system", "security", "graphics", "bench", "eda", "windows", "network")
DOCTOR_ALIASES = {"sys": "system", "secure": "security", "gpu": "graphics", "dev": "bench", "can": "bench",
                  "win": "windows", "net": "network"}
# the SilikOS packages the kickstart installs
SILIKOS_PKGS = ("silikos-branding", "silikos-desktop", "silikos-security", "silik-tools", "silik-command",
                "silik-eda-compat", "silik-eda-open", "silik-dev", "silik-win", "silikos-power")
DOC_RESTART = "/run/silikos/restart"          # written by silikos-security's restart-needed after an update
DOC_UPDATE_UNITS = {"all": (SEC_FULL_TIMER, "silikos-update.service"), "security": (SEC_TIMER, "silikos-security-update.service")}
DOC_SHOW = "Id,LoadState,UnitFileState,ActiveState,Result,ExecMainStatus,ExecMainExitTimestamp,LastTriggerUSec"
DOC_UPDATE_AGE = 2 * 86400     # s: a daily update older than this is late (the timer catches up after a start)
DOC_DNS_WAIT = 1.0             # s: a name of the update mirrors not resolved by then is said as unknown
HARDWARE = "/usr/share/silikos/hardware.tsv"   # the USB devices SilikOS knows (silik-tools)
# the device rules that give a kind of device to the user at the screen (uaccess), and the package that brings them
DOC_RULES = {"probe": ("/usr/lib/udev/rules.d/60-openocd.rules", "openocd"),
             "logic": ("/usr/lib/udev/rules.d/61-libsigrok-uaccess.rules", "sigrok"),
             "serial": ("/usr/lib/udev/rules.d/70-silikos-serial.rules", "silik-dev"),
             "can-slcan": ("/usr/lib/udev/rules.d/70-silikos-serial.rules", "silik-dev"),
             "vm": ("/usr/lib/udev/rules.d/70-silikos-usb-vm.rules", "silik-dev")}
GB = 1024 ** 3
DOC_RAN = []                   # the read-only commands this run asked (--verbose, --json)


def doc_cmd(argv, timeout=10):
    """a read-only command of the doctor, noted for --verbose: (exit code or None, stdout) as sec_cmd"""
    DOC_RAN.append(" ".join(shlex.quote(a.replace("\t", "\\t").replace("\n", "\\n")) for a in argv))   # (rpm reads \t \n itself)
    return sec_cmd(argv, timeout=timeout)


def doc_row(rows, area, i, name, state, value, fix=()):
    rows.append({"area": area, "id": i, "name": name, "state": state, "value": value, "fix": list(fix) if state != "ok" else []})


def ago(s):
    """an age in words: 40 s, 12 min, 5 h, 3 days"""
    s = max(0, int(s))
    return "%d s" % s if s < 90 else "%d min" % (s // 60) if s < 5400 else "%d h" % (s // 3600) if s < 172800 else "%d days" % (s // 86400)


def size(b):
    return "%.1f GB" % (b / GB) if b >= GB else "%d MB" % (b // (1024 * 1024))


def bitrate(n):
    return "%g Mbit/s" % (n / 1e6) if n >= 1000000 else "%g kbit/s" % (n / 1e3)


def rate_word(n):
    """a bit rate as `silik dev can up` takes it: 500k, 1M"""
    return "%gM" % (n / 1e6) if n >= 1000000 else "%gk" % (n / 1e3)


def no_secret(url):
    """a proxy's address without the user and password it may carry"""
    return re.sub(r"//[^@/]*@", "//", url)


def user_bus():
    return os.path.exists(os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/nonexistent", "bus"))


# ---- system
def doc_probe_system():
    disks = {}
    for mp in ("/", "/home", "/var"):
        try:
            s = os.statvfs(mp)
            disks[mp] = {"dev": os.stat(mp).st_dev, "size": s.f_blocks * s.f_frsize, "free": s.f_bavail * s.f_frsize,
                         "files": s.f_files, "ffree": s.f_ffree}
        except OSError:
            disks[mp] = None
    units = [u for pair in DOC_UPDATE_UNITS.values() for u in pair]
    rpm, show, journal, failed, ufailed = par([
        lambda: doc_cmd(["rpm", "-q", "--qf", "%{NAME}\t%{VERSION}-%{RELEASE}.%{ARCH}\t%{INSTALLTIME}\n", "kernel-core"] + list(SILIKOS_PKGS))
        if shutil.which("rpm") else (None, ""),
        lambda: doc_cmd(["systemctl", "show", "--timestamp=unix", "-p", DOC_SHOW] + units),
        # (the job results of the update services, across starts; readable by root and the groups wheel and adm)
        lambda: doc_cmd(["journalctl", "-q", "--no-pager", "-o", "json", "-n", "40"] + sum((["-u", u] for u in units if u.endswith(".service")), []), timeout=5),
        lambda: doc_cmd(["systemctl", "list-units", "--failed", "--plain", "--no-legend", "--no-pager"]),
        lambda: doc_cmd(["systemctl", "--user", "list-units", "--failed", "--plain", "--no-legend", "--no-pager"]) if user_bus() else (None, "")])
    return {"os": os_release(), "silikos": os.path.exists("/etc/silikos-release"), "base": read("/etc/redhat-release").strip(),
            "kernel": os.uname().release, "rpm": rpm, "show": show, "journal": journal, "failed": failed, "ufailed": ufailed,
            "restart": read(DOC_RESTART, None), "disks": disks, "meminfo": read("/proc/meminfo"), "now": time.time(),
            "container": sec_container()}


def systemd_show(text):
    """{unit: {property: value}} from `systemctl show -p ... UNIT...` (one block per unit)"""
    out = {}
    for block in text.split("\n\n"):
        p = dict(l.partition("=")[::2] for l in block.splitlines() if "=" in l)
        if p.get("Id"):
            out[p["Id"]] = p
    return out


def unix_time(v):
    """a time of `systemctl show --timestamp=unix` (@1731390723), or None"""
    v = (v or "").strip()
    return int(v[1:]) if v.startswith("@") and v[1:].isdigit() and int(v[1:]) > 0 else None


def journal_jobs(text, unit):
    """[(time, 'done' | 'failed' | ...)] of the start jobs of UNIT in `journalctl -o json` lines, oldest first"""
    out = []
    for l in text.splitlines():
        try:
            e = json.loads(l)
        except ValueError:
            continue
        if e.get("UNIT") == unit and e.get("JOB_RESULT") and e.get("JOB_TYPE", "start") == "start":
            t = e.get("__REALTIME_TIMESTAMP", "")
            out.append((int(t) / 1e6 if str(t).isdigit() else None, e["JOB_RESULT"]))
    return out


def doc_updates(st, rows):
    rc, text = st["show"]
    if rc != 0:
        doc_row(rows, "system", "updates", "automatic updates", "unknown", "systemd does not answer%s" % (" (inside a container)" if st["container"] else ""))
        return
    sh = systemd_show(text)
    mode = next((k for k in ("all", "security") if sh.get(DOC_UPDATE_UNITS[k][0], {}).get("UnitFileState") == "enabled"), "")
    if not mode:
        if all(sh.get(DOC_UPDATE_UNITS[k][0], {}).get("LoadState") in (None, "not-found") for k in DOC_UPDATE_UNITS):
            doc_row(rows, "system", "updates", "automatic updates", "warn", "off (the package silikos-security is not installed)",
                    ["sudo dnf -y install silikos-security"])
        else:
            doc_row(rows, "system", "updates", "automatic updates", "warn", "off", ["silik update --auto all"])
        return
    timer, service = DOC_UPDATE_UNITS[mode]
    what = {"all": "every update, daily", "security": "security advisories, daily"}[mode]
    t, s = sh.get(timer, {}), sh.get(service, {})
    if t.get("ActiveState") not in ("active", "activating", "reloading"):
        doc_row(rows, "system", "updates", "automatic updates", "warn", "%s (%s): on from the next start, not running now" % (what, timer),
                ["sudo systemctl start " + timer])
        return
    last = unix_time(t.get("LastTriggerUSec"))
    seen = []                                      # (time, result) known
    jobs = journal_jobs(st["journal"][1], service) if st["journal"][0] == 0 else []
    if jobs and jobs[-1][0]:
        seen.append((jobs[-1][0], "success" if jobs[-1][1] == "done" else jobs[-1][1]))
    end = unix_time(s.get("ExecMainExitTimestamp"))
    if end:                                        # (this start's run, as systemd keeps it)
        res = s.get("Result", "")
        seen.append((end, res if res != "exit-code" else "exit status %s" % s.get("ExecMainStatus", "?")))
    if seen:
        when, res = max(seen, key=lambda x: x[0])
        age = st["now"] - when
        if res != "success":
            doc_row(rows, "system", "updates", "automatic updates", "bad", "%s; the last run (%s ago) failed: %s" % (what, ago(age), res),
                    ["journalctl -u %s -n 50   # what dnf said (root, or a member of wheel)" % service, "silik update"])
        elif age > DOC_UPDATE_AGE:
            doc_row(rows, "system", "updates", "automatic updates", "warn", "%s; the last run was %s ago" % (what, ago(age)),
                    ["silik update", "systemctl list-timers %s   # when it runs next" % timer])
        else:
            doc_row(rows, "system", "updates", "automatic updates", "ok", "%s; last run %s ago: done" % (what, ago(age)))
    elif last:
        doc_row(rows, "system", "updates", "automatic updates", "unknown", "%s; last run %s ago, its result is not readable here" % (what, ago(st["now"] - last)),
                ["journalctl -u %s -n 50   # as root, or as a member of wheel" % service])
    else:
        doc_row(rows, "system", "updates", "automatic updates", "unknown", "%s; it has not run yet" % what, ["systemctl list-timers " + timer])


def doc_check_system(st):
    rows, osr, here = [], st["os"], " (inside a container)" if st["container"] else ""
    shown = osr.get("PRETTY_NAME") if st["silikos"] else ""
    if not st["base"]:
        doc_row(rows, "system", "base", "base", "unknown", "no /etc/redhat-release: not an EL system (%s)" % (osr.get("PRETTY_NAME") or "unknown"))
    elif osr.get("VERSION_ID", "").split(".")[0] != "9":
        doc_row(rows, "system", "base", "base", "warn", "%s: SilikOS is made for EL 9" % st["base"])
    else:
        doc_row(rows, "system", "base", "base", "ok", "%s on %s, kernel %s" % (shown or "SilikOS packages", st["base"], st["kernel"]))

    rc, out = st["rpm"]
    have, kernels = {}, []
    for l in out.splitlines():
        p = l.split("\t")
        if len(p) == 3:
            if p[0] == "kernel-core":
                kernels.append((int(p[2]) if p[2].isdigit() else 0, p[1]))
            else:
                have[p[0]] = p[1].rsplit(".", 1)[0].rsplit("-", 1)[0]
    if rc is None:
        doc_row(rows, "system", "packages", "SilikOS packages", "unknown", "rpm is not on this system")
    else:
        miss = [p for p in SILIKOS_PKGS if p not in have]
        val = ", ".join("%s %s" % (p, have[p]) for p in SILIKOS_PKGS if p in have) or "none installed"
        if have.get("silik-tools") and have["silik-tools"] != VERSION:
            val += "; this silik is %s (not the installed one)" % VERSION
        if miss:
            doc_row(rows, "system", "packages", "SilikOS packages", "warn", "%d of %d: %s; missing: %s" % (len(have), len(SILIKOS_PKGS), val, " ".join(miss)),
                    ["sudo dnf -y install " + " ".join(miss)])
        else:
            doc_row(rows, "system", "packages", "SilikOS packages", "ok", val)

    newest = max(kernels)[1] if kernels else ""
    if st["restart"] is not None:
        doc_row(rows, "system", "restart", "restart", "warn", "an update waits for a restart%s" % (" (since %s)" % st["restart"].strip()[:16].replace("T", " ") if st["restart"].strip() else ""),
                ["systemctl reboot"])
    elif newest and newest != st["kernel"]:
        doc_row(rows, "system", "restart", "restart", "warn", "kernel %s is installed; %s runs" % (newest, st["kernel"]), ["systemctl reboot"])
    elif newest:
        doc_row(rows, "system", "restart", "restart", "ok", "none waits: the newest installed kernel runs")
    else:
        doc_row(rows, "system", "restart", "restart", "unknown", "no restart note; the installed kernels are not known (no kernel-core package)" + here)

    doc_updates(st, rows)
    doc_rollback(st, rows)

    seen = {}
    for mp in ("/", "/home", "/var"):
        d = st["disks"].get(mp)
        if d is None:
            doc_row(rows, "system", "disk" + mp, "disk " + mp, "unknown", "not readable")
            continue
        if d["dev"] in seen:
            seen[d["dev"]].append(mp)
            continue
        seen[d["dev"]] = [mp]
    for dev, mps in seen.items():
        d, mp = st["disks"][mps[0]], mps[0]
        free = d["free"] / d["size"] if d["size"] else 0
        iused = 1 - d["ffree"] / d["files"] if d["files"] else 0
        val = "%s free of %s (%d %%)%s" % (size(d["free"]), size(d["size"]), round(free * 100),
                                          ", inodes %d %% used" % round(iused * 100) if d["files"] else "")
        val += " (with %s)" % ", ".join(mps[1:]) if len(mps) > 1 else ""
        fix = (["du -xh -d1 ~ 2>/dev/null | sort -h | tail   # what takes the space"] if mp == "/home" else
               ["sudo dnf clean all", "sudo journalctl --vacuum-size=500M", "sudo du -xh -d1 %s 2>/dev/null | sort -h | tail   # what takes the space" % mp])
        if "/home" in mps and mp != "/home":
            fix.insert(0, "du -xh -d1 ~ 2>/dev/null | sort -h | tail")
        state = "bad" if free < 0.02 or d["free"] < GB // 2 or iused > 0.97 else "warn" if free < 0.05 or d["free"] < 2 * GB or iused > 0.9 else "ok"
        doc_row(rows, "system", "disk" + mp, "disk " + mp, state, val, fix)

    mi = {}
    for l in st["meminfo"].splitlines():
        k, _, v = l.partition(":")
        if v.split() and v.split()[0].isdigit():
            mi[k] = int(v.split()[0]) * 1024
    if "MemTotal" not in mi or "MemAvailable" not in mi:
        doc_row(rows, "system", "memory", "memory", "unknown", "/proc/meminfo is not readable")
    else:
        av = mi["MemAvailable"] / mi["MemTotal"]
        sw, swf = mi.get("SwapTotal", 0), mi.get("SwapFree", 0)
        val = "%s available of %s; %s" % (size(mi["MemAvailable"]), size(mi["MemTotal"]),
                                         "swap %s of %s used" % (size(sw - swf), size(sw)) if sw else "no swap")
        state = "bad" if av < 0.03 else "warn" if av < 0.1 or (sw and (sw - swf) / sw > 0.9) else "ok"
        doc_row(rows, "system", "memory", "memory", state, val, ["top -o %MEM   # what holds it"])

    rc, out = st["failed"]
    if rc != 0:
        doc_row(rows, "system", "units", "services", "unknown", "systemd does not answer" + here)
    else:
        units = [l.split()[0] for l in out.splitlines() if l.split()]
        urc, uout = st["ufailed"]
        uunits = [l.split()[0] for l in uout.splitlines() if l.split()] if urc == 0 else []
        if units or uunits:
            doc_row(rows, "system", "units", "services", "warn", "failed: %s" % ", ".join(units + ["%s (yours)" % u for u in uunits]),
                    ["systemctl status " + u for u in units[:3]] + ["systemctl --user status " + u for u in uunits[:2]] +
                    ["sudo systemctl reset-failed   # once understood"])
        else:
            doc_row(rows, "system", "units", "services", "ok", "no failed systemd unit" + ("" if urc == 0 else " (the system's; yours not seen: no session bus)"))
    return rows


