def eda_work(ctx, kind):
    """a new folder for the files of a run, under the user's cache folder: /tmp may not run programs (a system
    mounted that way for safety), and one of the jobs builds a program and runs it"""
    base = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache"), "silikos")
    if ctx.dry:
        return os.path.join(base, kind + "-XXXX")
    os.makedirs(base, exist_ok=True)
    import tempfile
    return tempfile.mkdtemp(prefix=kind + "-", dir=base)


def eda_try(ctx, a):
    jobs = [j for j in eda_try_jobs() if a.job in ("all", j[0])]
    if not jobs:
        die("no such job: %s (%s, all)" % (a.job, ", ".join(j[0] for j in eda_try_jobs())), 2)
    if not os.path.isdir(EDA_TRY):
        die("the files of the jobs are not here (%s): they come with the package silik-eda-open" % EDA_TRY)
    work = eda_work(ctx, "eda-try")
    ctx.run(["cp", "-r", EDA_TRY + "/.", work])
    ctx.echo(["cd", work])
    if not ctx.dry:
        os.chdir(work)
    rows = []
    for name, needs, cmds, checks in jobs:
        missing = [t[5:] + " (a file of silik-eda-open)" if t.startswith("file:") else t for t in needs if not tool_where(t)]
        if missing and not ctx.dry:
            rows.append(("unknown", name, "not run: %s %s not on the system" % (", ".join(missing), "is" if len(missing) == 1 else "are")))
            continue
        failed = None
        for argv, out in cmds:
            if failed is not None:              # (what follows a command that failed has nothing to work on)
                break
            if not ctx.quiet:
                print("$ " + " ".join(shlex.quote(x) for x in argv) + (" > " + out if out else ""), flush=True)
            if ctx.dry:
                continue
            ctx.note(argv)
            try:
                with open(out, "w") as f:
                    rc = subprocess.run(argv, stdout=f, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL).returncode
            except OSError as e:                # (a program that is not there after all, or that may not be run)
                failed = "%s could not be started: %s" % (argv[0], e.strerror or e)
                continue
            if rc != 0 and failed is None:
                failed = "%s exited %d: %s" % (argv[0], rc, " / ".join(read(out).strip().splitlines()[-2:]))
        if ctx.dry:
            continue
        for path, rx, means in checks:
            if failed is None and not re.search(rx, read(path)):
                failed = "not seen: " + means + " (" + os.path.join(work, path) + ")"
        said = "; ".join(c[2] for c in checks)
        if not failed and name == "postlayout":     # the two delays it measured (with the exercise's simple transistor models)
            t = [re.search(r"(?m)^%s += +(\S+)" % k, read("post.out")) for k in ("tphl", "tplh")]
            if all(t):
                said += ": %.0f ps falling, %.0f ps rising" % (float(t[0].group(1)) * 1e12, float(t[1].group(1)) * 1e12)
        if not failed and name == "device":         # the two currents it found (the exercise's doping, not a real device's)
            t = re.search(r"(?m)^PASS rectifies: forward (\S+) A/cm2 at 0\.5 V, reverse (\S+) A/cm2", read("devsim.out"))
            if t:
                said += ": %.2g A/cm2 at 0.5 V, %.2g A/cm2 at -0.5 V" % (float(t.group(1)), float(t.group(2)))
        rows.append(("bad", name, failed) if failed else ("ok", name, said))
    if ctx.dry:
        return 0
    count = {k: sum(1 for r in rows if r[0] == k) for k in ("ok", "bad", "unknown")}
    text = "\n".join(["%s %-10s %s" % (SEC_MARK[s], n, d) for s, n, d in rows] +
                     ["%d ok, %d failed, %d not run; the files: %s" % (count["ok"], count["bad"], count["unknown"], work)])
    try:
        print(text)
    except UnicodeEncodeError:
        print(text.encode("ascii", "replace").decode("ascii"))
    return 1 if count["bad"] else 0


def eda_bench_circuit(rings, stages):
    """a circuit that keeps the simulator busy with transistor models: `rings` ring oscillators of `stages` CMOS
    inverters each, with ngspice's own BSIM4 defaults (no vendor models)"""
    out = ["* silik eda bench: %d ring oscillators of %d inverters (%d transistors, BSIM4 defaults)" % (rings, stages, 2 * rings * stages),
           ".model n1 nmos level=14 version=4.8.2", ".model p1 pmos level=14 version=4.8.2", "vdd vdd 0 dc 1.2"]
    for r in range(rings):
        for i in range(stages):
            a, b = "r%d_%d" % (r, i), "r%d_%d" % (r, (i + 1) % stages)
            out += ["mn%d_%d %s %s 0 0 n1 w=0.5u l=0.1u" % (r, i, b, a), "mp%d_%d %s %s vdd vdd p1 w=1u l=0.1u" % (r, i, b, a),
                    "c%d_%d %s 0 2f" % (r, i, b)]
        out.append(".ic v(r%d_0)=0" % r)
    return "\n".join(out + [".tran 5p 4n uic", ".control", "run", "print length(v(r0_0))", ".endc", ".end"]) + "\n"


def eda_bench(ctx, a):
    if not shutil.which("ngspice") and not ctx.dry:
        die("ngspice is not on the system (package ngspice, with silik-eda-open)")
    cores = cpu_cores()
    threads = sorted(set([1, 2, cores] + ([os.cpu_count()] if a.all_threads and os.cpu_count() else [])))
    work = eda_work(ctx, "eda-bench")
    ctx.echo(["cd", work])
    if not ctx.dry:
        os.chdir(work)
        with open("rings.cir", "w") as f:
            f.write(eda_bench_circuit(a.rings, a.stages))
    print("silik: %d ring oscillators of %d inverters, %d transistors; best of %d run%s each" % (a.rings, a.stages, 2 * a.rings * a.stages, a.runs, "" if a.runs == 1 else "s"))
    env = dict(os.environ, HOME=work)          # the threads are set in a .spiceinit of this folder, not in the user's
    times = {}
    for t in threads:
        if not ctx.quiet:
            print("$ printf 'set num_threads=%d\\n' > .spiceinit; ngspice -b rings.cir" % t, flush=True)
        if ctx.dry:
            continue
        with open(".spiceinit", "w") as f:
            f.write("set num_threads=%d\n" % t)
        best = None
        for _ in range(a.runs):
            t0 = time.time()
            p = subprocess.run(["ngspice", "-b", "rings.cir"], env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               stdin=subprocess.DEVNULL, universal_newlines=True)
            dt = time.time() - t0
            if p.returncode != 0 or "length(v(r0_0))" not in p.stdout:
                die("ngspice did not finish the circuit: " + " / ".join(p.stdout.strip().splitlines()[-2:]))
            best = dt if best is None else min(best, dt)
        times[t] = best
    if ctx.dry:
        return 0
    fastest = min(times, key=lambda k: times[k])
    for t in threads:
        print("%2d threads  %7.2f s%s%s" % (t, times[t], "  (ngspice's default)" if t == 2 else "", "  <- fastest" if t == fastest else ""))
    now = ngspice_threads() or 2
    if times[fastest] < 0.95 * times.get(now, times[fastest] / 0.9) and fastest != now:
        print("silik: on this circuit %d threads take %.0f %% of the time of %d (%s): `silik eda tune --threads %d`" % (
            fastest, 100 * times[fastest] / times[now] if now in times else 0, now, "set now" if ngspice_threads() else "the default", fastest))
    else:
        print("silik: the threads set now (%d) are within 5 %% of the fastest: nothing to change" % now)
    return 0


def eda_tune(ctx, a):
    n = a.threads or cpu_cores()
    if n < 1 or n > 1024:
        die("threads: a number from 1", 2)
    path = spiceinit()
    kept = [l for l in read(path).splitlines() if l != SPICEINIT_NOTE and not re.match(r"set num_threads *=", l)]
    new = kept + ([] if a.undo else [SPICEINIT_NOTE, "set num_threads=%d" % n])
    if not ctx.quiet:
        if a.undo:
            print("$ sed -i '/^set num_threads *=/d; /silik eda tune/d' %s" % shlex.quote(path), flush=True)
        else:
            print("$ printf '%%s\\n' %s 'set num_threads=%d' >> %s" % (shlex.quote(SPICEINIT_NOTE), n, shlex.quote(path)), flush=True)
    if ctx.dry:
        return 0
    if new:
        with open(path, "w") as f:
            f.write("".join(l + "\n" for l in new))
    elif os.path.exists(path):          # nothing else was in the file: it goes
        os.remove(path)
    print("silik: ngspice %s" % ("is back to its default of 2 threads" if a.undo else
                                 "evaluates transistor models on %d threads from its next start (this machine has %d cores); `silik eda bench` measures it" % (n, cpu_cores())))
    return 0


# ------------------------------------------------------------------ win
# Windows programs run by Wine: one prefix per program, or the prefix "default" for whatever is double-clicked
# (`silik win open`). Under bubblewrap when it is installed: the programs of a prefix see the system read-only, their
# prefix, the shared folder (drive W:), the folders shown read-only, and nothing else of the home folder.
# A prefix has ONE sandbox while its programs run: bwrap starts it with the prefix's wineserver as its first program,
# and every program enters it with nsenter. They cannot have a sandbox each: the programs of a prefix must talk to one
# wineserver, the wineserver numbers them by process id (one process namespace) and it is the wineserver that opens
# their files (one view of the files). So what a sandbox shows is fixed when it starts. docs/WINDOWS.md.
import fcntl   # the modules below are used by this section only
import signal
import stat

WIN_DEFAULT = "default"                               # the prefix of `silik win open` when none is named
WIN_EXT = (".exe", ".msi", ".bat", ".cmd", ".lnk")    # what `silik win open` takes
WIN_ICON = "org.silikvolt.Win"
# what a sandboxed program keeps of the environment (plus LC_*); nothing else crosses: no session bus, no tokens
WIN_ENV = ("DISPLAY", "LANG", "LANGUAGE", "TZ", "TERM", "PULSE_SERVER", "DESKTOP_STARTUP_ID", "DRI_PRIME",
           "__NV_PRIME_RENDER_OFFLOAD", "__GLX_VENDOR_LIBRARY_NAME", "__VK_LAYER_NV_optimus")
# Wine's own switches, passed on the `env` part of the line when they are set
WINE_ENV = ("WINEDLLOVERRIDES", "WINEESYNC", "WINEFSYNC", "WINE_LARGE_ADDRESS_AWARE")
WINE_SHARE = "/opt/silik-wine/share/wine:/usr/share/wine:/opt/wine"     # where Wine looks for Mono and Gecko
# The sandbox has no session bus, and must be told so: a library that finds no address starts a bus of its own
# (dbus-launch --autolaunch, through the display), and that bus never ends, so the sandbox never ends either. Seen
# with SDL2 on the system, which Wine loads when it is there: every Windows program left a sandbox behind.
WIN_NO_BUS = "unix:path=/nonexistent/no-session-bus-in-the-sandbox"
# An isolated sandbox (`--isolated`, or a prefix marked so: docs/WINDOWS.md) is for a program the owner does not
# trust with the session. X11 does not separate its clients, so such a program gets an X server of its own (Xephyr,
# a window of this session that is its whole screen), a network namespace of its own (the session's server also
# listens on an abstract socket, which a box that shares the network namespace reaches without the socket's file),
# no GPU device, and no sound unless asked.
WIN_ISOLATED = "isolated"                             # the prefix of `silik win open --isolated` when none is named
WIN_SCREEN = "1280x800"                               # the size of an isolated program's screen ($SILIK_WIN_SCREEN)
WIN_ENV_ISOLATED = ("LANG", "LANGUAGE", "TZ", "TERM")  # what an isolated program keeps of the environment (plus LC_*)
X11_SOCKETS = "/tmp/.X11-unix"


def prefix_dir(n):
    if not valid_name(n):
        die("prefix name '%s': letters, digits, - _ . (max 40)" % n, 2)
    return os.path.join(WINE_ROOT, n)


def win_shared(name=None):
    """the folder of the home that Windows programs see and write, drive W:. ~/Windows ($SILIK_WIN_SHARED) for the
    programs of the normal box. A prefix of isolated programs (`name`: win_apart) has a folder of its own inside it,
    ~/Windows/NAME, and does not see the rest: with one folder for all, an isolated program changed the files
    beside a program the owner had approved for the normal box, or the program itself between the moment it was
    checked and the moment it ran, and its code then ran there, on the session's display (seen, 14/11/2026)"""
    base = os.environ.get("SILIK_WIN_SHARED") or os.path.join(os.path.expanduser("~"), "Windows")
    return os.path.join(base, name) if name else base


def win_runtime(name):
    """where the state of a prefix's running sandbox is: its /tmp, its runtime folder (Wine's server socket is in
    one of the two), and what `silik` notes about it"""
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base or not os.path.isdir(base):
        base = "/tmp/silik-%d" % os.getuid()
    return os.path.join(base, "silik-win", name)


def data_home():
    return os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")


def bwrap_bin():
    return os.environ.get("SILIK_BWRAP") or shutil.which("bwrap")


def win_boxed(a):
    return bool(bwrap_bin()) and not getattr(a, "no_sandbox", False)


def xephyr_bin():
    return os.environ.get("SILIK_XEPHYR") or shutil.which("Xephyr")


def pasta_bin():
    return os.environ.get("SILIK_PASTA") or shutil.which("pasta")


def win_cannot_isolate():
    """why a program cannot have a display of its own here; '' when it can"""
    if not bwrap_bin():
        return "bwrap (bubblewrap) is not installed"
    if not xephyr_bin():
        return "Xephyr is not installed (the package xorg-x11-server-Xephyr)"
    if not (os.environ.get("DISPLAY") or "").startswith(":"):
        return "this session has no local X11 display to open the program's own display in"
    return ""


def win_marks_file():
    """the names of the prefixes that always run isolated, one per line. Beside the prefixes, not inside one: a
    prefix is writable by its programs, and a program must not be able to take its own mark away"""
    return os.path.join(os.path.dirname(WINE_ROOT), "win-isolated")


def win_marked():
    return set(l.strip() for l in read(win_marks_file()).splitlines() if valid_name(l.strip()))


def win_private_write(path, text):
    """writes a file of this user's alone (0600, its folder 0700 when made here), not through a link"""
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def win_mark(ctx, name, on=True):
    """marks the prefix as one that always runs isolated (or takes the mark away)"""
    names = win_marked()
    if (name in names) == on:
        return
    names = names | {name} if on else names - {name}
    if not ctx.quiet:
        if on:
            print("$ echo %s >> %s" % (shlex.quote(name), shlex.quote(win_marks_file())), flush=True)
        else:
            print("$ sed -i %s %s" % (shlex.quote("/^%s$/d" % name.replace(".", "\\.")), shlex.quote(win_marks_file())), flush=True)
    if not ctx.dry:
        win_private_write(win_marks_file(), "".join(n + "\n" for n in sorted(names)))


def win_apart(a, name):
    """True for a prefix of isolated programs: asked for (--isolated, or the answer to the question), or the prefix
    is marked"""
    return bool(getattr(a, "isolated", False)) or name in win_marked()


def win_iso(a, name):
    """True when the prefix's programs run isolated here (win_apart, and there is a sandbox to isolate them in;
    where there is none they do not run at all: win_exec)"""
    return win_boxed(a) and win_apart(a, name)


def win_shared_of(a, name):
    """the shared folder of prefix `name`: its own when its programs are isolated ones"""
    return win_shared(name if win_apart(a, name) else None)


def win_from_isolated(f):
    """the prefix of isolated programs that file f belongs to: f lies in that prefix or in its shared folder
    (~/Windows/NAME); None for any other file. Such a file is one an isolated program wrote or could change, so it
    runs isolated, in that prefix, whatever was answered for it (or for a file with the same SHA-256) before"""
    for n in sorted(win_marked()):
        if any(_under(f, os.path.realpath(top)) for top in (win_shared(n), os.path.join(WINE_ROOT, n))):
            return n
    return None


def win_real(ctx, path):
    """the file behind `path`, links followed, unless the path lies where Windows programs write (the shared
    folder, a prefix) and leads out of there: a program can leave a link named like an installer that points at a
    file elsewhere in the home, and opening it would show that file's whole folder to the sandbox (seen). Such a
    link is not followed: the command ends"""
    f, given = os.path.realpath(path), os.path.abspath(path)
    tops = [win_shared(), WINE_ROOT]
    real = [os.path.realpath(x) for x in tops]
    if any(_under(given, x) for x in tops + real) and not any(_under(f, x) for x in real):
        win_die(ctx, "%s is a link that leads out of %s (to %s): not followed. Open that file itself if it is the one you mean"
                % (win_plain(given), [x for x in tops + real if _under(given, x)][0], win_plain(f)), 2)
    return f


def _under(p, top):
    return p == top or p.startswith(top.rstrip("/") + "/")


def wine_addon(kind):
    """is Wine Mono ("mono") or Wine Gecko ("gecko") on the system, unpacked where Wine looks for it (a shared
    install: share/wine/mono/wine-mono-VERSION, share/wine/gecko/wine-gecko-VERSION-ARCH)?"""
    for top in (os.environ.get("SILIK_WINE_SHARE") or WINE_SHARE).split(":"):
        d = os.path.join(top, kind)
        try:
            if any(n.startswith("wine-%s-" % kind) and os.path.isdir(os.path.join(d, n)) for n in os.listdir(d)):
                return True
        except OSError:
            pass
    return False


def wine_argv(d, cmd, arch=None):
    """a Wine command of the prefix as it is typed: env WINEDEBUG=... WINEPREFIX=... wine ..."""
    e = ["WINEDEBUG=" + os.environ.get("WINEDEBUG", "-all")]
    e += [k + "=" + os.environ[k] for k in WINE_ENV if os.environ.get(k) is not None]
    if list(cmd)[:1] == ["wineboot"] and os.environ.get("WINEDLLOVERRIDES") is None:
        # setting a prefix up: without Wine Mono (.NET) or Wine Gecko (HTML) on the system, Wine opens a dialog
        # offering to download them and waits for an answer (seen on the first installed system: the set-up never
        # ended). With the packages silik-wine-mono / silik-wine-gecko Wine finds them and asks nothing; for the
        # one that is missing, its library is left out of the set-up
        off = [dll for dll, kind in (("mscoree", "mono"), ("mshtml", "gecko")) if not wine_addon(kind)]
        if off:
            e.append("WINEDLLOVERRIDES=" + ",".join(off) + "=")
    if arch:
        e.append("WINEARCH=" + arch)
    return ["env"] + e + ["WINEPREFIX=" + d] + list(cmd)


def win_helper_env():
    """the environment of a helper with a window of its own (the question, a notification): this session's without
    G_RESOURCE_OVERLAYS. That variable is for the shell (its stylesheet); every GLib program that starts with it
    prints a line per overlay, and those lines were all that the output of a `silik win` command showed (seen)"""
    return dict((k, v) for k, v in os.environ.items() if k != "G_RESOURCE_OVERLAYS")


def win_die(ctx, msg, rc=1):
    """an error at the start of a Windows program; also a desktop notification when no terminal shows it (a
    double-click has none). The notification is not waited for more than 5 s (with nobody to take it, notify-send
    stays), and says nothing on this command's streams"""
    if not sys.stderr.isatty() and os.environ.get("DISPLAY") and shutil.which("notify-send"):
        argv = ["notify-send", "--app-name=SilikOS", "--icon=" + WIN_ICON, "SilikOS", msg]
        ctx.echo(argv)
        if not ctx.dry:
            try:
                subprocess.run(argv, check=False, timeout=5, env=win_helper_env(), stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except (OSError, subprocess.SubprocessError):
                pass
    die(msg, rc)


def win_echo(ctx, argv, redirect=""):
    """prints a command that runs with a redirected descriptor (the line a shell would take)"""
    if not ctx.quiet:
        print("$ " + " ".join(shlex.quote(a) for a in argv) + (" " + redirect if redirect else ""), flush=True)


def win_short(argv):
    """a sandboxed command for the status bar: the long front of the line as "...", then WINEPREFIX=... wine ..."""
    cut = [i for i, x in enumerate(argv) if x.startswith("WINEDEBUG=")]
    return [os.path.basename(argv[2]), "..."] + argv[cut[0]:] if cut and argv[:2] == ["env", "-i"] else argv


def win_narrow(folder):
    """True when a folder can be shown as a whole: not the home or what holds it, not a hidden folder of the home,
    not a place the sandbox mounts itself"""
    home = os.path.expanduser("~")
    taken = [home, WINE_ROOT, win_shared(), "/tmp", "/run", "/dev", "/proc", "/sys", "/usr", "/etc", "/home", "/var", "/opt"]
    hidden = _under(folder, home) and any(p.startswith(".") for p in folder[len(home):].split("/"))
    return not hidden and not any(_under(t, folder) for t in taken)


def win_downloads():
    """the Downloads folder: the one XDG_DOWNLOAD_DIR names in the user's user-dirs.dirs, else ~/Downloads"""
    home = os.path.expanduser("~")
    v = os.path.join(home, "Downloads")
    cfg = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config"), "user-dirs.dirs")
    for l in read(cfg).splitlines():
        if l.startswith("XDG_DOWNLOAD_DIR="):
            v = l.split("=", 1)[1].strip().strip('"').replace("$HOME", home)
    return os.path.normpath(v)


def win_always():
    """the folders every sandbox shows read-only: $SILIK_WIN_SHOW (a colon list), by default the Downloads folder"""
    v = os.environ.get("SILIK_WIN_SHOW")
    if v is None:
        v = win_downloads()
    return [p for p in (os.path.normpath(x) for x in v.split(":") if x) if os.path.isdir(p) and win_narrow(p)]


def wine_opt():
    """the folder of a Wine installed under /opt (/opt/silik-wine), which the sandbox shows read-only; else None"""
    wine = os.path.realpath(shutil.which("wine") or "")
    return "/".join(wine.split("/")[:3]) if wine.startswith("/opt/") and wine.count("/") > 2 else None


def win_show(f, d, iso=False):
    """what the sandbox must show, read-only, for file f to open: nothing when it is seen already (the prefix, the
    shared folder, the system, Wine's own folder, a folder always shown), else its folder, or f alone when the
    folder is too much. An isolated sandbox (`iso`) is not shown the Downloads folder: a file that lies directly
    in it is shown alone, so that a program nobody trusts yet cannot read, and send away, the other downloads"""
    always = [] if iso else win_always()
    if any(_under(f, t) for t in [win_shared(os.path.basename(d) if iso else None), d, "/usr", "/etc"] + [p for p in [wine_opt()] if p] + always):
        return []
    folder = os.path.dirname(f)
    return [folder] if win_narrow(folder) and not (iso and folder in win_always()) else [f]


def win_env(d, display=True, iso=None):
    """the environment of a sandboxed command, whole: nothing else crosses (no session bus address, no tokens).
    `iso`: the sandbox's own display ({"display": number, "xauth": its key file, "sound": bool}) when it is an
    isolated one: then nothing of the session's display, GPU or sound is named either"""
    home = os.path.expanduser("~")
    path = [p for p in (os.environ.get("PATH") or "").split(":") if p and any(_under(p, t) for t in ("/usr", "/bin", "/sbin"))]
    wine = shutil.which("wine") or ""
    if os.path.realpath(wine).startswith("/opt/"):
        path.insert(0, os.path.dirname(wine))
    e = {"HOME": os.path.join(d, "home"), "PATH": ":".join(path or ["/usr/bin", "/bin"]),
         "XDG_RUNTIME_DIR": os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()}
    e["USER"] = e["LOGNAME"] = os.environ.get("USER") or os.environ.get("LOGNAME") or "user"
    e["DBUS_SESSION_BUS_ADDRESS"] = WIN_NO_BUS
    if display and iso:
        keep = WIN_ENV_ISOLATED + (("PULSE_SERVER",) if iso.get("sound") else ())
        for k, v in os.environ.items():
            if k in keep or k.startswith("LC_"):
                e[k] = v
        e["DISPLAY"], e["XAUTHORITY"] = ":%s" % iso["display"], iso["xauth"]
    elif display:
        for k, v in os.environ.items():
            if k in WIN_ENV or k.startswith("LC_"):
                e[k] = v
        xa = os.environ.get("XAUTHORITY") or os.path.join(home, ".Xauthority")
        if os.path.isfile(xa):
            e["XAUTHORITY"] = xa
    return ["%s=%s" % (k, e[k]) for k in sorted(e)]


def win_sandbox(name, d, show=(), net=True, info_fd=None, iso=None, filter_fd=None):
    """the bwrap command line of a prefix's sandbox, up to "--": new user, process, IPC and host-name namespaces
    (and network, without `net`); the system read-only, the prefix and the shared folder read-write, `show`
    read-only, the display, sound and GPU; nothing else of the home folder.
    `iso` (win_env's): an isolated sandbox. Its own network namespace always (its network, when it has one, comes
    from pasta: win_pasta); of the display, the socket and the key of its own server only; no GPU device; the sound
    sockets only when asked"""
    home, rt, shared = os.path.expanduser("~"), win_runtime(name), win_shared(name if iso else None)
    xrd_host = os.environ.get("XDG_RUNTIME_DIR") or ""
    xrd = xrd_host or "/run/user/%d" % os.getuid()
    # env -i: the first process of the sandbox is bwrap itself, and it must not carry this command's environment
    a = ["env", "-i", bwrap_bin() or "bwrap", "--unshare-user", "--unshare-pid", "--unshare-ipc", "--unshare-uts", "--unshare-cgroup-try"]
    a += ([] if net and not iso else ["--unshare-net"]) + ["--new-session", "--cap-drop", "ALL"]
    if iso:
        a += ["--die-with-parent"]      # (its parent is the process that also holds its display: win_isolated_start)
    if info_fd is not None:
        a += ["--info-fd", str(info_fd)]
    if filter_fd is not None:           # the system calls a Windows program has no use for (win_filter)
        a += ["--seccomp", str(filter_fd)]

    def ro(p):
        a.extend(["--ro-bind", p, p])

    # the system, read-only
    ro("/usr")
    for p in ("/bin", "/sbin", "/lib", "/lib32", "/lib64", "/libx32"):
        if os.path.islink(p):
            a.extend(["--symlink", os.readlink(p), p])
        elif os.path.isdir(p):
            ro(p)
    ro("/etc")
    if wine_opt():                              # a Wine installed under /opt/NAME: that folder only
        ro(wine_opt())
    a += ["--proc", "/proc"]
    for p in ("/proc/keys", "/proc/key-users"):     # the names of this user's keys in the kernel (not their contents)
        if os.path.exists(p):
            a += ["--ro-bind", "/dev/null", p]
    a += ["--tmpfs", "/dev"]
    for n in ("null", "zero", "full", "random", "urandom"):
        a += ["--dev-bind", "/dev/" + n, "/dev/" + n]
    a += ["--tmpfs", "/dev/shm", "--symlink", "/proc/self/fd", "/dev/fd"]
    # /tmp and the runtime folder of this sandbox (Wine's server socket is in one of them)
    a += ["--bind", os.path.join(rt, "tmp"), "/tmp", "--bind", os.path.join(rt, "run"), xrd]
    resolv = os.path.realpath("/etc/resolv.conf")
    if net and resolv.startswith("/run/") and os.path.exists(resolv):   # a link into /run (systemd-resolved)
        ro(resolv)
    # GPU (an isolated sandbox has none: its display draws in software, and a GPU device is one more door)
    if not iso:
        if os.path.isdir("/dev/dri"):
            a += ["--dev-bind", "/dev/dri", "/dev/dri"]
        try:
            for n in sorted(os.listdir("/dev")):
                if n.startswith("nvidia"):
                    a += ["--dev-bind", "/dev/" + n, "/dev/" + n]
        except OSError:
            pass
    for p in ("/sys/dev", "/sys/devices", "/sys/class", "/sys/bus"):
        if os.path.isdir(p):
            ro(p)
    if iso:
        # its own display: that server's socket and key, nothing of the session's
        ro("%s/X%s" % (X11_SOCKETS, iso["display"]))
        ro(iso["xauth"])
    else:
        # the X11 display and its key
        disp = os.environ.get("DISPLAY") or ""
        sock = "/tmp/.X11-unix/X" + disp[1:].split(".")[0] if disp.startswith(":") else ""
        if sock and os.path.exists(sock):
            ro(sock)
        xa = os.environ.get("XAUTHORITY") or os.path.join(home, ".Xauthority")
        if os.path.isfile(xa):
            ro(xa)
    # sound: the PulseAudio and PipeWire sockets
    for s in ("pulse/native", "pipewire-0") if not iso or iso.get("sound") else ():
        if xrd_host and os.path.exists(os.path.join(xrd_host, s)):
            ro(os.path.join(xrd_host, s))
    # the prefix and the shared folder, read-write; the folders shown, read-only
    a += ["--bind", d, d, "--bind", shared, shared]
    for p in show:
        ro(p)
    return a + ["--remount-ro", "/", "--chdir", d, "--"]


def win_no_keys():
    """what a sandbox's first process and every program entering it call before they start: a new, empty session
    keyring of the kernel (keyctl(KEYCTL_JOIN_SESSION_KEYRING, NULL)). Without it they inherit this session's, and
    with it whatever the session keeps there and in the user keyring linked into it (a Kerberos ticket cache of
    the KEYRING kind, CIFS credentials, an eCryptfs key): run on EL 9, a key of the session was read from inside the
    box. Returns the function to call in the child, or None where the call is not known (not x86_64 or aarch64).
    It is not the whole answer: a program of the same user can still link the USER keyring by its number (seen);
    the system-call filter stops that (win_filter: keyctl is refused once this call is made, win_confine)."""
    nr = {"x86_64": 250, "aarch64": 219}.get(os.uname().machine)
    if nr is None:
        return None
    try:
        import ctypes
        call = ctypes.CDLL(None).syscall
    except (OSError, AttributeError):
        return None
    args = (ctypes.c_long(nr), ctypes.c_long(1), ctypes.c_long(0))

    def join():
        call(*args)
    return join


# -- the system calls a sandboxed program has no use for
# bubblewrap takes the capabilities away, but a program in the box could still make a user namespace of its own and
# be root in it (seen, 14/11/2026: a network device made, a file system mounted): that is where most of the
# kernel's privilege-escalation faults of the last years were reached from. It could also read the kernel's key
# list and link the user keyring by its number (seen: a key of the session read, one added). Wine needs none of
# these calls. They are refused by a filter of the kernel (seccomp) that bwrap loads for the box's first program
# and that every program entering the box loads before it enters: EPERM, and ENOSYS for clone3, which cannot be
# looked into (the C library then uses clone, whose flags can).
WIN_REFUSED = ("unshare", "mount", "umount", "umount2", "pivot_root", "open_tree", "move_mount", "fsopen", "fsconfig", "fsmount",
               "fspick", "mount_setattr", "keyctl", "add_key", "request_key", "bpf", "perf_event_open", "userfaultfd",
               "io_uring_setup", "io_uring_enter", "io_uring_register", "open_by_handle_at", "clone3")
# setns is not among them: every program enters the box with it (nsenter), and with unshare and clone's namespace
# flags refused a program of the box has no namespace to enter but its own.
WIN_CALLS = {       # the numbers of those calls, of clone and of ioctl (the kernel's tables: x86_64, i386, the generic one)
    "x86_64": {"unshare": 272, "mount": 165, "umount2": 166, "pivot_root": 155, "open_tree": 428, "move_mount": 429, "fsopen": 430,
               "fsconfig": 431, "fsmount": 432, "fspick": 433, "mount_setattr": 442, "keyctl": 250, "add_key": 248, "request_key": 249,
               "bpf": 321, "perf_event_open": 298, "userfaultfd": 323, "io_uring_setup": 425, "io_uring_enter": 426,
               "io_uring_register": 427, "open_by_handle_at": 304, "clone3": 435, "clone": 56, "ioctl": 16},
    "i386": {"unshare": 310, "mount": 21, "umount": 22, "umount2": 52, "pivot_root": 217, "open_tree": 428, "move_mount": 429,
             "fsopen": 430, "fsconfig": 431, "fsmount": 432, "fspick": 433, "mount_setattr": 442, "keyctl": 288, "add_key": 286,
             "request_key": 287, "bpf": 357, "perf_event_open": 336, "userfaultfd": 374, "io_uring_setup": 425, "io_uring_enter": 426,
             "io_uring_register": 427, "open_by_handle_at": 342, "clone3": 435, "clone": 120, "ioctl": 54},
    "aarch64": {"unshare": 97, "mount": 40, "umount2": 39, "pivot_root": 41, "open_tree": 428, "move_mount": 429, "fsopen": 430,
                "fsconfig": 431, "fsmount": 432, "fspick": 433, "mount_setattr": 442, "keyctl": 219, "add_key": 217, "request_key": 218,
                "bpf": 280, "perf_event_open": 241, "userfaultfd": 282, "io_uring_setup": 425, "io_uring_enter": 426,
                "io_uring_register": 427, "open_by_handle_at": 265, "clone3": 435, "clone": 220, "ioctl": 29},
}
# (a 32-bit Windows program is an i386 program to the kernel, with its own numbers: both tables on x86_64)
WIN_ARCHS = {"x86_64": ((0xc000003e, "x86_64"), (0x40000003, "i386")), "aarch64": ((0xc00000b7, "aarch64"),)}
CLONE_NAMESPACES = 0x7e020000       # CLONE_NEWNS, NEWCGROUP, NEWUTS, NEWIPC, NEWUSER, NEWPID, NEWNET
TIOCSTI, TIOCLINUX = 0x5412, 0x541c  # typing into a terminal, and the console's own paste


def win_filter(machine=None):
    """the filter as the kernel takes it (classic BPF, 8 bytes an instruction); None for a machine whose numbers
    are not written here. What it says: a call of another architecture than this machine's: EPERM; a call in
    WIN_REFUSED: EPERM (clone3: ENOSYS); clone with a namespace flag: EPERM; ioctl TIOCSTI or TIOCLINUX: EPERM;
    anything else: allowed"""
    import struct
    archs = WIN_ARCHS.get(machine or os.uname().machine)
    if not archs:
        return None
    allow, eperm, enosys = 0x7fff0000, 0x00050000 | errno.EPERM, 0x00050000 | errno.ENOSYS
    ld, jeq, jset, jge, ret = 0x20, 0x15, 0x45, 0x35, 0x06

    def ins(code, k, jt=0, jf=0):
        return struct.pack("<HBBI", code, jt, jf, k)

    blocks = []
    for arch, table in archs:
        calls = WIN_CALLS[table]
        b = [ins(ld, 0)]                                           # the call's number
        if table == "x86_64":
            b += [ins(jge, 0x40000000, 0, 1), ins(ret, enosys)]    # (the x32 numbers: a third table nobody uses)
        for name in WIN_REFUSED:
            if name in calls:
                b += [ins(jeq, calls[name], 0, 1), ins(ret, enosys if name == "clone3" else eperm)]
        b += [ins(jeq, calls["clone"], 0, 4), ins(ld, 16), ins(jset, CLONE_NAMESPACES, 0, 1), ins(ret, eperm), ins(ret, allow),
              ins(jeq, calls["ioctl"], 0, 4), ins(ld, 24), ins(jeq, TIOCSTI, 1, 0), ins(jeq, TIOCLINUX, 0, 1), ins(ret, eperm),
              ins(ret, allow)]
        blocks.append((arch, b))
    out = [ins(ld, 4)]                                              # the architecture of the call
    for i, (arch, b) in enumerate(blocks):
        # to its block: over the tests of the architectures after it, the "no" below and the blocks before it
        out.append(ins(jeq, arch, len(blocks) - 1 - i + 1 + sum(len(x[1]) for x in blocks[:i]), 0))
    out.append(ins(ret, eperm))
    for _arch, b in blocks:
        out += b
    return b"".join(out)


def win_filter_file(rt):
    """the filter as a file of the prefix's runtime folder (bwrap reads it from a descriptor: --seccomp); None
    when this machine has none"""
    f = win_filter()
    if f is None:
        return None
    path = os.path.join(rt, "seccomp.bpf")
    if read_bytes(path) != f:
        win_private_write_bytes(path, f)
    return path


def read_bytes(path):
    try:
        with open(path, "rb") as fh:
            return fh.read()
    except OSError:
        return None


def win_private_write_bytes(path, data):
    tmp = "%s.%d.tmp" % (path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    os.replace(tmp, path)


def win_confine():
    """what every program entering a sandbox calls before it starts (after the fork, before nsenter): win_no_keys,
    then no new privileges and the filter (prctl PR_SET_NO_NEW_PRIVS, PR_SET_SECCOMP). A filter stays for the
    program and everything it starts. When the kernel does not take it the program does not start (exit 126):
    a box without the filter is not the box that was promised. None where nothing can be called (no ctypes)"""
    keys, f = win_no_keys(), win_filter()
    if f is None:
        return keys
    try:
        import ctypes

        class Prog(ctypes.Structure):
            _fields_ = [("len", ctypes.c_ushort), ("filter", ctypes.c_void_p)]

        buf = ctypes.create_string_buffer(f, len(f))
        prog = Prog(len(f) // 8, ctypes.cast(buf, ctypes.c_void_p))
        prctl = ctypes.CDLL(None, use_errno=True).prctl
    except (OSError, AttributeError):
        return keys
    one, zero = ctypes.c_ulong(1), ctypes.c_ulong(0)

    def confine():
        if keys:
            keys()
        if prctl(38, one, zero, zero, zero) != 0 or prctl(22, ctypes.c_ulong(2), ctypes.byref(prog), zero, zero) != 0:
            os.write(2, b"silik: the kernel did not take the sandbox's system-call filter (seccomp): the program is not started\n")
            os._exit(126)
    confine.keep = (buf, prog)      # (the filter's bytes live as long as the function)
    return confine


def _isatty(fd):
    try:
        return os.isatty(fd)
    except OSError:
        return False


def win_relay(argv, console=False, preexec=None):
    """runs a command of an isolated sandbox without handing it this command's terminal; returns its exit code.
    A terminal given to a program stays in its hands when the command has ended: a helper that an isolated program
    left behind turned the terminal's echo on, wrote to it, and read the password typed at the next prompt (seen,
    14/11/2026). So where one of this command's three streams is a terminal the program gets a pipe, and this
    command copies: its output to the terminal, and what is typed to a console program (`console`); a windowed one
    reads nothing (/dev/null). The pipes end with this command. A stream that is not a terminal (a file, a pipe:
    `> out.txt`) is passed as it is: the owner named it."""
    import select
    tty = [_isatty(fd) for fd in (0, 1, 2)]
    if not any(tty):
        return subprocess.run(argv, check=False, preexec_fn=preexec).returncode
    p = subprocess.Popen(argv, preexec_fn=preexec, stdin=(subprocess.PIPE if console else subprocess.DEVNULL) if tty[0] else None,
                         stdout=subprocess.PIPE if tty[1] else None, stderr=subprocess.PIPE if tty[2] else None)
    out = {}
    if tty[1]:
        out[p.stdout.fileno()] = 1
    if tty[2]:
        out[p.stderr.fileno()] = 2
    inp = p.stdin.fileno() if tty[0] and console else None
    if inp is not None:
        os.set_blocking(inp, False)
    pending, end = b"", None

    def no_input():
        try:
            p.stdin.close()
        except OSError:
            pass

    try:
        while True:
            done = p.poll() is not None
            if done and end is None:
                end = time.time() + 0.5     # what the program wrote before it ended; not what a helper writes after
            r, w, _ = select.select(list(out) + ([0] if inp is not None and not pending else []),
                                    [inp] if inp is not None and pending else [], [], 0 if done else 0.1)
            for fd in r:
                if fd in out:
                    b = os.read(fd, 65536)
                    if not b:
                        del out[fd]
                        continue
                    to = out[fd]
                    while b:
                        b = b[os.write(to, b):]
                else:
                    pending = os.read(0, 65536)
                    if not pending:         # the end of what is typed (Ctrl+D)
                        no_input()
                        inp = None
            if w:
                try:
                    pending = pending[os.write(inp, pending):]
                except BlockingIOError:
                    pass
                except OSError:             # the program closed its input
                    no_input()
                    inp, pending = None, b""
            if done and (not r or time.time() > end):
                break
    finally:
        if p.poll() is None:
            p.kill()
            p.wait()
        for f in (p.stdin, p.stdout, p.stderr):
            try:
                if f is not None:
                    f.close()
            except OSError:
                pass
    return p.returncode


# -- an isolated sandbox's own display
WIN_TITLE = {"en": "SilikOS: isolated Windows programs (%s)", "ca": "SilikOS: programes de Windows aïllats (%s)",
             "es": "SilikOS: programas de Windows aislados (%s)"}


def win_lang():
    """en, ca or es: the language of what a person is asked or shown (as the COMMAND bar chooses it)"""
    for k in ("SILIK_LANG", "LC_ALL", "LC_MESSAGES", "LANG"):
        v = (os.environ.get(k) or "")[:2].lower()
        if v in WIN_TITLE:
            return v
    return "en"


def win_xauth_entry(cookie):
    """one entry of an X authority file: this key, for any host and any display number (the file is one display's)"""
    def field(b):
        return len(b).to_bytes(2, "big") + b
    return (0xffff).to_bytes(2, "big") + field(b"") + field(b"") + field(b"MIT-MAGIC-COOKIE-1") + field(cookie)


def win_xkb(text):
    """the session's keyboard layout, read from its `setxkbmap -query` (rules, model, layout, variant, options), as
    the switches that give it to another server with setxkbmap. A nested server starts with the US layout whatever
    the session has, and Xephyr 1.20.11's own -xkb-layout and -keybd switches only change the layout's NAME (seen
    in a session set to es/cat: the key right of L stayed a semicolon); setxkbmap from outside changes the keys."""
    out = []
    for l in text.splitlines():
        k, _, v = l.partition(":")
        k, v = k.strip(), v.strip()
        if k in ("rules", "model", "layout", "variant", "options") and v and all(c.isalnum() or c in "-_:,+()." for c in v):
            out += ["-" + k.replace("options", "option"), v]
    return out


def win_xkb_set(ctx, iso):
    """gives the sandbox's own server the session's keyboard layout (a client from outside, with the server's key)"""
    xkb = win_xkb(ctx.query(["setxkbmap", "-query"]))
    if xkb:
        ctx.run(["env", "XAUTHORITY=" + iso["xauth"], "setxkbmap", "-display", ":%s" % iso["display"]] + xkb, check=False)


def win_screen():
    """WIDTHxHEIGHT of an isolated program's screen: $SILIK_WIN_SCREEN, else WIN_SCREEN"""
    v = os.environ.get("SILIK_WIN_SCREEN") or ""
    w, _, h = v.partition("x")
    return v if w.isdigit() and h.isdigit() and 320 <= int(w) <= 16384 and 200 <= int(h) <= 16384 else WIN_SCREEN


# What the nested server offers and a Windows program has no use for: every extension is code that reads what the
# box sends (the record of other clients' requests, made-up input, the old security extension, double buffers, video
# overlays, the list of other clients' resources, the screen saver). Run: Wine 9.0's notepad and console with them off.
WIN_X_OFF = ("RECORD", "XTEST", "SECURITY", "DOUBLE-BUFFER", "XVideo", "X-Resource", "MIT-SCREEN-SAVER")


def win_free_display(name, tried=()):
    """a display number for the sandbox's own server: 100 or more, with no socket (file or abstract) and no lock
    file. Left to choose (-displayfd alone), the server took the first number whose socket FILE it could make its
    own, and with no abstract socket to tell it otherwise (-nolisten local) that was the session's: on a session
    whose display is :0 it removed the session's /tmp/.X11-unix/X0, put its own there, and took it away when it
    ended (seen on the first installed system, 14/11/2026, and again in a container). Prefixes start looking at
    different numbers, so two that start together do not meet."""
    import socket
    first = 100 + sum(name.encode()) % 400
    for n in list(range(first, 600)) + list(range(100, first)):
        if n in tried or os.path.lexists("%s/X%d" % (X11_SOCKETS, n)) or os.path.lexists("/tmp/.X%d-lock" % n):
            continue
        s = socket.socket(socket.AF_UNIX)
        try:
            s.connect("\0%s/X%d" % (X11_SOCKETS, n))
            continue                    # (a server answers on the abstract socket of that number)
        except OSError:
            return n
        finally:
            s.close()
    return None


def win_xephyr(name, rt, displayfd, number="N"):
    """the nested X server of an isolated sandbox: a window of this session, titled with the prefix's name, that is
    the whole screen of the prefix's programs.
    -displayfd: the server takes a free display number and writes it when it is ready; -auth: its own key, so that
    nothing else of this user connects by chance; no TCP and no abstract socket (-nolisten local: the socket's file
    is then the only way in, and only this sandbox is given it); -noreset: it stays between two programs;
    -no-host-grab: it never takes the session's keyboard or pointer for itself (Xephyr's Ctrl+Shift grab is off);
    -extension: WIN_X_OFF; :NUMBER: the display number is given (win_free_display), -displayfd says when it is up.
    setpriv --pdeathsig: it ends with the process that started it (win_isolated_start), as the sandbox does."""
    return ["setpriv", "--pdeathsig", "TERM", xephyr_bin() or "Xephyr", "-displayfd", str(displayfd), "-auth", os.path.join(rt, "Xauthority"),
            "-nolisten", "tcp", "-nolisten", "local", "-noreset", "-no-host-grab", "-screen", win_screen(),
            "-title", WIN_TITLE[win_lang()] % name, "-name", "silik-win-isolated"] + \
           [w for e in WIN_X_OFF for w in ("-extension", e)] + [":%s" % number]


def win_route_out(ctx):
    """the interfaces this machine's default routes leave by: (IPv4's, IPv6's), '' where there is none or `ip`
    does not say"""
    out = []
    for fam in ("-4", "-6"):
        dev = ""
        try:
            for r in json.loads(ctx.query(["ip", "-j", fam, "route", "show", "default"]) or "[]"):
                d = r.get("dev") or ""
                if d and all(c.isalnum() or c in "-_.:@" for c in d) and len(d) < 16:
                    dev = dev or d
        except (ValueError, TypeError, AttributeError):
            pass
        out.append(dev)
    return tuple(out)


def win_pasta(pid, out=("", ""), rt=None):
    """the network of an isolated sandbox: pasta (the package passt) joins the sandbox's network namespace and
    carries its connections out as this user's own. No port of the sandbox is opened to this machine (-t/-u none),
    none of this machine's loopback ports is reachable from inside (-T/-U none), and the gateway's address is not
    this machine (--no-map-gw): what listens on localhost here is not there. pasta leaves when the namespace goes.
    `out` (win_route_out): its connections leave by the interface of the default route and by no other
    (--outbound-if4/6). Without that a connection to another address of this machine (a bridge of virtual machines
    or containers, a second network) was delivered here: a server listening on every address answered the box, and
    so would a virtual machine behind the bridge (seen, 14/11/2026)."""
    return [pasta_bin() or "pasta", "--quiet", "--config-net", "-t", "none", "-u", "none", "-T", "none", "-U", "none", "--no-map-gw"] + \
           (["--outbound-if4", out[0]] if out[0] else []) + (["--outbound-if6", out[1]] if out[1] else []) + \
           ["--no-netns-quit"] + (["--pid", os.path.join(rt, "pasta.pid")] if rt else []) + \
           ["--userns", "/proc/%s/ns/user" % pid, "--netns", "/proc/%s/ns/net" % pid]


def win_pasta_run(ctx, name, pid, rt):
    """starts pasta for the sandbox whose first process is `pid`; True when the sandbox has its network.
    On EL 9 pasta runs in its own SELinux domain (pasta_t), and what that domain may do decides how it is called
    (passt-selinux 0^20251210, read with sesearch; the first installed system refused the call before this,
    14/11/2026: `denied { open } comm=pasta.avx2 ... unconfined_t dir`):
    - it may search /proc/PID of a program of the session and read the links there, and open the namespace files,
      but not OPEN the folder /proc/PID/ns, which it does to watch for the namespace's end: --no-netns-quit, and
      this command ends pasta itself (win_pasta_end: its number is in the file --pid names);
    - it may create and write files in the runtime folder (user_tmp_t), not elsewhere: its pid file is there, and
      so are its own words (pasta.log), which it could not write to a file the caller had redirected to in /tmp."""
    argv, log = win_pasta(pid, win_route_out(ctx), rt), os.path.join(rt, "pasta.log")
    win_echo(ctx, argv, ">%s 2>&1" % shlex.quote(log))
    with open(log, "wb") as fh:
        try:
            rc = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=fh, stderr=fh, check=False).returncode
        except OSError as e:
            rc = 127
            fh.write(("%s\n" % e).encode())
    if rc:
        said = " ".join(read(log).split()[-40:])
        print("silik: pasta exited %d%s: the programs of prefix %s have no network" % (rc, " (%s)" % said if said else "", name), file=sys.stderr)
    return rc == 0


def win_pasta_end(rt, echo=None):
    """ends the pasta of the sandbox whose runtime folder is `rt` (it was told not to watch for the namespace's
    end: win_pasta_run). Only a process named pasta, of this user, whose number is in the pid file: the file is
    in a folder the sandbox does not see"""
    path = os.path.join(rt, "pasta.pid")
    try:
        pid = int(read(path).strip() or 0)
    except ValueError:
        pid = 0
    if pid > 1:
        try:
            if read("/proc/%d/comm" % pid).startswith("pasta") and os.stat("/proc/%d" % pid).st_uid == os.getuid():
                if echo:
                    echo(["kill", str(pid)])
                os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    try:
        os.unlink(path)
    except OSError:
        pass


def win_display_alive(n):
    """True when the X server of display number n answers on its socket"""
    import socket
    s = socket.socket(socket.AF_UNIX)
    try:
        s.settimeout(2)
        s.connect("%s/X%s" % (X11_SOCKETS, n))
        return True
    except (OSError, ValueError):
        return False
    finally:
        s.close()


def win_isolated_start(ctx, name, d, rt, show, net, fd, iso, tail, logf, filt=None):
    """starts an isolated sandbox: its X server, then bwrap, both children of ONE small process that stays (a
    child of this command, named silik-win-box) and does nothing but wait for the first of the two to end, and then
    end the other: the window closed by the owner ends every program of the box at once, with or without a window
    of its own (one without would otherwise run on, unseen, with the network), and the end of the sandbox takes
    its window away. Both die with that process too (setpriv --pdeathsig, bwrap --die-with-parent).
    Returns (that process's id, the display number)."""
    import secrets
    disp = os.path.join(rt, "display")
    for f in (disp, iso["xauth"]):
        try:
            os.unlink(f)
        except OSError:
            pass
    xfd = os.open(iso["xauth"], os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    os.write(xfd, win_xauth_entry(secrets.token_bytes(16)))
    os.close(xfd)
    win_echo(ctx, win_xephyr(name, rt, 3), "3>%s &" % shlex.quote(disp))
    sys.stdout.flush()
    sys.stderr.flush()
    pid = os.fork()
    if pid == 0:                                    # the child: it starts the two, waits, and ends what is left
        rc = 127
        try:
            os.setsid()
            # nothing of this command stays open in it (the prefix's lock above all: it would be held for ever)
            os.closerange(3, fd)
            os.closerange(fd + 1, 4096)
            (win_no_keys() or (lambda: None))()         # (the X server and the sandbox: no key of the session's)
            log = os.open(logf, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            os.dup2(os.open(os.devnull, os.O_RDONLY), 0)
            os.dup2(log, 1)
            os.dup2(log, 2)
            try:
                import ctypes
                ctypes.CDLL(None).prctl(15, b"silik-win-box", 0, 0, 0)      # PR_SET_NAME: what `ps` and `top` call it
            except (OSError, AttributeError):
                pass
            tried, x, n = [], None, ""
            while not n.endswith("\n"):
                # (a number another server took between the look and the start: that start fails, the next number)
                number = win_free_display(name, tried)
                if number is None or len(tried) > 4:
                    raise OSError("the X server (Xephyr) did not start")
                tried.append(number)
                dfd = os.open(disp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                x = subprocess.Popen(win_xephyr(name, rt, dfd, number), pass_fds=(dfd,))
                os.close(dfd)
                t0 = time.time()
                while not n.endswith("\n") and x.poll() is None:
                    if time.time() - t0 > 20:
                        raise OSError("the X server (Xephyr) did not start")
                    time.sleep(0.02)
                    n = read(disp)
            ffd = os.open(filt, os.O_RDONLY) if filt else None
            b = subprocess.Popen(win_sandbox(name, d, show, net, info_fd=fd, iso=dict(iso, display=n.strip()), filter_fd=ffd) + tail(n.strip()),
                                 pass_fds=(fd,) if ffd is None else (fd, ffd))
            os.close(fd)
            if ffd is not None:
                os.close(ffd)
            gone = 0
            while gone not in (x.pid, b.pid):
                gone = os.wait()[0]
            for other in (x, b):
                if other.pid != gone:
                    other.terminate()           # (bwrap: its sandbox dies with it; Xephyr: it closes its window)
                    os.waitpid(other.pid, 0)
            win_pasta_end(rt)                   # (the box's network goes with it)
            rc = 0
        except BaseException as e:      # (nothing of this command's own exit path may run in the child)
            try:
                os.write(2, ("silik: %s\n" % e).encode())
            except OSError:
                pass
        os._exit(rc)
    t0, n = time.time(), ""
    while not n.endswith("\n"):
        if os.waitpid(pid, os.WNOHANG)[0] or time.time() - t0 > 25:
            die("the display of prefix %s did not start: %s" % (name, " ".join(read(logf).split()[-40:]) or "no message"))
        time.sleep(0.02)
        n = read(disp)
    return pid, n.strip()


def win_runtime_make(rt):
    """the prefix's runtime folders, this user's only (under /tmp another user could have made them first)"""
    tops = [rt, os.path.dirname(rt)]
    if not _under(rt, os.environ.get("XDG_RUNTIME_DIR") or "\0"):
        tops.append(os.path.dirname(tops[-1]))
    for p in tops[::-1]:
        try:
            os.mkdir(p, 0o700)
        except FileExistsError:
            pass
        st = os.lstat(p)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
            die("%s is not a folder of this user: not using it" % p)


def win_session_info(name):
    """the running sandbox of the prefix: {"pid": its first process as this system numbers it, "ns": its process
    namespace, "show": the folders it shows read-only, "net": True with network, "iso": win_env's dictionary when
    it is an isolated one}; {} when none runs"""
    try:
        s = json.loads(read(os.path.join(win_runtime(name), "session")) or "{}")
        pid = s["pid"]
        if os.readlink("/proc/%d/ns/pid" % pid) != s["ns"] or not os.readlink("/proc/%d/ns/mnt" % pid):
            return {}
        # an isolated sandbox whose display has gone (its window was closed) can show nothing: it is over, and
        # win_reap ends what is left of it
        if s.get("iso") and not win_display_alive(s["iso"]["display"]):
            return {}
        kids = read("/proc/%d/task/%d/children" % (pid, pid), None)
        if kids is None:        # this kernel does not list children: the first process is enough
            return s
        # its wineserver must be alive too: the sandbox ends with it
        live = [k for k in kids.split() if read("/proc/%s/comm" % k).startswith("wineserver")
                and read("/proc/%s/stat" % k).rpartition(")")[2].split()[:1] not in ([], ["Z"])]
        return s if live else {}
    except (ValueError, KeyError, TypeError, OSError):
        return {}


def win_reap(ctx, name):
    """ends what is left of a sandbox whose wineserver has gone. A sandbox lives as long as any process of it does:
    a helper that something started inside (a bus, a daemon) would keep it, its mounts and its processes for ever.
    Only processes of the recorded process namespace that have this prefix's runtime folder mounted are ended."""
    rt = win_runtime(name)
    try:
        ns = json.loads(read(os.path.join(rt, "session")) or "{}").get("ns") or ""
        if not ns or ns == os.readlink("/proc/self/ns/pid") or win_session_info(name):
            return
        left = []
        mark = "/silik-win/%s/tmp /tmp " % name       # (a mount's source is written from the root of its own filesystem)
        for p in os.listdir("/proc"):
            try:
                if p.isdigit() and os.readlink("/proc/%s/ns/pid" % p) == ns and mark in read("/proc/%s/mountinfo" % p):
                    left.append(int(p))
            except OSError:
                pass
    except (ValueError, TypeError, AttributeError, OSError):
        return
    if left:
        ctx.echo(["kill", "-KILL"] + [str(p) for p in sorted(left)])
        for p in ([] if ctx.dry else left):
            try:
                os.kill(p, signal.SIGKILL)
            except OSError:
                pass
    if not ctx.dry:
        try:
            os.unlink(os.path.join(rt, "session"))
        except OSError:
            pass


def win_server_socket(rt):
    """the socket of the sandbox's wineserver (its place differs between Wine builds), '' when there is none"""
    for top in ("tmp", "run"):
        for dp, _dn, fn in os.walk(os.path.join(rt, top)):
            if "socket" in fn and os.path.basename(dp).startswith("server-"):
                return os.path.join(dp, "socket")
    return ""


def win_session(ctx, name, d, show=(), net=True, iso=False, sound=False):
    """the prefix's running sandbox, started when there is none: bwrap with the prefix's wineserver as its first
    program. Every program of the prefix then enters it (win_enter): they must share the wineserver, and the
    wineserver is what opens their files, so they share its view. Returns win_session_info's dictionary.
    `iso`: an isolated one, with an X server of its own started first and, with `net`, pasta for its network."""
    s = win_session_info(name)
    if s:
        return s
    win_reap(ctx, name)                 # (what an earlier sandbox of this prefix may have left)
    rt = win_runtime(name)
    show = sorted((set() if iso else set(win_always())) | set(show))
    show = [p for p in show if not any(p != q and _under(p, q) for q in show)]
    iso = {"display": "N", "xauth": os.path.join(rt, "Xauthority"), "sound": bool(sound)} if iso else None

    def tail(n=None):
        return ["env"] + win_env(d, iso=dict(iso, display=n) if n else iso) + wine_argv(d, ["wineserver", "--foreground"])[1:]

    info = os.path.join(rt, "session.json")
    if ctx.dry:
        if iso:
            win_echo(ctx, win_xephyr(name, rt, 3), "3>%s &" % shlex.quote(os.path.join(rt, "display")))
            win_xkb_set(ctx, iso)
        win_echo(ctx, win_sandbox(name, d, show, net, info_fd=3, iso=iso, filter_fd=4 if win_filter() else None) + tail(),
                 "3>%s%s &" % (shlex.quote(info), " 4<%s" % shlex.quote(os.path.join(rt, "seccomp.bpf")) if win_filter() else ""))
        if iso and net:
            win_echo(ctx, win_pasta("PID", win_route_out(ctx), rt), ">%s 2>&1" % shlex.quote(os.path.join(rt, "pasta.log")))
        return {"pid": 0, "ns": "", "show": show, "net": net, "iso": iso}
    win_runtime_make(rt)
    with open(os.path.join(rt, "lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        s = win_session_info(name)
        if s:
            return s
        win_pasta_end(rt)                         # (the network of an earlier sandbox whose holder was killed)
        for sub in ("tmp", "run"):                # the sandbox's /tmp and runtime folder start empty
            shutil.rmtree(os.path.join(rt, sub), ignore_errors=True)
            os.mkdir(os.path.join(rt, sub), 0o700)
        fd = os.open(info, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        logf = os.path.join(rt, "session.log")
        filt = win_filter_file(rt)
        ffd = os.open(filt, os.O_RDONLY) if filt else None
        if iso:
            box, n = win_isolated_start(ctx, name, d, rt, show, net, fd, iso, tail, logf, filt)
            iso = dict(iso, display=n)
            win_xkb_set(ctx, iso)
            argv = win_sandbox(name, d, show, net, info_fd=fd, iso=iso, filter_fd=ffd) + tail(n)

            def ended():
                try:
                    return os.waitpid(box, os.WNOHANG)[0] != 0
                except ChildProcessError:
                    return True
        else:
            argv = win_sandbox(name, d, show, net, info_fd=fd, filter_fd=ffd) + tail()
        win_echo(ctx, argv, "%d>%s%s &" % (fd, shlex.quote(info), " %d<%s" % (ffd, shlex.quote(filt)) if filt else ""))
        ctx.note(win_short(argv))
        if not iso:
            with open(logf, "wb") as log:
                p = subprocess.Popen(argv, pass_fds=(fd,) if ffd is None else (fd, ffd), stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                     start_new_session=True, preexec_fn=win_no_keys())

            def ended():
                return p.poll() is not None
        os.close(fd)
        if ffd is not None:
            os.close(ffd)
        t0, pid = time.time(), 0
        while not (pid and win_server_socket(rt)):
            if ended() or time.time() - t0 > 30:
                die("the sandbox of prefix %s did not start: %s" % (name, " ".join(read(logf).split()[-40:]) or "no message"))
            time.sleep(0.05)
            try:
                pid = int(json.loads(read(info) or "{}").get("child-pid", 0))
            except ValueError:
                pid = 0
        if iso and net:
            # (pasta puts itself in the background once the network is there; the box's holder ends it: win_pasta_end)
            win_pasta_run(ctx, name, pid, rt)
        s = {"pid": pid, "ns": os.readlink("/proc/%d/ns/pid" % pid), "show": show, "net": net}
        if iso:
            s["iso"] = iso
        with open(os.path.join(rt, "session"), "w") as f:
            json.dump(s, f)
        return s


def win_enter(ctx, d, s, cmd, cwd=None, display=True, console=False):
    """runs a Wine command inside the prefix's running sandbox `s`: nsenter into its namespaces, then no new
    privileges, death with this command, a session of its own (no hold on the terminal) and a clean environment"""
    pid = s.get("pid")
    kinds = (("user", "-U"), ("mnt", "-m"), ("pid", "-p"), ("ipc", "-i"), ("uts", "-u"), ("net", "-n"), ("cgroup", "-C"))
    try:
        flags = [f for k, f in kinds if os.readlink("/proc/%d/ns/%s" % (pid, k)) != os.readlink("/proc/self/ns/" + k)] if pid else \
                ["-U", "-m", "-p", "-i", "-u"] + ([] if s.get("net", True) and not s.get("iso") else ["-n"])
    except OSError as e:
        print("silik: %s" % e, file=sys.stderr)
        return 126
    cwd = cwd or os.getcwd()
    seen = [d, win_shared(os.path.basename(d) if s.get("iso") else None), "/usr", "/etc"] + [p for p in s.get("show", ()) if os.path.isdir(p)]
    cwd = cwd if any(_under(cwd, t) for t in seen) else os.path.join(d, "home")
    # env -i first: what enters the sandbox carries none of this command's environment, not even for a moment
    argv = ["env", "-i", "nsenter", "--preserve-credentials", "-t", str(pid or "PID")] + flags + \
           ["--", "setpriv", "--no-new-privs", "--pdeathsig", "KILL", "setsid", "--wait", "env", "-C", cwd] + \
           win_env(d, display, s.get("iso")) + cmd[1:]
    ctx.echo(argv)
    if ctx.dry:
        return 0
    ctx.note(win_short(argv))
    try:
        # (an isolated program is not given this command's terminal: win_relay; `console`: it reads what is typed)
        rc = win_relay(argv, console, win_confine()) if s.get("iso") else subprocess.run(argv, check=False, preexec_fn=win_confine()).returncode
    except OSError as e:
        print("silik: %s" % e, file=sys.stderr)
        return 126
    return rc if rc >= 0 else 128 - rc


def win_outside(d):
    """True when a wineserver started outside the sandbox serves the prefix (upstream Wine's socket place)"""
    import socket
    try:
        st = os.stat(d)
        s = socket.socket(socket.AF_UNIX)
        try:
            s.connect("/tmp/.wine-%d/server-%x-%x/socket" % (os.getuid(), st.st_dev, st.st_ino))
            return True
        finally:
            s.close()
    except OSError:
        return False


WIN_CONSOLE = ("cmd", "cmd.exe", "reg", "reg.exe", "winepath", "wineboot", "wineserver")   # Wine's own programs without a window


def win_desktop(cmd):
    """a windowed program of an isolated sandbox runs on Wine's own desktop (`wine explorer /desktop=NAME,SIZE
    PROGRAM`): the nested server has no window manager, and without one a program's windows have no title bar and
    cannot be moved or closed (seen with Wine 9.0 in Xephyr). Wine's desktop draws them itself, with a task bar."""
    return cmd[:1] + ["explorer", "/desktop=silik,%s" % win_screen()] + cmd[1:] if cmd[:1] == ["wine"] and cmd[1:2] != ["explorer"] else cmd


def win_apart_check(ctx, a, name):
    """ends the command when the programs of prefix `name` are isolated ones (win_apart) and what was asked would
    run them, or let them reach, outside an isolated sandbox. Three ways that happened (seen, 14/11/2026):
    - no bwrap found (a PATH without it): the "isolated" program ran with no sandbox at all, after one line on
      the standard error that a double-click never shows; --no-sandbox on a marked prefix did the same on request;
    - an existing prefix that is not marked (`silik win install work setup.exe`, the question answered "isolated"):
      the program ran isolated once, in a prefix whose other programs run on the session's display, and replaced
      one of them; the next start of that one ran its code there. The programs of a prefix are not protected from
      each other, so an isolated run is for a prefix of isolated programs only"""
    if not win_apart(a, name):
        return
    d = prefix_dir(name)
    if os.path.isdir(d) and name not in win_marked():
        win_die(ctx, "prefix %s is not one of isolated programs: its programs use this session's display, and a program run isolated in it "
                "could change them, so nothing was run. Either `silik win isolate %s` (every program of %s then runs isolated), or "
                "another prefix (--prefix NEW, or none: the prefix \"%s\"), or the normal box if you trust this file (--yes)" % (name, name, name, WIN_ISOLATED), 69)
    if ctx.dry:
        return
    if getattr(a, "no_sandbox", False):
        win_die(ctx, "prefix %s is one of isolated programs: --no-sandbox would give them this user's whole account. "
                "`silik win isolate --off %s` first, if that is what you mean" % (name, name), 69)
    if win_cannot_isolate():
        win_die(ctx, "prefix %s runs isolated, and it cannot here: %s" % (name, win_cannot_isolate()), 69)


def win_exec(ctx, name, d, cmd, a=None, show=(), cwd=None, arch=None, window=True):
    """runs a Wine command of prefix `name` (in its sandbox when bwrap is there) and returns its exit code.
    `window`: False for a console program typed in a terminal (it is not put on Wine's desktop when isolated)"""
    win_apart_check(ctx, a, name)       # (again here: nothing of an isolated prefix runs without passing it)
    if window and win_iso(a, name):
        cmd = win_desktop(list(cmd))
    tail = wine_argv(d, cmd, arch)
    if not win_boxed(a):
        if not getattr(ctx, "win_said", False):       # once per command, however many Wine commands it takes
            ctx.win_said = True
            if bwrap_bin():
                print("silik: NO SANDBOX (--no-sandbox): this Windows program reads and writes EVERYTHING this user can, the whole home folder included", file=sys.stderr)
            else:
                print("silik: bwrap (bubblewrap) is not installed: Windows programs run without the sandbox", file=sys.stderr)
        if win_session_info(name) and not ctx.dry:
            win_die(ctx, "prefix %s is running in the sandbox: close its programs (`silik win stop %s`) before running it without" % (name, name))
        if cwd and os.path.isdir(cwd) and cwd != os.getcwd():
            ctx.echo(["cd", cwd])
            if not ctx.dry:
                os.chdir(cwd)
        rc, _ = ctx.run(tail, check=False)
        return rc
    net = not getattr(a, "no_net", False)
    iso, sound = win_iso(a, name), bool(getattr(a, "sound", False))
    if iso and not ctx.dry and win_cannot_isolate():
        win_die(ctx, "prefix %s runs isolated, and it cannot here: %s" % (name, win_cannot_isolate()), 69)
    if iso and net and not pasta_bin():
        net = False
        if not getattr(ctx, "win_net_said", False):
            ctx.win_net_said = True
            print("silik: pasta (the package passt) is not installed: the isolated programs of prefix %s run without network" % name, file=sys.stderr)
    rc = 0

    def fits(s):
        return s["net"] == net and bool(s.get("iso")) == iso and (not iso or not sound or bool(s["iso"].get("sound"))) and \
            all(any(_under(p, q) for q in s["show"]) for p in show)

    for again in (False, True):
        s = win_session_info(name)
        if s and not fits(s) and not ctx.dry:
            # a running sandbox cannot be given another folder or another network: it ends by itself 3 s after
            # its last program (the wineserver's own delay), so wait that long before giving up
            t0 = time.time()
            while win_session_info(name) and time.time() - t0 < 5:
                time.sleep(0.1)
            s = win_session_info(name)
            if s and not fits(s):
                what = ("with a display of its own (isolated)" if s.get("iso") else "on this session's display (not isolated)") if bool(s.get("iso")) != iso else \
                       "%s network" % ("with" if s["net"] else "without") if s["net"] != net else \
                       "without sound" if iso and sound and not s["iso"].get("sound") else \
                       "not showing " + " ".join(p for p in show if not any(_under(p, q) for q in s["show"]))
                win_die(ctx, "the programs of prefix %s are running in a sandbox %s, and a running sandbox is not changed: close them "
                        "(or `silik win stop %s`) and run this again, or put the file in %s" % (name, what, name, win_shared(name if iso else None)), 75)
        if not s and not ctx.dry and win_outside(d):
            win_die(ctx, "prefix %s is in use by a Wine started outside the sandbox: close its programs (`silik win stop %s`) first" % (name, name))
        fresh = not s
        s = s or win_session(ctx, name, d, show, net, iso, sound)
        t0 = time.time()
        rc = win_enter(ctx, d, s, tail, cwd, console=not window)
        # the sandbox can end while this program was entering it (the same 3 s): the program then failed or was
        # killed at once, and is started again in a new one. (An isolated sandbox also ends when its window is
        # closed, and a closed window is not opened again: not one this command started itself, and one that was
        # running only within 2 s)
        if ctx.dry or again or rc not in (1, 126, 137) or time.time() - t0 > (2 if s.get("iso") else 5) or (fresh and s.get("iso")):
            break
        while win_session_info(name) and time.time() - t0 < 1.5:
            time.sleep(0.1)
        if win_session_info(name):
            break
        print("silik: the sandbox of prefix %s ended while the program started: starting again" % name, file=sys.stderr)
    return rc


def win_need_wine(ctx):
    """ends the command, saying what to do, when Wine is not on this machine"""
    if not ctx.dry and not shutil.which("wine"):
        if not x86():
            win_die(ctx, ARM_WINE % (host_arch(), win_route_here()), 127)
        win_die(ctx, "Wine is not installed (the package silik-wine: `sudo dnf install silik-wine`): Windows programs cannot run here yet", 127)


def win_prepare(ctx, name, a=None, create=False, arch="win64", show=()):
    """before a program runs: the prefix (made on first use when `create`), its home, the shared folder, drive W:.
    `show`: what the program that follows needs shown. The set-up of a new prefix starts the prefix's sandbox, and
    a running sandbox is not changed: started without it, the first isolated open of a file ended with "a running
    sandbox is not changed" (the set-up's services had not gone after 5 s; seen on the first installed system)"""
    d, shared = prefix_dir(name), win_shared_of(a, name)
    new = not os.path.isdir(d)
    win_need_wine(ctx)
    if new and not create:
        if ctx.dry:
            return d
        die("no prefix %s; `silik win create %s`" % (name, name))
    dev = os.path.join(d, "dosdevices")
    if os.path.islink(dev) or os.path.islink(os.path.join(d, "home")):
        die("%s: dosdevices or home is a link: not using this prefix" % d)
    # a new prefix gets the folders Wine's first program would make, before its wineserver starts
    mk = [p for p in ([os.path.join(d, "home"), shared] + ([dev, os.path.join(d, "drive_c")] if new else [])) if not os.path.isdir(p)]
    if mk:
        ctx.run(["mkdir", "-p"] + mk)
    if new:
        ctx.run(["ln", "-s", "../drive_c", os.path.join(dev, "c:")])
        ctx.run(["ln", "-s", "/", os.path.join(dev, "z:")])
    link = os.path.join(dev, "w:")
    if new or (os.path.isdir(dev) and not (os.path.islink(link) and os.readlink(link) == shared)):
        ctx.run(["ln", "-sfn", shared, link])
    if new:
        if not ctx.dry:
            print("silik: first use of the Wine prefix %s: setting it up" % name, file=sys.stderr)
        if win_exec(ctx, name, d, ["wineboot", "--init"], a, show=show, arch=arch) != 0:
            die("wineboot could not set up the prefix %s" % name)
    return d


def win_path(f, d, shared):
    """file f as a Windows path of the prefix: W: is the shared folder, C: the prefix's drive, Z: the root"""
    c = os.path.join(d, "drive_c")
    for top, drive in ((shared, "W:"), (c, "C:")):
        if _under(f, top):
            return drive + "\\" + f[len(top):].strip("/").replace("/", "\\")
    return "Z:" + f.replace("/", "\\")


def win_unix(d, wp):
    """the file behind a Windows path of the prefix (names compared without case); None when it is not there"""
    if len(wp) < 3 or wp[1] != ":" or wp[2] not in "\\/":
        return None
    p = os.path.join(d, "dosdevices", wp[0].lower() + ":")
    for part in [x for x in wp[3:].replace("/", "\\").split("\\") if x]:
        if not os.path.lexists(os.path.join(p, part)):
            try:
                part = [n for n in os.listdir(p) if n.lower() == part.lower()][0]
            except (OSError, IndexError):
                return None
        p = os.path.join(p, part)
    return p if os.path.exists(p) else None


def win_settle(name, limit=10.0):
    """waits (at most `limit` seconds) for Wine's winemenubuilder: it writes the menu entries of what was installed
    after the installer has gone"""
    ns = win_session_info(name).get("ns", "")
    t0 = time.time()
    while time.time() - t0 < limit:
        busy = False
        for pid in os.listdir("/proc"):
            if pid.isdigit() and "winemenubuilder" in read("/proc/%s/cmdline" % pid):
                try:
                    busy = busy or not ns or os.readlink("/proc/%s/ns/pid" % pid) == ns
                except OSError:
                    pass
        if not busy:
            return
        time.sleep(0.2)


def win_after(ctx, name):
    """what follows every program: the applications list is brought up to date"""
    if not ctx.dry:
        win_settle(name)
        win_sync_all(ctx)


def win_create(ctx, a):
    d = prefix_dir(a.prefix)
    if os.path.isdir(d):
        die("prefix %s exists" % a.prefix)
    if getattr(a, "isolated", False):
        if win_cannot_isolate() and not ctx.dry:
            die("an isolated prefix cannot run here: " + win_cannot_isolate(), 69)
        win_mark(ctx, a.prefix)
    win_prepare(ctx, a.prefix, a, create=True, arch=a.arch)
    return 0


def win_isolate(ctx, a):
    """marks a prefix as one whose programs always run isolated, or (--off) takes the mark away; no prefix: the list"""
    if not a.prefix:
        for n in sorted(win_marked()):
            print(n)
        if not win_marked():
            print("no prefix is marked isolated; `silik win isolate PREFIX` marks one, `silik win open --isolated FILE` uses the prefix \"%s\"" % WIN_ISOLATED)
        return 0
    d = prefix_dir(a.prefix)
    if not os.path.isdir(d) and not ctx.dry:
        die("no prefix %s (silik win list)" % a.prefix)
    if win_session_info(a.prefix) and not ctx.dry:
        die("the programs of prefix %s are running: close them (`silik win stop %s`) first" % (a.prefix, a.prefix), 75)
    win_mark(ctx, a.prefix, not a.off)
    if not ctx.dry:
        win_sync_all(ctx)           # (its programs' names in the applications list say so)
        print("prefix %s: %s" % (a.prefix, "its programs run on this session's display again: they can read its keyboard, screen and clipboard" if a.off
                                 else "its programs run isolated from now on (a display of their own; their shared folder, drive W:, is %s)" % win_shared(a.prefix)))
    return 0


def win_run(ctx, a):
    d = prefix_dir(a.prefix)
    if not a.cmd:
        die("silik win run [--isolated] [--no-net] [--no-sandbox] PREFIX -- PROGRAM.exe [ARGS]", 2)
    win_need_wine(ctx)
    if not os.path.isdir(d) and not ctx.dry:
        die("no prefix %s; `silik win create %s`" % (a.prefix, a.prefix))
    cmd, show = list(a.cmd), []
    if os.path.isabs(cmd[0]) and os.path.isfile(cmd[0]):      # a file of this system: what `open` does for it
        cmd[0] = win_real(ctx, cmd[0])
        if win_from_isolated(cmd[0]):                           # a file of an isolated prefix runs isolated
            a.isolated = True
        win_gate(ctx, a, cmd[0], a.prefix)
    win_apart_check(ctx, a, a.prefix)
    win_prepare(ctx, a.prefix, a)
    if os.path.isabs(cmd[0]) and os.path.isfile(cmd[0]):
        show = win_show(cmd[0], d, win_iso(a, a.prefix))
    # a console program typed in a terminal keeps the terminal (its output, its exit code)
    prog = cmd[0] if os.path.isabs(cmd[0]) else win_unix(d, cmd[0])
    console = win_tty() and (cmd[0].lower() in WIN_CONSOLE or bool(prog and win_cui(prog)))
    rc = win_exec(ctx, a.prefix, d, ["wine"] + cmd, a, show=show, window=not console)
    win_after(ctx, a.prefix)
    return rc


def win_tty():
    """True when the command was typed in a terminal (any of its three streams is one), or has no display to open
    a console window on; False for a double-click"""
    return any(f is not None and f.isatty() for f in (sys.stdin, sys.stdout, sys.stderr)) or not os.environ.get("DISPLAY")


def win_cui(f):
    """True when the .exe is a console program (the Subsystem field of its PE header is 3)"""
    try:
        with open(f, "rb") as fh:
            head = fh.read(4096)
        pe = int.from_bytes(head[0x3c:0x40], "little")
        return head[:2] == b"MZ" and head[pe:pe + 4] == b"PE\0\0" and int.from_bytes(head[pe + 92:pe + 94], "little") == 3
    except OSError:
        return False


