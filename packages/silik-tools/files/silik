    def both():
        st = probe()
        st["rollback"] = snap_doc_probe()
        return st
    return both


def doc_rollback(st, rows):
    """the row "rollback" of `silik doctor system`: is there a way back from an update that breaks the machine.
    ST["rollback"] is what snap_doc_probe() read (doc_probe_rollback puts it there; the tests give made-up ones);
    a system that was not asked gets no row"""
    r = st.get("rollback")
    if r is None:
        return
    kind, uuid = r["booted"]
    no = snap_unavailable(r["root"], r["snapm"])
    if kind == "snapshot":
        doc_row(rows, "system", "rollback", "rollback", "warn", "started from a snapshot: nothing is updated here",
                ["silik rollback   # makes this state the system", "systemctl reboot   # and the normal entry: the system as it is"])
    elif r["hold"] is not None:
        doc_row(rows, "system", "rollback", "rollback", "warn", "the automatic updates wait since the rollback%s" % (" of %s" % r["hold"].strip()[:16].replace("T", " ") if r["hold"].strip() else ""),
                ["silik update   # updates now, with a snapshot first; the automatic updates go on after it"])
    elif r["root"] is None:
