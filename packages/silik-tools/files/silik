def cpu_name(ctx):
    """the processor's name: /proc/cpuinfo's "model name" (x86_64); an ARM kernel has none there, lscpu names it from
    the processor's implementer and part numbers ("Vendor ID", "Model name"); else the architecture"""
    cpu = [l.split(":", 1)[1].strip() for l in read("/proc/cpuinfo").splitlines() if l.startswith("model name")]
    if cpu:
        return cpu[0]
    f = dict((k.strip(), v.strip()) for k, _, v in (l.partition(":") for l in ctx.query(["lscpu"]).splitlines()))
    name = " ".join(x for x in (f.get("Vendor ID", ""), f.get("Model name", "")) if x and x != "-")
    return name or host_arch()


def hw_probe(ctx, a):
    info = {"cpu": cpu_name(ctx), "cores": os.cpu_count(), "arch": host_arch(), "gpus": gpus(ctx),
            "nvidia_driver": read("/proc/driver/nvidia/version").splitlines()[0] if os.path.exists("/proc/driver/nvidia/version") else "",
            "kvm": os.path.exists("/dev/kvm")}
    if a.json:
        print(json.dumps(info, indent=1))
    else:
        for k in ("cpu", "cores", "arch", "kvm", "nvidia_driver"):
            print("%-14s %s" % (k, info[k] if info[k] != "" else "-"))
        for g in info["gpus"] or ["-"]:
            print("%-14s %s" % ("gpu", g))
    return 0


NVIDIA_REPO = "https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo"


def hw_nvidia(ctx, a):
