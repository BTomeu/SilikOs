                    ["cat /etc/resolv.conf; nmcli device show | grep -i dns   # the name servers in use", "getent hosts " + bad[0]])
        elif slow:
            doc_row(rows, "network", "dns", "mirrors", "unknown", "no answer within %g s for %s" % (DOC_DNS_WAIT, ", ".join(slow)), ["getent hosts " + slow[0]])
        else:
            doc_row(rows, "network", "dns", "mirrors", "ok", "%s resolve (%d ms)" % (", ".join(okh), st["dns_ms"]))
    if env and not dnf:
