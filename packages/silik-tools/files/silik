    pats = ("extra/nvidia.ko*", "extra/nvidia/nvidia.ko*", "updates/dkms/nvidia.ko*", "kernel/drivers/video/nvidia.ko*")
    return {"gpus": gpus_, "lspci": names, "nvidia_proc": read("/proc/driver/nvidia/version"),
