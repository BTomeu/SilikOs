# figures of a new installation, and of other systems, by the same count: docs/NUMEROS.md, tools/weigh.sh)
DOC_WEIGHT_TOP = 5


def later(fn):
    """starts FN in a thread now; the callable it returns waits for FN's result (an exception is the result, as in par)"""
    import threading
    box = []

    def run():
        try:
            box.append(fn())
        except Exception as e:
            box.append(e)
    t = threading.Thread(target=run, daemon=True)
    t.start()

    def result(timeout=None):
        t.join(timeout)
        return box[0] if box else None
    return result


def doc_probe_weight():
    """every installed package's size in bytes and its name: (exit code or None, text)"""
    if not shutil.which("rpm"):
        return None, ""
    return doc_cmd(["rpm", "-q", "-a", "--qf", "%{LONGSIZE}\t%{NAME}\n"], timeout=30)


def rpm_sizes(text):
    """[(bytes, name)] of `rpm -q -a --qf '%{LONGSIZE}\t%{NAME}\n'`, the largest first (several kernels: several rows)"""
    out = []
    for l in text.splitlines():
        b, tab, name = l.partition("\t")
        if tab and b.isdigit() and name and name != "gpg-pubkey":      # (imported keys are rows of the database, not packages)
            out.append((int(b), name))
    return sorted(out, key=lambda r: (-r[0], r[1]))


