    ub, jh = keys["kernel.unprivileged_bpf_disabled"], keys["net.core.bpf_jit_harden"]
    jit = "; JIT hardening: %s" % ("root's to read" if jh is None else {0: "off", 1: "for users' programs", 2: "for every program"}.get(jh, str(jh)))
    if ub is None:
        row("bpf", "BPF for users", "unknown", "kernel.unprivileged_bpf_disabled is not readable" + here)
    elif ub == 0:
        row("bpf", "BPF for users", "warn", "on: any user loads programs into the kernel" + jit, ["sudo sysctl -w kernel.unprivileged_bpf_disabled=1"])
    else:
        row("bpf", "BPF for users", "ok", ("off until root turns it on" if ub == 2 else "off until the next start") + jit)

    kx = keys["kernel.kexec_load_disabled"]
    if kx is None:
        row("kexec", "kexec", "unknown", "kernel.kexec_load_disabled is not readable" + here)
    elif kx == 1:
        row("kexec", "kexec", "ok", "off until the next start: root cannot start another kernel from this one")
    elif ld in ("integrity", "confidentiality"):
