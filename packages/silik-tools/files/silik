def dev_version_key(path):
    """for sorting by the numbers in a path: ccs1280 after ccs910, stm32cubeide_1.19.0 after stm32cubeide_1.9.0"""
    return [(1, int(t), "") if t.isdigit() else (0, 0, t) for t in re.split(r"(\d+)", path)]


def dev_find_ides(exe, roots, depth=5):
    """every program called EXE under ROOTS (a few folders deep: the vendors' folders carry a version), oldest first"""
    found = []
    for root in roots:
        root = os.path.expanduser(root)
        if not os.path.isdir(root):
            continue
        base = root.rstrip("/").count("/")
        for d, dirs, files in os.walk(root):
            if d.count("/") - base >= depth:
                dirs[:] = []
            if exe in files and os.access(os.path.join(d, exe), os.X_OK):
                found.append(os.path.join(d, exe))
    return sorted(found, key=dev_version_key)


def dev_find_ide(exe, roots, depth=5):
    """the newest program called EXE under one of ROOTS, or ''"""
    found = dev_find_ides(exe, roots, depth)
    return found[-1] if found else ""


# CAN: the EL 9 kernel carries the CAN core and the USB adapters' drivers (gs_usb: candleLight, CANable; peak_usb:
# PCAN-USB; slcan; mcp251x/mcp251xfd over SPI), so an adapter is a network interface (can0). `silik dev can` lists
# them; `up IFACE BITRATE` sets the bit rate and brings it up (ip, as root); can-utils (silik-dev) reads and writes it.
CAN_RATES = (10000, 20000, 50000, 100000, 125000, 250000, 500000, 800000, 1000000)


def can_rate(v):
    """a bit rate: 500000, 500k, 1M"""
    t = v.strip().lower()
    mult = 1000 if t.endswith("k") else 1000000 if t.endswith("m") else 1
    try:
        n = int(float(t.rstrip("km")) * mult)
    except ValueError:
        raise argparse.ArgumentTypeError("not a bit rate: %s (e.g. 500k, 1M)" % v)
    if n not in CAN_RATES:
        raise argparse.ArgumentTypeError("%s: CAN bit rates are %s" % (v, ", ".join("%dk" % (r // 1000) if r < 1000000 else "1M" for r in CAN_RATES)))
    return n


def sys_read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def dev_what(devdir):
    """(driver, product) of a device of /sys (a network interface's or a tty's "device"): the USB product's name when
    it is a USB device"""
    drv = os.path.basename(os.path.realpath(os.path.join(devdir, "driver"))) if os.path.exists(os.path.join(devdir, "driver")) else ""
    prod = ""
    d = os.path.realpath(devdir)
    for _ in range(4):                              # the USB device is a parent of its interface
        prod = sys_read(os.path.join(d, "product"))
        if prod:
            maker = sys_read(os.path.join(d, "manufacturer"))
            prod = (maker + " " + prod).strip() if maker and maker.split()[0].lower() not in prod.lower() else prod
            break
        d = os.path.dirname(d)
    return drv, prod


CAN_FD_RATES = (1000000, 2000000, 4000000, 5000000, 8000000)


def can_fd_rate(v):
    t = v.strip().lower()
    mult = 1000 if t.endswith("k") else 1000000 if t.endswith("m") else 1
    try:
        n = int(float(t.rstrip("km")) * mult)
    except ValueError:
        raise argparse.ArgumentTypeError("not a bit rate: %s (e.g. 2M)" % v)
    if n not in CAN_FD_RATES:
        raise argparse.ArgumentTypeError("%s: CAN FD data bit rates here are 1M, 2M, 4M, 5M, 8M" % v)
    return n


def serial_ports():
    """[(device, stable name or '', driver, product)] of the serial ports that have a device behind them: USB adapters
    (ttyUSB: FTDI, CP210x, CH340, PL2303; RS-232 or RS-485), boards' virtual COM ports (ttyACM: ST-LINK, Nucleo, CDC
    ACM), and the machine's own UARTs that answer (ttyS with a driver other than the placeholder)"""
    byid = {}
    for d in ("/dev/serial/by-id",):
        for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            byid[os.path.realpath(os.path.join(d, f))] = os.path.join(d, f)
    out = []
    for name in sorted(os.listdir("/sys/class/tty")) if os.path.isdir("/sys/class/tty") else []:
        if not re.match(r"^tty(USB|ACM|S|AMA|THS)\d+$", name):
            continue
        devdir = os.path.join("/sys/class/tty", name, "device")
        if not os.path.exists(devdir):
            continue
        drv, prod = dev_what(devdir)
        if name.startswith("ttyS") and sys_read(os.path.join("/sys/class/tty", name, "type")) in ("", "0"):
            continue                                # (the 8250 driver's placeholders: no UART behind them, type 0)
        dev = "/dev/" + name
        out.append((dev, byid.get(dev, ""), drv, prod))
    return out


def dev_serial(ctx, a):
    ports = serial_ports()
    if a.json:
        print(json.dumps([{"device": d, "by_id": b or None, "driver": dr or None, "product": p or None} for d, b, dr, p in ports]))
        return 0 if ports else 1
    if not ports:
        print("no serial ports: plug in an adapter or a board (they appear as /dev/ttyUSB* or /dev/ttyACM*)")
        return 1
    for dev, byid, drv, prod in ports:
        print("%-14s %-30s %s" % (dev, prod or "-", "(%s)%s" % (drv, "  " + byid if byid else "") if drv else byid))
    print("open one: tio %s  (or picocom -b 115200, minicom -D); Modbus RTU over RS-485: libmodbus, pyserial" % ports[0][0])
    return 0


def can_links(ctx):
    """[(name, state, bitrate or None)] of the CAN interfaces of this system"""
    out = ctx.query(["ip", "-details", "-json", "link", "show", "type", "can"])
    try:
        links = json.loads(out) if out.strip() else []
    except ValueError:
        return []
    res = []
    for l in links:
        info = ((l.get("linkinfo") or {}).get("info_data") or {})
        res.append((l.get("ifname"), l.get("operstate", "?"), (info.get("bittiming") or {}).get("bitrate"),
                    (info.get("data_bittiming") or {}).get("bitrate")))
    return res


def dev_can(ctx, a):
    if a.action in (None, "list"):
        links = can_links(ctx)
        if not links:
            print("no CAN interfaces: plug in an adapter (candleLight / CANable, PCAN-USB, slcan); `ip link` shows it as can0")
            return 1
        for name, state, rate, drate in links:
            drv, prod = dev_what(os.path.join("/sys/class/net", name, "device"))
            print("%-8s %-6s %-22s %s" % (name, state.lower(),
                                          ("%d bit/s" % rate if rate else "bit rate not set") + (", data %d" % drate if drate else ""),
                                          " ".join(x for x in (prod, "(%s)" % drv if drv else "") if x)))
        return 0
    if not a.iface or not valid_name(a.iface):
        die("silik dev can %s IFACE%s" % (a.action, " BITRATE" if a.action == "up" else ""), 2)
    ctx.run(["sudo", "ip", "link", "set", a.iface, "down"], check=a.action == "down")
    if a.action == "up":
        if not a.bitrate:
            die("silik dev can up IFACE BITRATE (e.g. 500k, 1M)", 2)
        argv = ["sudo", "ip", "link", "set", a.iface, "type", "can", "bitrate", str(a.bitrate)]
        if a.fd:                                    # CAN FD: the data phase's bit rate (PCAN-USB FD, Kvaser, gs_usb FD...)
            argv += ["dbitrate", str(a.fd), "fd", "on"]
        if a.listen:                                # listen only: the adapter never sends, not even an acknowledgement
            argv += ["listen-only", "on"]
        argv += ["restart-ms", "100"]               # (back from bus-off by itself)
        ctx.run(argv)
        ctx.run(["sudo", "ip", "link", "set", a.iface, "up"])
        print("%s up at %d bit/s%s%s: `candump %s` shows its frames, `cansend %s 123#DEADBEEF` sends one%s"
              % (a.iface, a.bitrate, ", data %d bit/s (FD)" % a.fd if a.fd else "", ", listening only" if a.listen else "",
                 a.iface, a.iface, " (an FD frame: 123##1DEADBEEF)" if a.fd else ""))
    return 0


def dev_tools(ctx, a):
    rows, paths = [], [shutil.which(exe) for exe, _, _ in DEV_TOOLS]
    vers = rpm_versions(pkg for (_, pkg, _), path in zip(DEV_TOOLS, paths) if path)
    for (exe, pkg, what), path in zip(DEV_TOOLS, paths):
        ver = vers.get(pkg, "") if path else ""
        rows.append({"tool": exe, "package": pkg, "for": what, "path": path, "version": ver if ver and " " not in ver else ""})
    ides = [{"ide": key, "name": name, "path": dev_find_ide(exe, roots) or None} for key, name, exe, roots, _, _ in DEV_IDES]
    if a.json:
        print(json.dumps({"tools": rows, "ides": ides}, indent=1))
        return 0
    lines = ["%s %-18s %-12s %s" % (SEC_MARK["ok" if r["path"] else "unknown"], r["tool"],
                                    (r["version"] or "found") if r["path"] else "missing", r["for"]) for r in rows]
    for i in ides:
        lines.append("%s %-18s %s" % (SEC_MARK["ok" if i["path"] else "unknown"], i["ide"],
                                     i["path"] or "not installed: %s is its vendor's program; `silik dev install FILE` runs the installer you downloaded" % i["name"]))
    missing = sorted(set(r["package"] for r in rows if not r["path"]))
    if missing:
        lines.append("missing: sudo dnf install " + " ".join(missing))
    text = "\n".join(lines)
    try:
        print(text)
    except UnicodeEncodeError:
        print(text.encode("ascii", "replace").decode("ascii"))
    return 0


def dev_try_jobs():
    """the jobs of `silik dev try`: name, the tools it needs, its commands, and what its result must show.
    A command is (argv, the file its output goes to); a check is (file, a regular expression, what it means).
    Each job stands alone (one that needs the program builds it again)."""
    cc = ["arm-none-eabi-gcc"] + DEV_CPU + ["-Os", "-g", "-Wall", "-ffreestanding", "-ffunction-sections", "-fdata-sections"]
    link = ["-nostartfiles", "-T", "cortex-m.ld", "-Wl,--gc-sections"]
    blink = (cc + link + ["-nostdlib", "-Wl,-Map=blink.map", "-o", "blink.elf", "startup.c", "main.c"], "cc.out")
    return (
        ("build", ("arm-none-eabi-gcc",), [blink, (["arm-none-eabi-objcopy", "-O", "binary", "blink.elf", "blink.bin"], "objcopy.out"),
                                           (["arm-none-eabi-readelf", "-h", "-S", "blink.elf"], "readelf.out"),
                                           (["arm-none-eabi-readelf", "-l", "blink.elf"], "segments.out"),
                                           (["arm-none-eabi-nm", "-n", "blink.elf"], "nm.out"),
                                           (["arm-none-eabi-size", "blink.elf"], "size.out")],
         [("readelf.out", r"Machine:\s+ARM", "a Cortex-M4 program compiled"),
          ("readelf.out", r"\.isr_vector\s+PROGBITS\s+08000000", "its vector table is at the start of flash (0x08000000)"),
          ("nm.out", r"(?m)^080000[0-9a-f]{2} T Reset_Handler$", "its reset handler is in flash"),
          ("nm.out", r"(?m)^2000[0-9a-f]{4} [BbDd] ticks$", "its data is in RAM (0x20000000)"),
          ("nm.out", r"(?m)^2000[0-9a-f]{4} D level$", "an initialised variable among them"),
          ("segments.out", r"(?m)^\s*LOAD\s+0x[0-9a-f]+ 0x2000[0-9a-f]{4} 0x080[0-9a-f]{5} 0x0*[1-9a-f][0-9a-f]* ",
           "whose initial values are loaded from flash (a segment at a RAM address with a flash load address)")]),
        ("libc", ("arm-none-eabi-gcc",), [(cc + link + ["--specs=nano.specs", "--specs=nosys.specs", "-o", "hello.elf", "startup.c", "hello.c"], "libc.out"),
                                          (["arm-none-eabi-nm", "hello.elf"], "libc-nm.out")],
         [("libc-nm.out", r"(?m) T snprintf$", "the C library for this processor (newlib-nano, hard float) links")]),
        ("cxx", ("arm-none-eabi-gcc", "arm-none-eabi-g++"),
         [(cc + ["-c", "-o", "startup.o", "startup.c"], "cxx-start.out"),        # (the start is C)
          (["arm-none-eabi-g++"] + DEV_CPU + ["-Os", "-std=c++17", "-fno-exceptions", "-fno-rtti", "-ffreestanding"] + link +
           ["-nostdlib", "-o", "sum.elf", "startup.o", "sum.cpp"], "cxx.out"),
                                         (["arm-none-eabi-nm", "sum.elf"], "cxx-nm.out")],
         [("cxx-nm.out", r"(?m) [BbDd] result$", "C++ for the same processor compiles and links")]),
        ("debug", ("arm-none-eabi-gcc", "gdb"), [blink, (["gdb", "-batch", "-ex", "set architecture armv7e-m", "-ex", "file blink.elf", "-ex", "info address main",
                                                         "-ex", "info line main", "-ex", "disassemble main"], "gdb.out")],
         [("gdb.out", r'Symbol "main" is a function at address 0x80000[0-9a-f]{2}', "the debugger reads the program: main is in flash"),
          ("gdb.out", r"main\.c", "it knows the source line"),
          ("gdb.out", r"(?m)^\s+0x080000[0-9a-f]{2} <\+\d+>:\s+\S+", "it disassembles the ARM code")]),
        ("probe", ("openocd",), [(["openocd", "-f", "interface/stlink.cfg", "-f", "target/stm32g4x.cfg", "-c", DEV_OCD_ASK], "openocd-st.out"),
                                 (["openocd", "-f", "interface/xds110.cfg", "-f", "target/ti_msp432.cfg", "-c", DEV_OCD_ASK], "openocd-ti.out")],
         [("openocd-st.out", r"(?m)^probe hla, part stm32g4x\.cpu$", "OpenOCD reads its descriptions of the ST-LINK probe and the STM32G4 (no probe is plugged in for that)"),
          ("openocd-ti.out", r"(?m)^probe xds110, part msp432\.cpu$", "and of TI's XDS110 probe and the MSP432")]),
        ("dfu", ("dfu-util",), [(["dfu-util", "--version"], "dfu.out")],
         [("dfu.out", r"dfu-util \d+\.\d+", "dfu-util starts")]),
        ("stlink", ("st-info",), [(["st-info", "--version"], "stlink.out")],
         [("stlink.out", r"\d+\.\d+", "the ST-LINK tools start")]),
    )


def dev_try(ctx, a):
    jobs = [j for j in dev_try_jobs() if a.job in ("all", j[0])]
    if not jobs:
        die("no such job: %s (%s, all)" % (a.job, ", ".join(j[0] for j in dev_try_jobs())), 2)
    if not os.path.isdir(DEV_TRY) and not ctx.dry:
        die("the files of the jobs are not here (%s): they come with the package silik-dev" % DEV_TRY)
    work = eda_work(ctx, "dev-try")
    ctx.run(["cp", "-r", DEV_TRY + "/.", work])
    ctx.echo(["cd", work])
    if not ctx.dry:
        os.chdir(work)
    rows = []
    for name, needs, cmds, checks in jobs:
        missing = [t for t in needs if not shutil.which(t)]
        if missing and not ctx.dry:
            rows.append(("unknown", name, "not run: %s %s not on the system" % (", ".join(missing), "is" if len(missing) == 1 else "are")))
            continue
        failed = None
        for argv, out in cmds:
            if failed is not None:              # (what follows a command that failed has nothing to work on)
                break
            if not ctx.quiet:
                print("$ " + " ".join(shlex.quote(x) for x in argv) + " > " + out, flush=True)
            if ctx.dry:
                continue
            ctx.note(argv)
            try:
                with open(out, "w") as f:
                    rc = subprocess.run(argv, stdout=f, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL).returncode
            except OSError as e:                # (a program that is not there after all, or that may not be run)
                failed = "%s could not be started: %s" % (argv[0], e.strerror or e)
                continue
            if rc != 0:
                failed = "%s exited %d: %s" % (argv[0], rc, " / ".join(read(out).strip().splitlines()[-2:]))
        if ctx.dry:
            continue
        for path, rx, means in checks:
            if failed is None and not re.search(rx, read(path)):
                failed = "not seen: " + means + " (" + os.path.join(work, path) + ")"
        said = "; ".join(c[2] for c in checks)
        if not failed and name == "build":      # what the linker made of it (the tool's own numbers)
            m = re.search(r"(?m)^\s*(\d+)\s+(\d+)\s+(\d+)\s+\d+\s+[0-9a-f]+\s+blink\.elf", read("size.out"))
            if m:
                said += ": %s bytes of code, %s of data, %s of cleared memory" % m.groups()
        rows.append(("bad", name, failed) if failed else ("ok", name, said))
    if ctx.dry:
        return 0
    for verdict, name, said in rows:
        line = "%s %-7s %s" % (SEC_MARK[verdict], name, said)
        try:
            print(line)
        except UnicodeEncodeError:
            print(line.encode("ascii", "replace").decode("ascii"))
    n = {v: len([r for r in rows if r[0] == v]) for v in ("ok", "bad", "unknown")}
    print("%d ok, %d failed, %d not run; the files are in %s" % (n["ok"], n["bad"], n["unknown"], work))
    return 1 if n["bad"] else 0


# ccache (EPEL 9: 4.5.1). Installing it is what turns it on: its /etc/profile.d/ccache.sh puts /usr/lib64/ccache, a
# folder of links named after the compilers (gcc, cc, arm-none-eabi-gcc, avr-gcc...), first in the PATH of every login
# shell, so a Makefile that calls the compiler by its name compiles through the cache. Measured on an STM32G4 build
# (docs/POWER.md): a rebuild of unchanged sources a third of the time, a first build a quarter slower.
CCACHE_LINKS = "/usr/lib64/ccache"


def dev_ccache(ctx, a):
    if a.action == "on":
        ctx.run(as_root(["dnf", "-y", "install", "ccache"]))
        print("silik: every new login shell compiles through ccache (%s first in PATH); in this one: export PATH=%s:$PATH."
              " CMake: -DCMAKE_C_COMPILER_LAUNCHER=ccache. One build without it: CCACHE_DISABLE=1 make" % (CCACHE_LINKS, CCACHE_LINKS))
        return 0
    if a.action == "off":
        ctx.run(as_root(["dnf", "-y", "remove", "ccache"]))
        print("silik: the cache stays in ~/.cache/ccache (rm -rf ~/.cache/ccache frees its space); a shell started before "
              "keeps %s in its PATH until it ends" % CCACHE_LINKS)
        return 0
    if not shutil.which("ccache") and not ctx.dry:
        print("%-14s %s" % ("ccache", "off: silik dev ccache on"))
        return 1
    links = sorted(n for n in os.listdir(CCACHE_LINKS) if os.path.islink(os.path.join(CCACHE_LINKS, n))
                   and shutil.which(n, path="/usr/bin")) if os.path.isdir(CCACHE_LINKS) else []
    here = CCACHE_LINKS in os.environ.get("PATH", "").split(":") and not os.environ.get("CCACHE_DISABLE")
    print("%-14s %s" % ("ccache", "on in this shell" if here else "installed; not in this shell's PATH (a new login shell has it)"))
    print("%-14s %s" % ("compilers", " ".join(links) or "-"))
    ctx.run(["ccache", "--show-stats"], check=False)
    return 0


def dev_which_ide(path):
    n = os.path.basename(path).lower()
    for key, name, exe, roots, file_rx, setup_rx in DEV_IDES:
        if re.search(file_rx, n):
            return key, name, exe, roots, setup_rx
    return None


def dev_pick_installer(work, setup_rx):
    """the one installer inside an unpacked archive: a script whose name is the vendor's installer's. None or several
    is an error that lists what is there (the user can then give the script itself): never a guess, since ST's runs
    as root"""
    scripts = sorted(os.path.join(d, f) for d, _, fs in os.walk(work) for f in fs if f.lower().endswith((".sh", ".run")))
    match = [p for p in scripts if re.search(setup_rx, os.path.basename(p).lower())]
    if len(match) == 1:
        return match[0]
    shown = ", ".join(os.path.relpath(p, work) for p in scripts) or "none"
    if not match:
        die("no installer of the expected name inside the archive (scripts there: %s)" % shown)
    die("several installers inside the archive (%s): give the one to run, for example  silik dev install %s" % (
        ", ".join(os.path.relpath(p, work) for p in match), shlex.quote(match[0])))


def dev_install(ctx, a):
    """runs a vendor's own installer from the file the user downloaded (an archive is unpacked first, and removed
    after). The installer shows its licence and asks what it asks: nothing here answers for the user, and nothing is
    downloaded. Its exit code is this command's."""
    src = os.path.abspath(os.path.expanduser(a.file))
    ide = dev_which_ide(src)
    if not ide:
        die("not an installer this command knows: %s (it knows the Linux installers of %s, by their file names)" % (
            os.path.basename(src), " and ".join(i[1] for i in DEV_IDES)), 2)
    key, name, exe, roots, setup_rx = ide
    low = os.path.basename(src).lower()
    if key == "stm32cubeide" and "deb_bundle" in low:
        die("this is ST's bundle for Debian systems: SilikOS is an RPM system; ST's RPM bundle (…amd64.rpm_bundle.sh) is the one", 2)
    if not os.path.isfile(src) and not ctx.dry:
        die("no such file: " + src)
    print("%s is its vendor's program, under its vendor's licence: the installer shows it and asks; SilikOS only runs it" % name)
    run, work = src, None
    if low.endswith(DEV_ARCHIVES):
        work = eda_work(ctx, "dev-install")
        if low.endswith(".zip"):
            ctx.run(["unzip", "-q", "-o", src, "-d", work])
        else:
            ctx.run(["tar", "-xzf", src, "-C", work])
        run = os.path.join(work, "<the installer inside>") if ctx.dry else dev_pick_installer(work, setup_rx)
    elif not ctx.dry and not low.endswith((".sh", ".run")):
        die("not a Linux installer (.sh, .run, or an archive of one): " + os.path.basename(src))
    before = set(dev_find_ides(exe, roots)) if not ctx.dry else set()
    if key == "stm32cubeide":
        # ST's bundle for RPM systems installs packages (the IDE, the ST-LINK server, the probes' device rules): as root
        if "rpm_bundle" not in os.path.basename(run).lower() and not ctx.dry:
            print("silik: this is not ST's bundle for RPM systems (…amd64.rpm_bundle.sh): that is the one made for this base", file=sys.stderr)
        rc, _ = ctx.run(["sudo", "sh", run], check=False)
    else:
        # TI's installer is a program with its own window; it installs for the user who runs it
        ctx.run(["chmod", "+x", run])
        rc, _ = ctx.run([run], check=False)
    if work:
        ctx.run(["rm", "-rf", work])            # (the unpacked archive: a gigabyte or more)
    if ctx.dry:
        return 0
    found = dev_find_ides(exe, roots)
    if rc:
        print("silik: the installer exited %d: nothing is said to be installed%s" % (
            rc, " (%s was there before it)" % found[-1] if found else ""), file=sys.stderr)
        return rc
    if not found:
        print("silik: no %s under %s after the installer: `silik dev tools` looks again" % (exe, " or ".join(roots)), file=sys.stderr)
        return 1
    new = [p for p in found if p not in before]
    print("%s %s: %s%s" % (SEC_MARK["ok"], key, (new or found)[-1], "" if new else "  (it was there before: the installer added no other)"))
    if key == "ccs":      # TI's own script for the probes' device rules, when the installation has it
        top = (new or found)[-1]
        for _ in range(4):
            top = os.path.dirname(top)
            script = os.path.join(top, "install_scripts", "install_drivers.sh")
            if os.path.isfile(script):
                print("the probes' device rules are TI's own script, as root:  sudo %s" % script)
                break
    return 0


