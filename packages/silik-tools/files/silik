def dev_try_jobs():
    """the jobs of `silik dev try`: name, the tools it needs, its commands, and what its result must show.
    A command is (argv, the file its output goes to); a check is (file, a regular expression, what it means).
    Each job stands alone (one that needs the program builds it again)."""
    cc = ["arm-none-eabi-gcc"] + DEV_CPU + ["-Os", "-g", "-Wall", "-ffreestanding", "-ffunction-sections", "-fdata-sections"]
    link = ["-nostartfiles", "-T", "cortex-m.ld", "-Wl,--gc-sections"]
    blink = (cc + link + ["-nostdlib", "-Wl,-Map=blink.map", "-o", "blink.elf", "startup.c", "main.c"], "cc.out")
    return (
        ("build", ("arm-none-eabi-gcc",), [blink, (["arm-none-eabi-objcopy", "-O", "binary", "blink.elf", "blink.bin"], "objcopy.out"),
                                           (["arm-none-eabi-readelf", "-h", "-S", "blink.elf"], "readelf.out"),
                                           (["arm-none-eabi-readelf", "-l", "blink.elf"], "segments.out"),
                                           (["arm-none-eabi-nm", "-n", "blink.elf"], "nm.out"),
                                           (["arm-none-eabi-size", "blink.elf"], "size.out")],
         [("readelf.out", r"Machine:\s+ARM", "a Cortex-M4 program compiled"),
          ("readelf.out", r"\.isr_vector\s+PROGBITS\s+08000000", "its vector table is at the start of flash (0x08000000)"),
          ("nm.out", r"(?m)^080000[0-9a-f]{2} T Reset_Handler$", "its reset handler is in flash"),
          ("nm.out", r"(?m)^2000[0-9a-f]{4} [BbDd] ticks$", "its data is in RAM (0x20000000)"),
          ("nm.out", r"(?m)^2000[0-9a-f]{4} D level$", "an initialised variable among them"),
          ("segments.out", r"(?m)^\s*LOAD\s+0x[0-9a-f]+ 0x2000[0-9a-f]{4} 0x080[0-9a-f]{5} 0x0*[1-9a-f][0-9a-f]* ",
           "whose initial values are loaded from flash (a segment at a RAM address with a flash load address)")]),
        ("libc", ("arm-none-eabi-gcc",), [(cc + link + ["--specs=nano.specs", "--specs=nosys.specs", "-o", "hello.elf", "startup.c", "hello.c"], "libc.out"),
                                          (["arm-none-eabi-nm", "hello.elf"], "libc-nm.out")],
         [("libc-nm.out", r"(?m) T snprintf$", "the C library for this processor (newlib-nano, hard float) links")]),
        ("cxx", ("arm-none-eabi-gcc", "arm-none-eabi-g++"),
         [(cc + ["-c", "-o", "startup.o", "startup.c"], "cxx-start.out"),        # (the start is C)
          (["arm-none-eabi-g++"] + DEV_CPU + ["-Os", "-std=c++17", "-fno-exceptions", "-fno-rtti", "-ffreestanding"] + link +
           ["-nostdlib", "-o", "sum.elf", "startup.o", "sum.cpp"], "cxx.out"),
                                         (["arm-none-eabi-nm", "sum.elf"], "cxx-nm.out")],
         [("cxx-nm.out", r"(?m) [BbDd] result$", "C++ for the same processor compiles and links")]),
        ("debug", ("arm-none-eabi-gcc", "gdb"), [blink, (["gdb", "-batch", "-ex", "set architecture armv7e-m", "-ex", "file blink.elf", "-ex", "info address main",
                                                         "-ex", "info line main", "-ex", "disassemble main"], "gdb.out")],
         [("gdb.out", r'Symbol "main" is a function at address 0x80000[0-9a-f]{2}', "the debugger reads the program: main is in flash"),
          ("gdb.out", r"main\.c", "it knows the source line"),
          ("gdb.out", r"(?m)^\s+0x080000[0-9a-f]{2} <\+\d+>:\s+\S+", "it disassembles the ARM code")]),
        ("probe", ("openocd",), [(["openocd", "-f", "interface/stlink.cfg", "-f", "target/stm32g4x.cfg", "-c", DEV_OCD_ASK], "openocd-st.out"),
                                 (["openocd", "-f", "interface/xds110.cfg", "-f", "target/ti_msp432.cfg", "-c", DEV_OCD_ASK], "openocd-ti.out")],
         [("openocd-st.out", r"(?m)^probe hla, part stm32g4x\.cpu$", "OpenOCD reads its descriptions of the ST-LINK probe and the STM32G4 (no probe is plugged in for that)"),
          ("openocd-ti.out", r"(?m)^probe xds110, part msp432\.cpu$", "and of TI's XDS110 probe and the MSP432")]),
        ("dfu", ("dfu-util",), [(["dfu-util", "--version"], "dfu.out")],
         [("dfu.out", r"dfu-util \d+\.\d+", "dfu-util starts")]),
        ("stlink", ("st-info",), [(["st-info", "--version"], "stlink.out")],
         [("stlink.out", r"\d+\.\d+", "the ST-LINK tools start")]),
    )


def dev_try(ctx, a):
    jobs = [j for j in dev_try_jobs() if a.job in ("all", j[0])]
    if not jobs:
        die("no such job: %s (%s, all)" % (a.job, ", ".join(j[0] for j in dev_try_jobs())), 2)
    if not os.path.isdir(DEV_TRY) and not ctx.dry:
        die("the files of the jobs are not here (%s): they come with the package silik-dev" % DEV_TRY)
    work = eda_work(ctx, "dev-try")
    ctx.run(["cp", "-r", DEV_TRY + "/.", work])
    ctx.echo(["cd", work])
    if not ctx.dry:
        os.chdir(work)
    rows = []
    for name, needs, cmds, checks in jobs:
        missing = [t for t in needs if not shutil.which(t)]
        if missing and not ctx.dry:
            rows.append(("unknown", name, "not run: %s %s not on the system" % (", ".join(missing), "is" if len(missing) == 1 else "are")))
            continue
        failed = None
        for argv, out in cmds:
            if failed is not None:              # (what follows a command that failed has nothing to work on)
                break
            if not ctx.quiet:
                print("$ " + " ".join(shlex.quote(x) for x in argv) + " > " + out, flush=True)
            if ctx.dry:
                continue
            ctx.note(argv)
            try:
                with open(out, "w") as f:
                    rc = subprocess.run(argv, stdout=f, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL).returncode
            except OSError as e:                # (a program that is not there after all, or that may not be run)
                failed = "%s could not be started: %s" % (argv[0], e.strerror or e)
                continue
            if rc != 0:
                failed = "%s exited %d: %s" % (argv[0], rc, " / ".join(read(out).strip().splitlines()[-2:]))
        if ctx.dry:
            continue
        for path, rx, means in checks:
            if failed is None and not re.search(rx, read(path)):
                failed = "not seen: " + means + " (" + os.path.join(work, path) + ")"
        said = "; ".join(c[2] for c in checks)
        if not failed and name == "build":      # what the linker made of it (the tool's own numbers)
            m = re.search(r"(?m)^\s*(\d+)\s+(\d+)\s+(\d+)\s+\d+\s+[0-9a-f]+\s+blink\.elf", read("size.out"))
            if m:
                said += ": %s bytes of code, %s of data, %s of cleared memory" % m.groups()
        rows.append(("bad", name, failed) if failed else ("ok", name, said))
    if ctx.dry:
        return 0
    for verdict, name, said in rows:
        line = "%s %-7s %s" % (SEC_MARK[verdict], name, said)
        try:
            print(line)
        except UnicodeEncodeError:
            print(line.encode("ascii", "replace").decode("ascii"))
    n = {v: len([r for r in rows if r[0] == v]) for v in ("ok", "bad", "unknown")}
    print("%d ok, %d failed, %d not run; the files are in %s" % (n["ok"], n["bad"], n["unknown"], work))
    return 1 if n["bad"] else 0


# ccache (EPEL 9: 4.5.1). Installing it is what turns it on: its /etc/profile.d/ccache.sh puts /usr/lib64/ccache, a
# folder of links named after the compilers (gcc, cc, arm-none-eabi-gcc, avr-gcc...), first in the PATH of every login
# shell, so a Makefile that calls the compiler by its name compiles through the cache. Measured on an STM32G4 build
# (docs/POWER.md): a rebuild of unchanged sources a third of the time, a first build a quarter slower.
CCACHE_LINKS = "/usr/lib64/ccache"


def dev_ccache(ctx, a):
    if a.action == "on":
        ctx.run(as_root(["dnf", "-y", "install", "ccache"]))
        print("silik: every new login shell compiles through ccache (%s first in PATH); in this one: export PATH=%s:$PATH."
              " CMake: -DCMAKE_C_COMPILER_LAUNCHER=ccache. One build without it: CCACHE_DISABLE=1 make" % (CCACHE_LINKS, CCACHE_LINKS))
        return 0
    if a.action == "off":
        ctx.run(as_root(["dnf", "-y", "remove", "ccache"]))
        print("silik: the cache stays in ~/.cache/ccache (rm -rf ~/.cache/ccache frees its space); a shell started before "
              "keeps %s in its PATH until it ends" % CCACHE_LINKS)
        return 0
    if not shutil.which("ccache") and not ctx.dry:
        print("%-14s %s" % ("ccache", "off: silik dev ccache on"))
        return 1
    links = sorted(n for n in os.listdir(CCACHE_LINKS) if os.path.islink(os.path.join(CCACHE_LINKS, n))
                   and shutil.which(n, path="/usr/bin")) if os.path.isdir(CCACHE_LINKS) else []
    here = CCACHE_LINKS in os.environ.get("PATH", "").split(":") and not os.environ.get("CCACHE_DISABLE")
    print("%-14s %s" % ("ccache", "on in this shell" if here else "installed; not in this shell's PATH (a new login shell has it)"))
    print("%-14s %s" % ("compilers", " ".join(links) or "-"))
    ctx.run(["ccache", "--show-stats"], check=False)
    return 0


