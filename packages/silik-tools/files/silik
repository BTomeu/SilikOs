# ------------------------------------------------------------------ hw check: which devices have a driver
# `silik hw check`: every PCI and USB device of this machine with the driver bound to it, or the driver of this
# kernel that claims its ID, or "no driver in this kernel" and what to do. `--from FILE` asks the same of a list
# saved on another system (`lspci -nn`, `lspci -nnk`, `lsusb`, `lsusb -v`, or Windows' hardware IDs): will this
# computer's hardware have drivers on SilikOS, before installing it.
# The facts are the kernel's own: /lib/modules/KERNEL/modules.alias on this machine, and kernel-aliases.tsv (the
# same table of EL 9.8's kernel for x86_64 and aarch64, read from its packages by tools/gen_hwdb.py) for a list
# from elsewhere. A match says a driver claims the ID; it never says the device works (docs/DRIVERS.md).
KERNEL_ALIASES = "/usr/share/silikos/kernel-aliases.tsv"
PCI_TABLE = "/usr/share/silikos/pci.tsv"
# (the patterns are compiled when `silik hw check` or the doctor's hardware area first asks: not at every start)
HW_RX = {
    "pci": (r"^pci:v(\*|[0-9A-F]{8})d(\*|[0-9A-F]{8})sv(\*|[0-9A-F]{8})sd(\*|[0-9A-F]{8})bc(\*|[0-9A-F]{2})sc(\*|[0-9A-F]{2})i(\*|[0-9A-F]{2})\*?$", 0),
    "usb": (r"^usb:v(\*|[0-9A-F]{4})p(\*|[0-9A-F]{4})d(.*?)dc(\*|[0-9A-F]{2})dsc(\*|[0-9A-F]{2})dp(\*|[0-9A-F]{2})ic(\*|[0-9A-F]{2})isc(\*|[0-9A-F]{2})ip(\*|[0-9A-F]{2})in(\*|[0-9A-F]{2})\*?$", 0),
    "lspci": (r"^((?:[0-9a-f]{4}:)?[0-9a-f]{2}:[0-9a-f]{2}\.[0-9a-f]) (.*?) ?\[([0-9a-f]{4})\]: (.*) \[([0-9a-f]{4}):([0-9a-f]{4})\](.*)$", 0),
    "lspci-n": (r"^((?:[0-9a-f]{4}:)?[0-9a-f]{2}:[0-9a-f]{2}\.[0-9a-f]) ([0-9a-f]{4}): ([0-9a-f]{4}):([0-9a-f]{4})(.*)$", 0),
    "lsusb": (r"^Bus (\d+) Device (\d+): ID ([0-9a-f]{4}):([0-9a-f]{4}) ?(.*)$", 0),
    "win-pci": (r"PCI\\VEN_([0-9A-F]{4})&DEV_([0-9A-F]{4})((?:&[A-Z]+_[0-9A-F]+)*)", re.I),
    "win-usb": (r"USB\\VID_([0-9A-F]{4})&PID_([0-9A-F]{4})", re.I),
}
HW_RX_DONE = {}


def hw_rx(name):
    r = HW_RX_DONE.get(name)
    if r is None:
        r = HW_RX_DONE[name] = re.compile(*HW_RX[name])
    return r


