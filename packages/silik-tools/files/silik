def devsim_module():
    """the folder of DEVSIM's Python module, or None. Looked for, not imported: importing it loads its libraries"""
    import importlib.util
    try:
        spec = importlib.util.find_spec("devsim")
    except (ImportError, ValueError):
        return None
    return os.path.dirname(spec.origin) if spec and spec.origin else None


def rpm_versions(pkgs):
    """{package: version} for those of PKGS that are installed, from one rpm call (not one per package: each call
    opens the package database again). Two installed copies of a package (two architectures) give their versions
    run together, as `rpm -q --qf %{VERSION} PACKAGE` does. Read-only, not echoed, like Ctx.query"""
    pkgs = sorted(set(pkgs))
    if not pkgs or not shutil.which("rpm"):
        return {}
    try:
        p = subprocess.run(["rpm", "-q", "--qf", "%{NAME}\t%{VERSION}\n"] + pkgs, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, universal_newlines=True)
    except (FileNotFoundError, PermissionError):
        return {}
    out = {}
    for l in p.stdout.splitlines():     # (a package that is not installed is a line "package X is not installed")
        n, tab, v = l.partition("\t")
        if tab and n in pkgs:
            out[n] = out.get(n, "") + v.strip()
    return out


def tool_where(exe):
    """where a tool is: a program of the PATH; DEVSIM has no program of its own, it is a module of the system's Python
    (the one silik runs on); "file:NAME" is a file of the jobs (a job whose file came with a newer silik-eda-open)"""
    if exe.startswith("file:"):
        p = os.path.join(EDA_TRY, exe[5:])
        return p if os.path.isfile(p) else None
    return devsim_module() if exe == "devsim" else shutil.which(exe)


def spiceinit():
    return os.path.join(os.path.expanduser("~"), ".spiceinit")


def cpu_cores():
    """physical cores (two threads of one core count once), else the processors the system shows"""
    seen = set()
    for l in read("/proc/cpuinfo").split("\n\n"):
        f = dict((k.strip(), v.strip()) for k, _, v in (x.partition(":") for x in l.splitlines()))
        if "core id" in f:
            seen.add((f.get("physical id", "0"), f["core id"]))
    return len(seen) or os.cpu_count() or 1


def ngspice_threads():
    """the number `silik eda tune` wrote in ~/.spiceinit, or None (ngspice's default)"""
    m = re.search(r"^set num_threads *= *(\d+)", read(spiceinit()), re.M)
    return int(m.group(1)) if m else None


def eda_tools(ctx, a):
    rows, paths = [], [tool_where(exe) for exe, _, _ in OPEN_TOOLS]
    vers = rpm_versions(pkg for (_, pkg, _), path in zip(OPEN_TOOLS, paths) if path)
    for (exe, pkg, what), path in zip(OPEN_TOOLS, paths):
        ver = vers.get(pkg, "") if path else ""
        rows.append({"tool": exe, "package": pkg, "for": what, "path": path, "version": ver if ver and " " not in ver else ""})
    n = ngspice_threads()
    if a.json:
        print(json.dumps({"tools": rows, "ngspice_threads": n, "cores": cpu_cores()}, indent=1))
        return 0
    lines = ["%s %-10s %-12s %s" % (SEC_MARK["ok" if r["path"] else "unknown"], r["tool"],
                                    (r["version"] or "found") if r["path"] else "missing", r["for"]) for r in rows]
    if shutil.which("ngspice"):
        lines.append("ngspice threads: %s; this machine has %d cores%s" % (
            n if n else "2 (its default)", cpu_cores(), "" if n else "  (`silik eda tune` sets them; `silik eda bench` measures)"))
    missing = [r["package"] for r in rows if not r["path"]]
    if missing:
        lines.append("missing: sudo dnf install " + " ".join(missing))
    text = "\n".join(lines)
    try:
        print(text)
    except UnicodeEncodeError:
        print(text.encode("ascii", "replace").decode("ascii"))
    return 0


def eda_try_jobs():
    """the jobs of `silik eda try`: name, the tools it needs, its commands, and what its result must show.
    A command is (argv, the file its output goes to); a check is (file, a regular expression, what it means).
    Each job stands alone (one that needs a layout draws it again)."""
    magic = (["magic", "-dnull", "-noconsole", "-T", "scmos", "inverter.tcl"], "magic.out")
    icarus = [(["iverilog", "-o", "counter.vvp", "counter_tb.v", "counter.v"], "iverilog.out"), (["vvp", "counter.vvp"], "vvp.out")]
    return (
        ("sim", ("ngspice",), [(["ngspice", "-b", "inverter.cir"], "inverter.out")],
         [("inverter.out", r"v\(out\) = 3\.\d+e\+00[\s\S]*v\(out\) = \d\.\d+e-\d\d", "an inverter's output is high for a low input and low for a high one")]),
        ("schematic", ("xschem", "ngspice"), [(["xschem", "-n", "-s", "-q", "-x", "-o", ".", XSCHEM_EXAMPLE], "xschem.out"),
                                             (["ngspice", "-b", "rlc.spice"], "rlc.out")],
         [("rlc.spice", r"(?im)^L\S* ", "Xschem turned one of its own schematics (an RLC circuit) into a netlist"),
          ("rlc.out", r"No\. of Data Rows : [1-9]\d+", "ngspice simulated it")]),
        ("layout", ("magic", "netgen"), [magic, (["netgen", "-batch", "lvs", "inverter_lvs.spice inverter", "inverter_ref.spice inverter", "nosetup", "lvs.out"], "netgen.out")],
         [("magic.out", r"design rule errors: 0\b", "the inverter drawn in Magic breaks no design rule"),
          ("inverter_lvs.spice", r"(?m)^M\d+ out in vdd vdd pfet w=8u l=2u[\s\S]*^M\d+ out in gnd \S+ nfet w=4u l=2u", "Magic extracted its two transistors"),
          ("lvs.out", r"Final result: Circuits match uniquely", "Netgen: the layout matches the schematic")]),
        ("postlayout", ("magic", "ngspice"), [magic, (["ngspice", "-b", "inverter_post.cir"], "post.out")],
         [("inverter.spice", r"(?m)^C\d+ \S+ \S+ [\d.]+f", "the extraction carries the layout's parasitic capacitances"),
          ("post.out", r"(?m)^vhigh += +3\.\d+e\+00[\s\S]*^vlow += +\d\.\d+e-\d\d[\s\S]*^tphl += +\d\.\d+e-1[01][\s\S]*^tplh += +\d\.\d+e-1[01]",
           "the extracted inverter switches in simulation")]),
        ("gds", ("magic", "klayout"), [magic, (["klayout", "-zz", "-r", "gds_read.py", "-rd", "gds=inverter.gds"], "klayout.out")],
         [("klayout.out", r"read inverter: [1-9]\d* shapes", "KLayout reads the GDS file Magic wrote")]),
        ("digital", ("iverilog", "vvp"), icarus,
         [("vvp.out", r"PASS count=10", "the counter counts ten clock edges in simulation")]),
        ("waves", ("iverilog", "vvp", "vcd2fst", "fst2vcd"), icarus + [(["vcd2fst", "counter.vcd", "counter.fst"], "vcd2fst.out"),
                                                                    (["fst2vcd", "counter.fst"], "waves.out")],
         [("waves.out", r"\$var \S+ 4 \S+ q ", "the simulation's waveforms, packed by GTKWave's tools and read back, have the count in them")]),
        ("gates", ("yosys", "iverilog", "vvp"),
         [(["yosys", "-q", "-p", "read_verilog counter.v; synth -top counter; abc -g AND,NAND,OR,NOR,XOR,XNOR,MUX; clean; write_verilog -noattr counter_gates.v"], "yosys_gates.out"),
          (["iverilog", "-o", "gates.vvp", "counter_tb.v", "counter_gates.v"], "iverilog_gates.out"), (["vvp", "gates.vvp"], "vvp_gates.out")],
         [("counter_gates.v", r"module counter", "Yosys wrote the counter as gates"),
          ("vvp_gates.out", r"PASS count=10", "the gates count the same ten clock edges in Icarus Verilog")]),
        ("verilate", ("verilator", "g++", "make"),
         [(["verilator", "--binary", "--timing", "-Wno-fatal", "--top-module", "counter_tb", "-o", "counter_sim", "counter_tb.v", "counter.v"], "verilate.out"),
          (["obj_dir/counter_sim"], "verilated.out")],
         [("verilated.out", r"PASS count=10", "Verilator compiled the counter and its bench to a program, and it counts ten")]),
