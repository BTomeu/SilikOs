def sec_probe(pending=True, offline=False, parallel=False, more=True):
    """what the audit reads; PARALLEL: its parts at once (silik doctor), else one after the other. MORE: also the
    boot chain, the firmware and what listens (False for `apply`, which sets none of that; "doctor": without what
    asks a daemon that may have to be started)"""
    cont = sec_container()
    bw = shutil.which("bwrap")
    su = os.environ.get("SUDO_USER", "") if os.geteuid() == 0 else ""
    su = su if su != "root" and valid_name(su) else ""
    ns = read("/proc/sys/user/max_user_namespaces").strip()
    parts = (("selinux", lambda: sec_selinux(cont)), ("firewall", sec_firewall),
             ("sshd", lambda: {"unit": sec_unit("sshd.service"), "active": sec_active("sshd.service")}),
             ("auto", sec_updates_auto), ("pending", lambda: sec_pending(offline) if pending else None), ("disk", sec_disk),
             ("secureboot", lambda: sec_secureboot(cont)), ("lock", lambda: sec_lock(su)), ("autologin", sec_autologin),
             ("sysctl", sec_sysctl), ("bwrap", lambda: (sec_cmd(["bwrap", "--version"])[1].split() or [""])[-1] if bw else ""))
    vals = par([f for _, f in parts]) if parallel else [f() for _, f in parts]
    for v in vals:
        if isinstance(v, BaseException):
            raise v
    got = dict(zip([k for k, _ in parts], vals))
    st = {
        "container": cont, "uid": os.geteuid(), "el": os.path.exists("/etc/redhat-release"),
        "selinux": got["selinux"], "firewall": got["firewall"], "sshd": got["sshd"], "auto": got["auto"],
        "pending": got["pending"], "disk": got["disk"], "secureboot": got["secureboot"], "lock": got["lock"], "lock_user": su,
        "autologin": got["autologin"], "sysctl": got["sysctl"], "sysctl_file": os.path.isfile(SEC_SYSCTL_FILE),
        "vsyscall": kernel_vsyscall() if x86() else "n/a", "bwrap": {"path": bw or "", "version": got["bwrap"], "userns": int(ns) if ns.isdigit() else None},
        "plugins": sec_plugins_probe(parallel),      # (r7: listen, usb)
    }
    if more:
        st["more"] = sec_more(got["disk"], su, None if more == "doctor" else True, parallel)
    return st


def sec_checks(st):
    """the audit: one row per check, {id, name, state, value, fix}; fix is the list of commands that make it ok"""
    rows = []

    def row(i, name, state, value, fix=()):
        rows.append({"id": i, "name": name, "state": state, "value": value, "fix": list(fix) if state != "ok" else []})
        # (on an unknown row, "fix" is the command that lets it be seen)

    here = " (inside a container)" if st["container"] else ""
    apply_ = "silik secure apply"
    more = st.get("more")
    # the level the owner chose (`silik secure level hardened`): there Secure Boot and encryption are required
    hard = bool(more and (more.get("level") or {}).get("level") == "hardened")

    se = st["selinux"]
    sed = "sudo sed -i 's/^SELINUX=.*/SELINUX=enforcing/' " + SEC_SELINUX_CONF
    if se["mode"] is None:
        row("selinux", "SELinux", "unknown", "not visible: no /sys/fs/selinux" + here)
    elif se["mode"] == "enforcing" and se["config"] == "enforcing":
        row("selinux", "SELinux", "ok", "enforcing")
    elif se["mode"] == "enforcing":
        row("selinux", "SELinux", "warn", "enforcing now; at the next boot: %s" % (se["config"] or "not configured"), [sed])
    elif se["mode"] == "permissive":
        row("selinux", "SELinux", "warn", "permissive: violations are logged, nothing is stopped",
            ["sudo setenforce 1"] + ([sed] if se["config"] != "enforcing" else []))
    else:
        row("selinux", "SELinux", "bad", "disabled",
            ["sudo sed -i 's/^SELINUX=.*/SELINUX=permissive/' %s && sudo fixfiles -F onboot && sudo reboot" % SEC_SELINUX_CONF,
             "then, when `sudo ausearch -m avc -ts boot` shows nothing that matters: " + apply_])

    fw = st["firewall"]
    boot = {"enabled": "started at boot", "disabled": "not started at boot", "masked": "masked"}.get(fw["unit"], "boot state unknown")
    if fw["active"] is True:
        row("firewall", "firewall", "ok" if fw["unit"] == "enabled" else "warn", "firewalld running, " + boot, [apply_])
    elif fw["active"] is False:
        row("firewall", "firewall", "bad", "firewalld is not running (%s)" % boot, [apply_])
    elif not fw["installed"] and st["el"] and not st["container"]:
        row("firewall", "firewall", "bad", "firewalld is not installed", ["sudo dnf -y install firewalld", apply_])
    else:
        row("firewall", "firewall", "unknown", ("firewalld %s; whether it runs is not visible" % boot if fw["installed"] else "firewalld is not installed") + here)

    if fw["zone"] is None:
        row("incoming", "incoming", "unknown", "the default zone is not readable" + here, ["sudo silik secure status"] if st["uid"] else [])
    elif fw["open"] is None:
        pk = fw["packaged"]
        row("incoming", "incoming", "bad" if fw["active"] is False else "unknown",
            "%szone %s; what it opens is root's to read%s" % ("not filtered; configured: " if fw["active"] is False else "", fw["zone"],
                                                            " (its file as packaged: %s)" % (", ".join(pk["open"]) or "nothing open") if pk else ""),
            [apply_] if fw["active"] is False else ["sudo silik secure status"])
    else:
        extra = [o for o in fw["open"] if o not in SEC_ZONE_OPEN]
        val = "zone %s (target %s): %s" % (fw["zone"], fw["target"] or "?", ", ".join(fw["open"]) or "nothing open")
        if fw["icmp"]:
            val += "; ICMP: " + ", ".join(fw["icmp"])
        if fw["also_active"]:
            val += "; other zones in use: " + ", ".join(fw["also_active"])
        if fw["zone"] == SEC_ZONE:
            fix = ["sudo firewall-cmd --permanent --zone=%s --remove-%s=%s" % (SEC_ZONE, "port" if "/" in o else "service", o) for o in extra if not o.startswith(("rule:", "protocol ", "forward-port "))]
            fix = fix + ["sudo firewall-cmd --reload"] if fix else ["sudo firewall-cmd --zone=%s --list-all" % SEC_ZONE]
        else:
            fix = [apply_]
        if fw["active"] is False:
            row("incoming", "incoming", "bad", "not filtered; configured: " + val, [apply_])
        elif fw["target"] == "ACCEPT":
            row("incoming", "incoming", "bad", val + " (everything is accepted)", fix)
        elif extra:
            row("incoming", "incoming", "warn", val, fix)
        elif fw["active"] is None or fw["target"] is None:
            row("incoming", "incoming", "unknown", val + " (as configured; not seen running)")
        else:
            row("incoming", "incoming", "ok", val)

    sh = st["sshd"]
    if sh["unit"] == "not-found":
        row("sshd", "ssh server", "ok", "not installed")
    elif sh["active"] is True or sh["unit"] in ("enabled", "enabled-runtime"):
        runs = {True: "running", False: "not running", None: "running state unknown"}[sh["active"]]
        row("sshd", "ssh server", "warn", "sshd %s, %s" % ("started at boot" if sh["unit"] in ("enabled", "enabled-runtime") else "not started at boot", runs),
            ["sudo systemctl disable --now sshd", "(to keep it on purpose: silik secure apply --keep-ssh)"])
    elif sh["active"] is False and sh["unit"] is not None:
        row("sshd", "ssh server", "ok", "sshd off (%s, not running)" % sh["unit"])
    else:
        row("sshd", "ssh server", "unknown", "sshd %s; whether it runs is not visible%s" % (sh["unit"] or "state unknown", here))

    au = st["auto"]
    start = ["sudo systemctl enable --now " + SEC_FULL_TIMER]
    on = [(k, what, unit) for k, what, unit in (("full", "every update, daily", SEC_FULL_TIMER),
                                               ("silikos", "security advisories, daily", SEC_TIMER),
                                               ("dnf_install", "every update, daily", "dnf-automatic-install.timer"),
                                               ("dnf", "what /etc/dnf/automatic.conf says: it installs", "dnf-automatic.timer"))
          if au.get(k) == "enabled" and (k != "dnf" or au.get("dnf_applies"))]
    if on:
        k, what, unit = on[0]
        if au[k + "_active"] is True:
            row("updates-auto", "automatic updates", "ok", "%s (%s)" % (what, unit))
        elif au[k + "_active"] is False:
            row("updates-auto", "automatic updates", "warn", "%s (%s): on from the next boot, not started now" % (what, unit), ["sudo systemctl start " + unit])
        else:
            row("updates-auto", "automatic updates", "unknown", "%s (%s) is on at boot; whether the timer runs is not visible%s" % (what, unit, here))
    elif au["silikos"] is None and au["dnf_install"] is None and au["dnf"] is None:
        row("updates-auto", "automatic updates", "unknown", "systemd's units are not readable" + here)
    elif au["silikos"] == "not-found":
        row("updates-auto", "automatic updates", "warn", "off (the package silikos-security is not installed)",
            ["sudo dnf -y install silikos-security", apply_])
    else:
        row("updates-auto", "automatic updates", "warn", "off (%s is %s, %s is %s)" % (SEC_FULL_TIMER, au.get("full") or "in an unknown state",
                                                                                 SEC_TIMER, au["silikos"] or "in an unknown state"), start)

    pe = st["pending"]
    if pe is None:
        row("updates-pending", "pending updates", "unknown", "dnf gives no list of advisories")
    elif pe["advisories"] == 0:
        row("updates-pending", "pending updates", "ok", "no security advisory waits")
    else:
        row("updates-pending", "pending updates", "bad" if pe["worst"] in ("Critical", "Important") else "warn",
            "%d security advisor%s (%d packages), the worst: %s" % (pe["advisories"], "y" if pe["advisories"] == 1 else "ies", pe["packages"], pe["worst"]),
            ["sudo dnf -y upgrade --security"])

    dk = st["disk"]
    r, h = dk["/"], dk["/home"]
    luks = ["no command changes this: it is chosen in the installer (Installation Destination > Encrypt my data); docs/SECURITY.md"]
    if r["encrypted"] is None or h["encrypted"] is None:
        row("disk", "disk encryption", "unknown", "/ is on %s: not a block device seen from here%s" % (r["source"] or "an unknown device", here))
    elif r["encrypted"] and h["encrypted"]:
        row("disk", "disk encryption", "ok", "/ and /home are on LUKS (%s)" % (r["source"] if r["source"] == h["source"] else r["source"] + ", " + h["source"]))
    elif h["encrypted"]:
        row("disk", "disk encryption", "bad" if hard else "warn", "/home is on LUKS (%s); / (%s) is not%s" % (
            h["source"], r["source"], ": the hardened level requires it" if hard else ""), luks)
    else:
        row("disk", "disk encryption", "bad", "%s (%s) is not encrypted: whoever holds the machine reads the disk" % ("/home" if r["source"] != h["source"] else "/ with /home", h["source"]), luks)

    sb = st["secureboot"]
    mok = ["turned on in the firmware's setup; with the NVIDIA driver first: sudo mokutil --import /var/lib/dkms/mok.pub (docs/SECURITY.md)"]
    need = "; the hardened level requires it" if hard else ""
    if sb == "enabled":
        # (what it covers is said: on bare metal the initramfs and the kernel's arguments are read from /boot unchecked)
        row("secureboot", "Secure Boot", "ok", "enabled: the boot loader and the kernel are checked; the initramfs and the kernel's arguments are not")
    elif sb == "disabled":
        row("secureboot", "Secure Boot", "bad" if hard else "warn", "disabled: the firmware starts any boot loader" + need, mok)
    elif sb == "bios":
        row("secureboot", "Secure Boot", "bad" if hard else "warn", "not possible: this system was not started through UEFI" + need, ["an installation started in UEFI mode"])
    else:
        row("secureboot", "Secure Boot", "unknown", "the firmware's variables are not visible" + here)

    lk = st["lock"]
    who = " (user %s)" % st["lock_user"] if st["lock_user"] else ""
    if st["uid"] == 0 and not st["lock_user"]:
        row("screenlock", "screen lock", "unknown", "a user's setting: run `silik secure status` as the desktop's user, or with sudo from their session")
    elif lk["enabled"] is None or lk["idle"] is None or lk["delay"] is None:
        row("screenlock", "screen lock", "unknown", "the desktop's settings are not readable (gsettings)")
    elif not lk["enabled"] or lk["idle"] == 0:
        row("screenlock", "screen lock", "bad", "the screen never locks by itself (%s)%s" % ("the lock is off" if not lk["enabled"] else "it never goes blank", who),
            [" ".join(c) for c in sec_lock_fix(lk)])
    elif lk["idle"] + lk["delay"] > SEC_IDLE_MAX:
        row("screenlock", "screen lock", "warn", "locks after %d s without input (more than %d s)%s" % (lk["idle"] + lk["delay"], SEC_IDLE_MAX, who),
            [" ".join(c) for c in sec_lock_fix(lk)])
    else:
        row("screenlock", "screen lock", "ok", "locks after %d s without input%s" % (lk["idle"] + lk["delay"], who))

    al = st["autologin"]
    if al is None:
        row("autologin", "login", "unknown", "no %s" % SEC_GDM_CONF)
    elif al:
        row("autologin", "login", "bad", "the login screen opens a session without a password",
            ["sudo sed -i -E 's/^(AutomaticLoginEnable|TimedLoginEnable) *=.*/\\1=false/' " + SEC_GDM_CONF])
    else:
        row("autologin", "login", "ok", "a password is asked (no automatic login)")

    sy = st["sysctl"]
    weak, blind = [], []       # a key with * is said once, with the number of interfaces
    for n, c, w, how, key in sy:
        if sec_weaker(c, w, how):
            txt = "%s=%d (SilikOS: %d)" % (n, c, w) if "*" not in key else "%s=%d on %d interfaces (SilikOS: %d)" % (
                key, c, sum(1 for x in sy if x[4] == key and sec_weaker(x[1], x[2], x[3])), w)
            weak += [txt] if txt not in weak else []
        elif c is None and key not in blind:
            blind.append(key)
    nweak, nblind = sum(1 for x in sy if sec_weaker(x[1], x[2], x[3])), sum(1 for x in sy if x[1] is None)
    if not sy or nblind == len(sy):
        row("sysctl", "kernel settings", "unknown", "/proc/sys is not readable")
    elif weak:
        row("sysctl", "kernel settings", "warn", "%d of %d weaker than the SilikOS values: %s" % (nweak, len(sy), ", ".join(weak)),
            [apply_] if st["sysctl_file"] else ["sudo dnf -y install silikos-security", apply_])
    elif blind:
        row("sysctl", "kernel settings", "unknown", "%d of %d as SilikOS sets them or stricter; not in this kernel: %s" % (len(sy) - nblind, len(sy), ", ".join(blind)))
    else:
        row("sysctl", "kernel settings", "ok", "%d of %d as SilikOS sets them or stricter" % (len(sy), len(sy)))

    vs = st["vsyscall"]
    if vs == "n/a":       # (ARM: the page is a feature of x86_64 kernels)
        row("vsyscall", "vsyscall page", "ok", "none: this kernel's architecture (%s) has no such page" % host_arch())
    elif vs == "none":
        row("vsyscall", "vsyscall page", "ok", "none (an EL6 box does not run on this kernel: silik eda kernel-arg)")
    elif vs == "xonly":   # a trade-off, said as one: the page stays for glibc 2.12, at a fixed address, execute-only
        row("vsyscall", "vsyscall page", "ok", "xonly: this kernel's own default (the page stays, execute-only, for EL6 boxes); `none` is stricter and stops them")
    elif vs == "emulate":
        row("vsyscall", "vsyscall page", "warn", "emulate: the page is readable at a fixed address (wanted only by a program that reads it)",
            ["sudo grubby --update-kernel=ALL --args=vsyscall=xonly && sudo reboot"])
    else:
        row("vsyscall", "vsyscall page", "unknown", "the kernel's mode is not readable")

    bw = st["bwrap"]
    if not bw["path"]:
        row("sandbox", "sandbox", "warn", "bubblewrap is not installed: Windows programs cannot be confined", ["sudo dnf -y install bubblewrap"])
    elif bw["userns"] is None:
        row("sandbox", "sandbox", "unknown", "bubblewrap %s; user namespaces: not readable" % bw["version"])
    elif bw["userns"] == 0:
        row("sandbox", "sandbox", "warn", "bubblewrap %s, but user namespaces are off (user.max_user_namespaces = 0)" % bw["version"],
            ["grep -rs max_user_namespaces /etc/sysctl.conf /etc/sysctl.d /usr/lib/sysctl.d   # the file that turns them off"])
    else:
        row("sandbox", "sandbox", "ok", "bubblewrap %s, user namespaces on" % bw["version"])
    if more is not None:
        sec_checks_more(st, more, row, hard)
    sec_rows_join(rows, sec_plugins_rows(st))         # (r7: listen, usb)
    return rows


def sec_foreign(mods):
    """(unsigned, signed): the names of the kernel modules that are not the base's, from sec_modules(). Unsigned:
    loaded with the taint letter E, or a file without a signature. They stop loading once signatures are enforced"""
    uns = [n for n, t in mods["loaded"] if "E" in t]
    uns += [os.path.basename(p).split(".ko")[0] for p, signer in mods["files"] if not signer and os.path.basename(p).split(".ko")[0].replace("-", "_") not in
            [u.replace("-", "_") for u in uns]]
    sig = sorted(set([n for n, t in mods["loaded"] if "E" not in t and ("O" in t or "P" in t)] +
                     [os.path.basename(p).split(".ko")[0] for p, signer in mods["files"] if signer]))
    return uns, sig


def sec_checks_more(st, m, row, hard=False):
    """the rows of the boot chain, the firmware, what listens and the kernel's switches (sec_more())"""
    here = " (inside a container)" if st["container"] else ""
    sudo = ["sudo silik secure status"] if st["uid"] else []
    level = "silik secure level hardened   # what it sets and costs: silik secure level hardened --list"
    keys = m["keys"]

    ld = m["lockdown"]
    if ld is None:
        row("lockdown", "kernel lockdown", "unknown", "/sys/kernel/security/lockdown is not there" + here)
    elif ld == "none":
        row("lockdown", "kernel lockdown", "warn", "none: root can change the running kernel (unsigned modules, /dev/mem, another kernel by kexec); "
            "Secure Boot turns the lockdown on by itself", [level])
    else:
        row("lockdown", "kernel lockdown", "ok", ld + (": also no reading of kernel memory, so no kernel tracing" if ld == "confidentiality" else
                                                         ": the running kernel is not changed, not even by root; no hibernation"))

    mods, se = m["modules"], m["sig_enforce"]
    uns, sig = sec_foreign(mods) if mods else ([], [])
    foreign = ("; loaded or installed without a signature: %s" % " ".join(uns[:8]) if uns else "") + \
              ("; not the base's, signed: %s" % " ".join(sig[:8]) if sig else "")
    if se is None and ld in (None, "none"):
        row("modsig", "module signatures", "unknown", "/sys/module/module/parameters/sig_enforce is not there" + here)
    elif se or ld in ("integrity", "confidentiality"):
        row("modsig", "module signatures", "ok", "enforced%s: a kernel module loads only with a signature the kernel trusts%s" % (
            "" if se else " by the lockdown", foreign))
    else:
        row("modsig", "module signatures", "warn", "not enforced: root can load any kernel module%s%s" % (
            foreign, "; the kernel is tainted (%d)" % m["tainted"] if m["tainted"] else ""), [level])

    k = m["kernel"]
    if not k["installed"]:
        row("kernel", "kernel in use", "unknown", "running %s; no installed kernel is seen in /lib/modules%s" % (k["running"], here))
    elif k["running"] == k["installed"][-1]:
        row("kernel", "kernel in use", "ok", "%s, the newest installed" % k["running"])
    elif k["running"] in k["installed"]:
        row("kernel", "kernel in use", "warn", "running %s; %s is installed and protects only after a restart" % (k["running"], k["installed"][-1]),
            ["systemctl reboot   # (the system never restarts by itself)"])
    else:
        row("kernel", "kernel in use", "unknown", "running %s, which is not a kernel installed on this system (the newest: %s)%s" % (k["running"], k["installed"][-1], here))

    fw = m["firmware"]
    lvfs = ["sudo fwupdmgr enable-remote lvfs   # one metadata request a day to cdn.fwupd.org", "fwupdmgr get-updates"]
    if fw is None:
        pass                        # (silik doctor does not start fwupd: silik secure status says)
    elif not fw["tool"]:
        row("firmware", "firmware updates", "unknown", "fwupd is not installed: nothing here says whether the firmware (UEFI, the dbx list, devices) is current",
            ["sudo dnf -y install fwupd"])
    elif not fw["lvfs"]:
        row("firmware", "firmware updates", "unknown", "the vendors' firmware service (LVFS) is off, as the base ships it: nothing says whether a firmware "
            "update or a new Secure Boot revocation list (dbx) waits. Processor microcode comes with the system's updates", lvfs)
    elif fw["updates"] is None:
        row("firmware", "firmware updates", "unknown", "fwupd gave no answer", ["fwupdmgr get-updates"])
    elif fw["updates"]:
        row("firmware", "firmware updates", "warn", "%d device%s with a firmware update waiting" % (fw["updates"], "" if fw["updates"] == 1 else "s"),
            ["fwupdmgr get-updates", "fwupdmgr update"])
    else:
        row("firmware", "firmware updates", "ok", "none waits (fwupd, from the metadata it has)")

    cpu = m["cpu"]
    if not cpu:
        row("cpu", "processor flaws", "unknown", "/sys/devices/system/cpu/vulnerabilities is not there" + here)
    else:
        vul = ["%s (%s)" % (n, v[:60]) for n, v in sorted(cpu.items()) if v.lower().startswith("vulnerable")]
        if vul:
            row("cpu", "processor flaws", "warn", "%d of %d not mitigated: %s" % (len(vul), len(cpu), "; ".join(vul)),
                ["sudo dnf -y upgrade microcode_ctl kernel   # then a restart; a virtual machine: its host's"])
        else:
            row("cpu", "processor flaws", "ok", "%d known flaws: each not affected or mitigated" % len(cpu))

    li = m["listen"]
    if li is None:
        row("listening", "listening", "unknown", "ss (iproute) does not answer" + here)
    else:
        out = [r for r in li if not r["local"]]
        own = [r for r in out if (r["proto"], r["port"]) in SEC_LISTEN_OWN]
        out = [r for r in out if r not in own]
        said, blind = [], False
        for r in out:
            who = r["unit"] or r["who"]
            blind = blind or not who
            t = "%s %s:%s%s" % (r["proto"], r["addr"], r["port"], " (%s)" % who if who else "")
            said += [t] if t not in said else []
        tail = "; ".join(sorted(set(SEC_LISTEN_OWN[(r["proto"], r["port"])] for r in own)))
        if out:
            fwl = st["firewall"]
            row("listening", "listening", "warn", "%d beyond this machine: %s%s%s" % (
                len(said), ", ".join(said[:10]), "; the owner of a socket without a name here is root's to see" if blind and st["uid"] else "",
                "; the firewall zone drops what comes for them" if fwl["active"] and fwl["target"] not in (None, "ACCEPT") else ""),
                ["sudo systemctl disable --now UNIT   # the unit named; rpcbind.socket: NFSv3 only, avahi-daemon.service avahi-daemon.socket: finding printers"] + sudo)
        else:
            row("listening", "listening", "ok", "nothing listens beyond this machine (%d on the loopback only%s)" % (
                sum(1 for r in li if r["local"]), "; " + tail if tail else ""))

    tpm = m["tpm"]
    if tpm is None:
        row("tpm", "TPM", "unknown", "/sys/class is not readable" + here)
    elif tpm == "2":
        row("tpm", "TPM", "ok", "a TPM 2.0 is present")
    elif tpm:
        row("tpm", "TPM", "warn", "a TPM 1.2: it cannot hold the disk's key (systemd-cryptenroll needs 2.0)", ["the firmware's setup: some machines switch their TPM to 2.0 there"])
    else:
        row("tpm", "TPM", "warn", "none seen%s: the disk cannot be tied to this machine's boot chain; its passphrase is the whole protection" % here,
            ["the firmware's setup: Security > TPM / PTT / fTPM, when the machine has one"])

    un = m["unlock"]
    if un is not None:
        enrol = "sudo systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=7 --tpm2-with-pin=yes %s   # docs/HARDENED.md" % (un["device"] or "DEVICE")
        if un["tokens"] is None:
