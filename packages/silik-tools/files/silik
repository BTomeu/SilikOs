LOOK_SCHEMA = "com.silikvolt.silikos.shell"
LOOKS = (
    ("silik", "the title bar is the command line, a rail of text keys, a status bar"),
    ("bar", "one bar at the bottom: Start, the command line, the applications, workspaces, system, clock"),
