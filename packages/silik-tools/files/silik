UPDATE_AUTO = (("all", "every update, daily (silikos-update.timer)"),
               ("security", "security advisories only, daily (silikos-security-update.timer)"),
               ("off", "none: `silik update` by hand"))


def update_auto_now(ctx):
    """which automatic updates are on: all, security, off; '' when systemd cannot say"""
    st = {}
    for unit in (SEC_FULL_TIMER, SEC_TIMER):
        st[unit] = ctx.query(["systemctl", "is-enabled", unit], any_rc=True).strip()     # ("disabled" exits 1)
    if not any(st.values()):
        return ""
    return "all" if st[SEC_FULL_TIMER] == "enabled" else "security" if st[SEC_TIMER] == "enabled" else "off"


def cmd_update(ctx, a):
    if a.auto == "":
        now = update_auto_now(ctx)
        for k, what in UPDATE_AUTO:
            print("%s %-8s %s" % ("●" if k == now else " ", k, what))
        if os.path.exists("/run/silikos/restart"):
            print("silik: an update waits for a restart of the computer")
        if os.path.exists(SNAP_HOLD):
            print("silik: the automatic updates wait since a rollback: `silik update` updates now (a snapshot first) and they go on")
        return 0 if now else 1
    if a.auto:
        on = {"all": [SEC_FULL_TIMER], "security": [SEC_TIMER], "off": []}[a.auto]
        off = [u for u in (SEC_FULL_TIMER, SEC_TIMER) if u not in on]
        if off:
            ctx.run(["sudo", "systemctl", "disable", "--now"] + off)
        if on:
            ctx.run(["sudo", "systemctl", "enable", "--now"] + on)
            if os.path.exists(SNAP_HOLD):
                ctx.run(["sudo", "rm", "-f", SNAP_HOLD])   # (turned on by hand: the wait after a rollback ends)
        return 0
    if snap_booted()[0] == "snapshot":
        snap_refuse("this system is started from a snapshot: nothing is updated here",
                    ["systemctl reboot   # and the normal entry, then: silik update", "silik rollback   # makes this state the system"])
    # a snapshot of / first, when there is something to update and / is on a thin volume (docs/ROLLBACK.md): the hook
    # of the automatic updates. Without one the update goes on, and the hook says why
    hook = os.path.isfile(SNAP_HOOK) and not a.no_snapshot
    if hook:
        ctx.run(["sudo", SNAP_HOOK], check=False)
    # (ten downloads at a time, as the automatic updates: measured faster here; the base's dnf.conf is not changed)
    ctx.run(["sudo", "dnf", "-y", "--setopt=max_parallel_downloads=10", "upgrade", "--refresh"])
    if hook:
        ctx.run(["sudo", SNAP_HOOK, "settle"], check=False)
    if os.path.exists(SNAP_HOLD):
        ctx.run(["sudo", "rm", "-f", SNAP_HOLD])           # (updated by hand after a rollback: the automatic updates go on)
    if not ctx.dry and shutil.which("needs-restarting"):
        # (dnf-utils: exit 1 when the kernel, glibc, systemd or another core part was updated under the running system)
        if subprocess.run(["needs-restarting", "-r"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 1:
            print("silik: restart the computer to run what was updated (the kernel or a core library)")
        if os.path.isfile("/usr/libexec/silikos/restart-needed"):
            ctx.run(["sudo", "/usr/libexec/silikos/restart-needed"], check=False)     # (the status bar's note)
    return 0


