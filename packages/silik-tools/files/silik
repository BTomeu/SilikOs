def win_plain(text, limit=300):
    """a text that came with a file (an address in its attributes, its name), fit to be shown: printable characters
    only (no escape sequence reaches a terminal, no line break a window), cut at `limit`"""
    t = "".join(c if c.isprintable() else "?" for c in text)
    return t if len(t) <= limit else t[:limit - 1] + "…"


def win_origin(f):
    """where the file says it came from: the address a browser or a download tool wrote on it as an extended
    attribute (user.xdg.origin.url; curl --xattr and wget --xattr write it, Chromium did until 2019; Firefox writes
    none on Linux [A: not run here]). '' when it has none. What it says is the sender's word, not a fact."""
    for k in ("user.xdg.origin.url", "user.xdg.referrer.url"):
        try:
            v = os.getxattr(f, k).decode("utf-8", "replace").strip()
        except (OSError, AttributeError):
            v = ""
        if v:
            return win_plain(v)
    return ""


def win_signed(f):
    """True when the file is a PE program that carries an Authenticode signature block (the certificate table of
    its header is not empty and lies inside the file), False when it is one without, None when it is not a PE
    file. Presence only: Python's standard library cannot verify the signature, and a name read out of a block
    nobody verified would be the attacker's to choose, so no publisher is shown."""
    try:
        size = os.path.getsize(f)
        with open(f, "rb") as fh:
            head = fh.read(4096)
            pe = int.from_bytes(head[0x3c:0x40], "little")
            if head[:2] != b"MZ" or pe <= 0 or pe > size - 256:
                return None
            fh.seek(pe)
            h = fh.read(24 + 240)
    except OSError:
        return None
    if h[:4] != b"PE\0\0":
        return None
    magic = int.from_bytes(h[24:26], "little")
    dirs = 24 + {0x10b: 96, 0x20b: 112}.get(magic, 0)
    if dirs == 24 or int.from_bytes(h[dirs - 4:dirs], "little") < 5:
        return False
    at, n = int.from_bytes(h[dirs + 32:dirs + 36], "little"), int.from_bytes(h[dirs + 36:dirs + 40], "little")
    return n > 8 and 0 < at and at + n <= size


def win_sha256(f):
    import hashlib
    h = hashlib.sha256()
    with open(f, "rb") as fh:
        for block in iter(lambda: fh.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def win_approved_file():
    return os.path.join(os.path.dirname(WINE_ROOT), "win-approved")


def win_approved():
    """{SHA-256: "isolated" | "box"}: the files this owner answered the question for, and how each runs"""
    out = {}
    for l in read(win_approved_file()).splitlines():
        w = l.split(None, 2)
        if len(w) >= 2 and len(w[0]) == 64 and w[1] in ("isolated", "box"):
            out[w[0]] = w[1]
    return out


def win_approve(ctx, sha, mode, name):
    """keeps the owner's answer for this file: SHA-256, how it runs, its name (for the person reading the list)"""
    line = "%s %s %s" % (sha, mode, win_plain(name, 120))
    if not ctx.quiet:
        print("$ echo %s >> %s" % (shlex.quote(line), shlex.quote(win_approved_file())), flush=True)
    if ctx.dry:
        return
    keep = [l for l in read(win_approved_file()).splitlines() if l.split(None, 1)[:1] != [sha]]
    win_private_write(win_approved_file(), "".join(l + "\n" for l in keep + [line]))


def win_size(n):
    for unit, k in (("GB", 1 << 30), ("MB", 1 << 20), ("kB", 1 << 10)):
        if n >= k:
            return "%.1f %s" % (n / k, unit)
    return "%d B" % n


def win_decide(yes=False, isolated=False, no_sandbox=False, inside=False, approved=None):
    """what happens before a file runs: "go" (as the switches say), "isolated" (the owner chose it for this file
    before), or "ask" """
    if yes or isolated or no_sandbox or inside or approved == "box":
        return "go"
    return "isolated" if approved == "isolated" else "ask"


def win_question(f, sha, lang, cannot="", boxed=True):
    """the question for file f, as data: the same for the terminal and for the window.
    {"title", "head", "rows": [[label, value]], "note", "buttons": [[id, label]], "default": id}.
    `cannot`: why it cannot run isolated here ('' when it can); `boxed`: False when there is no sandbox at all"""
    t = WIN_Q[lang]
    origin = win_origin(f)
    sig = win_signed(f) if f.lower().endswith(".exe") else None
    try:
        size = " (%s)" % win_size(os.path.getsize(f))
    except OSError:
        size = ""
    rows = [[t["file"], win_plain(f) + size],
            [t["from"], origin or t["from_dl" if _under(f, win_downloads()) else "from_none"]],
            [t["sha"], sha],
            [t["sig"], t["sig_na"] if sig is None else t["signed" if sig else "unsigned"]]]
    buttons = ([] if cannot else [["isolated", t["isolated"]]]) + [["box", t["box" if boxed else "nobox"]], ["cancel", t["cancel"]]]
    return {"title": t["title"], "head": t["head"] % win_plain(os.path.basename(f), 80), "rows": rows,
            "note": t["note"] + ("\n" + t["cannot"] % cannot if cannot else ""), "buttons": buttons,
            "default": "cancel" if cannot else "isolated"}


def win_ask_text(q, lang, ask=input):
    """the question in a terminal; returns the chosen button's id (Enter: the default; anything else: cancel)"""
    t = WIN_Q[lang]
    w = max(len(r[0]) for r in q["rows"])
    print("silik: " + q["head"], file=sys.stderr)
    for label, value in q["rows"]:
        print("  %-*s  %s" % (w, label, value), file=sys.stderr)
    for l in q["note"].split("\n"):
        print("  " + l, file=sys.stderr)
    for i, (key, label) in enumerate(q["buttons"]):
        print("  [%d] %s%s" % (i + 1, label, " (%s)" % t["default"] if key == q["default"] else ""), file=sys.stderr)
    try:
        v = ask("%s [1-%d]: " % (t["choice"], len(q["buttons"]))).strip()
    except EOFError:
        return "cancel"
    if not v:
        return q["default"]
    return q["buttons"][int(v) - 1][0] if v.isdigit() and 1 <= int(v) <= len(q["buttons"]) else "cancel"


def win_ask_window(q, lang):
    """the question as a window (silik-win-ask: GTK 3, the COMMAND bar's look); the chosen button's id, or None when
    the window cannot be shown"""
    exe = os.environ.get("SILIK_WIN_ASK") or WIN_ASK
    if not os.path.isfile(exe):
        return None
    try:
        p = subprocess.run([exe, "--lang", lang], input=json.dumps(q), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           universal_newlines=True, check=False, env=win_helper_env())
    except OSError:
        return None
    v = p.stdout.strip()
    if p.returncode != 0:               # (its own error; what GLib and GTK say when all is well is not this command's)
        sys.stderr.write(p.stderr)
    return v if p.returncode == 0 and v in [b[0] for b in q["buttons"]] else None


def win_gate(ctx, a, f, name):
    """before file f runs in prefix `name`: asks the owner when the file was not run here before (the answer is
    kept), and sets a.isolated when the answer, now or then, is "isolated". Ends the command when the answer is no."""
    # (no question about a file inside a prefix, nor about the system's own programs: /usr, and the folder of a
    # Wine installed under /opt, where Wine Mono's compiler is; the first installed system asked about that one)
    inside = _under(f, WINE_ROOT) or any(_under(f, x) for x in ["/usr"] + [p for p in [wine_opt()] if p])
    marked = name in win_marked() and win_boxed(a)
    first = win_decide(getattr(a, "yes", False), getattr(a, "isolated", False) or marked, getattr(a, "no_sandbox", False), inside)
    if first == "go" or not os.path.isfile(f):
        return
    sha = win_sha256(f)
    what = win_decide(approved=win_approved().get(sha))
    if what == "ask":
        lang = win_lang()
        q = win_question(f, sha, lang, win_cannot_isolate(), win_boxed(a))
        if ctx.dry:
            print("silik: (not a dry run: the question \"%s\" comes here; --yes skips it)" % q["head"], file=sys.stderr)
            return
        if sys.stdin is not None and sys.stdin.isatty():
            what = win_ask_text(q, lang)
        else:
            what = win_ask_window(q, lang) if os.environ.get("DISPLAY") else None
            if what is None:
                win_die(ctx, "%s was not run here before, and there is nowhere to ask: run it from a terminal, or with --yes "
                        "(silik win open --yes --isolated FILE: on a display of its own)" % os.path.basename(f), 2)
        if what not in ("isolated", "box"):
            print("silik: %s: %s" % (os.path.basename(f), WIN_Q[lang]["not_run"]), file=sys.stderr)
            sys.exit(1)
        win_approve(ctx, sha, what, os.path.basename(f))
    if what == "isolated":
        a.isolated = True


def win_open(ctx, a):
    """what a double-click on a Windows file runs. Installers and portable programs are not told apart: both run in
    the prefix (the one named, or "default", made on first use); an installer installs into it. Without a terminal
    (a double-click) a console program or a batch file gets Wine's console window, as it gets one on Windows."""
    f = win_real(ctx, a.file)
    ext = os.path.splitext(f)[1].lower()
    if ext not in WIN_EXT:
        win_die(ctx, "%s: not a Windows program (%s)" % (a.file, " ".join(WIN_EXT)), 2)
    if not os.path.isfile(f) and not ctx.dry:
        win_die(ctx, "no such file: " + a.file)
    win_need_wine(ctx)                      # (no question about a program that cannot run here at all)
    theirs = win_from_isolated(f)
    if theirs:                              # a file of an isolated prefix runs isolated, there: no answer changes that
        a.isolated, a.prefix = True, a.prefix or theirs
    win_gate(ctx, a, f, a.prefix or WIN_DEFAULT)
    # an isolated program never goes into "default", where the trusted ones are: the prefix "isolated" is for those
    name = a.prefix or (WIN_ISOLATED if getattr(a, "isolated", False) and win_boxed(a) else WIN_DEFAULT)
    if getattr(a, "isolated", False) and win_boxed(a) and (name == WIN_ISOLATED or not os.path.isdir(prefix_dir(name))):
        win_mark(ctx, name)                 # a prefix made isolated stays so (the prefix "isolated" always is)
    win_apart_check(ctx, a, name)
    show = win_show(f, prefix_dir(name), win_iso(a, name)) if win_boxed(a) else []
    d, shared = win_prepare(ctx, name, a, create=True, show=show), win_shared_of(a, name)
    if show:
        print("silik: %s is shown to the program, read-only (the file is outside %s)" % (show[0], shared), file=sys.stderr)
    if ext == ".exe":
        cmd = [f]
    elif ext == ".msi":
        cmd = ["msiexec", "/i", win_path(f, d, shared)]
    elif ext in (".bat", ".cmd"):
        cmd = ["cmd", "/c", win_path(f, d, shared)]
    else:                                   # .lnk: Wine's start follows the shortcut (and does not wait for its program)
        cmd = ["start", win_path(f, d, shared)]
    console = ext in (".bat", ".cmd") or (ext == ".exe" and win_cui(f))
    window = not win_tty() and console
    cmd = ["wine"] + (["wineconsole"] if window else []) + cmd
    rc = win_exec(ctx, name, d, cmd + list(a.cmd or []), a, show=show, cwd=os.path.dirname(f), window=not (console and win_tty()))
    win_after(ctx, name)
    return rc


def win_install(ctx, a):
    a.file, a.cmd = a.setup, a.args or []
    return win_open(ctx, a)


WIN_STOP_WAIT = 10      # seconds `silik win stop` gives the wineserver to end its programs before the box is ended


def win_stop(ctx, a):
    """ends every program of the prefix (wineserver -k), in the sandbox when that is where they run"""
    d = prefix_dir(a.prefix)
    if not os.path.isdir(d) and not ctx.dry:
        die("no prefix %s" % a.prefix)
    s = win_session_info(a.prefix)
    tail = wine_argv(d, ["wineserver", "-k"])
    if s:
        # (timeout: `wineserver -k` waits for the server to go, and a program of the box can keep it from going)
        win_enter(ctx, d, s, wine_argv(d, ["timeout", "--signal=KILL", "10", "wineserver", "-k"]), display=False)
        t0 = time.time()
        while not ctx.dry and win_session_info(a.prefix) and time.time() - t0 < WIN_STOP_WAIT:
            time.sleep(0.1)
        # Asking was not enough when a program of the box stopped its wineserver (kill -STOP: it is alive and never
        # answers): `silik win stop` then returned 0 with every program still running (seen, 14/11/2026). The box's
        # first process is the first of its process namespace: the kernel ends every process of the box with it
        left = {} if ctx.dry else win_session_info(a.prefix)
        if left:
            ctx.echo(["kill", "-KILL", str(left["pid"])])
            try:
                os.kill(left["pid"], signal.SIGKILL)
            except OSError:
                pass
            t0 = time.time()
            while os.path.exists("/proc/%d" % left["pid"]) and read("/proc/%d/stat" % left["pid"]).rpartition(")")[2].split()[:1] != ["Z"] \
                    and time.time() - t0 < 5:
                time.sleep(0.05)
    else:
        ctx.run(tail, check=False)
    win_reap(ctx, a.prefix)
    if not ctx.dry:
        win_pasta_end(win_runtime(a.prefix), ctx.echo)
    return 0


def win_rm(ctx, a):
    d = prefix_dir(a.prefix)
    if not ctx.dry and not os.path.isdir(d):
        die("no prefix %s (silik win list)" % a.prefix)
    # (a program's Documents and Desktop are inside the prefix: they go with it)
    confirm(ctx, a, "the prefix %s (%s), with its programs and the files they saved inside it," % (a.prefix, d))
    if win_session_info(a.prefix) or (not ctx.dry and win_outside(d)):      # its programs end first
        win_stop(ctx, a)
    ctx.run(["rm", "-rf", "--", d, win_runtime(a.prefix)])
    win_mark(ctx, a.prefix, False)
    if not ctx.dry:
        win_sync_all(ctx)
    return 0


def win_list(ctx, a):
    ps = prefixes()
    if a.json:
        print(json.dumps(ps))
    else:
        for p in ps:
            print(p)
        if not ps:
            print("no Wine prefixes; `silik win open FILE.exe` makes the prefix \"%s\", `silik win create NAME` another" % WIN_DEFAULT)
    return 0


# -- installed Windows programs as applications of the desktop
def desktop_read(path):
    """the [Desktop Entry] group of a desktop file: key -> value as written"""
    e, on = {}, False
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for l in f:
                l = l.strip()
                if l.startswith("["):
                    on = l == "[Desktop Entry]"
                elif on and "=" in l and not l.startswith("#"):
                    k, v = l.split("=", 1)
                    e[k.strip()] = v.strip()
    except OSError:
        pass
    return e


def exec_args(line):
    """the arguments of an Exec= value (the string escapes, then the quoting rules), without its field codes"""
    s, i, out = line, 0, []
    while i < len(s):                       # string escapes: \s \n \t \r \\
        if s[i] == "\\" and i + 1 < len(s):
            out.append({"s": " ", "n": "\n", "t": "\t", "r": "\r", "\\": "\\"}.get(s[i + 1], "\\" + s[i + 1]))
            i += 1
        else:
            out.append(s[i])
        i += 1
    s, i, args, cur, quoted, some = "".join(out), 0, [], [], False, False
    while i < len(s):
        c = s[i]
        if quoted:
            if c == "\\" and i + 1 < len(s) and s[i + 1] in '"`$\\':
                cur.append(s[i + 1])
                i += 1
            elif c == '"':
                quoted = False
            else:
                cur.append(c)
        elif c == '"':
            quoted = some = True
        elif c == "\\" and i + 1 < len(s):      # Wine writes "\ " for a space outside quotes
            cur.append(s[i + 1])
            some = True
            i += 1
        elif c in " \t\n":
            if cur or some:
                args.append("".join(cur))
            cur, some = [], False
        else:
            cur.append(c)
        i += 1
    if cur or some:
        args.append("".join(cur))
    return [p.replace("%%", "%") for p in args if not (len(p) == 2 and p[0] == "%" and p[1] != "%")]


def exec_line(argv):
    """an Exec= value for these arguments (Desktop Entry Specification: quoting, then the string escapes)"""
    out = []
    for a in argv:
        if any(ord(c) < 0x20 or ord(c) == 0x7f for c in a):
            # (a line break would end the value: the rest would be a key of its own, e.g. a second Exec=)
            raise ValueError("a control character in a command-line argument: %r" % a)
        if a and all(c.isalnum() or c in "-_./:=@,+" for c in a):
            out.append(a)
        else:
            out.append('"' + "".join("\\" + c if c in '"`$\\' else c for c in a) + '"')
    return " ".join(out).replace("%", "%%").replace("\\", "\\\\")


def win_slug(s):
    out = "".join(c.lower() if c.isalnum() else "-" for c in s)
    while "--" in out:
        out = out.replace("--", "-")
    return out.strip("-") or "program"


def win_apps_dir():
    return os.path.join(data_home(), "applications", "silik-win")


def win_icons(top, name):
    """the files of icon `name` in the hicolor theme under data folder `top`: [(size folder, file name)]"""
    out, hi = [], os.path.join(top, "icons", "hicolor")
    try:
        sizes = sorted(os.listdir(hi))
    except OSError:
        return out
    for sz in sizes:
        apps = os.path.join(hi, sz, "apps")
        try:
            # plain files in plain folders only: these come from inside a prefix, and are copied out of it
            if not os.path.islink(os.path.join(hi, sz)) and not os.path.islink(apps):
                out += [(sz, fn) for fn in sorted(os.listdir(apps))
                        if os.path.splitext(fn)[0] == name and stat.S_ISREG(os.lstat(os.path.join(apps, fn)).st_mode)]
        except OSError:
            pass
    return out


def win_adopt(dry):
    """entries Wine wrote straight into the user's applications (a program run without the sandbox, or Wine used by
    hand on one of our prefixes) move to their prefix's own menu; those of a removed prefix go"""
    real = os.path.join(data_home(), "applications", "wine")
    for dp, _dn, fns in os.walk(real, topdown=False):
        for fn in sorted(fns):
            src = os.path.join(dp, fn)
            e = desktop_read(src)
            pfx = [x[11:] for x in exec_args(e.get("Exec", "")) if x.startswith("WINEPREFIX=")]
            if not fn.endswith(".desktop") or not pfx or not _under(pfx[0], WINE_ROOT) or pfx[0] == WINE_ROOT:
                continue
            name = pfx[0][len(WINE_ROOT):].strip("/").split("/")[0]
            if dry:
                continue
            # The prefix's home is the sandbox's, and its programs may still run while this runs: a check of the
            # destination followed by a move by path would follow whatever is there at the moment of the move (a link
            # swapped in after the check, e.g. to ~/.config/autostart; audit 12/11/2026). So every folder on the way is
            # opened relative to the one before it and never through a link (O_NOFOLLOW), and the file is renamed
            # between the two open folders: a link, or a folder swapped for one, stops it, and the entry is then
            # removed instead. (A folder moved elsewhere inside the prefix while it is open still is the prefix's.)
            share = [name, "home", ".local", "share"]
            for sz, icon in win_icons(data_home(), e.get("Icon", "\0")):
                isrc = os.path.join(data_home(), "icons", "hicolor", sz, "apps", icon)
                if not _move_into(isrc, WINE_ROOT, share + ["icons", "hicolor", sz, "apps"]):
                    _unlink(isrc)
            rel = os.path.relpath(dp, real)
            sub = [] if rel == "." else rel.split(os.sep)
            if not _move_into(src, WINE_ROOT, share + ["applications", "wine"] + sub):
                _unlink(src)
        if not dry:
            try:
                os.rmdir(dp)        # only when it is empty now
            except OSError:
                pass


def _unlink(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def _open_below(top, parts, create=True):
    """a descriptor of the folder TOP/PARTS..., each part opened relative to the folder before it, never through a
    symbolic link (O_NOFOLLOW), made when missing (create); None when a part is a link, not a folder, or not a plain
    name. TOP itself is the user's own (not the sandbox's) and is opened as it is"""
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
    try:
        fd = os.open(top, flags)
    except OSError:
        return None
    for part in parts:
        if part in ("", ".", "..") or "/" in part or "\0" in part:
            os.close(fd)
            return None
        try:
            nfd = os.open(part, flags | os.O_NOFOLLOW, dir_fd=fd)
        except FileNotFoundError:
            nfd = None
            if create:
                try:
                    os.mkdir(part, 0o777, dir_fd=fd)
                except FileExistsError:
                    pass
                except OSError:
                    os.close(fd)
                    return None
                try:
                    nfd = os.open(part, flags | os.O_NOFOLLOW, dir_fd=fd)
                except OSError:
                    nfd = None
        except OSError:             # a link (ELOOP), not a folder (ENOTDIR)
            nfd = None
        os.close(fd)
        if nfd is None:
            return None
        fd = nfd
    return fd


def _move_into(src, top, parts):
    """moves the file SRC (in the user's own folders) into TOP/PARTS... (below TOP: the sandbox may write there) under
    its own name, without following a link on the way or at the end: True when it was moved"""
    fn = os.path.basename(src)
    if fn in ("", ".", ".."):
        return False
    dfd = _open_below(top, parts)
    if dfd is None:
        return False
    try:
        sfd = os.open(os.path.dirname(src), os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    except OSError:
        os.close(dfd)
        return False
    try:
        try:
            # rename() replaces a link or file at the destination itself, never what a link names; a folder there fails
            os.rename(fn, fn, src_dir_fd=sfd, dst_dir_fd=dfd)
            return True
        except OSError as err:
            if err.errno != errno.EXDEV:
                return False
        # another file system: a copy written under a new name in the open folder, then renamed over the name
        tmp = ".silik-adopt-%d" % os.getpid()
        try:
            out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644, dir_fd=dfd)
        except OSError:
            return False
        try:
            with open(src, "rb") as f, os.fdopen(out, "wb") as o:
                shutil.copyfileobj(f, o)
            os.rename(tmp, fn, src_dir_fd=dfd, dst_dir_fd=dfd)
        except OSError:
            try:
                os.unlink(tmp, dir_fd=dfd)
            except OSError:
                pass
            return False
        os.unlink(src)
        return True
    finally:
        os.close(sfd)
        os.close(dfd)


def win_menu(name):
    """the start-menu entries Wine's winemenubuilder wrote for prefix `name` -> [(slug, entry, icon files)]"""
    d = prefix_dir(name)
    top = os.path.join(d, "home", ".local", "share")
    out, used, marked = [], set(), win_marked()
    for dp, dn, fns in os.walk(os.path.join(top, "applications", "wine")):
        dn.sort()
        for fn in sorted(fns):
            e = desktop_read(os.path.join(dp, fn))
            argv = exec_args(e.get("Exec", ""))
            w = [i for i, x in enumerate(argv) if os.path.basename(x) in ("wine", "wine64", "wine-stable")]
            run = argv[w[0] + 1:] if w else []
            if not fn.endswith(".desktop") or not run:
                continue
            if run[0][1:3] in (":\\", ":/") and win_unix(d, run[0]) is None:      # the shortcut is gone: uninstalled
                continue
            # a shortcut runs a program of the prefix (C:\...); one that names a file of this system (written from
            # inside the sandbox, where that folder is writable) would make `silik win run` show its folder to the
            # sandbox: such an entry is not offered
            if run[0].startswith(("/", "~")) or "/" in run[0].split(":", 1)[0]:
                continue
            # an argument with a control character (an escaped line break, written from inside the sandbox) would
            # give the entry a second Exec= of the program's choosing, run outside the sandbox: not offered
            if any(ord(c) < 0x20 or ord(c) == 0x7f for x in run for c in x):
                continue
            slug = base = win_slug(e.get("Name") or fn[:-8])
            n = 2
            while slug in used:
                slug, n = "%s-%d" % (base, n), n + 1
            used.add(slug)
            icons = win_icons(top, e.get("Icon", "\0"))
            # (the icons are the prefix's own: a folder on the way that is a link out of the prefix would make this
            # command copy a file of the home into the icon theme)
            if icons and not _under(os.path.realpath(os.path.join(top, "icons", "hicolor")), os.path.realpath(d)):
                icons = []
            # a program chooses its own name and icon; an isolated one must not pass for another application of
            # this desktop (seen: an entry named Firefox with its icon), so its name says what it is
            tag = {"": " (isolated)", "[ca]": " (aïllat)", "[es]": " (aislado)"} if name in marked else {"": ""}
            new = {"Type": "Application", "Name": (e.get("Name") or fn[:-8]) + tag[""],
                   "Exec": exec_line(["silik", "win", "run", name, "--"] + run),
                   "Icon": "silik-win-%s-%s" % (name, e["Icon"]) if icons else WIN_ICON,
                   "X-SilikOS-Prefix": name}
            for lang in sorted(tag)[1:]:
                new["Name" + lang] = (e.get("Name") or fn[:-8]) + tag[lang]
            for k in ("Comment", "Path", "StartupNotify", "StartupWMClass", "Categories"):
                # a window class that is not a Windows program's would let the entry claim another application's windows
                if e.get(k) and (k != "StartupWMClass" or e[k].lower().endswith(".exe")):
                    new[k] = e[k]
            out.append((slug, new, [(sz, icon, os.path.join(top, "icons", "hicolor", sz, "apps", icon)) for sz, icon in icons]))
    return out


def win_sync_all(ctx, say=False):
    """the applications list follows the prefixes: an entry per installed Windows program (Wine's own start-menu
    entries, with `silik win run PREFIX -- ...` as their command), none for what was uninstalled or removed"""
    dry, apps = ctx.dry, win_apps_dir()
    win_adopt(dry)
    want, icons = {}, {}
    for name in prefixes():
        for slug, e, ics in win_menu(name):
            text = "[Desktop Entry]\n" + "".join("%s=%s\n" % (k, e[k]) for k in e)
            want[os.path.join(apps, name, slug + ".desktop")] = (text, "win/%s  %s  (%s)" % (slug, e["Name"], name))
            for sz, icon, src in ics:
                icons[os.path.join(data_home(), "icons", "hicolor", sz, "apps", "silik-win-%s-%s" % (name, icon))] = src
    have = [os.path.join(dp, fn) for dp, _dn, fns in os.walk(apps) for fn in fns]
    hi = os.path.join(data_home(), "icons", "hicolor")
    have_icons = [os.path.join(dp, fn) for dp, _dn, fns in os.walk(hi) for fn in fns if fn.startswith("silik-win-")]
    changed = 0
    for path in sorted(want):
        text, line = want[path]
        if read(path, None) != text:
            print("%s %s" % ("+" if path not in have else "~", line))
            changed += 1
            if not dry:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "w", encoding="utf-8") as f:
                    f.write(text)
    for path in sorted(have):
        if path not in want:
            print("- win/%s  (%s)" % (os.path.basename(path)[:-8], os.path.basename(os.path.dirname(path))))
            changed += 1
            if not dry:
                os.unlink(path)
    if not dry:
        for dst, src in icons.items():
            try:
                if not os.path.exists(dst) or os.path.getsize(dst) != os.path.getsize(src) or os.path.getmtime(dst) < os.path.getmtime(src):
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    # (not through a link put there after the look: the file comes from inside a prefix)
                    with os.fdopen(os.open(src, os.O_RDONLY | os.O_NOFOLLOW), "rb") as fi, open(dst, "wb") as fo:
                        shutil.copyfileobj(fi, fo)
                    changed += 1
            except OSError:
                pass
        for path in have_icons:
            if path not in icons:
                os.unlink(path)
                changed += 1
        for dp, _dn, _fns in os.walk(apps, topdown=False):
            try:
                os.rmdir(dp)        # the folder of a prefix without programs
            except OSError:
                pass
        if changed and os.path.isdir(hi):
            os.utime(hi)            # icon themes are read again when their folder changes
    if say and not changed:
        print("the applications list is up to date: %d Windows program%s" % (len(want), "" if len(want) == 1 else "s"))
    return changed


def win_sync(ctx, a):
    win_sync_all(ctx, say=True)
    return 0


def win_programs():
    """the Windows programs in the applications list (what `silik win sync` wrote)"""
    out, apps = [], win_apps_dir()
    taken = set(prefixes()) | {"vm"}
    try:
        names = sorted(os.listdir(apps))
    except OSError:
        names = []
    for name in names:
        try:
            fns = sorted(os.listdir(os.path.join(apps, name)))
        except OSError:
            continue
        for fn in fns:
            e = desktop_read(os.path.join(apps, name, fn))
            argv = exec_args(e.get("Exec", ""))
            if not fn.endswith(".desktop") or "--" not in argv:
                continue
            slug = fn[:-8]
            address = slug if slug not in taken else "%s-%s" % (slug, name)
            taken.add(address)
            out.append({"address": "win/" + address, "name": e.get("Name", slug), "prefix": name, "run": argv[argv.index("--") + 1:],
                        "id": "silik-win-%s-%s" % (name, fn), "wmclass": e.get("StartupWMClass", ""), "icon": e.get("Icon", ""),
                        "file": os.path.join(apps, name, fn)})
    return out


def win_apps(ctx, a):
    ps = win_programs()
    if a.json:
        print(json.dumps(ps, indent=1))
    else:
        for p in ps:
            print("%-28s %-12s %s" % (p["address"], p["prefix"], p["name"]))
        if not ps:
            print("no installed Windows programs; an installer opened with `silik win open SETUP.exe` adds its own")
    return 0


# ------------------------------------------------------------------ win routes
# How a Windows program built for x86 can run on this machine, by what is seen here (nothing is run or changed).
# On ARM (docs/ARM.md): Windows 11 for ARM in a virtual machine runs x86 and x64 programs through Windows' own
# emulation (user programs; a kernel driver must be an ARM64 one); a Wine for ARM with an x86 emulator (FEX-Emu,
# box64: Hangover) is in neither EL 9 nor EPEL 9, and Wine's ARM64 support needs 4K pages (Wine 10.0's release
# notes): EL 9's default aarch64 kernel has them, kernel-64k does not.
def page_size():
    try:
        return os.sysconf("SC_PAGE_SIZE")
    except (ValueError, OSError):
        return 0


def win_routes_list():
    """[{id, state: ready | missing | no | unknown, name, detail, how}], the most useful first"""
    arch, kvm, virt = host_arch(), os.path.exists(KVM_DEV), shutil.which("virt-install") is not None
    wine = shutil.which("wine") is not None
    out = []

    def route(i, state, name, detail, how=""):
        out.append({"id": i, "state": state, "name": name, "detail": detail, "how": how})

    def vm(name, note):
        if not kvm:
            route("vm", "no", name, "no KVM here (%s is missing): virtualisation is off in the firmware's setup, or this system is "
                  "itself a virtual machine without nested virtualisation; %s" % (KVM_DEV, note))
        elif not virt:
            route("vm", "missing", name, "KVM is here; virt-install is not installed; " + note, "sudo dnf install silik-win virt-install")
        else:
            route("vm", "ready", name, "KVM and virt-install are here; " + note, "silik win vm create --iso ISO")

    if arch == "x86_64":
        if wine:
            route("wine", "ready", "Wine, in the sandbox", "the program runs directly on this processor", "silik win open FILE.exe")
        else:
            route("wine", "missing", "Wine, in the sandbox", "the package silik-wine is not installed", "sudo dnf install silik-wine")
        vm("a Windows virtual machine", "for the programs Wine does not run")
        return out
    vm("a Windows 11 for ARM virtual machine",
       "Windows runs x86 and x64 programs through its own emulation (a kernel driver must be an ARM64 one)")
    page = page_size()
    pages = ("this kernel's pages are %d bytes, the size Wine on ARM needs" % page if page == 4096 else
             "Wine on ARM needs 4K pages and this kernel's are %d bytes (EL 9's default kernel has 4K pages; kernel-64k does not)" % page)
    if wine:
        route("wine", "ready" if page == 4096 else "no", "Wine for ARM with an x86 emulator",
              "a `wine` is on this system (not SilikOS's: silik-wine is x86_64 only); %s" % pages, "silik win open FILE.exe")
    else:
        route("wine", "no", "Wine for ARM with an x86 emulator (FEX-Emu, box64: Hangover)",
              "not packaged: EL 9 and EPEL 9 have no Wine, FEX-Emu, box64 or Hangover for %s, and silik-wine is x86_64 only; %s" % (arch, pages))
    emu = os.path.exists(BINFMT_X86)
    route("emulator", "ready" if emu else "missing", "x86_64 Linux programs under emulation (binfmt_misc)",
          ("registered (%s)" % BINFMT_X86 if emu else "no x86_64 emulator is registered: " + BINFMT_HOW) +
          "; for the x86_64 boxes of the EDA tools, slow; not a way to run Windows programs", "silik eda create NAME --arch amd64")
    # (Hyper-V's guests have its VMBus: /sys/bus/vmbus [A: not seen on an ARM guest here])
    hv = os.path.isdir(HYPERV_BUS)
    route("windows", "ready" if hv else "unknown", "Windows itself, on a Windows on ARM computer",
          "this system is a guest of Hyper-V (%s): the Windows that hosts it runs the program, through its own emulation" % HYPERV_BUS if hv else
          "where SilikOS is a virtual machine of a Windows on ARM computer, that Windows runs the program; nothing here says "
          "this is one (no %s)" % HYPERV_BUS)
    return out


def win_route_here():
    """the one route for a Windows program on this ARM machine, in words (`silik win open` without a Wine)"""
    r = dict((x["id"], x) for x in win_routes_list())
    if r.get("wine", {}).get("state") == "ready":
        return "the `wine` of this system"
    vm = r["vm"]
    if vm["state"] == "ready":
        return ("a Windows 11 for ARM virtual machine (`silik win vm create --iso ISO`), where Windows runs x86 programs "
                "through its own emulation")
    if vm["state"] == "missing":
        return "a Windows 11 for ARM virtual machine, once virt-install is installed (`%s`)" % vm["how"]
    return ("nothing on this machine: it has no KVM (%s), so no Windows virtual machine either. On a Windows on ARM computer "
            "run the program in Windows itself" % KVM_DEV)


def win_routes(ctx, a):
    rs = win_routes_list()
    if a.json:
        print(json.dumps({"arch": host_arch(), "page_size": page_size(), "routes": rs}, indent=1))
        return 0
    print("arch %s, pages of %d bytes" % (host_arch(), page_size()))
    for r in rs:
        print("%-9s %-8s %s: %s%s" % (r["id"], r["state"], r["name"], r["detail"], "  <- " + r["how"] if r["how"] else ""))
    return 0


def vm_create(ctx, a):
    if not os.path.isfile(a.iso) and not ctx.dry:
        die("no such ISO: " + a.iso)
    if not valid_name(a.name):
        die("VM name: letters, digits, - _ .", 2)
    if a.drivers and not os.path.isfile(a.drivers) and not ctx.dry:
        die("no such ISO: " + a.drivers)
    if not os.path.exists("/dev/kvm") and not ctx.dry:
        die("no KVM on this machine (/dev/kvm is missing): virtualisation is off in the firmware's setup, or this system "
            "is itself a virtual machine without nested virtualisation (SilikOS in Hyper-V on a Windows on ARM laptop: "
            "there, Windows is the host and runs its programs itself)")
    argv = ["virt-install", "--connect", "qemu:///session", "--name", a.name, "--memory", str(a.ram * 1024), "--vcpus", str(a.cpus),
            "--cpu", "host-passthrough"]
    # EL 9's qemu-kvm has no SPICE and no QXL (`qemu-kvm -spice` is an invalid option there; no QXL device), and no
    # NVMe device: the screen is VNC (virt-viewer shows it), until Remote Desktop is on
    if x86():
        argv += ["--machine", "q35", "--boot", "uefi", "--tpm", "backend.type=emulator,backend.version=2.0,model=tpm-crb",
                 "--disk", "size=%d,format=qcow2,bus=sata" % a.disk, "--cdrom", a.iso, "--os-variant", a.os_variant,
                 "--network", "passt,model=e1000e,portForward=127.0.0.1:3389:3389", "--graphics", "vnc", "--video", "vga", "--sound", "ich9"]
        if a.drivers:
            argv += ["--disk", "path=%s,device=cdrom,bus=sata,readonly=on" % a.drivers]
    else:
        # Windows 11 for ARM on the `virt` machine with AAVMF (UEFI: edk2-aarch64) and a TPM 2.0 of libvirt's default
        # model for the architecture. Windows Setup installs to no USB disk and has no driver for virtio: the disk and
        # the network are virtio, with the ARM64 drivers of virtio-win (--drivers ISO, "Load driver" in Setup); the
        # installation disc is USB (it boots first), the screen a RAM framebuffer (UEFI's, which Windows keeps)
        argv += ["--machine", "virt", "--boot", "uefi", "--tpm", "backend.type=emulator,backend.version=2.0",
                 "--disk", "path=%s,device=cdrom,bus=usb,readonly=on,boot.order=1" % a.iso,
                 "--disk", "size=%d,format=qcow2,bus=virtio,boot.order=2" % a.disk]
        if a.drivers:
            argv += ["--disk", "path=%s,device=cdrom,bus=usb,readonly=on" % a.drivers]
        argv += ["--import", "--os-variant", a.os_variant, "--network", "passt,model=virtio,portForward=127.0.0.1:3389:3389",
                 "--graphics", "vnc", "--video", "ramfb", "--sound", "none"]
    ctx.run(argv + ["--noautoconsole"])
    if not x86() and not a.drivers:
        print("silik: Windows Setup for ARM sees the virtio disk only with virtio-win's ARM64 drivers: give their ISO "
              "with --drivers (or load them from another medium in Setup)", file=sys.stderr)
    print("install Windows in the window that `virt-viewer --connect qemu:///session %s` opens; then enable Remote Desktop in it" % a.name)
    return 0


def vm_start(ctx, a):
    ctx.run(["virsh", "--connect", "qemu:///session", "start", a.name], check=False)
    return 0


def vm_stop(ctx, a):
    ctx.run(["virsh", "--connect", "qemu:///session", "shutdown", a.name], check=False)
    return 0


# A USB device for the Windows VM: hardware whose driver exists only for Windows (Vector's VN1600 family: the Vector
# Driver Package, then CANoe / CANalyzer under the user's licence, all inside the VM) goes to the VM whole, through
# libvirt (qemu:///session). The user's VM opens the device node, so it must be the user's: Vector's devices are by
# 70-silikos-usb-vm.rules (silik-dev); for another, the message says so.
def usb_devices(ctx):
    """[(vid:pid, bus, dev, name)] from lsusb"""
    out = []
    for l in ctx.query(["lsusb"]).splitlines():
        m = re.match(r"^Bus (\d+) Device (\d+): ID ([0-9a-f]{4}:[0-9a-f]{4}) ?(.*)$", l.strip())
        if m:
            out.append((m.group(3), m.group(1), m.group(2), m.group(4)))
    return out


def vm_usb(ctx, a):
    devs = usb_devices(ctx)
    if not a.action:
        for vp, bus, dev, name in devs:
            print("%s  %s%s" % (vp, name or "-", "   (Vector: for the VM)" if vp.startswith("1248:") else ""))
        if not devs:
            print("no USB devices seen (lsusb: the package usbutils)")
        return 0 if devs else 1
    if not re.match(r"^[0-9a-f]{4}:[0-9a-f]{4}$", a.id or ""):
        die("silik win vm usb %s VID:PID [--name N] (the ID that `silik win vm usb` lists, e.g. 1248:1060)" % a.action, 2)
    vid, pid = a.id.split(":")
    if a.action == "attach" and not ctx.dry:
        hit = [d for d in devs if d[0] == a.id]
        if not hit:
            die("no USB device %s is plugged in (`silik win vm usb` lists them)" % a.id)
        node = "/dev/bus/usb/%s/%s" % (hit[0][1], hit[0][2])
        if not os.access(node, os.R_OK | os.W_OK):
            die("%s (%s) is not yours: the VM runs as you and cannot open it. A udev rule with TAG+=\"uaccess\" for "
                "ATTR{idVendor}==\"%s\" gives it to the user at the screen (Vector's devices have one: silik-dev)" % (node, a.id, vid))
    xml = ("<hostdev mode='subsystem' type='usb' managed='yes'><source><vendor id='0x%s'/><product id='0x%s'/></source></hostdev>\n"
           % (vid, pid))
    import tempfile
    f = os.path.join(tempfile.mkdtemp(prefix="silik-usb-"), "dev.xml") if not ctx.dry else "/tmp/silik-usb-%s.xml" % a.id.replace(":", "-")
    if not ctx.dry:
        with open(f, "w") as h:
            h.write(xml)
    rc, _ = ctx.run(["virsh", "--connect", "qemu:///session", "attach-device" if a.action == "attach" else "detach-device",
                     a.name, f, "--live"], check=False)
    if not ctx.dry:
        shutil.rmtree(os.path.dirname(f), ignore_errors=True)
    if rc == 0 and a.action == "attach" and not ctx.dry:
        print("%s is the VM's now (Windows sees it plugged in); `silik win vm usb detach %s` gives it back" % (a.id, a.id))
    return rc


def vm_app(ctx, a):
    """one Windows program of the VM as a window of this desktop (RDP RemoteApp). The VM sees one folder of this
    system, the shared one (~/Windows, drive W: of the Wine prefixes too), never the whole home folder: a program in
    the VM could otherwise write ~/.bashrc or an autostart entry and run on this system"""
    argv = ["xfreerdp", "/v:" + a.host, "/u:" + a.user, "/cert:tofu", "/dynamic-resolution", "+clipboard",
            "/drive:Windows," + win_shared(), "/app:" + a.exe]
    ctx.run(argv, check=False)
    return 0


# ------------------------------------------------------------------ hw
def cpu_name(ctx):
    """the processor's name: /proc/cpuinfo's "model name" (x86_64); an ARM kernel has none there, lscpu names it from
    the processor's implementer and part numbers ("Vendor ID", "Model name"); else the architecture"""
    cpu = [l.split(":", 1)[1].strip() for l in read("/proc/cpuinfo").splitlines() if l.startswith("model name")]
    if cpu:
        return cpu[0]
    f = dict((k.strip(), v.strip()) for k, _, v in (l.partition(":") for l in ctx.query(["lscpu"]).splitlines()))
    name = " ".join(x for x in (f.get("Vendor ID", ""), f.get("Model name", "")) if x and x != "-")
    return name or host_arch()


def hw_probe(ctx, a):
    info = {"cpu": cpu_name(ctx), "cores": os.cpu_count(), "arch": host_arch(), "gpus": gpus(ctx),
            "nvidia_driver": read("/proc/driver/nvidia/version").splitlines()[0] if os.path.exists("/proc/driver/nvidia/version") else "",
            "kvm": os.path.exists("/dev/kvm")}
    if a.json:
        print(json.dumps(info, indent=1))
    else:
        for k in ("cpu", "cores", "arch", "kvm", "nvidia_driver"):
            print("%-14s %s" % (k, info[k] if info[k] != "" else "-"))
        for g in info["gpus"] or ["-"]:
            print("%-14s %s" % ("gpu", g))
    return 0


NVIDIA_REPO = "https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo"


def hw_nvidia(ctx, a):
    if a.action == "status":
        v = read("/proc/driver/nvidia/version")
        print(v.strip() or "the NVIDIA kernel module is not loaded")
        return 0 if v else 1
    if getattr(a, "source", "nvidia") == "almalinux":
        # AlmaLinux's own packages (wiki.almalinux.org/documentation/nvidia.html): NVIDIA's open kernel modules built
        # by AlmaLinux for the base's kernel (no compiler, no DKMS) and signed with a key whose certificate is in its
        # kernel, so Secure Boot needs no key enrolled; x86_64 and aarch64. docs/DRIVERS.md has what was read.
        ctx.run(["sudo", "dnf", "-y", "install", "almalinux-release-nvidia-driver"])
        ctx.run(["sudo", "dnf", "-y", "install", "nvidia-open-kmod", "nvidia-driver"])
        print("restart. These are NVIDIA's open modules: GeForce GTX 16xx / RTX 20xx (Turing) and newer cards; an older card\n"
              "needs the other source (silik hw nvidia install). nvidia-smi and CUDA: sudo dnf -y install nvidia-driver-cuda")
        return 0
    if not x86():
        # (NVIDIA has an EL 9 repository for ARM servers with its cards, "sbsa": not set up or tried by silik; a
        # Snapdragon laptop, or a virtual machine on one, has no NVIDIA graphics)
        die("the NVIDIA driver set up here is NVIDIA's EL 9 repository for x86_64; this machine is %s" % host_arch(), 2)
    # NVIDIA's own EL9 repository, DKMS flavour: the module is rebuilt for each kernel of the base system
    # (the headers of the running kernel: the newest kernel-devel may be of a kernel not booted yet)
    # (the headers of the running kernel, and of the newest installed one: an automatic update may have put a kernel
    # in place that boots next, and DKMS builds the module for each kernel whose headers are there)
    ctx.run(["sudo", "dnf", "-y", "install", "epel-release", "kernel-devel-" + os.uname().release, "kernel-devel", "kernel-headers", "dkms"])
    ctx.run(["sudo", "dnf", "config-manager", "--add-repo", NVIDIA_REPO])
    ctx.run(["sudo", "dnf", "-y", "module", "install", "nvidia-driver:latest-dkms"])
    print("reboot; with Secure Boot on, enrol the DKMS key first (mokutil --import /var/lib/dkms/mok.pub)")
    return 0


IDENTITY = "/usr/libexec/silikos/identity"


def cmd_identity(ctx, a):
    """the names the system shows: SilikOS (default) or the base's own os-release, for an installer that insists on it"""
    if a.which == "show":
        osr = os_release()
        print("%-14s %s" % ("shown as", osr.get("PRETTY_NAME", "-")))
        print("%-14s %s %s (ID_LIKE %s)" % ("read as", osr.get("ID", "-"), osr.get("VERSION_ID", "-"), osr.get("ID_LIKE", "-")))
        print("%-14s %s" % ("release file", read("/etc/redhat-release").strip() or "-"))
        print("%-14s %s" % ("os-release", "the base's own file" if os.path.islink("/etc/os-release") else "SilikOS display names over the base's"))
        return 0
    ctx.run(["sudo", IDENTITY, a.which])
    return 0


UPDATE_AUTO = (("all", "every update, daily (silikos-update.timer)"),
               ("security", "security advisories only, daily (silikos-security-update.timer)"),
               ("off", "none: `silik update` by hand"))


def update_auto_now(ctx):
    """which automatic updates are on: all, security, off; '' when systemd cannot say"""
    st = {}
    for unit in (SEC_FULL_TIMER, SEC_TIMER):
        st[unit] = ctx.query(["systemctl", "is-enabled", unit], any_rc=True).strip()     # ("disabled" exits 1)
    if not any(st.values()):
        return ""
    return "all" if st[SEC_FULL_TIMER] == "enabled" else "security" if st[SEC_TIMER] == "enabled" else "off"


# SilikOS's own packages (silik, the desktop, Wine, the open EDA and embedded tools) come from a repository of their
# own, the file REPO_FILE of the package silikos-repos: two channels, both off until one is chosen here. A channel is
# turned on only when this system has the key its packages and metadata are signed with (REPO_KEY, in the same
# package once the owner has made the key): nothing unsigned is ever trusted. The base's repository files and
# /etc/dnf/dnf.conf are not touched.
REPO_FILE = "/etc/yum.repos.d/silikos.repo"
REPO_KEY = "/etc/pki/rpm-gpg/RPM-GPG-KEY-SilikOS"
CHANNELS = (("stable", "silikos", "what a release of SilikOS published"),
            ("next", "silikos-next", "every build of main that passed the tests"),
            ("off", "", "none: SilikOS's own packages stay at the version they were installed with"))
REPO_CHECKS = ("gpgcheck", "repo_gpgcheck")       # the package's signature, the metadata's
# Old metadata served again (docs/SIGNING.md): the dnf plugin silikos-repo of the package silikos-repos remembers in
# REPO_SEEN the highest revision of each channel's metadata this system has seen and takes nothing from older ones,
# inside every dnf (this command's and the daily update's). Here its notes are read and said; nothing is judged twice.
REPO_SEEN = "/var/lib/silikos/repo-revision"
REPO_QUIET_DAYS = 45        # [PROPOSAL] as the plugin's warn_days: a channel that is on and was not reached for this long is said
REPO_PLUGIN = "/usr/lib/python3.9/site-packages/dnf-plugins/silikos_repo.py"


def repo_seen():
    """the plugin's notes: {repository id: {"revision": the highest seen, "seen": when, "said": its last refusal or
    warning, absent after a good run}}; {} when there is no file or it is not that"""
    try:
        data = json.loads(read(REPO_SEEN, "") or "{}")
    except ValueError:
        return {}
    if not isinstance(data, dict):
        return {}
    return dict((k, v) for k, v in data.items() if isinstance(v, dict) and isinstance(v.get("revision", 0), int))


def repo_quiet(st, now=None, days=REPO_QUIET_DAYS):
    """[(channel, when it last gave metadata that were taken)] of the channels that are on and were last reached more
    than DAYS ago. A repository that does not answer (or is blocked on the way) is left out by dnf with one line
    and no error: this is where that is noticed. A channel never reached yet is not in it"""
    now = time.time() if now is None else now
    ids = dict((name, rid) for name, rid, _ in CHANNELS)
    out = []
    for name in st["on"]:
        seen = ((st.get("seen") or {}).get(ids[name]) or {}).get("seen")
        if isinstance(seen, int) and seen > 0 and now - seen > days * 86400:
            out.append((name, seen))
    return out


def repo_said(st, since=0):
    """[(channel, verdict, text)] of what the plugin refused or warned about for the channels that are on, noted at
    or after SINCE"""
    out = []
    ids = dict((name, rid) for name, rid, _ in CHANNELS)
    for name in st["on"]:
        said = ((st.get("seen") or {}).get(ids[name]) or {}).get("said")
        if isinstance(said, dict) and said.get("verdict") in ("refuse", "warn") and said.get("when", 0) >= since:
            out.append((name, said["verdict"], str(said.get("text", ""))[:400]))
    return out


def channel_read():
    """the SilikOS repository as this system has it: {"file": is there a repository file, "key": ok | missing |
    placeholder (a file that is not a key), "on": [the channels that are on], "unchecked": [those of them with a
    signature check off], "new": a newer file of the package waits (.rpmnew), "plugin": the replay check is
    installed, "seen": its notes (repo_seen)}"""
    text = read(REPO_FILE, None)
    key = read(REPO_KEY, None)
    st = {"file": text is not None, "key": "missing" if key is None else "ok" if "-----BEGIN PGP PUBLIC KEY BLOCK-----" in key else "placeholder",
          "on": [], "unchecked": [], "new": os.path.exists(REPO_FILE + ".rpmnew"),
          "plugin": os.path.exists(REPO_PLUGIN), "seen": repo_seen()}
    sect, opts = "", {}
    for l in (text or "").splitlines():
        l = l.strip()
        if l.startswith("[") and l.endswith("]"):
            sect = l[1:-1].strip()
            opts[sect] = {}
        elif sect and "=" in l and not l.startswith(("#", ";")):
            k, _, v = l.partition("=")
            opts[sect][k.strip()] = v.strip()
    yes = ("1", "true", "yes", "on")
    for name, rid, _ in CHANNELS:
        o = opts.get(rid)
        if not rid or o is None or o.get("enabled", "1").lower() not in yes:
            continue
        st["on"].append(name)
        if any(o.get(k, "0").lower() not in yes for k in REPO_CHECKS):
            st["unchecked"].append(name)
    return st


def channel_key_words(st):
    return {"ok": "installed", "missing": "not on this system: the repository is not published signed yet, the channels stay off",
            "placeholder": "that file is not a key: the channels stay off"}[st["key"]]


def update_channel(ctx, want):
    st = channel_read()
    if want is None:
        for name, rid, what in CHANNELS:
            on = name in st["on"] if rid else not st["on"]
            print("%s %-8s %s" % ("●" if on else " ", name, what))
        print("  %-8s %s: %s" % ("key", REPO_KEY, channel_key_words(st)))
        if not st["file"]:
            print("silik: no %s: the package silikos-repos is not installed" % REPO_FILE)
        for name in st["unchecked"]:
            print("silik: the channel %s is on with a signature check off: silik update channel %s turns both on again" % (name, name))
        ids = dict((name, rid) for name, rid, _ in CHANNELS)
        for name in st["on"]:
            row = st["seen"].get(ids[name]) or {}
            if row.get("revision"):
                print("  %-8s %s: the newest metadata seen are of %s (revision %d); older ones are refused"
                      % ("revision", name, time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime(row["revision"])), row["revision"]))
            else:
                print("  %-8s %s: none seen yet (the first `silik update` notes it in %s)" % ("revision", name, REPO_SEEN))
        if st["on"] and not st["plugin"]:
            print("silik: the check for old metadata served again is not installed (the dnf plugin of the package silikos-repos): sudo dnf -y upgrade silikos-repos")
        for name, verdict, text in repo_said(st):
            print("silik: %s: %s" % ("REFUSED" if verdict == "refuse" else "warning", text))
        return 0
    if not st["file"]:
        die("no %s: sudo dnf install silikos-repos" % REPO_FILE)
    ids = dict((name, rid) for name, rid, _ in CHANNELS)
    if want == "off":
        ctx.run(["sudo", "dnf", "config-manager", "--save"] + ["--setopt=%s.enabled=0" % ids[n] for n in ("stable", "next")])
        return 0
    if st["key"] != "ok":
        die("%s: %s. Nothing unsigned is trusted: the key comes with the package silikos-repos once SilikOS's repository is signed"
            % (REPO_KEY, channel_key_words(st)))
    other = "next" if want == "stable" else "stable"
    if st["new"]:
        # (the package's newer file, kept aside because this one was changed by choosing a channel)
        ctx.run(["sudo", "mv", "-f", REPO_FILE + ".rpmnew", REPO_FILE])
    ctx.run(["sudo", "dnf", "config-manager", "--save", "--setopt=%s.enabled=1" % ids[want], "--setopt=%s.enabled=0" % ids[other]]
            + ["--setopt=%s.%s=1" % (ids[want], k) for k in REPO_CHECKS])
    # the key, for the packages (rpm's keyring) and for the metadata (dnf's, asked once here): the automatic
    # updates then never wait for an answer
    ctx.run(["sudo", "rpm", "--import", REPO_KEY])
    # (asked alone and not skipped when it fails, so that a repository that does not answer, or whose signature is
    # not this key's, is said here; in the updates dnf leaves such a repository out and goes on with the base's)
    rc, _ = ctx.run(["sudo", "dnf", "-y", "--disablerepo=*", "--enablerepo=" + ids[want], "--setopt=%s.skip_if_unavailable=0" % ids[want],
                     "makecache"], check=False)
    if rc != 0:
        print("silik: the channel %s is on, but its repository did not answer or did not verify (above): the updates leave it out until it does" % want)
        return 1
    return 0


def cmd_update(ctx, a):
    if a.what == "channel":
        return update_channel(ctx, a.channel)
    if a.auto == "":
        now = update_auto_now(ctx)
        for k, what in UPDATE_AUTO:
            print("%s %-8s %s" % ("●" if k == now else " ", k, what))
        if os.path.exists("/run/silikos/restart"):
            print("silik: an update waits for a restart of the computer")
        if os.path.exists(SNAP_HOLD):
            print("silik: the automatic updates wait since a rollback: `silik update` updates now (a snapshot first) and they go on")
        return 0 if now else 1
    if a.auto:
        on = {"all": [SEC_FULL_TIMER], "security": [SEC_TIMER], "off": []}[a.auto]
        off = [u for u in (SEC_FULL_TIMER, SEC_TIMER) if u not in on]
        if off:
            ctx.run(["sudo", "systemctl", "disable", "--now"] + off)
        if on:
            ctx.run(["sudo", "systemctl", "enable", "--now"] + on)
            if os.path.exists(SNAP_HOLD):
                ctx.run(["sudo", "rm", "-f", SNAP_HOLD])   # (turned on by hand: the wait after a rollback ends)
        return 0
    if snap_booted()[0] == "snapshot":
        snap_refuse("this system is started from a snapshot: nothing is updated here",
                    ["systemctl reboot   # and the normal entry, then: silik update", "silik rollback   # makes this state the system"])
    # a snapshot of / first, when there is something to update and / is on a thin volume (docs/ROLLBACK.md): the hook
    # of the automatic updates. Without one the update goes on, and the hook says why
    hook = os.path.isfile(SNAP_HOOK) and not a.no_snapshot
    if hook:
        ctx.run(["sudo", SNAP_HOOK], check=False)
    # (ten downloads at a time, as the automatic updates: measured faster here; the base's dnf.conf is not changed)
    t0 = int(time.time())
    ctx.run(["sudo", "dnf", "-y", "--setopt=max_parallel_downloads=10", "upgrade", "--refresh"])
    if hook:
        ctx.run(["sudo", SNAP_HOOK, "settle"], check=False)
    if os.path.exists(SNAP_HOLD):
        ctx.run(["sudo", "rm", "-f", SNAP_HOLD])           # (updated by hand after a rollback: the automatic updates go on)
    if not ctx.dry and shutil.which("needs-restarting"):
        # (dnf-utils: exit 1 when the kernel, glibc, systemd or another core part was updated under the running system)
        if subprocess.run(["needs-restarting", "-r"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 1:
            print("silik: restart the computer to run what was updated (the kernel or a core library)")
        if os.path.isfile("/usr/libexec/silikos/restart-needed"):
            ctx.run(["sudo", "/usr/libexec/silikos/restart-needed"], check=False)     # (the status bar's note)
    st = channel_read()
    if not st["on"]:
        print("silik: SilikOS's own packages were not updated: no repository enabled (silik update channel)")
        return 0
    # what the dnf above was given as SilikOS's repository, as its plugin silikos-repo judged it (docs/SIGNING.md)
    rc = 0
    if not ctx.dry:
        if not st["plugin"]:
            print("silik: old metadata served again would not be noticed: the dnf plugin of the package silikos-repos is not installed")
        said = repo_said(st, t0)
        for name, verdict, text in said:
            if verdict == "refuse":
                print("silik: REFUSED: %s. Nothing of SilikOS's own was updated; the base's updates went on. Run `silik update` "
                      "again on another network; if it stays: docs/SIGNING.md" % text)
                rc = 1
            else:
                print("silik: warning: %s" % text)
        # a repository that did not answer: dnf left it out with a line of its own and no error
        ids = dict((name, rid) for name, rid, _ in CHANNELS)
        for name in st["on"]:
            row = st["seen"].get(ids[name]) or {}
            # (two seconds of slack: the plugin notes the time less the age of dnf's copy, each read at its own moment)
            if st["plugin"] and name not in [x[0] for x in said] and row.get("seen", 0) < t0 - 2:
                last = time.strftime("%Y-%m-%d", time.gmtime(row["seen"])) if row.get("seen") else "never"
                print("silik: SilikOS's repository (channel %s) was not reached in this run (dnf says why above): nothing of "
                      "SilikOS's own was updated. Last reached: %s" % (name, last))
    return rc


# ------------------------------------------------------------------ secure
# `silik secure status` reads the system and judges it; `silik secure apply` sets the SilikOS defaults (the files are
# the package silikos-security's; docs/SECURITY.md says why each one). A judgement is ok / warn / bad / unknown,
# drawn as in SilikStudio: shape and word. A check that cannot see its subject (a tool or a file is absent, as inside
# a container) says unknown, never ok. Three layers: sec_probe() reads, sec_checks() judges what was read,
# sec_plan() lists the commands that tighten it; the last two run nothing, so the tests feed them made-up systems.
# sec_more() / sec_checks_more() are the second half of the audit (the boot chain, the firmware, what listens, the
# kernel's switches). `silik secure level` (further down: lvl_*) reads and sets the hardened level, item by item.
# (glob and xml.etree are imported by the functions that use them: xml.etree was 2.4 ms of every start)

