# ---- network
def repo_hosts(d="/etc/yum.repos.d"):
    """{host: [repository ids]} of the enabled repositories' baseurl, mirrorlist and metalink (hosts written with a
    $variable are left out)"""
    hosts = {}
    try:
        files = sorted(f for f in os.listdir(d) if f.endswith(".repo"))
    except OSError:
        return hosts
    for fn in files:
        sect, conf = None, {}
        for l in read(os.path.join(d, fn)).splitlines() + ["[]"]:
            l = l.strip()
            if l.startswith("["):
                if sect and conf.get("enabled", "1").lower() in ("1", "true", "yes"):
                    for k in ("baseurl", "mirrorlist", "metalink"):
                        for u in conf.get(k, "").replace(",", " ").split():
                            m = re.match(r"^[a-z]+://(?:[^@/]*@)?([A-Za-z0-9.-]+)(?:[:/]|$)", u)
                            if m:
                                hosts.setdefault(m.group(1).lower(), []).append(sect)
                sect, conf = l.strip("[]"), {}
            elif "=" in l and sect:
                k, _, v = l.partition("=")
                conf[k.strip()] = v.strip()
    return hosts


def dnf_proxy(path="/etc/dnf/dnf.conf"):
    sect = ""
    for l in read(path).splitlines():
        l = l.strip()
        if l.startswith("["):
            sect = l
        elif sect == "[main]" and l.replace(" ", "").startswith("proxy="):
            return l.split("=", 1)[1].strip()
    return ""


def default_route():
    """True / False: a default route (IPv4 or IPv6); None when the routing tables are not readable"""
    v4, v6 = read("/proc/net/route", None), read("/proc/net/ipv6_route", None)
    if v4 is None and v6 is None:
        return None
    if any(l.split()[1:2] == ["00000000"] and len(l.split()) > 7 and l.split()[7] == "00000000" for l in (v4 or "").splitlines()[1:]):
        return True
    return any(l.split()[:2] == ["0" * 32, "00"] and l.split()[-1:] != ["lo"] for l in (v6 or "").splitlines())


def doc_probe_network():
    import socket
    hosts = repo_hosts()
    names = sorted(hosts)
    t0 = time.monotonic()
    res = par([lambda h=h: socket.getaddrinfo(h, 443, proto=socket.IPPROTO_TCP) for h in names], timeout=DOC_DNS_WAIT)
    dns = {}
    for h, r in zip(names, res):
        dns[h] = "pending" if r is None else "fail: " + str(r) if isinstance(r, BaseException) else "ok"
    env = {k: os.environ[k] for k in ("https_proxy", "HTTPS_PROXY", "http_proxy", "HTTP_PROXY", "all_proxy", "ALL_PROXY") if os.environ.get(k)}
    gnome = doc_cmd(["gsettings", "get", "org.gnome.system.proxy", "mode"], timeout=3)[1].strip("'") if user_bus() and shutil.which("gsettings") else ""
    return {"hosts": hosts, "dns": dns, "dns_ms": int((time.monotonic() - t0) * 1000), "env": env, "dnf": dnf_proxy(), "gnome": gnome,
            "route": default_route()}


