        elif any(d["security"] == "none" and not d["iommu"] for d in tb):
            row("thunderbolt", "Thunderbolt", "warn", val + ": a device that is plugged in gets the PCIe bus without a question",
                ["the firmware's setup: Thunderbolt security level (user or secure)", level])
        else:
            row("thunderbolt", "Thunderbolt", "ok", val)

    sd, pat = keys["fs.suid_dumpable"], m["core_pattern"]
    where = "systemd-coredump keeps a program's memory image (coredumpctl), readable by its user" if pat and "systemd-coredump" in pat else \
            "a crashing program's memory image goes to: %s" % pat if pat else ""
    if sd is None or not pat:
        row("coredump", "core dumps", "unknown", "fs.suid_dumpable or kernel.core_pattern is not readable" + here)
    elif sd == 1:
