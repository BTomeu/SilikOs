def dev_pick_installer(work, setup_rx):
    """the one installer inside an unpacked archive: a script whose name is the vendor's installer's. None or several
    is an error that lists what is there (the user can then give the script itself): never a guess, since ST's runs
    as root"""
    scripts = sorted(os.path.join(d, f) for d, _, fs in os.walk(work) for f in fs if f.lower().endswith((".sh", ".run")))
    match = [p for p in scripts if re.search(setup_rx, os.path.basename(p).lower())]
    if len(match) == 1:
        return match[0]
    shown = ", ".join(os.path.relpath(p, work) for p in scripts) or "none"
    if not match:
        die("no installer of the expected name inside the archive (scripts there: %s)" % shown)
    die("several installers inside the archive (%s): give the one to run, for example  silik dev install %s" % (
        ", ".join(os.path.relpath(p, work) for p in match), shlex.quote(match[0])))


def dev_install_facts(name, src, run, root):
    """what the owner is shown before a vendor's installer runs (the audit's finding B5: the installer was chosen by
    its file name and ran, ST's as root, without a word): the command and whose rights it gets, the file, its size,
    where it says it came from, its SHA-256. A list of (label, text) rows."""
    def sha(f):
        try:
            return "%s  (%s)" % (win_sha256(f), win_size(os.path.getsize(f)))
        except OSError:
            return "(the file is read when this is not a dry run)"
    rows = [("runs", " ".join(shlex.quote(x) for x in ((["sudo", "sh"] if root else []) + [run]))),
            ("as", "root: it installs packages on the system" if root else "you (%s): it installs into your own folders" % (os.environ.get("USER") or "this user")),
            ("file", win_plain(src)), ("SHA-256", sha(src))]
    if run != src:
        rows += [("inside", win_plain(os.path.basename(run))), ("SHA-256", sha(run))]
    rows += [("from", (win_origin(src) if os.path.isfile(src) else "") or "no mark of where it came from on the file"),
             ("signature", "none this system can check: compare the SHA-256 with the one on %s's download page" % (
                 (re.findall(r"\((\w+)\)$", name) or ["the vendor"])[0]))]
    return rows


def dev_install_ask(ctx, a, name, src, run, root):
    """shows dev_install_facts and asks; --yes (for scripts) and --dry-run do not ask. Ends the command on a no."""
    rows = dev_install_facts(name, src, run, root)
    print("silik: about to run the installer of %s" % name, file=sys.stderr)
    for k, v in rows:
        print("  %-9s  %s" % (k, v), file=sys.stderr)
    if ctx.dry or getattr(a, "yes", False):
        return
    if not sys.stdin.isatty():
        die("an installer is not run without a yes: add --yes (after reading the lines above)", 2)
    try:
        ok = input("silik: run it? [y/N] ").strip().lower() in ("y", "yes", "s", "si", "sí")
    except EOFError:
        ok = False
    if not ok:
        die("nothing run", 1)


def dev_install(ctx, a):
    """runs a vendor's own installer from the file the user downloaded (an archive is unpacked first, and removed
    after). The installer shows its licence and asks what it asks: nothing here answers for the user, and nothing is
    downloaded. Before it runs the owner is shown what will run and as whom, and asked (--yes for scripts). Its exit
    code is this command's."""
    src = os.path.abspath(os.path.expanduser(a.file))
    ide = dev_which_ide(src)
    if not ide:
        die("not an installer this command knows: %s (it knows the Linux installers of %s, by their file names)" % (
            os.path.basename(src), " and ".join(i[1] for i in DEV_IDES)), 2)
    key, name, exe, roots, setup_rx = ide
    low = os.path.basename(src).lower()
    if key == "stm32cubeide" and "deb_bundle" in low:
        die("this is ST's bundle for Debian systems: SilikOS is an RPM system; ST's RPM bundle (…amd64.rpm_bundle.sh) is the one", 2)
    if not os.path.isfile(src) and not ctx.dry:
        die("no such file: " + src)
    print("%s is its vendor's program, under its vendor's licence: the installer shows it and asks; SilikOS only runs it" % name)
    run, work = src, None
    if low.endswith(DEV_ARCHIVES):
        work = eda_work(ctx, "dev-install")
        if low.endswith(".zip"):
            ctx.run(["unzip", "-q", "-o", src, "-d", work])
        else:
            ctx.run(["tar", "-xzf", src, "-C", work])
        run = os.path.join(work, "<the installer inside>") if ctx.dry else dev_pick_installer(work, setup_rx)
    elif not ctx.dry and not low.endswith((".sh", ".run")):
        die("not a Linux installer (.sh, .run, or an archive of one): " + os.path.basename(src))
    try:
        dev_install_ask(ctx, a, name, src, run, key == "stm32cubeide")
    except SystemExit:
        if work:
            ctx.run(["rm", "-rf", work])        # (a no leaves no unpacked archive behind)
        raise
    before = set(dev_find_ides(exe, roots)) if not ctx.dry else set()
    if key == "stm32cubeide":
        # ST's bundle for RPM systems installs packages (the IDE, the ST-LINK server, the probes' device rules): as root
        if "rpm_bundle" not in os.path.basename(run).lower() and not ctx.dry:
            print("silik: this is not ST's bundle for RPM systems (…amd64.rpm_bundle.sh): that is the one made for this base", file=sys.stderr)
        rc, _ = ctx.run(["sudo", "sh", run], check=False)
    else:
        # TI's installer is a program with its own window; it installs for the user who runs it
        ctx.run(["chmod", "+x", run])
        rc, _ = ctx.run([run], check=False)
    if work:
        ctx.run(["rm", "-rf", work])            # (the unpacked archive: a gigabyte or more)
    if ctx.dry:
        return 0
    found = dev_find_ides(exe, roots)
    if rc:
        print("silik: the installer exited %d: nothing is said to be installed%s" % (
            rc, " (%s was there before it)" % found[-1] if found else ""), file=sys.stderr)
        return rc
    if not found:
        print("silik: no %s under %s after the installer: `silik dev tools` looks again" % (exe, " or ".join(roots)), file=sys.stderr)
        return 1
    new = [p for p in found if p not in before]
    print("%s %s: %s%s" % (SEC_MARK["ok"], key, (new or found)[-1], "" if new else "  (it was there before: the installer added no other)"))
    if key == "ccs":      # TI's own script for the probes' device rules, when the installation has it
        top = (new or found)[-1]
        for _ in range(4):
            top = os.path.dirname(top)
            script = os.path.join(top, "install_scripts", "install_drivers.sh")
            if os.path.isfile(script):
                print("the probes' device rules are TI's own script, as root:  sudo %s" % script)
                break
    return 0


