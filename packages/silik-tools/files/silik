GB = 1024 ** 3
DOC_RAN = []                   # the read-only commands this run asked (--verbose, --json)


def doc_cmd(argv, timeout=10):
    """a read-only command of the doctor, noted for --verbose: (exit code or None, stdout) as sec_cmd"""
    DOC_RAN.append(" ".join(shlex.quote(a.replace("\t", "\\t").replace("\n", "\\n")) for a in argv))   # (rpm reads \t \n itself)
    return sec_cmd(argv, timeout=timeout)


def doc_row(rows, area, i, name, state, value, fix=()):
    rows.append({"area": area, "id": i, "name": name, "state": state, "value": value, "fix": list(fix) if state != "ok" else []})


def ago(s):
    """an age in words: 40 s, 12 min, 5 h, 3 days"""
    s = max(0, int(s))
    return "%d s" % s if s < 90 else "%d min" % (s // 60) if s < 5400 else "%d h" % (s // 3600) if s < 172800 else "%d days" % (s // 86400)


def size(b):
    return "%.1f GB" % (b / GB) if b >= GB else "%d MB" % (b // (1024 * 1024))


def bitrate(n):
    return "%g Mbit/s" % (n / 1e6) if n >= 1000000 else "%g kbit/s" % (n / 1e3)


def rate_word(n):
    """a bit rate as `silik dev can up` takes it: 500k, 1M"""
    return "%gM" % (n / 1e6) if n >= 1000000 else "%gk" % (n / 1e3)


def no_secret(url):
    """a proxy's address without the user and password it may carry"""
    return re.sub(r"//[^@/]*@", "//", url)


def user_bus():
    return os.path.exists(os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/nonexistent", "bus"))


# ---- system
def doc_probe_system():
    weight = later(doc_probe_weight)               # (the rpm database, read while the rest is)
    disks = {}
    for mp in ("/", "/home", "/var"):
        try:
            s = os.statvfs(mp)
            disks[mp] = {"dev": os.stat(mp).st_dev, "size": s.f_blocks * s.f_frsize, "free": s.f_bavail * s.f_frsize,
                         "files": s.f_files, "ffree": s.f_ffree}
        except OSError:
            disks[mp] = None
    units = [u for pair in DOC_UPDATE_UNITS.values() for u in pair]
    rpm, show, journal, failed, ufailed = par([
        lambda: doc_cmd(["rpm", "-q", "--qf", "%{NAME}\t%{VERSION}-%{RELEASE}.%{ARCH}\t%{INSTALLTIME}\n", "kernel-core"] + list(SILIKOS_PKGS))
        if shutil.which("rpm") else (None, ""),
        lambda: doc_cmd(["systemctl", "show", "--timestamp=unix", "-p", DOC_SHOW] + units),
        # (the job results of the update services, across starts; readable by root and the groups wheel and adm)
        lambda: doc_cmd(["journalctl", "-q", "--no-pager", "-o", "json", "-n", "40"] + sum((["-u", u] for u in units if u.endswith(".service")), []), timeout=5),
        lambda: doc_cmd(["systemctl", "list-units", "--failed", "--plain", "--no-legend", "--no-pager"]),
        lambda: doc_cmd(["systemctl", "--user", "list-units", "--failed", "--plain", "--no-legend", "--no-pager"]) if user_bus() else (None, "")])
    return {"os": os_release(), "silikos": os.path.exists("/etc/silikos-release"), "base": read("/etc/redhat-release").strip(),
            "kernel": os.uname().release, "rpm": rpm, "show": show, "journal": journal, "failed": failed, "ufailed": ufailed,
            "weight": weight(),
            "restart": read(DOC_RESTART, None), "disks": disks, "meminfo": read("/proc/meminfo"), "now": time.time(),
            "speed": speed_probe(doc_cmd),
            "container": sec_container(), "channel": channel_read()}


def systemd_show(text):
    """{unit: {property: value}} from `systemctl show -p ... UNIT...` (one block per unit)"""
    out = {}
    for block in text.split("\n\n"):
        p = dict(l.partition("=")[::2] for l in block.splitlines() if "=" in l)
        if p.get("Id"):
            out[p["Id"]] = p
    return out


def unix_time(v):
    """a time of `systemctl show --timestamp=unix` (@1731390723), or None"""
    v = (v or "").strip()
    return int(v[1:]) if v.startswith("@") and v[1:].isdigit() and int(v[1:]) > 0 else None


def journal_jobs(text, unit):
    """[(time, 'done' | 'failed' | ...)] of the start jobs of UNIT in `journalctl -o json` lines, oldest first"""
    out = []
    for l in text.splitlines():
        try:
            e = json.loads(l)
        except ValueError:
            continue
        if e.get("UNIT") == unit and e.get("JOB_RESULT") and e.get("JOB_TYPE", "start") == "start":
            t = e.get("__REALTIME_TIMESTAMP", "")
            out.append((int(t) / 1e6 if str(t).isdigit() else None, e["JOB_RESULT"]))
    return out


def doc_updates(st, rows):
    rc, text = st["show"]
    if rc != 0:
        doc_row(rows, "system", "updates", "automatic updates", "unknown", "systemd does not answer%s" % (" (inside a container)" if st["container"] else ""))
        return
    sh = systemd_show(text)
    mode = next((k for k in ("all", "security") if sh.get(DOC_UPDATE_UNITS[k][0], {}).get("UnitFileState") == "enabled"), "")
    if not mode:
        if all(sh.get(DOC_UPDATE_UNITS[k][0], {}).get("LoadState") in (None, "not-found") for k in DOC_UPDATE_UNITS):
            doc_row(rows, "system", "updates", "automatic updates", "warn", "off (the package silikos-security is not installed)",
                    ["sudo dnf -y install silikos-security"])
        else:
            doc_row(rows, "system", "updates", "automatic updates", "warn", "off", ["silik update --auto all"])
        return
    timer, service = DOC_UPDATE_UNITS[mode]
    what = {"all": "every update, daily", "security": "security advisories, daily"}[mode]
    t, s = sh.get(timer, {}), sh.get(service, {})
    if t.get("ActiveState") not in ("active", "activating", "reloading"):
        doc_row(rows, "system", "updates", "automatic updates", "warn", "%s (%s): on from the next start, not running now" % (what, timer),
                ["sudo systemctl start " + timer])
        return
    last = unix_time(t.get("LastTriggerUSec"))
    seen = []                                      # (time, result) known
    jobs = journal_jobs(st["journal"][1], service) if st["journal"][0] == 0 else []
    if jobs and jobs[-1][0]:
        seen.append((jobs[-1][0], "success" if jobs[-1][1] == "done" else jobs[-1][1]))
    end = unix_time(s.get("ExecMainExitTimestamp"))
    if end:                                        # (this start's run, as systemd keeps it)
        res = s.get("Result", "")
        seen.append((end, res if res != "exit-code" else "exit status %s" % s.get("ExecMainStatus", "?")))
    if seen:
        when, res = max(seen, key=lambda x: x[0])
        age = st["now"] - when
        if res != "success":
            doc_row(rows, "system", "updates", "automatic updates", "bad", "%s; the last run (%s ago) failed: %s" % (what, ago(age), res),
                    ["journalctl -u %s -n 50   # what dnf said (root, or a member of wheel)" % service, "silik update"])
        elif age > DOC_UPDATE_AGE:
            doc_row(rows, "system", "updates", "automatic updates", "warn", "%s; the last run was %s ago" % (what, ago(age)),
                    ["silik update", "systemctl list-timers %s   # when it runs next" % timer])
        else:
            doc_row(rows, "system", "updates", "automatic updates", "ok", "%s; last run %s ago: done" % (what, ago(age)))
    elif last:
        doc_row(rows, "system", "updates", "automatic updates", "unknown", "%s; last run %s ago, its result is not readable here" % (what, ago(st["now"] - last)),
                ["journalctl -u %s -n 50   # as root, or as a member of wheel" % service])
    else:
        doc_row(rows, "system", "updates", "automatic updates", "unknown", "%s; it has not run yet" % what, ["systemctl list-timers " + timer])


