def libvirt_session_vms():
    """{name: True running / False off} of the virtual machines of qemu:///session, from libvirt's files (virsh would
    start libvirt's session daemon) [A: libvirt's paths of a session's configuration and run state]"""
    home = os.path.expanduser("~")
    conf = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config"), "libvirt", "qemu")
    run = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/nonexistent", "libvirt", "qemu", "run")
    out = {}
    try:
        names = [f[:-4] for f in os.listdir(conf) if f.endswith(".xml")]
    except OSError:
        return out
    for n in sorted(names):
        pid = read(os.path.join(run, n + ".pid")).strip()
        out[n] = pid.isdigit() and os.path.exists("/proc/" + pid)
    return out


