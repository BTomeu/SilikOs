def sec_cmd(argv, timeout=20):
    """a read-only command, not echoed: (exit code, stdout); the code is None when the command is absent, may not
    be run or does not answer in time"""
    env = dict(os.environ)
    env["LC_ALL"] = "C"
    try:
        p = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                           universal_newlines=True, timeout=timeout, env=env)
        return p.returncode, p.stdout.strip()
    except (OSError, subprocess.SubprocessError, ValueError):
        return None, ""


def sec_container():
    if os.path.exists("/run/.containerenv") or os.path.exists("/.dockerenv"):
        return True
    rc, out = sec_cmd(["systemd-detect-virt", "--container"])
    return rc == 0 and out not in ("", "none")


def sec_unit(unit):
    """enabled / disabled / masked / static ... as systemctl says; 'not-found' when there is no such unit file;
    None when it cannot be told"""
    rc, out = sec_cmd(["systemctl", "is-enabled", unit])
    if rc is None:
        return None
    if out:
        return out.splitlines()[0].strip()
    dirs = ("/etc/systemd/system", "/run/systemd/system", "/usr/lib/systemd/system", "/lib/systemd/system")
    return None if any(os.path.exists(os.path.join(d, unit)) for d in dirs) else "not-found"


def sec_active(unit):
    """True / False as systemd says; None when systemd does not answer (a container, a chroot)"""
    rc, out = sec_cmd(["systemctl", "is-active", unit])
    if out in ("active", "activating", "reloading"):
        return True
    if out in ("inactive", "failed", "deactivating"):
        return False
    return None


def sec_selinux(container):
    enf = read("/sys/fs/selinux/enforce").strip()
    mode = {"1": "enforcing", "0": "permissive"}.get(enf)
    conf = None
    for l in read(SEC_SELINUX_CONF).splitlines():
        if l.strip().startswith("SELINUX="):
            conf = l.split("=", 1)[1].strip().lower()
    if mode is None and conf is not None and not container:
        mode = "disabled"          # an SELinux system whose kernel runs without it
    return {"mode": mode, "config": conf}


def sec_zone_parse(path):
    """a firewalld zone file: its target, what it opens (services, ports, accepting rules) and the ICMP types it
    accepts; None when it cannot be read"""
    import xml.etree.ElementTree as ElementTree
    try:
        root = ElementTree.parse(path).getroot()
    except (ElementTree.ParseError, OSError):
        return None
    opened = [s.get("name", "?") for s in root.findall("service")]
    opened += ["%s/%s" % (p.get("port", "?"), p.get("protocol", "?")) for p in root.findall("port")]
    opened += ["protocol " + p.get("value", "?") for p in root.findall("protocol")]
    opened += ["forward-port %s/%s" % (p.get("port", "?"), p.get("protocol", "?")) for p in root.findall("forward-port")]
    icmp = []
    for r in root.findall("rule"):
        if r.find("accept") is None:
            continue
        it = r.find("icmp-type")
        if it is not None:
            icmp.append(it.get("name", "?"))
            continue
        el = [e for e in r if e.tag in ("service", "port", "protocol", "forward-port", "source-port", "masquerade")]
        opened.append("rule:" + (el[0].get("name") or el[0].get("port") or el[0].get("value") or el[0].tag if el else "accept"))
    return {"target": root.get("target") or "default", "open": opened, "icmp": icmp}


def sec_zone_path(zone):
    for d in ("/etc/firewalld/zones", "/usr/lib/firewalld/zones"):
        p = os.path.join(d, zone + ".xml")
        if os.path.isfile(p):
            return p
    return ""


def sec_fw_list(out):
    """the output of `firewall-cmd --list-all`: {zone, target, open, icmp}; None when it is not that"""
    lines = out.splitlines()
    if not lines or not lines[0].strip() or lines[0].startswith(" "):
        return None
    f, rules, key = {}, [], ""
    for l in lines[1:]:
        if l.startswith("\t") and key == "rich rules":
            rules.append(l.strip())
        elif ":" in l:
            key, _, v = l.strip().partition(":")
            f[key] = v.strip()
    if "services" not in f or "ports" not in f:
        return None
    acc = [r for r in rules if r.endswith("accept")]
    opened = f["services"].split() + f["ports"].split() + ["protocol " + x for x in f.get("protocols", "").split()]
    opened += ["forward-port " + x for x in f.get("forward-ports", "").split()] + ["rule:accept" for r in acc if "icmp-type" not in r]
    return {"zone": lines[0].split()[0], "target": f.get("target") or None, "open": opened,
            "icmp": [r.split('icmp-type name="', 1)[1].split('"')[0] for r in acc if 'icmp-type name="' in r]}


def sec_firewall():
    """firewalld as it runs, else as it is configured. Anyone may ask a running firewalld for its default zone;
    what a zone opens is root's to read (polkit asks for a password, /etc/firewalld is closed): for another user
    "open" stays None and "packaged" holds what the zone's file in /usr/lib says, which root may have changed."""
    fw = {"installed": shutil.which("firewall-cmd") is not None, "active": sec_active("firewalld.service"),
          "unit": sec_unit("firewalld.service"), "zone": None, "target": None, "open": None, "icmp": [],
          "packaged": None, "zones": None, "also_active": [], "zone_file": os.path.isfile("/usr/lib/firewalld/zones/%s.xml" % SEC_ZONE)}
    root = os.geteuid() == 0
    if fw["unit"] not in (None, "not-found"):
        fw["installed"] = True
    if fw["active"] is None and root and sec_cmd(["firewall-cmd", "--state"]) == (0, "running"):
        fw["active"] = True    # systemd does not answer, the firewall itself does
    if fw["active"]:           # ask the running firewall (three questions at once: each is a start of firewall-cmd)
        (rc, z), (rcz, zs), (rc, az) = par([lambda q=q: sec_cmd(["firewall-cmd", q]) for q in
                                            ("--get-default-zone", "--get-zones", "--get-active-zones")])
        if rc == 0 and z:
            fw["zone"] = z
        if rcz == 0 and zs:
            fw["zones"] = zs.split()
        if rc == 0:
            fw["also_active"] = [l.strip() for l in az.splitlines() if l and not l.startswith(" ") and l.strip() != fw["zone"]]
        if root:
            rc, out = sec_cmd(["firewall-cmd", "--list-all"])
            fw.update((sec_fw_list(out) if rc == 0 else None) or {})
    if fw["zone"] is None:     # the permanent configuration (readable by root)
        for l in read("/etc/firewalld/firewalld.conf").splitlines():
            if l.startswith("DefaultZone="):
                fw["zone"] = l.split("=", 1)[1].strip() or None
    if fw["zone"] and fw["open"] is None:
        if os.access("/etc/firewalld/zones", os.R_OK):
            z = sec_zone_parse(sec_zone_path(fw["zone"])) if sec_zone_path(fw["zone"]) else None
            if z:
                fw["target"], fw["open"], fw["icmp"] = z["target"], z["open"], z["icmp"]
        else:
            fw["packaged"] = sec_zone_parse("/usr/lib/firewalld/zones/%s.xml" % fw["zone"])
    return fw


def sec_updates_auto():
    au = {"dnf_applies": None}
    for k, unit in (("full", SEC_FULL_TIMER), ("silikos", SEC_TIMER), ("dnf_install", "dnf-automatic-install.timer"), ("dnf", "dnf-automatic.timer")):
        au[k], au[k + "_active"] = sec_unit(unit), sec_active(unit)
    sect = ""
    for l in read("/etc/dnf/automatic.conf").splitlines():
        l = l.strip()
        if l.startswith("["):
            sect = l
        elif sect == "[commands]" and l.replace(" ", "").startswith("apply_updates="):
            au["dnf_applies"] = l.split("=", 1)[1].strip().lower() in ("yes", "true", "1", "on")
    return au


def sec_pending(offline=False):
    """the security advisories that name an installed package and are not installed; None when dnf does not answer"""
    rc, out = sec_cmd(["dnf", "-q"] + (["-C"] if offline else []) + ["updateinfo", "list", "--security"], timeout=180)
    if rc != 0:
        return None
    adv, pkgs = {}, 0
    for l in out.splitlines():
        p = l.split()
        if len(p) >= 3 and "Sec" in p[1]:
            pkgs += 1
            adv[p[0]] = p[1].split("/")[0] if "/" in p[1] else "Unknown"
    order = ["Critical", "Important", "Moderate", "Low", "Unknown"]
    worst = min(adv.values(), key=lambda s: order.index(s) if s in order else len(order)) if adv else ""
    return {"advisories": len(adv), "packages": pkgs, "worst": worst}


def sec_disk():
    """for / and /home: the device and whether a LUKS (dm-crypt) layer is under it; None when it cannot be told"""
    out = {}
    for mp in ("/", "/home"):
        rc, src = sec_cmd(["findmnt", "-n", "-o", "SOURCE", "-T", mp])
        src = src.split("[")[0].strip() if rc == 0 else ""
        enc = None
        if src.startswith("/dev/"):
            rc, types = sec_cmd(["lsblk", "-s", "-n", "-l", "-o", "TYPE", src])
            if rc == 0 and types:
                enc = "crypt" in types.split()
        out[mp] = {"source": src, "encrypted": enc}
    return out


def sec_secureboot(container):
    """'enabled' / 'disabled' / 'bios' (not started through UEFI) / None"""
    import glob
    for p in glob.glob("/sys/firmware/efi/efivars/SecureBoot-*"):
        try:
            with open(p, "rb") as f:
                b = f.read()
        except OSError:
            continue
        if len(b) >= 5:            # 4 bytes of attributes, then the value
            return "enabled" if b[4] == 1 else "disabled"
    rc, out = sec_cmd(["mokutil", "--sb-state"])
    if rc == 0 and "SecureBoot enabled" in out:
        return "enabled"
    if rc == 0 and "SecureBoot disabled" in out:
        return "disabled"
    if not container and os.path.isdir("/sys/firmware") and not os.path.isdir("/sys/firmware/efi"):
        return "bios"
    return None


def sec_lock(user=""):
    """the screen lock settings of this user; of `user` (the one behind sudo) when given"""
    def gs(schema, key):
        get = ["gsettings", "get", schema, key]
        rc, out = sec_cmd(["runuser", "-l", user, "-c", " ".join(get)] if user else get)
        return out.split()[-1] if rc == 0 and out else None
    en, idle, delay = gs("org.gnome.desktop.screensaver", "lock-enabled"), gs("org.gnome.desktop.session", "idle-delay"), gs("org.gnome.desktop.screensaver", "lock-delay")
    return {"enabled": {"true": True, "false": False}.get(en), "idle": int(idle) if idle and idle.isdigit() else None,
            "delay": int(delay) if delay and delay.isdigit() else None}


def sec_lock_fix(lk):
    """the commands (a user's own, no sudo) that bring a readable screen lock setting to: on, blank + lock within
    SEC_IDLE_MAX seconds; each one only shortens"""
    gs, cmds, idle = ["gsettings", "set"], [], lk["idle"]
    if not lk["enabled"]:
        cmds.append(gs + ["org.gnome.desktop.screensaver", "lock-enabled", "true"])
    if idle == 0 or idle > SEC_IDLE_MAX:
        cmds.append(gs + ["org.gnome.desktop.session", "idle-delay", str(SEC_IDLE)])
        idle = SEC_IDLE
    if idle + lk["delay"] > SEC_IDLE_MAX:
        cmds.append(gs + ["org.gnome.desktop.screensaver", "lock-delay", "0"])
    return cmds


def sec_autologin():
    """True when the login screen opens a session by itself; None without GDM's configuration file"""
    txt = read(SEC_GDM_CONF, None)
    if txt is None:
        return None
    for l in txt.splitlines():
        k, _, v = l.partition("=")
        if k.strip() in ("AutomaticLoginEnable", "TimedLoginEnable") and v.strip().lower() in ("true", "1", "yes"):
            return True
    return False


def sec_sysctl():
    """[(name, current value or None, wanted, direction, key of SEC_SYSCTL)] as the running kernel has it"""
    import glob
    res, seen = [], set()
    for key, want, how, _ in SEC_SYSCTL:
        pat = "/proc/sys/" + key.replace(".", "/")
        paths = sorted(glob.glob(pat)) if "*" in key else [pat]
        if not paths:
            res.append((key, None, want, how, key))
        for p in paths:
            parts = p[len("/proc/sys/"):].split("/")
            name = "/".join(parts) if any("." in x for x in parts) else ".".join(parts)   # eth0.100: sysctl's a/b form
            if name in seen:
                continue
            seen.add(name)
            txt = read(p).strip()
            res.append((name, int(txt) if txt.isdigit() else None, want, how, key))
    return res


def sec_weaker(cur, want, how):
    return cur is not None and (cur < want if how == "min" else cur > want)


def par(fns, timeout=None):
    """runs the callables FNS at once, each in a thread (the slow parts of a check are other programs, which run side
    by side); their results in order. One that raised gives its exception as its result; one still running after
    TIMEOUT seconds gives None"""
    import threading
    res = [None] * len(fns)

    def one(i, f):
        try:
            res[i] = f()
        except Exception as e:      # (handed to the caller, who decides)
            res[i] = e
    ts = [threading.Thread(target=one, args=(i, f), daemon=True) for i, f in enumerate(fns)]
    for t in ts:
        t.start()
    end = None if timeout is None else time.monotonic() + timeout
    for t in ts:
        t.join(None if end is None else max(0.0, end - time.monotonic()))
    return res


# ---- the boot chain, the firmware, what listens (the audit of 13/11/2026: "status tells the truth"). Read-only, and
# most of it files of /sys and /proc; what only root may read (the LUKS header, the JIT's hardening, root's account,
# who owns another user's socket) is None for anybody else, and its row then says unknown with the command to see it.
SEC_PROC = os.environ.get("SILIK_PROC") or "/proc"
SEC_MODULE_DIRS = ("extra", "updates", "weak-updates")     # where a kernel module that is not the base's is installed
SEC_KEYS = ("kernel.yama.ptrace_scope", "kernel.unprivileged_bpf_disabled", "net.core.bpf_jit_harden", "kernel.kexec_load_disabled",
            "kernel.sysrq", "fs.suid_dumpable", "kernel.kptr_restrict", "dev.tty.legacy_tiocsti")
SEC_LISTEN_OWN = {("udp", "68"): "DHCP client", ("udp", "546"): "DHCPv6 client"}     # what a network client itself listens on
SEC_LVFS = "/etc/fwupd/remotes.d/lvfs.conf"


def sec_sys(*parts):
    return os.path.join(SYSFS, *parts)       # (SYSFS: /sys, or the tests' made-up tree)


def sec_int(path):
    txt = read(path).strip()
    return int(txt) if txt.lstrip("-").isdigit() else None


def sec_lockdown():
    """the kernel's lockdown: 'none' / 'integrity' / 'confidentiality'; None when securityfs does not show it"""
    m = re.search(r"\[(\w+)\]", read(sec_sys("kernel/security/lockdown")))
    return m.group(1) if m else None


def sec_modules(files=True):
    """the kernel modules that are not the base's own: {"loaded": [(name, taint letters)] of those that taint the
    kernel (E: no signature the kernel trusts, O: not of the kernel's tree, P: proprietary), "files": [(path,
    signer or '')] of those installed outside the kernel's own folders}; None when /sys/module is not there"""
    import glob
    base = sec_sys("module")
    if not os.path.isdir(base):
        return None
    loaded = []
    for p in sorted(glob.glob(os.path.join(base, "*", "taint"))):
        t = read(p).strip()
        if t:
            loaded.append((os.path.basename(os.path.dirname(p)), t))
    found = []
    if files:
        top = os.path.join("/lib/modules", os.uname().release)
        paths = [p for d in SEC_MODULE_DIRS for p in sorted(glob.glob(os.path.join(top, d, "**", "*.ko*"), recursive=True))][:200]
        for p in paths:
            rc, out = sec_cmd(["modinfo", "-F", "signer", p])
            found.append((p, out.splitlines()[0].strip() if rc == 0 and out else ""))
    return {"loaded": loaded, "files": found}


SEC_MODULES = "/lib/modules"


def sec_kernel():
    """{"running", "installed": the kernels on the disk as uname names them, oldest first (None: none is seen)}. A
    kernel package of EL 9 (kernel-core, kernel-rt-core...) puts its image in /lib/modules/VERSION/vmlinuz: read
    there, without asking rpm (50 ms of every `silik doctor`)"""
    try:
        inst = sorted((n for n in os.listdir(SEC_MODULES) if os.path.isfile(os.path.join(SEC_MODULES, n, "vmlinuz"))), key=rpm_vercmp_key)
    except OSError:
        inst = []
    return {"running": os.uname().release, "installed": inst or None}


def sec_firmware(ask=True):
    """fwupd: {"tool", "lvfs": is the vendors' firmware service on (None: no such file), "updates": how many devices
    have one waiting (None: not asked or no answer)}. Nothing is downloaded: fwupd answers from the metadata it has."""
    fw = {"tool": bool(shutil.which("fwupdmgr")), "lvfs": None, "updates": None}
    for l in read(SEC_LVFS).splitlines():
        k, _, v = l.partition("=")
        if k.strip() == "Enabled":
            fw["lvfs"] = v.strip().lower() == "true"
    if ask and fw["tool"] and fw["lvfs"]:
        rc, out = sec_cmd(["fwupdmgr", "get-updates", "--json", "--no-metadata-check", "--no-remote-check"], timeout=30)
        if rc == 2:             # (fwupdmgr: nothing to do)
            fw["updates"] = 0
        elif rc == 0:
            try:
                fw["updates"] = sum(1 for d in json.loads(out).get("Devices", []) if d.get("Releases"))
            except (ValueError, AttributeError):
                pass
    return fw


def sec_cpu():
    """{flaw: what the kernel says of it} from /sys/devices/system/cpu/vulnerabilities; None when it is not there"""
    d = sec_sys("devices/system/cpu/vulnerabilities")
    try:
        return {n: read(os.path.join(d, n)).strip() for n in sorted(os.listdir(d))}
    except OSError:
        return None


def sec_ss_parse(out):
    """`ss -Htulnp`: [{"proto", "addr", "port", "local": bound to this machine only, "who", "pid"}]"""
    res = []
    for l in out.splitlines():
        f = l.split()
        if len(f) < 5 or f[0] not in ("tcp", "udp"):
            continue
        addr, _, port = f[4].rpartition(":")
        bare = addr.split("%")[0].strip("[]")
        local = bare.startswith("127.") or bare in ("::1",) or bare.startswith("::ffff:127.") or addr.endswith("%lo")
        m = re.search(r'users:\(\("([^"]*)",pid=(\d+)', l)
        res.append({"proto": f[0], "addr": addr, "port": port, "local": local, "who": m.group(1) if m else "", "pid": int(m.group(2)) if m else None})
    return res


def sec_sockets_parse(out):
    """`systemctl list-sockets --no-legend`: {listening address: the socket unit}"""
    res = {}
    for l in out.splitlines():
        f = l.split()
        if len(f) >= 2 and f[1].endswith(".socket"):
            res[f[0]] = f[1]
    return res


def sec_listen():
    """what listens for connections: sec_ss_parse's rows with "unit", the systemd unit each belongs to ('' when it
    cannot be told: another user's process is root's to see); None when ss does not answer"""
    rc, out = sec_cmd(["ss", "-Htulnp"])
    if rc != 0:
        return None
    rows = sec_ss_parse(out)
    socks = None
    for r in rows:
        r["unit"] = ""
        if r["pid"] and r["pid"] != 1:
            m = re.search(r"/([^/\n]+\.(?:service|scope|socket))\s*$", read(os.path.join(SEC_PROC, str(r["pid"]), "cgroup")), re.M)
            r["unit"] = m.group(1) if m else ""
        if not r["unit"] and not r["local"]:
            if socks is None:
                rc2, o2 = sec_cmd(["systemctl", "list-sockets", "--no-legend", "--no-pager"])
                socks = sec_sockets_parse(o2) if rc2 == 0 else {}
            r["unit"] = socks.get("%s:%s" % (r["addr"], r["port"]), "")
            if not r["unit"] and r["addr"] in ("*", "[::]", "0.0.0.0"):       # (a socket for every address is named in more than one way)
                r["unit"] = next((u for k, u in sorted(socks.items()) if k.rpartition(":")[2] == r["port"] and k.rpartition(":")[0] in ("*", "[::]", "0.0.0.0")), "")
    return rows


def sec_tpm():
    """'2' / '1' (the TPM's major version), '' when the kernel shows none, None when /sys/class is not readable"""
    d = sec_sys("class/tpm")
    if not os.path.isdir(sec_sys("class")):
        return None
    try:
        names = sorted(n for n in os.listdir(d) if n.startswith("tpm"))
    except OSError:
        return ""
    if not names:
        return ""
    return read(os.path.join(d, names[0], "tpm_version_major")).strip() or "1"      # (the file came with TPM 2.0 support)


def sec_luks_tokens(text):
    """the JSON of `cryptsetup luksDump --dump-json-metadata`: {"keyslots": how many, "tokens": [{"type", "pin":
    True / False / None, "pcrs"}]}; None when it is not that"""
    try:
        d = json.loads(text)
        toks = [{"type": t.get("type", "?"), "pin": t.get("tpm2-pin") if t.get("type") == "systemd-tpm2" else None,
                 "pcrs": t.get("tpm2-pcrs") or []} for _, t in sorted(d.get("tokens", {}).items())]
        return {"keyslots": len(d.get("keyslots", {})), "tokens": toks}
    except (ValueError, AttributeError, TypeError):
        return None


def sec_unlock(src):
    """what opens the encrypted device under SRC (the source of /): {"device": the LUKS device, "keyslots",
    "tokens"}; tokens None when the header was not read (it is root's)"""
    rc, out = sec_cmd(["lsblk", "-s", "-n", "-l", "-o", "PATH,TYPE", src]) if src.startswith("/dev/") else (None, "")
    rows = [l.split() for l in out.splitlines() if len(l.split()) == 2] if rc == 0 else []
    dev = next((rows[i + 1][0] for i in range(len(rows) - 1) if rows[i][1] == "crypt"), "")
    res = {"device": dev, "keyslots": None, "tokens": None}
    if dev and os.geteuid() == 0:
        rc, out = sec_cmd(["cryptsetup", "luksDump", "--dump-json-metadata", dev])
        res.update((sec_luks_tokens(out) if rc == 0 else None) or {})
    return res


def sec_swap():
    """[{"name", "kind": zram | disk, "encrypted": True / False / None}] of the swap in use; None when /proc/swaps
    is not readable"""
    txt = read(os.path.join(SEC_PROC, "swaps"), None)
    if txt is None:
        return None
    res = []
    for l in txt.splitlines()[1:]:
        f = l.split()
        if len(f) < 2:
            continue
        name, enc = f[0], None
        if os.path.basename(name).startswith("zram"):
            res.append({"name": name, "kind": "zram", "encrypted": None})
            continue
        dev = name
        if f[1] == "file":
            rc, src = sec_cmd(["findmnt", "-n", "-o", "SOURCE", "-T", name])
            dev = src.split("[")[0].strip() if rc == 0 else ""
        if dev.startswith("/dev/"):
            rc, types = sec_cmd(["lsblk", "-s", "-n", "-l", "-o", "TYPE", dev])
            if rc == 0 and types:
                enc = "crypt" in types.split()
        res.append({"name": name, "kind": "disk", "encrypted": enc})
    return res


def sec_iommu():
    """{"units": the IOMMUs the kernel uses, "types": how their groups translate (DMA: strict, DMA-FQ: lazy,
    identity: not at all)}; None when /sys/class/iommu is not there"""
    import glob
    try:
        units = sorted(os.listdir(sec_sys("class/iommu")))
    except OSError:
        return None
    types = sorted(set(read(p).strip() for p in sorted(glob.glob(sec_sys("kernel/iommu_groups/*/type")))[:256]) - {""})
    return {"units": units, "types": types}


def sec_thunderbolt():
    """[{"domain", "security", "iommu": is the kernel's DMA protection on for it}]; None when /sys/bus is not there"""
    import glob
    if not os.path.isdir(sec_sys("bus")):
        return None
    res = []
    for d in sorted(glob.glob(sec_sys("bus/thunderbolt/devices/domain*"))):
        res.append({"domain": os.path.basename(d), "security": read(os.path.join(d, "security")).strip() or None,
                    "iommu": {"1": True, "0": False}.get(read(os.path.join(d, "iommu_dma_protection")).strip())})
    return res


def sec_usb(user=""):
    """USBGuard and GNOME's use of it: {"installed", "active", "protection", "level"}. The desktop's two keys are
    asked only while usbguard runs (they mean nothing without it), with one command"""
    dirs = ("/etc/systemd/system", "/usr/lib/systemd/system", "/lib/systemd/system")
    us = {"installed": any(os.path.exists(os.path.join(d, "usbguard.service")) for d in dirs) if any(os.path.isdir(d) for d in dirs) else None,
          "active": None, "protection": None, "level": None}
    if us["installed"] is not False:
        us["active"] = sec_active("usbguard.service")
    if us["active"]:
        get = ["gsettings", "list-recursively", "org.gnome.desktop.privacy"]
        rc, out = sec_cmd(["runuser", "-l", user, "-c", " ".join(get)] if user else get)
        keys = {f[1]: f[2].strip("'") for f in (l.split(None, 2) for l in out.splitlines()) if len(f) == 3} if rc == 0 else {}
        us["protection"], us["level"] = {"true": True, "false": False}.get(keys.get("usb-protection")), keys.get("usb-protection-level")
    return us


def sec_more(disk=None, user="", firmware=True, parallel=False):
    """the second half of what the audit reads (the rows sec_checks_more judges)"""
    src = ((disk or {}).get("/") or {}).get("source", "") if ((disk or {}).get("/") or {}).get("encrypted") else ""
    root = os.geteuid() == 0
    parts = (("modules", sec_modules), ("kernel", sec_kernel), ("firmware", lambda: sec_firmware(firmware) if firmware is not None else None),
             ("listen", sec_listen), ("unlock", lambda: sec_unlock(src) if src else None), ("swap", sec_swap), ("usb", lambda: sec_usb(user)),
             # (is kdump started at boot: its link, not a question to systemd)
             ("kdump", lambda: "enabled" if os.path.lexists("/etc/systemd/system/multi-user.target.wants/kdump.service") else "disabled"),
             ("root", lambda: ((sec_cmd(["passwd", "-S", "root"])[1].split() + ["", ""])[1] or None) if root else None))
    vals = par([f for _, f in parts]) if parallel else [f() for _, f in parts]
    for v in vals:
        if isinstance(v, BaseException):
            raise v
    m = dict(zip([k for k, _ in parts], vals))
    sig = read(sec_sys("module/module/parameters/sig_enforce")).strip()
    m.update({"lockdown": sec_lockdown(), "sig_enforce": {"Y": True, "N": False}.get(sig), "cpu": sec_cpu(), "tpm": sec_tpm(),
              "iommu": sec_iommu(), "thunderbolt": sec_thunderbolt(), "tainted": sec_int(os.path.join(SEC_PROC, "sys/kernel/tainted")),
              "keys": {k: sec_int(os.path.join(SEC_PROC, "sys", k.replace(".", "/"))) for k in SEC_KEYS},
              "core_pattern": read(os.path.join(SEC_PROC, "sys/kernel/core_pattern")).strip() or None,
              "level": lvl_choice()})
    return m


# ---- r7 (listen, usb): rows and commands of `silik secure` that live in plugins -------------------------------------
# A plugin of SEC_PLUGINS gives three functions: secure_probe(silik) reads, secure_rows(silik, probe) judges what was
# read ([{id, name, state, value, fix}]), secure_plan(silik, probe, dry) lists apply's commands ((commands, notes)).
# One that is not installed gives nothing; one that fails gives an unknown row, never an ok one.
SEC_PLUGINS = ("listen", "usb")
_sec_plugins = {}


class _Self:
    """this program's own names as attributes: what a plugin is handed as `silik` (however this file was loaded)"""
    def __getattr__(self, k):
        try:
            return globals()[k]
        except KeyError:
            raise AttributeError(k)


def sec_plugin(name):
    """the plugin NAME when it is installed and takes part in `silik secure`, else None"""
    if name not in plugins():
        return None
    if name not in _sec_plugins:
        _sec_plugins[name] = load_plugin(name)
    mod = _sec_plugins[name]
    return mod if all(hasattr(mod, f) for f in ("secure_probe", "secure_rows", "secure_plan")) else None


def sec_plugins_probe(parallel=False):
    """{plugin: what it read}; {"failed": why} for one that raised"""
    me, names = _Self(), [n for n in SEC_PLUGINS if sec_plugin(n)]

    def one(n):
        try:
            return sec_plugin(n).secure_probe(me)
        except Exception as e:      # (a plugin's fault is that row's, not the audit's)
            return {"failed": "%s: %s" % (type(e).__name__, e)}
    fns = [lambda n=n: one(n) for n in names]
    return dict(zip(names, par(fns) if parallel else [f() for f in fns]))


def sec_plugins_rows(st):
    rows = []
    for n, got in (st.get("plugins") or {}).items():
        try:
            if not isinstance(got, dict) or "failed" in got:
                raise RuntimeError(got.get("failed", "no answer") if isinstance(got, dict) else "no answer")
            rows += sec_plugin(n).secure_rows(_Self(), got)
        except Exception as e:
            rows.append({"id": n, "name": n, "state": "unknown", "value": "`silik %s` could not read it: %s" % (n, e), "fix": ["silik " + n]})
    return rows


def sec_plugins_plan(st, dry=False):
    cmds, notes = [], []
    for n, got in (st.get("plugins") or {}).items():
        try:
            if not isinstance(got, dict) or "failed" in got:
                raise RuntimeError(got.get("failed", "no answer") if isinstance(got, dict) else "no answer")
            c, m = sec_plugin(n).secure_plan(_Self(), got, dry)
            cmds += c
            notes += m
        except Exception as e:
            notes.append("%s: not changed, `silik %s` could not read it: %s" % (n, n, e))
    return cmds, notes
def sec_rows_join(rows, extra):
    """a plugin's rows into the audit's: a row the audit has under the same id is not said twice. The plugin's USB row
    takes its place (it knows the daemon's own settings); of `listening` the audit's row stays (everything that
    listens, with its unit) and takes the plugin's commands, and the worse of the two states"""
    worse = ("ok", "unknown", "warn", "bad")
    for r in extra:
        i = next((k for k, e in enumerate(rows) if e.get("id") == r.get("id")), None)
        if i is None:
            rows.append(r)
        elif r.get("id") == "usb":
            rows[i] = r
        else:
            e = rows[i]
            if r["state"] != "ok":
                e["value"] = "%s; %s" % (e["value"], r["value"])
            e["state"] = max(e["state"], r["state"], key=worse.index)
            e["fix"] = list(r.get("fix") or []) + [f for f in (e.get("fix") or []) if f not in (r.get("fix") or [])]
    return rows


