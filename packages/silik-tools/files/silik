DOC_RESTART = "/run/silikos/restart"          # written by silikos-security's restart-needed after an update
DOC_UPDATE_UNITS = {"all": (SEC_FULL_TIMER, "silikos-update.service"), "security": (SEC_TIMER, "silikos-security-update.service")}
DOC_SHOW = "Id,LoadState,UnitFileState,ActiveState,Result,ExecMainStatus,ExecMainExitTimestamp,LastTriggerUSec"
DOC_UPDATE_AGE = 2 * 86400     # s: a daily update older than this is late (the timer catches up after a start)
