            continue
        if kind == "serial":
            if not u["ttys"]:
                doc_row(rows, "bench", "usb-" + vp, r["name"], "warn", "%s: no serial port (%s not bound)" % (label, drv), ["sudo modprobe " + drv])
                continue
            node, acc, how = tty, u["tty_access"].get(tty), r["use"].replace("TTY", tty)
