def lvl_read(path):
    return read(LVL_ROOT + path, None)


def lvl_choice():
    """the owner's choice: {"level": hardened | default, "without": [the items left out]}"""
    words = (lvl_read(LVL_CHOICE) or "").split()
    if not words or words[0] != "hardened":
        return {"level": "default", "without": []}
    return {"level": "hardened", "without": [w for w in words[1:] if w in LVL_IDS]}


def lvl_state():
    """what `level hardened` wrote down; (state, readable): readable False when the file is there and is root's"""
    empty = {"kernel_args": [], "sysctl": {}, "files": [], "authselect": False, "faillock": False, "bolt": None}
    try:
        with open(LVL_ROOT + LVL_STATE) as f:
            st = json.load(f)
    except PermissionError:
        return empty, False
    except (OSError, ValueError):
        return empty, True
    if not isinstance(st, dict):
        return empty, True
    out = dict(empty)
    out["kernel_args"] = [w for w in st.get("kernel_args", []) if isinstance(w, str) and KERNEL_ARG.match(w)] if isinstance(st.get("kernel_args"), list) else []
    out["sysctl"] = {k: v for k, v in st.get("sysctl", {}).items() if isinstance(v, int)} if isinstance(st.get("sysctl"), dict) else {}
    out["files"] = [p for p in st.get("files", []) if isinstance(p, str)] if isinstance(st.get("files"), list) else []
    # (authselect: True, this command turned with-faillock on in the profile there was; "selected": it selected the profile too)
    out["authselect"], out["faillock"] = (st.get("authselect") if st.get("authselect") in (True, "selected") else False), st.get("faillock") is True
    out["bolt"] = st.get("bolt") if st.get("bolt") in ("enabled", "disabled") else None
    return out, True


def lvl_args(it, arch):
    """the kernel arguments of the item on this architecture"""
    return tuple(a for a in it["args"] if arch == "x86_64" or a not in it.get("x86", ()))


def lvl_arg_in(words, a):
    """is the kernel argument A on the command line WORDS (or the owner's stricter value of it)"""
    return a in words or any(s in words for s in LVL_STRICTER if s.split("=")[0] == a.split("=")[0])


def lvl_arg_other(words, a):
    """the word on the command line that gives A's name another value ('' when none does)"""
    if lvl_arg_in(words, a):
        return ""
    return next((w for w in words if w.split("=", 1)[0] == a.split("=", 1)[0]), "")


def lvl_conf_keys(text):
    """the settings a configuration file sets: {key: value} of its `key = value` lines that are not comments"""
    res = {}
    for l in (text or "").splitlines():
        l = l.strip()
        if l and not l.startswith(("#", ";", "[")) and "=" in l:
            k, v = l.split("=", 1)
            res[k.strip()] = v.strip()
    return res


def lvl_probe():
    """what `silik secure level` reads (nothing is changed)"""
    cont = sec_container()
    entries = bls_entries()
    user = os.environ.get("SUDO_USER", "") if os.geteuid() == 0 else ""
    home = os.path.expanduser("~" + user) if valid_name(user) else os.path.expanduser("~")
    disk = sec_disk()
    src = disk["/"]["source"] if disk["/"]["encrypted"] else ""
    tb = sec_thunderbolt()
    bolt = None
    if tb and shutil.which("boltctl"):
        rc, out = sec_cmd(["boltctl", "config", "auth-mode"])
        bolt = out.split()[-1] if rc == 0 and out.split() and out.split()[-1] in ("enabled", "disabled") else None
    rc, raw = sec_cmd(["authselect", "current", "--raw"])
    state, readable = lvl_state()

    def listed(d):          # {file name: is it there} of a folder; None when the folder is not readable
        try:
            return set(os.listdir(LVL_ROOT + d))
        except OSError:
            return None
    rules = listed(LVL_AUDIT)
    return {
        "uid": os.geteuid(), "arch": host_arch(), "remote": remote_session(), "online": speed_online(), "container": cont,
        "cmdline": read(os.path.join(SEC_PROC, "cmdline")).split(),
        "entries": [e["options"].split() for e in entries if "$kernelopts" not in e["options"]] if entries else None,
        "keys": {it["key"]: sec_int(os.path.join(SEC_PROC, "sys", it["key"].replace(".", "/"))) for it in LVL_ITEMS if it["kind"] == "sysctl"},
        "files": {p: lvl_read(p) for p in LVL_OWN + (LVL_FAILLOCK,)},
        "sshd_dir": listed(os.path.dirname(LVL_SSHD)) is not None,
        "audit": None if rules is None else [r for r in LVL_AUDIT_RULES if r in rules],
        "audit_src": all(os.path.isfile(os.path.join(LVL_ROOT + LVL_AUDIT_SRC, r)) for r in LVL_AUDIT_RULES),
        "auditd": sec_active("auditd.service"),
        # the profile and its features; []: no profile is selected (a system installed before the kickstart selected
        # one: `authselect current` then ends with 2); None: authselect does not answer
        "authselect": raw.split() if rc == 0 and raw.split() else [] if rc == 2 else None,
        "dconf": bool(shutil.which("dconf")), "gdm": os.path.isdir(LVL_ROOT + os.path.dirname(LVL_GDM)),
        "nm": os.path.isdir(LVL_ROOT + os.path.dirname(LVL_NM)), "nm_active": sec_active("NetworkManager.service"),
        "sshd": {"unit": sec_unit("sshd.service"), "active": sec_active("sshd.service")},
        "ssh_keys": bool((read(os.path.join(home, ".ssh/authorized_keys")) or "").strip()), "user": user or os.environ.get("USER", ""),
        "kdump": sec_unit("kdump.service"), "modules": sec_modules(), "thunderbolt": tb, "bolt": bolt, "boltctl": bool(shutil.which("boltctl")),
        "secureboot": sec_secureboot(cont), "disk": disk, "unlock": sec_unlock(src) if src else None,
        "state": state, "state_readable": readable, "choice": lvl_choice(),
        "marks": [p for p in (LVL_CHOICE, LVL_STATE) if os.path.exists(LVL_ROOT + p)],
    }


def lvl_rows(pr):
    """one row per item of the hardened level: state on (as the level has it) | pending (set, in effect after a
    restart) | off | n/a (nothing of it on this system: why) | unknown (not visible: why); nothing is run"""
    rows = []
    for it in LVL_ITEMS:
        r = {"id": it["id"], "row": it["row"], "sets": it["sets"], "cost": it["cost"]}
        kind = it["kind"]
        if kind == "karg":
            args = lvl_args(it, pr["arch"])
            if not args:
                r["state"], r["value"] = "n/a", "an argument of x86 machines: nothing to set on %s" % pr["arch"]
                rows.append(r)
                continue
            run = all(lvl_arg_in(pr["cmdline"], a) for a in args)
            nxt = all(all(lvl_arg_in(e, a) for a in args) for e in pr["entries"]) if pr["entries"] else None
            other = [w for w in (lvl_arg_other(pr["cmdline"], a) for a in args) if w]
            if run and nxt is not False:
                r["state"], r["value"] = "on", "on the running kernel's command line" + (" and every boot entry's" if nxt else "")
            elif nxt:
                r["state"], r["value"] = "pending", "set in every boot entry: in effect after a restart"
            else:
                r["state"] = "off"
                r["value"] = "on the running kernel's command line, but not in every boot entry: not kept at the next start" if run else \
                    "the owner's %s is kept" % " ".join(other) if other else "not on the kernel's command line"
        elif kind == "sysctl":
            cur, mine = pr["keys"].get(it["key"]), it["key"] in lvl_conf_keys(pr["files"][LVL_SYSCTL])
            if it["id"] == "kexec" and cur != 1 and pr["kdump"] in ("enabled", "enabled-runtime"):
                r["state"], r["value"] = "n/a", "kdump is on (crash dumps) and needs kexec: kept; `silik speed apply kdump` turns kdump off"
            elif cur is None:
                r["state"], r["value"] = ("on" if mine else "off"), "%s: the value is root's to read; %s" % (it["key"], "set in %s" % LVL_SYSCTL if mine else "not set by the level")
            elif sec_weaker(cur, it["value"], it["how"]):
                r["state"], r["value"] = "off", "%s = %d" % (it["key"], cur)
            else:
                r["state"], r["value"] = "on", "%s = %d%s" % (it["key"], cur, "" if mine else " (not by this command's file)")
        elif it["id"] == "locks":
            have = set(l.strip() for l in (pr["files"][LVL_LOCKS] or "").splitlines())
            on = all(k in have for k in LVL_LOCK_KEYS)
            r["state"], r["value"] = ("on" if on else "off"), "%d keys locked in %s" % (len(LVL_LOCK_KEYS), LVL_LOCKS) if on else "not locked"
        elif it["id"] == "userlist":
            on = lvl_conf_keys(pr["files"][LVL_GDM]).get("disable-user-list") == "true"
            r["state"], r["value"] = ("n/a", "GDM is not installed") if not pr["gdm"] else ("on", LVL_GDM) if on else ("off", "the login screen lists the users")
        elif it["id"] == "automount":
            k = lvl_conf_keys(pr["files"][LVL_DCONF])
            on = k.get("automount") == "false" and k.get("automount-open") == "false"
            r["state"], r["value"] = ("on", LVL_DCONF) if on else ("off", "the desktop's default")
        elif kind == "nm":
            k = lvl_conf_keys(pr["files"][LVL_NM])
            on = all(k.get(s.split("=")[0]) == s.split("=")[1] for s in LVL_NM_SET[it["id"]])
            r["state"], r["value"] = ("n/a", "NetworkManager is not installed") if not pr["nm"] else ("on", LVL_NM) if on else ("off", "NetworkManager's default")
        elif kind == "pam":
            k = lvl_conf_keys(pr["files"][LVL_FAILLOCK])
            if pr["authselect"] is None:
                r["state"], r["value"] = "n/a", "authselect is not on this system: the PAM files are not changed"
            elif "with-faillock" in pr["authselect"] and all(key in k for key, _ in LVL_FAILLOCK_SET):
                r["state"], r["value"] = "on", "with-faillock; " + ", ".join("%s = %s" % (key, k[key]) for key, _ in LVL_FAILLOCK_SET)
            else:
                r["state"], r["value"] = "off", ("with-faillock is on, %s has the base's values" % LVL_FAILLOCK if "with-faillock" in pr["authselect"] else
                                                 "wrong passwords are not counted" + ("" if pr["authselect"] else " (no authselect profile is selected)"))
        elif kind == "bolt":
            tb = pr["thunderbolt"]
            if not tb:
                r["state"], r["value"] = "n/a", "no Thunderbolt or USB4 controller in use"
            elif all(d["iommu"] for d in tb):
                r["state"], r["value"] = "n/a", "the kernel's DMA protection is on for it: bolt's own policy stays"
            elif not pr["boltctl"]:
                r["state"], r["value"] = "n/a", "bolt is not installed"
            elif pr["bolt"] is None:
                r["state"], r["value"] = "unknown", "bolt does not answer (boltctl config auth-mode)"
            else:
                r["state"], r["value"] = ("on" if pr["bolt"] == "disabled" else "off"), "auth-mode " + pr["bolt"]
        elif kind == "audit":
            if not pr["audit_src"]:
                r["state"], r["value"] = "n/a", "the base's sample rules (%s, package audit) are not on this system" % LVL_AUDIT_SRC
            elif pr["audit"] is None:
                r["state"], r["value"] = "unknown", "%s is root's to read" % LVL_AUDIT
            else:
                on = len(pr["audit"]) == len(LVL_AUDIT_RULES)
                r["state"], r["value"] = ("on" if on else "off"), "%s in %s" % (" ".join(pr["audit"]) or "neither rule file", LVL_AUDIT)
        elif kind == "sshd":
            text = pr["files"][LVL_SSHD]
            if pr["sshd"]["unit"] == "not-found":
                r["state"], r["value"] = "n/a", "sshd is not installed"
            elif text is None and not pr["sshd_dir"]:
                r["state"], r["value"] = "unknown", "%s is root's to read" % os.path.dirname(LVL_SSHD)
            else:
                have = set(l.strip() for l in (text or "").splitlines())
                on = all(s in have for s in LVL_SSHD_SET)
                r["state"], r["value"] = ("on", LVL_SSHD) if on else ("off", "sshd's own settings")
        rows.append(r)
    return rows


def lvl_required(pr):
    """the rows of what the level requires and does not set: state on | off | unknown | n/a"""
    sb, enc, un = pr["secureboot"], pr["disk"]["/"]["encrypted"], pr["unlock"]
    res = [{"id": "secureboot", "state": "on" if sb == "enabled" else "unknown" if sb is None else "off",
            "value": {"enabled": "enabled", "disabled": "Secure Boot is off", "bios": "Secure Boot is not possible (not started through UEFI)"}.get(sb, "the firmware's variables are not visible")},
           {"id": "encryption", "state": "on" if enc else "unknown" if enc is None else "off",
            "value": "/ is on LUKS" if enc else "what / is on cannot be seen" if enc is None else "/ is not encrypted"}]
    if un is None:
        res.append({"id": "unlock", "state": "n/a", "value": "no encrypted disk to open"})
    elif un["tokens"] is None:
        res.append({"id": "unlock", "state": "unknown", "value": "what opens %s is in its LUKS header, root's to read" % (un["device"] or "the disk")})
    else:
        tp = [t for t in un["tokens"] if t["type"] == "systemd-tpm2"]
        nopin = any(t["pin"] is not True for t in tp)
        res.append({"id": "unlock", "state": "off" if nopin else "on",
                    "value": "%s opens by its TPM without a PIN" % un["device"] if nopin else "%s: %s" % (un["device"], "TPM 2.0 with a PIN" if tp else "a passphrase")})
    for r, (_, row_, text) in zip(res, LVL_REQUIRED):
        r["row"], r["requires"] = row_, text
    return res


def lvl_at(rows, req, choice):
    """(level, the item rows that differ from it, the requirements not met or not seen, the item rows not visible):
    level is hardened | default | mixed"""
    mine = [r for r in rows if r["id"] not in choice["without"]]
    on = [r for r in mine if r["state"] in ("on", "pending")]
    off = [r for r in mine if r["state"] == "off"]
    blind = [r for r in mine if r["state"] == "unknown"]
    if not on:
        level, differ = "default", []
    elif not off or choice["level"] == "hardened":      # the owner chose it: hardened, and what is off is said as an exception
        level, differ = "hardened", off
    else:                                               # nobody chose it here and some of it is set
        level, differ = "mixed", on
    return level, differ, [q for q in req if q["state"] in ("off", "unknown")] if level != "default" else [], blind


def lvl_text(path, lines):
    return LVL_HEAD + "\n".join(lines) + "\n"


def lvl_plan(pr, without=(), keep_ssh=False, dry=False):
    """(steps, notes, refused) of `silik secure level hardened` on the system PR. A step: ("run", argv) | ("write",
    path, text, mode) | ("append", path, text) | ("check", argv, the file to take away when it fails, the lines the
    service must then say) | ("state", what was changed) | ("choice", text). refused: [(item, why)], the items whose precondition does not hold: they are
    said and left, the rest is done. Nothing is loosened: an owner's stricter or other value is kept and said."""
    steps, notes, refused = [], [], []
    ids = [i for i in LVL_IDS if i not in without]
    rows = {r["id"]: r for r in lvl_rows(pr)}
    state = json.loads(json.dumps(pr["state"]))
    files = pr["files"]
    for i in ids:
        if rows[i]["state"] == "n/a":
            notes.append("%s: %s" % (i, rows[i]["value"]))
    for i in without:
        if rows[i]["state"] in ("on", "pending"):
            notes.append("%s: set by an earlier run and left as it is (`silik secure level default` puts everything back)" % i)

    # ---- the kernel's command line: one grubby call for all of it
    add = []
    for it in LVL_ITEMS:
        if it["kind"] != "karg" or it["id"] not in ids:
            continue
        if it["id"] == "lockdown" and rows["lockdown"]["state"] == "off":
            if pr["modules"] is None:
                refused.append(("lockdown", "the kernel modules in use cannot be seen here (/sys/module), so whether one of them would stop loading is not known"))
                continue
            uns, sig = sec_foreign(pr["modules"])
            if uns:
                refused.append(("lockdown", "kernel modules without a signature the kernel trusts are in use and would stop loading: %s. Sign them and enrol the key "
                                            "(docs/HARDENED.md), or remove them; or leave this out: --without lockdown" % " ".join(uns[:8])))
                continue
            if sig:
                notes.append("lockdown: kernel modules that are not the base's and are signed: %s. They go on loading only while the key that signed "
                             "them is enrolled (mokutil --list-enrolled)" % " ".join(sig[:8]))
            if any(w.startswith("resume=") for w in pr["cmdline"]):
                notes.append("lockdown: hibernation stops working (resume= is on the command line); suspend to memory is not affected")
        for a in lvl_args(it, pr["arch"]):
            words = [w for e in pr["entries"] for w in e] if pr["entries"] else pr["cmdline"]
            other = lvl_arg_other(words, a) or lvl_arg_other(pr["cmdline"], a)
            if other:
                notes.append("%s: %s is on the kernel's command line (the owner's): kept, %s is not set" % (it["id"], other, a))
                continue
            everywhere = all(lvl_arg_in(e, a) for e in pr["entries"]) if pr["entries"] else lvl_arg_in(pr["cmdline"], a)
            if everywhere:
                continue
            add.append(a)
            # (ours to take off again only when nobody had it before: not on the running kernel, not in any entry)
            if not lvl_arg_in(words, a) and not lvl_arg_in(pr["cmdline"], a) and a not in state["kernel_args"]:
                state["kernel_args"].append(a)
    if add:
        steps.append(("run", as_root(["grubby", "--update-kernel=ALL", "--args=" + " ".join(add)])))
        notes.append("the kernel's arguments are in effect after a restart")

    # ---- kernel settings: one file, loaded alone
    have = lvl_conf_keys(files[LVL_SYSCTL])
    want = []
    for it in LVL_ITEMS:
        if it["kind"] != "sysctl":
            continue
        cur = pr["keys"].get(it["key"])
        if it["key"] in have or (it["id"] in ids and rows[it["id"]]["state"] == "off"):
            want.append((it["key"], it["value"]))
            if it["key"] not in have and cur is not None:
                state["sysctl"].setdefault(it["key"], cur)         # what it was before, for `level default`
    if want and dict((k, str(v)) for k, v in want) != have:
        steps.append(("write", LVL_SYSCTL, lvl_text(LVL_SYSCTL, ["%s = %d" % kv for kv in want]), "0644"))
        if LVL_SYSCTL not in state["files"]:
            state["files"].append(LVL_SYSCTL)
        if pr["online"]:          # (only the keys of this file: not `sysctl --system`, which sets every file's again)
            steps.append(("run", as_root(["sysctl", "-p", LVL_SYSCTL])))
        else:
            notes.append("the kernel settings are read at the next start (no running system here)")

    # ---- the desktop: locks, the login screen, automount
    dconf = False
    for i, path, lines in (("locks", LVL_LOCKS, list(LVL_LOCK_KEYS)),
                           ("automount", LVL_DCONF, ["[org/gnome/desktop/media-handling]", "automount=false", "automount-open=false"]),
                           ("userlist", LVL_GDM, ["[org/gnome/login-screen]", "disable-user-list=true"])):
        if i in ids and rows[i]["state"] == "off":
            steps.append(("write", path, lvl_text(path, lines), "0644"))
            if path not in state["files"]:
                state["files"].append(path)
            dconf = True
    if dconf:
        if pr["dconf"]:
            steps.append(("run", as_root(["dconf", "update"])))
        else:
            notes.append("dconf is not installed: the desktop's files are written and read once it is (dconf update)")

    # ---- wrong passwords
    if "faillock" in ids and rows["faillock"]["state"] == "off":
        if not pr["authselect"]:
            # no profile is selected (seen on installed systems: `authselect current` says so and enable-feature then
            # does nothing): the profile a new installation gets, with the feature; authselect itself keeps a copy of
            # the files it replaces (--force). Run, authselect 1.2.6 in an EL 9 container
            steps.append(("run", as_root(["authselect", "select", "sssd", "with-faillock", "--force"])))
            state["authselect"] = state["authselect"] or "selected"
            notes.append("faillock: no authselect profile was selected: the profile sssd is, as on a new installation; what the PAM files were is "
                         "authselect's own backup (authselect backup-list)")
        elif "with-faillock" not in pr["authselect"]:      # (the features that are on stay: only this one is added)
            steps.append(("run", as_root(["authselect", "enable-feature", "with-faillock"])))
            state["authselect"] = state["authselect"] or True
        k = lvl_conf_keys(files[LVL_FAILLOCK])
        new = ["%s = %d" % (key, v) for key, v in LVL_FAILLOCK_SET if key not in k]
        for key, v in LVL_FAILLOCK_SET:
            if key in k:
                notes.append("faillock: %s has %s = %s (the owner's): kept" % (LVL_FAILLOCK, key, k[key]))
        if new and LVL_MARK[0] not in (files[LVL_FAILLOCK] or ""):
            glue = "" if (files[LVL_FAILLOCK] or "\n").endswith("\n") else "\n"       # (a last line without its end is not joined to ours)
            steps.append(("append", LVL_FAILLOCK, glue + "\n".join([LVL_MARK[0]] + new + [LVL_MARK[1]]) + "\n"))
            state["faillock"] = True

    # ---- NetworkManager
    k = lvl_conf_keys(files[LVL_NM])
    nm = [i for i in ("wifi-mac", "dhcp-name") if all(k.get(s.split("=")[0]) == s.split("=")[1] for s in LVL_NM_SET[i])]
    new = []
    for i in ("wifi-mac", "dhcp-name"):
        if i in ids and rows[i]["state"] == "off":
            if i == "wifi-mac" and pr["remote"] and not keep_ssh:
                refused.append((i, "this is an ssh session, and a new hardware address at the next reconnection would end it: run it at the machine, or with "
                                   "--keep-ssh (written; NetworkManager is not asked to read it again)"))
            else:
                new.append(i)
    if new:
        steps.append(("write", LVL_NM, lvl_text(LVL_NM, ["[connection-silikos-hardened]"] + [s for i in ("wifi-mac", "dhcp-name") if i in nm + new for s in LVL_NM_SET[i]]), "0644"))
        if LVL_NM not in state["files"]:
            state["files"].append(LVL_NM)
        if pr["nm_active"] and not pr["remote"]:
            steps.append(("run", as_root(["nmcli", "general", "reload", "conf"])))
            notes.append("NetworkManager: a connection takes the new settings the next time it comes up")
        else:
            notes.append("NetworkManager reads %s at its next start%s" % (LVL_NM, " (not asked now: this is an ssh session)" if pr["remote"] and pr["nm_active"] else ""))

    # ---- Thunderbolt
    if "thunderbolt" in ids and rows["thunderbolt"]["state"] == "off":
        steps.append(("run", as_root(["boltctl", "config", "auth-mode", "disabled"])))
        state["bolt"] = state["bolt"] or pr["bolt"]
    elif "thunderbolt" in ids and rows["thunderbolt"]["state"] == "unknown":
        refused.append(("thunderbolt", rows["thunderbolt"]["value"]))

    # ---- audit rules: the base's own files, copied; one already there is the owner's
    if "audit" in ids and rows["audit"]["state"] in ("off", "unknown"):
        if rows["audit"]["state"] == "unknown" and not dry:
            refused.append(("audit", rows["audit"]["value"]))
        else:
            if pr["audit"] is None:
                notes.append("audit: %s is root's to read: a real run copies only the rule files that are not there" % LVL_AUDIT)
            for rule in LVL_AUDIT_RULES:
                if rule not in (pr["audit"] or ()):
                    dst = os.path.join(LVL_AUDIT, rule)
                    steps.append(("run", as_root(["install", "-m", "0640", os.path.join(LVL_AUDIT_SRC, rule), dst])))
                    if dst not in state["files"]:
                        state["files"].append(dst)
            if pr["auditd"]:
                steps.append(("run", as_root(["augenrules", "--load"])))
            else:
                notes.append("audit: auditd does not run here: the rules are loaded at its next start")

    # ---- sshd: the file only; sshd reads it again unless this is its own connection
    if "sshd" in ids and rows["sshd"]["state"] in ("off", "unknown"):
        on = pr["sshd"]["active"] or pr["sshd"]["unit"] in ("enabled", "enabled-runtime")
        if rows["sshd"]["state"] == "unknown" and not dry:
            refused.append(("sshd", rows["sshd"]["value"]))
        elif pr["remote"] and not keep_ssh:
            refused.append(("sshd", "this is an ssh session: sshd's settings are not changed from inside it. Run it at the machine, or with --keep-ssh "
                                    "(the file is written; sshd is not asked to read it again)"))
        elif on and not pr["ssh_keys"]:
            refused.append(("sshd", "sshd is on and %s has no key in ~/.ssh/authorized_keys: without passwords nobody could log in. Put a key there first "
                                    "(ssh-copy-id), or leave this out: --without sshd" % (pr["user"] or "this user")))
        else:
            steps.append(("write", LVL_SSHD, lvl_text(LVL_SSHD, list(LVL_SSHD_SET)), "0600"))
            # (-G, not -t: -t also wants host keys, and an sshd that never ran has none; run, openssh 9.9)
            steps.append(("check", as_root(["sshd", "-G"]), LVL_SSHD, [l.lower() for l in LVL_SSHD_SET]))
            if LVL_SSHD not in state["files"]:
                state["files"].append(LVL_SSHD)
            if pr["sshd"]["active"] and not pr["remote"]:
                steps.append(("run", as_root(["systemctl", "reload", "sshd"])))
            elif pr["sshd"]["active"]:
                notes.append("sshd: not asked to read its settings again (this is its own connection): sudo systemctl reload sshd")
            else:
                notes.append("sshd is off: the file is read when it is started")

    left = [w for w in LVL_IDS if w in without]
    if pr["choice"] != {"level": "hardened", "without": left}:
        steps.append(("choice", "hardened" + "".join(" " + w for w in left) + "\n"))
    if state != pr["state"]:
        state["applied"] = time.strftime("%Y-%m-%dT%H:%M:%S")
        steps.append(("state", state))
    return steps, notes, refused


def lvl_unplan(pr):
    """(steps, notes) of `silik secure level default`: what `level hardened` wrote down is put back, and the files
    with its names are removed; a kernel argument it did not add is said and kept"""
    steps, notes = [], []
    st, files = pr["state"], pr["files"]
    words = set(w for e in pr["entries"] for w in e) if pr["entries"] else set(pr["cmdline"])
    words |= set(pr["cmdline"])
    rem = [a for a in st["kernel_args"] if a in words]
    if rem:
        steps.append(("run", as_root(["grubby", "--update-kernel=ALL", "--remove-args=" + " ".join(rem)])))
        notes.append("the kernel's arguments are gone after a restart")
    kept = [a for it in LVL_ITEMS if it["kind"] == "karg" for a in lvl_args(it, pr["arch"]) if a in words and a not in st["kernel_args"]]
    if kept:
        notes.append("on the kernel's command line and not added by this command%s: kept: %s (to take them off: sudo grubby --update-kernel=ALL --remove-args=\"%s\")"
                     % ("" if pr["state_readable"] else " as far as can be seen without root", " ".join(kept), " ".join(kept)))
    if st["bolt"] and pr["bolt"] == "disabled" and st["bolt"] != "disabled":
        steps.append(("run", as_root(["boltctl", "config", "auth-mode", st["bolt"]])))
    if st["faillock"] or LVL_MARK[0] in (files[LVL_FAILLOCK] or ""):
        steps.append(("run", as_root(["sed", "-i", "/^# silikos-hardened: begin/,/^# silikos-hardened: end/d", LVL_FAILLOCK])))
    if st["authselect"] and "with-faillock" in (pr["authselect"] or ()):      # only the feature this command added
        steps.append(("run", as_root(["authselect", "disable-feature", "with-faillock"])))
        if st["authselect"] == "selected":
            notes.append("faillock: the profile sssd stays selected, as on a new installation (no profile was before): the PAM files as they "
                         "were then are authselect's backup (sudo authselect backup-list, sudo authselect backup-restore NAME)")
    gone = [p for p in LVL_OWN if files[p] is not None or p in st["files"]]
    gone += [p for p in st["files"] if p not in gone and os.path.dirname(p) == LVL_AUDIT and os.path.basename(p) in LVL_AUDIT_RULES]
    if not pr["sshd_dir"] and LVL_SSHD not in gone and pr["sshd"]["unit"] != "not-found":
        gone.append(LVL_SSHD)           # (a folder that is root's to read: rm -f of a file that may be there)
    if gone:
        steps.append(("run", as_root(["rm", "-f"] + gone)))
    if any(p in gone for p in (LVL_DCONF, LVL_LOCKS, LVL_GDM)) and pr["dconf"]:
        steps.append(("run", as_root(["dconf", "update"])))
    back = ["%s=%d" % (k, v) for k, v in sorted(st["sysctl"].items()) if k != "kernel.kexec_load_disabled" and pr["keys"].get(k) != v]
    if back and pr["online"]:
        steps.append(("run", as_root(["sysctl", "-w"] + back)))
    if "kernel.kexec_load_disabled" in st["sysctl"] and st["sysctl"]["kernel.kexec_load_disabled"] != 1:
        notes.append("kernel.kexec_load_disabled stays 1 until the next start: the kernel does not take it back")
    if any(os.path.dirname(p) == LVL_AUDIT for p in gone):
        if pr["auditd"]:
            steps.append(("run", as_root(["augenrules", "--load"])))
        notes.append("audit: a login's identity stays unchangeable until the next start (the kernel does not take that back)")
    if LVL_SSHD in gone and pr["sshd"]["active"]:
        if pr["remote"]:
            notes.append("sshd: not asked to read its settings again (this is its own connection): sudo systemctl reload sshd")
        else:
            steps.append(("run", as_root(["systemctl", "reload", "sshd"])))
    if LVL_NM in gone and pr["nm_active"]:
        if pr["remote"]:
            notes.append("NetworkManager reads its settings again at its next start (not asked now: this is an ssh session)")
        else:
            steps.append(("run", as_root(["nmcli", "general", "reload", "conf"])))
    if pr["marks"]:
        steps.append(("run", as_root(["rm", "-f"] + pr["marks"])))
    return steps, notes


def lvl_write(ctx, argv, text, say=None):
    """ARGV run as written, TEXT on its standard input; the text (or SAY, a line about it) printed after the command"""
    ctx.echo(argv)
    if not ctx.quiet:
        print("".join("    | %s\n" % l for l in (text if say is None else say).splitlines()), end="", flush=True)
    if ctx.dry:
        return 0
    ctx.note(argv)
    try:
        return subprocess.run(argv, input=text, universal_newlines=True, stdout=subprocess.DEVNULL).returncode
    except OSError:
        return 127


def lvl_do(ctx, steps):
    """runs the steps in order; the commands that failed. What was meant to change is written down even when one
    failed (taking back what did not happen changes nothing)"""
    failed = []
    for s in steps:
        if s[0] == "run":
            rc, _ = ctx.run(s[1], check=False)
            if rc != 0:
                failed.append(" ".join(shlex.quote(x) for x in s[1]))
        elif s[0] == "check":       # the service reads its configuration with the new file: (argv, the file, the lines it must then say)
            rc, out = ctx.run(s[1], check=False, capture=True)
            if rc != 0:             # a file that the service refuses is not left behind
                failed.append(" ".join(shlex.quote(x) for x in s[1]))
                ctx.run(as_root(["rm", "-f", s[2]]), check=False)
            elif not ctx.dry:
                have = set(" ".join(l.split()) for l in out.lower().splitlines())
                lost = [l for l in s[3] if l not in have]
                if lost:
                    failed.append("%s is written, but another line of the service's configuration is read first: not in effect: %s" % (s[2], "; ".join(lost)))
        elif s[0] == "write":
            if lvl_write(ctx, as_root(["install", "-D", "-m", s[3], "/dev/stdin", s[1]]), s[2]) != 0:
                failed.append("write " + s[1])
        elif s[0] == "append":
            if lvl_write(ctx, as_root(["tee", "-a", s[1]]), s[2]) != 0:
                failed.append("append to " + s[1])
        elif s[0] == "choice":
            if lvl_write(ctx, as_root(["install", "-D", "-m", "0644", "/dev/stdin", LVL_CHOICE]), s[1]) != 0:
                failed.append("write " + LVL_CHOICE)
        elif s[0] == "state":
            say = "what this command changed, for `silik secure level default`: %d kernel arguments, %d kernel settings, %d files" % (
                len(s[1]["kernel_args"]), len(s[1]["sysctl"]), len(s[1]["files"]))
            if lvl_write(ctx, as_root(["install", "-D", "-m", "0600", "/dev/stdin", LVL_STATE]), json.dumps(s[1], indent=1, sort_keys=True) + "\n", say) != 0:
                failed.append("write " + LVL_STATE)
    return failed


def lvl_list():
    lines = ["the hardened level: what each item sets, and what stops working with it (docs/HARDENED.md)"]
    for it in LVL_ITEMS:
        lines.append("%-12s %-4s %s" % (it["id"], it["row"], it["sets"]))
        lines.append("%-17s costs: %s" % ("", it["cost"]))
    lines.append("required, and only checked (the level then says \"hardened, except: ...\"):")
    lines += ["%-12s %-4s %s" % r for r in LVL_REQUIRED]
    lines.append("leave an item out: silik secure level hardened --without ID [--without ID ...]; go back: silik secure level default")
    lines.append("[A]: not run or not seen where this was written; [PROPOSAL values]: the owner's to change")
    lines.append("not part of the level, on purpose:")
    lines += ["  - " + r for r in LVL_REFUSED]
    return "\n".join(lines)


def lvl_summary(level, differ, unmet, blind, choice, refused=()):
    """the level in one line: hardened | hardened, except: ... | default | mixed: ..."""
    why = dict(refused)
    exc = [q["value"] for q in unmet if q["state"] == "off"]
    exc += ["%s (%s)" % (r["id"], re.split(r"[:.] ", why[r["id"]])[0]) if r["id"] in why else r["id"] + " is off" for r in differ if level == "hardened"]
    line = level + (", except: " + "; ".join(exc) if exc and level == "hardened" else "")
    if level == "mixed":
        line += ": set, of the hardened level: " + " ".join(r["id"] for r in differ) + ("; " + "; ".join(exc) if exc else "")
    unseen = [q["value"] for q in unmet if q["state"] == "unknown"]
    if unseen and level != "default":
        line += "; required and not seen here: " + "; ".join(unseen)
    if choice["without"] and level != "default":
        line += "; left out by choice: " + " ".join(choice["without"])
    if blind:
        line += "; not visible without root: %s (sudo silik secure level)" % " ".join(r["id"] for r in blind)
    return line


def lvl_after(pr, without, refused, dry=False):
    """the level in one line as it is once the plan's steps ran: what the plan set counts as set, and an item that
    was refused is an exception whatever could be seen of it (under --dry-run: as it would be)"""
    no = set(i for i, _ in refused)
    done = set(i for i in LVL_IDS if i not in without) - no
    rows = [dict(r, state="off") if r["id"] in no else
            dict(r, state="on") if r["id"] in done and (r["state"] == "off" or (dry and r["state"] == "unknown")) else r for r in lvl_rows(pr)]
    choice = {"level": "hardened", "without": [w for w in LVL_IDS if w in without]}
    level, differ, unmet, blind = lvl_at(rows, lvl_required(pr), choice)
    if not any(r["state"] in ("on", "pending") for r in rows):
        level = "default"           # (nothing of it could be set here)
    return lvl_summary(level, differ, unmet, blind, choice, refused)


def lvl_sudo(ctx, a, argv):
    """a real run is root's (the note of what was changed is root's to read and to write): this command again, with sudo"""
    # (the program that is running, by its path: not whatever `silik` comes first in the user's PATH at that moment,
    # which would be run as root)
    me = os.path.realpath(sys.argv[0])
    rc, _ = ctx.run(["sudo", me] + (["-q"] if ctx.quiet else []) + argv, check=False)
    return rc


def secure_level(ctx, a):
    without = [w for x in a.without for w in x.replace(",", " ").split()]
    bad = [w for w in without if w not in LVL_IDS]
    if bad:
        die("silik secure level: no item %s; the items are %s" % (" ".join(bad), " ".join(LVL_IDS)), 2)
    if a.list:
        print(lvl_list())
        return 0
    if (without or a.keep_ssh) and a.name != "hardened":
        die("--without and --keep-ssh go with `silik secure level hardened`", 2)
    if a.name and os.geteuid() != 0 and not ctx.dry:
        return lvl_sudo(ctx, a, ["secure", "level", a.name] + [x for w in without for x in ("--without", w)] + (["--keep-ssh"] if a.keep_ssh else []))
    pr = lvl_probe()
    if a.name == "hardened":
        steps, notes, refused = lvl_plan(pr, without, a.keep_ssh, ctx.dry)
        failed = lvl_do(ctx, steps)
        for n in notes:
            print(n)
        for i, why in refused:
            print("not set: %s: %s" % (i, why))
        for f in failed:
            print("silik: failed: " + f, file=sys.stderr)
        if not steps:
            print("nothing to change: every item%s is set, left to the owner's value, or not on this system" % (" asked" if without else ""))
        # (the level as it is once the steps ran: what the plan set counts as set; under --dry-run, as it would be)
        print("level: " + lvl_after(pr, without, refused, ctx.dry) + (" (after this dry run's commands)" if ctx.dry else ""))
        print("`silik secure level` shows each item; `silik secure level default` puts back what this changed")
        return 1 if failed else 0
    if a.name == "default":
        if not pr["state_readable"] and ctx.dry:
            print("silik: what `level hardened` wrote down (%s) is root's to read: a real run reads it; this dry run lists what can be seen" % LVL_STATE, file=sys.stderr)
        steps, notes = lvl_unplan(pr)
        failed = lvl_do(ctx, steps)
        for n in notes:
            print(n)
        for f in failed:
            print("silik: failed: " + f, file=sys.stderr)
        if not steps:
            print("nothing to put back: `silik secure level hardened` has changed nothing on this system")
        else:
            print("put back as it was before `silik secure level hardened`; the default level's own settings are `silik secure apply`'s")
        return 1 if failed else 0
    rows, req = lvl_rows(pr), lvl_required(pr)
    level, differ, unmet, blind = lvl_at(rows, req, pr["choice"])
    summary = lvl_summary(level, differ, unmet, blind, pr["choice"])
    if a.json:
        print(json.dumps({"level": level, "summary": summary, "choice": pr["choice"], "differ": [r["id"] for r in differ],
                          "except": [q["id"] for q in unmet if q["state"] == "off"], "unseen": [q["id"] for q in unmet if q["state"] == "unknown"] + [r["id"] for r in blind],
                          "items": rows, "required": req, "state_file": LVL_STATE, "choice_file": LVL_CHOICE}, indent=1))
        return 0
    lines = ["level: " + summary]
    for r in rows:
        out_ = r["id"] in pr["choice"]["without"]
        lines.append("%s %-8s %-12s %-4s %s%s" % ("●" if r["state"] == "on" else "◆" if r["state"] == "pending" else "?" if r["state"] == "unknown" else " ",
                                                 r["state"], r["id"], r["row"], r["value"], " (left out by choice)" if out_ else ""))
    lines.append("required by the hardened level, checked only:")
    for q in req:
        lines.append("%s %-8s %-12s %-4s %s" % ("●" if q["state"] == "on" else "▼" if q["state"] == "off" else "?" if q["state"] == "unknown" else " ",
                                               q["state"], q["id"], q["row"], q["value"]))
    lines.append("`silik secure level hardened --list`: what each item sets and costs; `silik secure level hardened [--without ID]` sets them; "
                 "`silik secure level default` goes back")
    text = "\n".join(lines)
    try:
        print(text)
    except UnicodeEncodeError:
        print(text.encode("ascii", "replace").decode("ascii"))
    return 0


