        x = vd.add_parser("prepare", help="runs the commands `check` gives (each printed; --dry-run runs nothing); what is left to the person is said")
        x.add_argument("tools", nargs="*", metavar="TOOL"); x.add_argument("--all", action="store_true"); x.set_defaults(fn=vendor_prepare)
        x = vd.add_parser("lib", help="the EL 9 package that holds a library a program asks for (libtinfo.so.5 ...)")
        x.add_argument("names", nargs="+", metavar="LIBRARY"); x.set_defaults(fn=vendor_lib)
        x = vd.add_parser("names"); x.set_defaults(fn=vendor_names)      # (for tools/check_deps.sh)

    mf = s.add_parser("manifest", help="this machine's packages, repositories, settings and boxes as one file; what differs from one; bring this machine to it").add_subparsers(dest="cmd")
    if only in (None, "manifest"):
        x = mf.add_parser("export", help="write the manifest (to FILE, or to the terminal)")
        x.add_argument("file", nargs="?"); x.add_argument("--with-host", action="store_true", help="also this machine's name, user and network addresses")
        x.set_defaults(fn=manifest_export)
        x = mf.add_parser("diff", help="what differs between this machine and FILE (exit 0: the same)")
        x.add_argument("file"); x.add_argument("--json", action="store_true"); x.set_defaults(fn=manifest_diff_cmd)
        x = mf.add_parser("apply", help="the dnf transaction and the silik commands that bring this machine to FILE, each printed")
        x.add_argument("file"); x.add_argument("--prune", action="store_true", help="also remove the packages (and kernel arguments) that are here and not in FILE")
        x.add_argument("--kernel", action="store_true", help="also install the kernel packages of FILE and set its kernel arguments (otherwise the kernel is left alone)")
        x.add_argument("--downgrade", action="store_true", help="also take packages that are newer here back to FILE's versions (otherwise they are kept)")
        x.set_defaults(fn=manifest_apply)
    sn = s.add_parser("snapshot", help="snapshots of / (LVM thin, snapm): list | create [NAME] | delete NAME | status | setup (no command: status)")
    sn.add_argument("--json", action="store_true"); sn.set_defaults(fn=snap_status)
    sn = sn.add_subparsers(dest="cmd", metavar="{status,list,create,delete,setup}")
    if only in (None, "snapshot"):
        x = sn.add_parser("status", help="is there a way back: the root volume, the pool's use and growth, the snapshots kept, /boot"); x.add_argument("--json", action="store_true"); x.set_defaults(fn=snap_status)
        x = sn.add_parser("list", help="the snapshots, newest first"); x.add_argument("--json", action="store_true"); x.set_defaults(fn=snap_list)
        x = sn.add_parser("create", help="a snapshot of / now, with its entries in the boot menu (no NAME: manual.N)"); x.add_argument("name", nargs="?"); x.set_defaults(fn=snap_create)
        x = sn.add_parser("delete", help="delete a snapshot and its boot entries"); x.add_argument("name"); x.add_argument("--yes", action="store_true"); x.set_defaults(fn=snap_delete)
        x = sn.add_parser("setup", help="on a running system: snapm and boom-boot, the thin pool grows by itself, weekly trim"); x.set_defaults(fn=snap_setup)
        x = sn.add_parser("auto"); x.set_defaults(fn=snap_auto)     # (the update hook's own, not listed: a snapshot, then the old ones pruned)

    c = s.add_parser("secure", help="security: an audit of this system, and the SilikOS defaults").add_subparsers(dest="cmd")
    if only in (None, "secure"):
        x = c.add_parser("status", help="read-only audit: ok / warn / bad / unknown, and the command that fixes each")
        x.add_argument("--json", action="store_true")
        x.add_argument("--offline", action="store_true", help="pending updates from dnf's cache only: the repositories are not asked")
        x.set_defaults(fn=secure_status)
        x = c.add_parser("apply", help="set the SilikOS defaults; never loosens what is stricter, never touches a disk")
        x.add_argument("--keep-ssh", action="store_true", help="leave sshd as it is and keep its port open in the firewall zone")
        x.set_defaults(fn=secure_apply)
        x = c.add_parser("level", help="the level this system is at (default / hardened / mixed); `hardened` sets the hardened level, `default` puts back what that changed")
        x.add_argument("name", nargs="?", choices=["hardened", "default"])
        x.add_argument("--list", action="store_true", help="the items of the hardened level: what each sets, what stops working, what is refused on purpose")
        x.add_argument("--without", action="append", default=[], metavar="ITEM", help="with hardened: leave this item out (see --list); may be given more than once")
        x.add_argument("--keep-ssh", action="store_true", help="with hardened, in an ssh session: write sshd's and NetworkManager's files anyway (neither is asked to read them again)")
        x.add_argument("--json", action="store_true")
        x.set_defaults(fn=secure_level)
    for name, (_, text) in plugins().items():
        if name in s.choices:        # (a plugin never replaces a command of silik's own)
            continue
        g = s.add_parser(name, help=text)
        if only == name:
            # (a plugin gets the parser itself: it is the command typed, and a plugin may read what it made)
            load_plugin(name).register(g._build(), sys.modules.get(__name__) or sys.modules["__main__"])   # (this module, however it was loaded)
    return p


WIN_SWITCHES = ("--prefix", "--no-net", "--no-sandbox", "--isolated", "--sound", "--yes")


GROUPS = ("eda", "dev", "win", "power", "speed", "bench", "hw", "secure", "vendor", "manifest", "snapshot")   # the groups with commands of their own (parser(only=...))


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    # the global switches take no value, so the first word that is not a switch is the group
    first = next((x for x in argv if not x.startswith("-")), None)
    p = parser(first if first in GROUPS or first in plugins() else None)
    # the global switches are taken anywhere before a "--" (`silik secure apply --dry-run` as `silik --dry-run ...`)
    cut = argv.index("--") if "--" in argv else len(argv)
    # (after `win open FILE` / `win run PREFIX` / `win install PREFIX SETUP` the words are the Windows program's own:
    # its -q or --dry-run are not silik's)
    gcut, pos, i = cut, [], 0
    while i < cut:   # where the words that are not switches are (the value of a bare --prefix is not one)
        if argv[i] == "--prefix":
            i += 2
            continue
        if not argv[i].startswith("-"):
            pos.append(i)
        i += 1
    words = [argv[k] for k in pos]
    prog = {"open": 2, "run": 2, "install": 3}.get(words[1] if len(words) > 1 and words[0] == "win" else "")
    if prog and len(words) > prog:
        gcut = pos[prog]
    head = [x for x in argv[:gcut] if x not in ("--dry-run", "-q", "--quiet")] + argv[gcut:cut]
    glob_ = [x for x in argv[:gcut] if x in ("--dry-run", "-q", "--quiet")]
    a = p.parse_args(glob_ + head + argv[cut:])
    if not getattr(a, "fn", None):
        # a group without its command: that group's help (silik eda, silik win vm)
        words = [w for w in (getattr(a, "group", None), getattr(a, "cmd", None) if getattr(a, "group", None) == "win" else None) if w]
        try:
            p.parse_args(words + ["--help"]) if words else p.print_help()
        except SystemExit:
            pass
        return 2
    # `silik win open FILE --no-net` would hand --no-net to the Windows program and run it with the network: the
    # switches go before FILE (PREFIX for `win run`); after a "--" they are the program's own. (Read from the words
    # typed: argparse's REMAINDER keeps or drops the "--" depending on the Python version)
    if a.fn in (win_open, win_run, win_install):
        words = head[head.index(a.group) + 2:] if a.group in head else []
        seen, i = False, 0
        while i < len(words):
            w = words[i]
            if w.split("=")[0] in WIN_SWITCHES:
                if seen:
                    die("the switches %s go before %s: silik win %s [--prefix P] [--isolated] [--no-net] [--no-sandbox] %s"
                        % ("/".join(WIN_SWITCHES), "FILE" if a.fn is win_open else "PREFIX",
                           {win_open: "open", win_run: "run", win_install: "install"}[a.fn],
                           {win_open: "FILE [ARGS]", win_run: "PREFIX -- PROG.exe [ARGS]", win_install: "PREFIX SETUP [ARGS]"}[a.fn]), 2)
                i += 2 if w == "--prefix" else 1
                continue
            seen = True
            i += 1
    for k in ("cmd", "args"):   # argparse.REMAINDER keeps the "--" separator
        v = getattr(a, k, None)
        if isinstance(v, list) and v and v[0] == "--":
            setattr(a, k, v[1:])
    return a.fn(Ctx(a.dry_run, a.quiet), a) or 0


if __name__ == "__main__":
    sys.exit(main())
