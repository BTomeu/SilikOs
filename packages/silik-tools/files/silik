def doc_check_bench(st):
    rows = []
    rc, ipj = st["ip"]
    links = can_parse(ipj) if rc == 0 else None
    usb = st["usb"]
    table = st["table"]
    root = st["uid"] == 0
    done_ttys = set()
    if links is None:
        doc_row(rows, "bench", "can", "CAN", "unknown", "`ip` gives no list of interfaces" if rc != 0 else "`ip -json` gave something else",
                ["ip -details -statistics link show"])
    for c in links or []:
        drv, prod = st["whats"].get(c["name"], ("", ""))
        who = " ".join(x for x in (prod, "(%s)" % drv if drv else "(%s)" % c["kind"] if c["kind"] else "") if x)
        rate = c["bitrate"]
        cnt = []
        if c["berr"]:
            cnt.append("error counters tx %s rx %s" % (c["berr"].get("tx", "?"), c["berr"].get("rx", "?")))
        xs = c["xstats"]
        if xs.get("bus_error") or xs.get("bus_off") or xs.get("restarts"):
            cnt.append("since up: %s bus errors, %s bus-off, %s restarts" % (xs.get("bus_error", 0), xs.get("bus_off", 0), xs.get("restarts", 0)))
        if c["rx_err"] or c["tx_err"]:
            cnt.append("frames with errors rx %s tx %s" % (c["rx_err"] or 0, c["tx_err"] or 0))
        head = "%s%s" % (who + ": " if who else "", ", ".join(x for x in (
            bitrate(rate) if rate else "", "data " + bitrate(c["dbitrate"]) if c["dbitrate"] else "",
            "listen only" if "LISTEN-ONLY" in c["ctrl"] else "") if x))
        up = (["sudo ip link set %s up" % c["name"]] if c["kind"] in ("vcan", "") else
              ["silik dev can up %s %s" % (c["name"], rate_word(rate) if rate else "500k")])
        hint = "check: one bit rate on every node; 120 ohm at both ends of the bus (60 ohm across CAN_H and CAN_L, power off); another node that acknowledges"
        errs = "candump -e %s,0~0,#FFFFFFFF   # the error frames" % c["name"]
        state = (c["state"] or "").upper()
        if not c["up"]:
            doc_row(rows, "bench", "can", c["name"], "warn", "down%s" % ("; " + head if head else ""), up)
        elif state == "BUS-OFF":
            doc_row(rows, "bench", "can", c["name"], "bad", "bus-off: the adapter stopped sending; %s" % "; ".join([head] + cnt),
                    [errs, hint, "sudo ip link set %s down && %s" % (c["name"], up[0])])
        elif state in ("ERROR-WARNING", "ERROR-PASSIVE"):
            doc_row(rows, "bench", "can", c["name"], "warn", "%s; %s" % (state.lower(), "; ".join([head] + cnt)), [errs, hint])
        elif state in ("STOPPED", "SLEEPING"):
            doc_row(rows, "bench", "can", c["name"], "warn", "%s; %s" % (state.lower(), head), up)
        else:
            doc_row(rows, "bench", "can", c["name"], "ok", "up%s; %s" % (", " + state.lower() if state else "", "; ".join([head] + cnt + ([] if state else ["no bus state from this driver"]))))
    if usb is None:
        doc_row(rows, "bench", "usb", "USB devices", "unknown", "/sys/bus/usb is not readable" + (" (inside a container)" if st["container"] else ""))
        usb = []
    for u in usb:
        r = hw_match(table, u["vid"], u["pid"], u["product"])
        if not r:
            continue
        vp = "%s:%s" % (u["vid"], u["pid"])
        nm = (u["product"] or r["name"]) if r["id"].startswith("product=") or r["id"].endswith(":*") else r["name"]
        label = "%s [%s]" % (nm, vp)
        kind, drv = r["kind"], r["driver"]
        done_ttys.update("/dev/" + t for t in u["ttys"])
        if kind == "can":
            if u["nets"]:
                continue                    # (said with its interface above)
            if drv in u["drivers"]:
                doc_row(rows, "bench", "usb-" + vp, r["name"], "unknown", "%s: driver %s, no CAN interface seen" % (label, drv), ["ip -details link show"])
            elif r.get("el9") == "no":
                doc_row(rows, "bench", "usb-" + vp, r["name"], "bad", "%s: EL 9's %s does not know this product (it is in newer kernels: %s)" % (label, drv, r["source"]),
                        ["no driver on SilikOS for it yet; another adapter, or Windows in the VM: silik win vm usb attach " + vp])
            else:
                doc_row(rows, "bench", "usb-" + vp, r["name"], "warn", "%s: the driver %s is not bound" % (label, drv), ["sudo modprobe " + drv])
            continue
        tty = "/dev/" + u["ttys"][0] if u["ttys"] else ""
        if kind == "can-slcan":
            if not tty:
                doc_row(rows, "bench", "usb-" + vp, r["name"], "warn", "%s: no serial port (cdc_acm not bound)" % label, ["sudo modprobe cdc_acm"])
            else:
                fix = ([] if st["slcand"] else ["sudo dnf -y install can-utils   # slcand"]) + \
                      ["sudo slcand -o -c -s6 %s can0 && sudo ip link set can0 up   # -s6: 500 kbit/s (s4 125k, s5 250k, s8 1M)" % tty,
                       "or flash its candleLight firmware: then it is a gs_usb adapter, can0 at once"]
                doc_row(rows, "bench", "usb-" + vp, r["name"], "warn", "%s on %s: a serial port, not yet a CAN interface (slcan)" % (label, tty), fix)
            continue
        if kind == "serial":
            if not u["ttys"]:
                doc_row(rows, "bench", "usb-" + vp, r["name"], "warn", "%s: no serial port (%s not bound)" % (label, drv), ["sudo modprobe " + drv])
                continue
            node, acc, how = tty, u["tty_access"].get(tty), r["use"].replace("TTY", tty)
        else:
            node, acc = u["node"], u["access"]
            how = r["use"].replace("VID:PID", vp)
            if tty:
                how += "; its serial port: tio " + tty
        if root:
            doc_row(rows, "bench", "usb-" + vp, r["name"], "unknown", "%s: seen as root, the user's access is not checked" % label, ["silik doctor bench   # as the user"])
        elif acc is None:
            doc_row(rows, "bench", "usb-" + vp, r["name"], "unknown", "%s: no device node %s" % (label, node or "") , ["ls -l /dev/bus/usb/*/*"])
        elif not acc:
            doc_row(rows, "bench", "usb-" + vp, r["name"], "warn", "%s: %s is not yours" % (label, node),
                    [f.replace("NODE", node) for f in doc_access_fix(st, kind, "it")])
        else:
            doc_row(rows, "bench", "usb-" + vp, r["name"], "ok", "%s: yours; %s" % (label, how))
    for p in st["ports"]:
        if p["dev"] in done_ttys or not re.match(r"^/dev/tty(USB|ACM)\d+$", p["dev"]):
            continue
        label = "%s (%s)" % (p["dev"], " ".join(x for x in (p["product"], p["driver"]) if x) or "serial port")
        if root:
            doc_row(rows, "bench", "tty-" + p["dev"], "serial", "unknown", "%s: seen as root, the user's access is not checked" % label, ["silik doctor bench   # as the user"])
        elif p["access"] is False:
            doc_row(rows, "bench", "tty-" + p["dev"], "serial", "warn", "%s is not yours" % label, [f.replace("NODE", p["dev"]) for f in doc_access_fix(st, "serial", "it")])
        elif p["access"]:
            doc_row(rows, "bench", "tty-" + p["dev"], "serial", "ok", "%s: yours; tio %s" % (label, p["dev"]))
    if not rows and st["usb"] is not None and links is not None:
        doc_row(rows, "bench", "bench", "bench", "ok", "no CAN interface; none of the %d USB devices SilikOS knows is plugged in" % len(table)
                if table else "no CAN interface; the list of known devices (%s) is missing" % HARDWARE)
    elif not table:
        doc_row(rows, "bench", "hardware", "known devices", "unknown", "the list of known devices (%s) is missing" % HARDWARE, ["sudo dnf -y reinstall silik-tools"])
    return rows


