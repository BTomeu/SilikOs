    else:
        row("iommu", "IOMMU", "ok", "on (%s)%s" % (" ".join(io["units"][:3]), {("DMA",): ", strict", ("DMA-FQ",): ", lazy: a freed mapping stays valid for a moment"}.get(tuple(io["types"]), "")))

    tb = m["thunderbolt"]
    if tb is None:
        row("thunderbolt", "Thunderbolt", "unknown", "/sys/bus is not readable" + here)
    elif not tb:
        row("thunderbolt", "Thunderbolt", "ok", "no Thunderbolt or USB4 controller in use")
    else:
        val = ", ".join("%s: %s%s" % (d["domain"], d["security"] or "?", " + the kernel's DMA protection" if d["iommu"] else "") for d in tb)
        if any(d["security"] is None for d in tb):
