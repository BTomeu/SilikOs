def devsim_module():
    """the folder of DEVSIM's Python module, or None. Looked for, not imported: importing it loads its libraries.
    /usr/bin/silik runs without the site module (python3 -S: 2-3 ms of every start), so its own path has no
    site-packages, where the module is: those folders are asked of site. (13/11/2026: the first system installed
    after -S said "devsim is not on the system" with DEVSIM installed; the offline ISO's run caught it)"""
    import importlib.machinery
    import site
    try:
        paths = list(sys.path) + [d for d in site.getsitepackages() if d not in sys.path]
        spec = importlib.machinery.PathFinder.find_spec("devsim", paths)
    except (ImportError, ValueError):
        return None
    return os.path.dirname(spec.origin) if spec and spec.origin else None


def rpm_versions(pkgs):
    """{package: version} for those of PKGS that are installed, from one rpm call (not one per package: each call
    opens the package database again). Two installed copies of a package (two architectures) give their versions
    run together, as `rpm -q --qf %{VERSION} PACKAGE` does. Read-only, not echoed, like Ctx.query"""
    pkgs = sorted(set(pkgs))
    if not pkgs or not shutil.which("rpm"):
        return {}
    try:
        p = subprocess.run(["rpm", "-q", "--qf", "%{NAME}\t%{VERSION}\n"] + pkgs, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, universal_newlines=True)
    except (FileNotFoundError, PermissionError):
        return {}
    out = {}
    for l in p.stdout.splitlines():     # (a package that is not installed is a line "package X is not installed")
        n, tab, v = l.partition("\t")
        if tab and n in pkgs:
            out[n] = out.get(n, "") + v.strip()
    return out


def tool_where(exe):
    """where a tool is: a program of the PATH; DEVSIM has no program of its own, it is a module of the system's Python
    (the one silik runs on); "file:NAME" is a file of the jobs (a job whose file came with a newer silik-eda-open)"""
    if exe.startswith("file:"):
        p = os.path.join(EDA_TRY, exe[5:])
        return p if os.path.isfile(p) else None
    return devsim_module() if exe == "devsim" else shutil.which(exe)


def spiceinit():
    return os.path.join(os.path.expanduser("~"), ".spiceinit")


def cpu_cores():
    """physical cores (two threads of one core count once), else the processors the system shows"""
    seen = set()
    for l in read("/proc/cpuinfo").split("\n\n"):
        f = dict((k.strip(), v.strip()) for k, _, v in (x.partition(":") for x in l.splitlines()))
        if "core id" in f:
            seen.add((f.get("physical id", "0"), f["core id"]))
    return len(seen) or os.cpu_count() or 1


def ngspice_threads():
    """the number `silik eda tune` wrote in ~/.spiceinit, or None (ngspice's default)"""
    m = re.search(r"^set num_threads *= *(\d+)", read(spiceinit()), re.M)
    return int(m.group(1)) if m else None


def eda_tools(ctx, a):
    rows, paths = [], [tool_where(exe) for exe, _, _ in OPEN_TOOLS]
    vers = rpm_versions(pkg for (_, pkg, _), path in zip(OPEN_TOOLS, paths) if path)
    for (exe, pkg, what), path in zip(OPEN_TOOLS, paths):
        ver = vers.get(pkg, "") if path else ""
        rows.append({"tool": exe, "package": pkg, "for": what, "path": path, "version": ver if ver and " " not in ver else ""})
    n = ngspice_threads()
    if a.json:
        print(json.dumps({"tools": rows, "ngspice_threads": n, "cores": cpu_cores()}, indent=1))
        return 0
    lines = ["%s %-10s %-12s %s" % (SEC_MARK["ok" if r["path"] else "unknown"], r["tool"],
                                    (r["version"] or "found") if r["path"] else "missing", r["for"]) for r in rows]
    if shutil.which("ngspice"):
        lines.append("ngspice threads: %s; this machine has %d cores%s" % (
            n if n else "2 (its default)", cpu_cores(), "" if n else "  (`silik eda tune` sets them; `silik eda bench` measures)"))
    missing = [r["package"] for r in rows if not r["path"]]
    if missing:
        lines.append("missing: sudo dnf install " + " ".join(missing))
    text = "\n".join(lines)
    try:
        print(text)
    except UnicodeEncodeError:
        print(text.encode("ascii", "replace").decode("ascii"))
    return 0


