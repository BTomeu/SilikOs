# The accent (key "accent", silikos-desktop 0.13): one colour for what is selected, focused, on or running; text,
# frames and the mark stay ink on paper; NAME-vivid also gives the title bars a deep tone of it. Its colours are silikos-desktop's (tools/gen_accents.py); the extension
# follows the key, GTK programs and the shell's own parts follow the themes SilikOS-<accent> (gtk-theme and
# shell-theme make them on the system), which this sets with the key, and Qt 5 programs the user's qt5ct.conf
# (qt_accent). "ink" is the look without an accent: SilikOS.
ACCENTS = (
    ("ink", "one ink on paper, the original"),
    ("steel", "steel #3e5c76"),
    ("steel-vivid", "steel #3e5c76, the title bars in #2a3846"),
    ("cobalt", "cobalt #2f5fe0"),
    ("cobalt-vivid", "cobalt #2f5fe0, the title bars in #22366c"),
    ("silicon", "silicon indigo #4338b8"),
    ("silicon-vivid", "silicon indigo #4338b8, the title bars in #332c7a"),
    ("volt", "volt violet #6d28d9"),
    ("volt-vivid", "volt violet #6d28d9, the title bars in #482285"),
    ("spark", "spark yellow #f2c230"),
)
THEMES = "/usr/share/themes"
ICONS = "/usr/share/icons"
USER_THEME = "org.gnome.shell.extensions.user-theme"
# Qt 5 programs (KLayout, SavvyCAN, PulseView) take their palette from qt5ct (silikos-desktop 0.15: the session's
# QT_QPA_PLATFORMTHEME); qt5ct reads the user's ~/.config/qt5ct/qt5ct.conf, made from silikos-desktop's
# /etc/xdg/qt5ct/qt5ct.conf. The accent's palette is a file of silikos-desktop (tools/gen_accents.py)
QT_SCHEMES = "/usr/share/silikos/qt"
QT5CT_GLOBAL = "/etc/xdg/qt5ct/qt5ct.conf"
QT5CT_PLUGIN_DIRS = tuple(os.environ.get("SILIK_QT5CT_PLUGIN_DIRS", "/usr/lib64/qt5/plugins/platformthemes").split(":"))


def qt5ct_conf(text, keys):
    """TEXT (a qt5ct.conf) with KEYS ({key: value}) set in its [Appearance], every other line as it was"""
    lines = text.splitlines()
    start = next((i for i, l in enumerate(lines) if l.strip() == "[Appearance]"), None)
    if start is None:
        lines += ([""] if lines and lines[-1].strip() else []) + ["[Appearance]"]
        start = len(lines) - 1
    end = next((i for i in range(start + 1, len(lines)) if lines[i].strip().startswith("[")), len(lines))
    left = dict(keys)
    for i in range(start + 1, end):
        k = lines[i].split("=", 1)[0].strip()
        if k in left:
            lines[i] = "%s=%s" % (k, left.pop(k))
    while end > start + 1 and not lines[end - 1].strip():      # (new keys go after the section's last line)
        end -= 1
    lines[end:end] = ["%s=%s" % kv for kv in left.items()]
    return "\n".join(lines) + "\n"


def qt_accent(ctx, accent, icons):
    """the user's qt5ct.conf takes the accent's palette and the icon theme (from silikos-desktop's file when the user
    has none yet); a running Qt 5 program follows it at once (qt5ct watches the file)"""
    scheme = os.path.join(QT_SCHEMES, accent + ".conf")
    if not os.path.isfile(scheme) or not any(os.path.isfile(os.path.join(d, "libqt5ct.so")) for d in QT5CT_PLUGIN_DIRS):
        return   # (qt5ct is only recommended: without it nothing reads the file)
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "qt5ct", "qt5ct.conf")
    old = read(path, None)
    new = qt5ct_conf(old if old is not None else read(QT5CT_GLOBAL, ""),
                     {"custom_palette": "true", "color_scheme_path": scheme, "icon_theme": icons})
    if new == old:
        return
    if not ctx.quiet:
        print("%s %s  (Qt 5 programs: color_scheme_path=%s icon_theme=%s)" % ("~" if old is not None else "+", path, scheme, icons))
    if ctx.dry:
        return
    try:
        # written beside it and renamed over it: qt5ct watches the folder, whose entries change only so (a file
        # rewritten in place left running programs as they were, seen in the rig 12/11/2026)
        path = os.path.realpath(path)   # (a dotfiles link stays a link)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        import tempfile
        fd, tmp = tempfile.mkstemp(prefix=".qt5ct.conf.", dir=os.path.dirname(path))
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(new)
            os.chmod(tmp, 0o644)
            os.replace(tmp, path)
        except BaseException:
            os.unlink(tmp)
            raise
    except OSError as e:
        die("could not write %s: %s" % (path, e.strerror or e))


def look_now(ctx):
    """the look in use, or '' when the setting is not on this system (silikos-desktop older than 0.11, or no desktop)"""
    v = ctx.query(["gsettings", "get", LOOK_SCHEMA, "look"]).strip().strip("'")
    return v if v in [k for k, _ in LOOKS] else ""


def accent_now(ctx):
    """the accent in use, or '' when the key is not on this system (silikos-desktop older than 0.13)"""
    v = ctx.query(["gsettings", "get", LOOK_SCHEMA, "accent"]).strip().strip("'")
    return v if v in [k for k, _ in ACCENTS] else ""


def accent_theme(ident):
    return "SilikOS" if ident == "ink" else "SilikOS-" + ident


def accent_icons(ctx, accent):
    """the icons: in ink with the ink, with a band of colour per kind of file with an accent (tools/gen_icons.py)"""
    return "SilikOS" if accent == "ink" or (not ctx.dry and not os.path.isdir(os.path.join(ICONS, "SilikOS-Colour"))) else "SilikOS-Colour"


def cmd_look(ctx, a):
    if a.qt:
        # Qt 5 programs brought in line with the accent in use (the shell runs it at login and at each change of the
        # accent: a user's qt5ct.conf seeded from the ink one, or an accent set with gsettings, follows it)
        acc = accent_now(ctx) or "ink"
        qt_accent(ctx, acc, accent_icons(ctx, acc))
        return 0
    now = look_now(ctx)
    if a.which is None and a.accent is None:
        acc = accent_now(ctx) if now else ""
        if a.json:
            print(json.dumps({"look": now or None, "looks": [k for k, _ in LOOKS],
                              "accent": acc or None, "accents": [k for k, _ in ACCENTS]}))
            return 0 if now else 1
        for k, what in LOOKS:
            print("%s %-7s %s" % ("●" if k == now else " ", k, what))
        if acc:
            for k, what in ACCENTS:
                print("%s %-7s accent: %s" % ("●" if k == acc else " ", k, what))
        if not now:
            print("silik: no setting %s on this system: the looks come with silikos-desktop 0.11" % LOOK_SCHEMA, file=sys.stderr)
            return 1
        return 0
    if not now and not ctx.dry:
        die("no setting %s on this system: the looks come with silikos-desktop 0.11" % LOOK_SCHEMA)
    if a.accent is not None and not ctx.dry:
        if not accent_now(ctx):
            die("no accent on this system: the accents come with silikos-desktop 0.13")
        theme = accent_theme(a.accent)
        missing = [p for p in (os.path.join(THEMES, theme, "gtk-3.0", "gtk.css"), os.path.join(THEMES, theme, "gnome-shell", "gnome-shell.css"))
                   if not os.path.isfile(p)]
        if missing:
            die("the theme %s is not made on this system (%s): sudo /usr/libexec/silikos/gtk-theme; sudo /usr/libexec/silikos/shell-theme"
                % (theme, ", ".join(missing)))
    if a.which is not None:
        ctx.run(["gsettings", "set", LOOK_SCHEMA, "look", a.which])
        if not ctx.dry and look_now(ctx) != a.which:
            # (gsettings exits 0 when it cannot reach the session's settings service: under sudo, or from a shell
            # without the session's bus, nothing changes)
            die("the look is still %s: run it as the user, in the desktop session (gsettings could not change the setting)" % (look_now(ctx) or "unknown"))
    if a.accent is not None:
        theme = accent_theme(a.accent)
        before = accent_now(ctx)
        ctx.run(["gsettings", "set", LOOK_SCHEMA, "accent", a.accent])
        ctx.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", theme])
        ctx.run(["gsettings", "set", USER_THEME, "name", theme])
        icons = accent_icons(ctx, a.accent)
        ctx.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", icons])
        if not ctx.dry and accent_now(ctx) != a.accent:
            die("the accent is still %s: run it as the user, in the desktop session (gsettings could not change the setting)" % (accent_now(ctx) or "unknown"))
        qt_accent(ctx, a.accent, icons)
        if (before or "ink").endswith("-vivid") != a.accent.endswith("-vivid") and before:
            # (mutter redraws the frames of X11 windows only at the first change of theme of a session: seen 12/11/2026)
            print("silik: the title bars of X11 programs (xterm, Magic, Xschem, Wine) take the new colour at the next login")
    return 0


# The session's keys (Start's foot in the bar and island looks, the COMMAND bar's sys/lock, sys/logout, sys/off). The
# screen is locked by the shell's own service; leaving and powering off go through the session's question (it waits
# for an answer and for programs with unsaved work), never around it.
SESSION = {
    "lock": ["gdbus", "call", "--session", "--dest", "org.gnome.ScreenSaver", "--object-path", "/org/gnome/ScreenSaver",
             "--method", "org.gnome.ScreenSaver.Lock"],
    "logout": ["gnome-session-quit", "--logout"],
    "off": ["gnome-session-quit", "--power-off"],
}


def cmd_session(ctx, a):
    if not shutil.which(SESSION[a.what][0]) and not ctx.dry:
        die("%s is not on this system: this is for a desktop session" % SESSION[a.what][0])
    rc, _ = ctx.run(SESSION[a.what], check=False, capture=True)
    if rc:
        die("%s exited %d: is this a desktop session?" % (SESSION[a.what][0], rc), rc)
    return 0


# ------------------------------------------------------------------ power
# `silik power`: one front for the power profile (docs/POWER.md). On EL 9.8 the profiles are tuned's (tuned 2.27, in
# the base set). tuned-ppd (AppStream; gnome-control-center 40 pulls it in, and it conflicts with
# power-profiles-daemon) puts the power-profiles-daemon interface on the system bus, the one the shell's system menu
# and the Settings' Power panel use: a profile is set through it when the system has it, so that the menu shows the
# same, and with tuned-adm otherwise. `auto` is the service silikos-power-auto (package silikos-power): at boot and
# when the mains is plugged or unplugged (a udev rule) it runs `silik power apply`. Nothing here is read through a
# command that starts a service: a look at the profile never changes it.
POWER = (("performance", "full speed: the highest clocks and boost (tuned throughput-performance)"),
         ("balanced", "fast when there is work, saving when idle (tuned balanced; balanced-battery on battery)"),
         ("saver", "the least power: low clocks, no boost (tuned powersave)"))
POWER_PPD = {"performance": "performance", "balanced": "balanced", "saver": "power-saver"}   # the interface's names
# each one's tuned profile on mains power and on battery: /etc/tuned/ppd.conf of EL 9.8's tuned-ppd, which does the same
POWER_TUNED = {"performance": ("throughput-performance", "throughput-performance"), "balanced": ("balanced", "balanced-battery"),
               "saver": ("powersave", "powersave")}
POWER_WORD = {"throughput-performance": "performance", "balanced": "balanced", "balanced-battery": "balanced",
              "powersave": "saver", "performance": "performance", "power-saver": "saver"}
POWER_BUS = ["net.hadess.PowerProfiles", "/net/hadess/PowerProfiles", "net.hadess.PowerProfiles", "ActiveProfile"]
POWER_AUTO = "silikos-power-auto.service"
POWER_CONF = "/etc/silikos/power.conf"
POWER_AUTO_DEFAULT = {"ac": "performance", "battery": "balanced"}
PPD_SERVICE = "/usr/share/dbus-1/system-services/net.hadess.PowerProfiles.service"   # tuned-ppd's or power-profiles-daemon's
TUNED_PPD = "/usr/sbin/tuned-ppd"
TUNED_ACTIVE = "/etc/tuned/active_profile"
UNIT_DIR = "/usr/lib/systemd/system"
SYSFS = os.environ.get("SILIK_SYSFS") or "/sys"
PROC_SWAPS = "/proc/swaps"
ZRAM_GEN = "/usr/lib/systemd/system-generators/zram-generator"   # zram-generator (AppStream): its config makes zram0
ZRAM_UNITS = ["dev-zram0.swap", "systemd-zram-setup@zram0.service"]


def as_root(argv):
    """sudo, unless this already runs as root (the service of `auto`)"""
    return list(argv) if os.geteuid() == 0 else ["sudo"] + list(argv)


def power_source(root=None):
    """(on battery, mains, batteries) from the kernel's power supplies. mains: True when one is online, False when
    some are and none is online, None when none is reported (a desktop's supply is not). A battery: name, percent,
    status; a device's own battery (a mouse: scope Device) is not the computer's. On battery: a battery discharging
    and no mains online (UPower's rule)"""
    top = os.path.join(root or SYSFS, "class", "power_supply")
    mains, bats = None, []
    try:
        names = sorted(os.listdir(top))
    except OSError:
        names = []
    for n in names:
        d = os.path.join(top, n)
        kind = read(os.path.join(d, "type")).strip()
        if kind == "Battery":
            if read(os.path.join(d, "scope")).strip() == "Device":
                continue
            cap = read(os.path.join(d, "capacity")).strip()
            bats.append({"name": n, "percent": int(cap) if cap.isdigit() else None, "status": read(os.path.join(d, "status")).strip() or None})
        elif kind in ("Mains", "USB", "Wireless"):
            if read(os.path.join(d, "online")).strip() == "1":
                mains = True
            elif mains is None:
                mains = False
    on_battery = bool(bats) and not mains and any(b["status"] == "Discharging" for b in bats)
    return on_battery, mains, bats


def power_driver():
    """what carries the profiles: tuned-ppd or power-profiles-daemon (they conflict: one at most), tuned alone, or ''"""
    if os.path.exists(PPD_SERVICE):
        return "tuned-ppd" if os.path.exists(TUNED_PPD) else "power-profiles-daemon"
    return "tuned" if shutil.which("tuned-adm") else ""


def power_conf(path=None):
    """auto's choice: the profile on mains power and on battery (/etc/silikos/power.conf, `key = value` lines)"""
    conf = dict(POWER_AUTO_DEFAULT)
    for line in read(path or POWER_CONF).splitlines():
        k, _, v = line.partition("=")
        k, v = k.strip(), v.strip()
        if k in conf and v in POWER_PPD:
            conf[k] = v
    return conf


def power_cpu(root=None):
    """what the processor was told (read-only, from sysfs): frequency driver, governor, energy preference, boost,
    and the firmware's platform profile. None where the machine does not say (a virtual machine, a container)"""
    r = root or SYSFS
    c = os.path.join(r, "devices/system/cpu/cpu0/cpufreq")
    out = {k: read(os.path.join(c, f)).strip() or None for k, f in
           (("driver", "scaling_driver"), ("governor", "scaling_governor"), ("energy_preference", "energy_performance_preference"))}
    out["platform_profile"] = read(os.path.join(r, "firmware/acpi/platform_profile")).strip() or None
    boost = read(os.path.join(r, "devices/system/cpu/cpufreq/boost")).strip()
    no_turbo = read(os.path.join(r, "devices/system/cpu/intel_pstate/no_turbo")).strip()
    out["boost"] = (boost == "1") if boost else (no_turbo == "0") if no_turbo else None
    return out


def power_zram(path=None):
    """the zram swap devices in use: name, size and used in MiB (/proc/swaps)"""
    out = []
    for line in read(path or PROC_SWAPS).splitlines()[1:]:
        f = line.split()
        if len(f) >= 4 and "/zram" in f[0] and f[2].isdigit() and f[3].isdigit():
            out.append({"device": f[0], "size_mib": int(f[2]) // 1024, "used_mib": int(f[3]) // 1024})
    return out


def power_ppd_now(ctx):
    """the profile the power-profiles interface has, when its service runs ('' otherwise: not started for asking)"""
    out = ctx.query(["busctl", "--auto-start=no", "get-property"] + POWER_BUS).strip()     # s "balanced"
    return out[3:-1] if out.startswith('s "') and out.endswith('"') else ""


def power_state(ctx):
    on_battery, mains, bats = power_source()
    driver = power_driver()
    ppd = power_ppd_now(ctx) if driver in ("tuned-ppd", "power-profiles-daemon") else ""
    # (tuned-ppd answering means tuned runs: it requires it)
    tuned_runs = (driver == "tuned-ppd" and bool(ppd)) or ctx.query(["systemctl", "is-active", "tuned.service"]).strip() == "active"
    tuned = read(TUNED_ACTIVE).strip() if tuned_runs and driver != "power-profiles-daemon" else ""
    auto = ctx.query(["systemctl", "is-enabled", POWER_AUTO], any_rc=True).strip()
    return {"profile": POWER_WORD.get(ppd) or POWER_WORD.get(tuned), "ppd": ppd or None, "tuned": tuned or None,
            "tuned_running": tuned_runs, "driver": driver or None,
            "auto": True if auto == "enabled" else False if auto else None, "auto_profiles": power_conf(),
            "on_battery": on_battery, "mains": mains, "batteries": bats, "cpu": power_cpu(), "zram": power_zram(),
            "zram_generator": os.path.exists(ZRAM_GEN), "trim": ctx.query(["systemctl", "is-enabled", "fstrim.timer"], any_rc=True).strip() or None}


def power_print(st):
    for k, what in POWER:
        print("%s %-12s %s" % ("●" if k == st["profile"] else " ", k, what))
    ap = st["auto_profiles"]
    if st["auto"] is None:
        print("  %-12s not on this system: sudo dnf install silikos-power" % "auto")
    else:
        print("%s %-12s %s on mains power, %s on battery, chosen at each plug and unplug" % ("●" if st["auto"] else " ", "auto", ap["ac"], ap["battery"]))
    if st["batteries"]:
        src = ", ".join("battery %s%% (%s)" % (b["percent"] if b["percent"] is not None else "?", (b["status"] or "?").lower()) for b in st["batteries"])
        src = ("on battery: " if st["on_battery"] else "mains, " if st["mains"] else "") + src
    else:
        src = "mains (no battery)" if st["mains"] is not False else "no battery reported"
    print("%-14s %s" % ("power source", src))
    drv = {"tuned-ppd": "tuned through tuned-ppd (the system menu's power profiles)", "power-profiles-daemon": "power-profiles-daemon",
           "tuned": "tuned (no power-profiles service: the system menu shows no profiles)"}.get(st["driver"] or "", "none: sudo dnf install tuned tuned-ppd")
    print("%-14s %s" % ("driver", drv))
    if st["driver"] in ("tuned", "tuned-ppd"):
        print("%-14s %s" % ("tuned", st["tuned"] or "not running: sudo systemctl enable --now tuned"))
    cpu = st["cpu"]
    said = ["%s %s" % (k, cpu[f]) for k, f in (("governor", "governor"), ("energy preference", "energy_preference"), ("platform", "platform_profile")) if cpu[f]]
    if cpu["boost"] is not None:
        said.append("boost " + ("on" if cpu["boost"] else "off"))
    print("%-14s %s" % ("processor", (", ".join(said) + (" (%s)" % cpu["driver"] if cpu["driver"] else "")) if said else "the machine does not say (no cpufreq: a virtual machine?)"))
    z = st["zram"]
    print("%-14s %s" % ("zram swap", ", ".join("%s %d MiB, %d MiB used" % (d["device"], d["size_mib"], d["used_mib"]) for d in z) if z
                        else "set up at the next start (zram-generator)" if st["zram_generator"] else "off: silik power zram on"))
    print("%-14s %s" % ("trim", "weekly (fstrim.timer)" if st["trim"] == "enabled" else "off: silik power trim on" if st["trim"] else "unknown"))


def power_show(ctx, a):
    st = power_state(ctx)
    if getattr(a, "json", False):
        print(json.dumps(st, indent=1))
    else:
        power_print(st)
    return 0 if st["profile"] else 1


def power_set(ctx, word):
    """sets the profile WORD; through the power-profiles interface when the system has it (the session at the screen
    may: polkit's allow_active; from elsewhere it asks for root), with tuned-adm otherwise"""
    driver = power_driver()
    if driver in ("tuned-ppd", "power-profiles-daemon"):
        argv = ["busctl", "set-property"] + POWER_BUS + ["s", POWER_PPD[word]]
        rc, _ = ctx.run(argv, check=False)
        if rc and os.geteuid() != 0:
            ctx.run(["sudo"] + argv)
        elif rc:
            die("busctl exited %d" % rc, rc)
    elif driver == "tuned":
        if ctx.query(["systemctl", "is-active", "tuned.service"]).strip() != "active" and not ctx.dry:
            die("tuned is not running: sudo systemctl enable --now tuned")
        ctx.run(as_root(["tuned-adm", "profile", POWER_TUNED[word][1 if power_source()[0] else 0]]))
    else:
        die("no power profiles on this system: sudo dnf install tuned tuned-ppd")
    if ctx.dry:
        return 0
    now = power_state(ctx)["profile"]
    if now != word:
        print("silik: the profile reads %s, not %s" % (now or "unknown", word), file=sys.stderr)
        return 1
    return 0


def power_profile(ctx, a):
    """a profile chosen by hand: the automatic choice stops (it would change it at the next plug or unplug)"""
    if ctx.query(["systemctl", "is-enabled", POWER_AUTO], any_rc=True).strip() == "enabled":
        ctx.run(as_root(["systemctl", "disable", "--now", POWER_AUTO]))
    return power_set(ctx, a.cmd)


def power_auto(ctx, a):
    if not os.path.exists(os.path.join(UNIT_DIR, POWER_AUTO)) and not ctx.dry:
        die("the automatic choice comes with the package silikos-power: sudo dnf install silikos-power")
    conf = power_conf()
    want = {"ac": a.ac or conf["ac"], "battery": a.battery or conf["battery"]}
    if want != conf:
        ctx.run(as_root(["sed", "-i", "-e", "s/^ac *=.*/ac = %s/" % want["ac"], "-e", "s/^battery *=.*/battery = %s/" % want["battery"], POWER_CONF]))
    ctx.run(as_root(["systemctl", "enable", POWER_AUTO]))
    ctx.run(as_root(["systemctl", "restart", POWER_AUTO]))     # (a oneshot: this runs `silik power apply` now)
    return 0


def power_apply(ctx, a):
    """the profile auto chooses for the power source now (what silikos-power-auto runs)"""
    on_battery = power_source()[0]
    word = power_conf()["battery" if on_battery else "ac"]
    st = power_state(ctx)
    # (with the power-profiles interface, what it says: tuned-ppd not started yet would, when it starts, put back the
    # profile it keeps, whatever tuned's file says; so it is set through it, which starts it)
    now = POWER_WORD.get(st["ppd"] or "") if st["driver"] in ("tuned-ppd", "power-profiles-daemon") else st["profile"]
    print("silik: on %s: %s%s" % ("battery" if on_battery else "mains power", word, " (already)" if now == word else ""))
    return 0 if now == word else power_set(ctx, word)


def power_zram_cmd(ctx, a):
    """swap in compressed memory (zram-generator, AppStream): the kernel compresses pages instead of writing them to
    disk. Its configuration (the package's) makes /dev/zram0 as large as the memory, at most 8 GiB, used before a disk
    swap. Never on by itself: installing the package is what turns it on, so nothing of SilikOS asks for it"""
    if a.action == "on":
        if not os.path.exists(ZRAM_GEN) or ctx.dry:
            ctx.run(as_root(["dnf", "-y", "install", "zram-generator"]))
        ctx.run(as_root(["systemctl", "daemon-reload"]))         # (the generator writes the units)
        ctx.run(as_root(["systemctl", "start", ZRAM_UNITS[0]]))
    elif a.action == "off":
        # (the pages in it come back to memory first: that needs the free memory, and takes a moment)
        ctx.run(as_root(["systemctl", "stop"] + ZRAM_UNITS), check=False)
        ctx.run(as_root(["dnf", "-y", "remove", "zram-generator"]))
        ctx.run(as_root(["systemctl", "daemon-reload"]))
    if ctx.dry:
        return 0
    z = power_zram()
    print("%-14s %s" % ("zram swap", ", ".join("%s %d MiB, %d MiB used" % (d["device"], d["size_mib"], d["used_mib"]) for d in z)
                        if z else "set up at the next start (zram-generator)" if os.path.exists(ZRAM_GEN) else "off"))
    return 0 if bool(z) == (a.action != "off") or a.action is None else 1


def power_trim(ctx, a):
    """fstrim.timer (util-linux): once a week the file systems tell the SSD which blocks are free. Off on EL 9.8 by
    default; the SilikOS kickstart turns it on"""
    if a.action:
        ctx.run(as_root(["systemctl", "enable" if a.action == "on" else "disable", "--now", "fstrim.timer"]))
    if ctx.dry:
        return 0
    st = ctx.query(["systemctl", "is-enabled", "fstrim.timer"], any_rc=True).strip()
    print("%-14s %s" % ("trim", "weekly (fstrim.timer)" if st == "enabled" else "off" if st else "unknown"))
    return 0


# ------------------------------------------------------------------ command line
def parser(only=None):
    """the command line. ONLY: the group typed (main reads it): the other groups get their name and help, which
    `silik --help` shows, but not their commands (building every command was 4-5 ms of each start: docs/STATUS.md)"""
    p = argparse.ArgumentParser(prog="silik", description="SilikOS system command")
    p.add_argument("--dry-run", action="store_true", help="print the commands, run nothing")
    p.add_argument("-q", "--quiet", action="store_true", help="do not print the `$ ...` lines")
    p.add_argument("--version", action="version", version="silik " + VERSION)
    s = p.add_subparsers(dest="group")
    x = s.add_parser("status", help="what this system is: base, kernel, SilikOS packages, the desktop"); x.add_argument("--json", action="store_true"); x.set_defaults(fn=cmd_status)
    x = s.add_parser("update", help="update every package (the base's and SilikOS's), then say whether to restart; --auto: the automatic updates")
    x.add_argument("--auto", nargs="?", const="", choices=["", "all", "security", "off"], help="all | security | off (no value: which is on)")
    x.set_defaults(fn=cmd_update)
    x = s.add_parser("identity", help="the names the system shows: silikos | base | show")
    x.add_argument("which", nargs="?", default="show", choices=["show", "silikos", "base"]); x.set_defaults(fn=cmd_identity)
    x = s.add_parser("look", help="the desktop's look: silik | bar | island, and its accent (no argument: which are in use)")
    x.add_argument("which", nargs="?", choices=[k for k, _ in LOOKS])
    x.add_argument("--accent", choices=[k for k, _ in ACCENTS], help="one colour for what is selected, focused, on or running (ink: none)")
    x.add_argument("--qt", action="store_true", help="Qt 5 programs take the accent in use (the shell runs it)")
    x.add_argument("--json", action="store_true"); x.set_defaults(fn=cmd_look)
    x = s.add_parser("session", help="this session: lock | logout | off (the last two ask first)")
    x.add_argument("what", choices=sorted(SESSION)); x.set_defaults(fn=cmd_session)

    e = s.add_parser("eda", help="EDA: EL6 / EL7 / EL8 boxes for the vendors' tools, and the open tools").add_subparsers(dest="cmd")
    if only in (None, "eda"):
        x = e.add_parser("list"); x.add_argument("--json", action="store_true"); x.set_defaults(fn=eda_list)
        x = e.add_parser("create"); x.add_argument("name"); x.add_argument("--el", default="7"); x.add_argument("--image"); x.set_defaults(fn=eda_create)
        x = e.add_parser("setup"); x.add_argument("name"); x.add_argument("--el"); x.set_defaults(fn=eda_setup)
        x = e.add_parser("enter"); x.add_argument("name"); x.add_argument("--shell", default="/bin/bash"); x.set_defaults(fn=eda_enter)
        x = e.add_parser("run"); x.add_argument("name"); x.add_argument("cmd", nargs=argparse.REMAINDER); x.set_defaults(fn=eda_run)
        x = e.add_parser("import-vm"); x.add_argument("disk"); x.add_argument("--name", required=True); x.add_argument("--el", default="6"); x.add_argument("--tmp"); x.set_defaults(fn=eda_import_vm)
        x = e.add_parser("rm"); x.add_argument("name"); x.set_defaults(fn=eda_rm)
        x = e.add_parser("check"); x.set_defaults(fn=eda_check)
        x = e.add_parser("kernel-arg"); x.set_defaults(fn=eda_kernel_arg)
        x = e.add_parser("tools", help="the open EDA tools on this system"); x.add_argument("--json", action="store_true"); x.set_defaults(fn=eda_tools)
        x = e.add_parser("try", help="the open tools do real jobs together: sim, schematic, layout, postlayout, gds, digital, waves, gates, verilate, vhdl, lint, synth, device")
        x.add_argument("job", nargs="?", default="all"); x.set_defaults(fn=eda_try)
        x = e.add_parser("bench", help="times ngspice on this machine with 1, 2 and all its cores")
        x.add_argument("--rings", type=int, default=40); x.add_argument("--stages", type=int, default=51)
        x.add_argument("--runs", type=int, default=3); x.add_argument("--all-threads", action="store_true", help="also every processor thread")
        x.set_defaults(fn=eda_bench)
        x = e.add_parser("tune", help="ngspice evaluates transistor models on this machine's cores (its default is 2 threads)")
        x.add_argument("--threads", type=int); x.add_argument("--undo", action="store_true"); x.set_defaults(fn=eda_tune)

    d = s.add_parser("dev", help="embedded development: the tools on this system, real jobs with them, a vendor's IDE installer").add_subparsers(dest="cmd")
    if only in (None, "dev"):
        x = d.add_parser("tools", help="the embedded-development tools and the vendors' IDEs on this system"); x.add_argument("--json", action="store_true"); x.set_defaults(fn=dev_tools)
        x = d.add_parser("try", help="the tools do real jobs: build, libc, cxx, debug, probe, dfu, stlink")
        x.add_argument("job", nargs="?", default="all"); x.set_defaults(fn=dev_try)
        x = d.add_parser("can", help="CAN interfaces: list them; up IFACE BITRATE; down IFACE")
        x.add_argument("action", nargs="?", choices=["list", "up", "down"]); x.add_argument("iface", nargs="?")
        x.add_argument("bitrate", nargs="?", type=can_rate)
