def dev_version_key(path):
    """for sorting by the numbers in a path: ccs1280 after ccs910, stm32cubeide_1.19.0 after stm32cubeide_1.9.0"""
    return [(1, int(t), "") if t.isdigit() else (0, 0, t) for t in re.split(r"(\d+)", path)]


def dev_find_ides(exe, roots, depth=5):
    """every program called EXE under ROOTS (a few folders deep: the vendors' folders carry a version), oldest first"""
    found = []
    for root in roots:
        root = os.path.expanduser(root)
        if not os.path.isdir(root):
            continue
        base = root.rstrip("/").count("/")
        for d, dirs, files in os.walk(root):
            if d.count("/") - base >= depth:
                dirs[:] = []
            if exe in files and os.access(os.path.join(d, exe), os.X_OK):
                found.append(os.path.join(d, exe))
    return sorted(found, key=dev_version_key)


def dev_find_ide(exe, roots, depth=5):
    """the newest program called EXE under one of ROOTS, or ''"""
    found = dev_find_ides(exe, roots, depth)
    return found[-1] if found else ""


# CAN: the EL 9 kernel carries the CAN core and the USB adapters' drivers (gs_usb: candleLight, CANable; peak_usb:
# PCAN-USB; slcan; mcp251x/mcp251xfd over SPI), so an adapter is a network interface (can0). `silik dev can` lists
# them; `up IFACE BITRATE` sets the bit rate and brings it up (ip, as root); can-utils (silik-dev) reads and writes it.
CAN_RATES = (10000, 20000, 50000, 100000, 125000, 250000, 500000, 800000, 1000000)


def can_rate(v):
    """a bit rate: 500000, 500k, 1M"""
    t = v.strip().lower()
    mult = 1000 if t.endswith("k") else 1000000 if t.endswith("m") else 1
    try:
        n = int(float(t.rstrip("km")) * mult)
    except ValueError:
        raise argparse.ArgumentTypeError("not a bit rate: %s (e.g. 500k, 1M)" % v)
    if n not in CAN_RATES:
        raise argparse.ArgumentTypeError("%s: CAN bit rates are %s" % (v, ", ".join("%dk" % (r // 1000) if r < 1000000 else "1M" for r in CAN_RATES)))
    return n


def sys_read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def dev_what(devdir):
    """(driver, product) of a device of /sys (a network interface's or a tty's "device"): the USB product's name when
    it is a USB device"""
    drv = os.path.basename(os.path.realpath(os.path.join(devdir, "driver"))) if os.path.exists(os.path.join(devdir, "driver")) else ""
    prod = ""
    d = os.path.realpath(devdir)
    for _ in range(4):                              # the USB device is a parent of its interface
        prod = sys_read(os.path.join(d, "product"))
        if prod:
            maker = sys_read(os.path.join(d, "manufacturer"))
            prod = (maker + " " + prod).strip() if maker and maker.split()[0].lower() not in prod.lower() else prod
            break
        d = os.path.dirname(d)
    return drv, prod


CAN_FD_RATES = (1000000, 2000000, 4000000, 5000000, 8000000)


def can_fd_rate(v):
    t = v.strip().lower()
    mult = 1000 if t.endswith("k") else 1000000 if t.endswith("m") else 1
    try:
        n = int(float(t.rstrip("km")) * mult)
    except ValueError:
        raise argparse.ArgumentTypeError("not a bit rate: %s (e.g. 2M)" % v)
    if n not in CAN_FD_RATES:
        raise argparse.ArgumentTypeError("%s: CAN FD data bit rates here are 1M, 2M, 4M, 5M, 8M" % v)
    return n


def serial_ports():
    """[(device, stable name or '', driver, product)] of the serial ports that have a device behind them: USB adapters
    (ttyUSB: FTDI, CP210x, CH340, PL2303; RS-232 or RS-485), boards' virtual COM ports (ttyACM: ST-LINK, Nucleo, CDC
    ACM), and the machine's own UARTs that answer (ttyS with a driver other than the placeholder)"""
    byid = {}
    for d in ("/dev/serial/by-id",):
        for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            byid[os.path.realpath(os.path.join(d, f))] = os.path.join(d, f)
    out = []
    for name in sorted(os.listdir("/sys/class/tty")) if os.path.isdir("/sys/class/tty") else []:
        if not re.match(r"^tty(USB|ACM|S|AMA|THS)\d+$", name):
            continue
        devdir = os.path.join("/sys/class/tty", name, "device")
        if not os.path.exists(devdir):
            continue
        drv, prod = dev_what(devdir)
        if name.startswith("ttyS") and sys_read(os.path.join("/sys/class/tty", name, "type")) in ("", "0"):
            continue                                # (the 8250 driver's placeholders: no UART behind them, type 0)
        dev = "/dev/" + name
        out.append((dev, byid.get(dev, ""), drv, prod))
    return out


def dev_serial(ctx, a):
    ports = serial_ports()
    if a.json:
        print(json.dumps([{"device": d, "by_id": b or None, "driver": dr or None, "product": p or None} for d, b, dr, p in ports]))
        return 0 if ports else 1
    if not ports:
        print("no serial ports: plug in an adapter or a board (they appear as /dev/ttyUSB* or /dev/ttyACM*)")
        return 1
    for dev, byid, drv, prod in ports:
        print("%-14s %-30s %s" % (dev, prod or "-", "(%s)%s" % (drv, "  " + byid if byid else "") if drv else byid))
    print("open one: tio %s  (or picocom -b 115200, minicom -D); Modbus RTU over RS-485: libmodbus, pyserial" % ports[0][0])
    return 0


def can_links(ctx):
    """[(name, state, bitrate or None)] of the CAN interfaces of this system"""
    out = ctx.query(["ip", "-details", "-json", "link", "show", "type", "can"])
    try:
        links = json.loads(out) if out.strip() else []
    except ValueError:
        return []
    res = []
    for l in links:
        if not l.get("ifname"):     # (iproute 6.17 of EL 9.8 prints {} for each link the type filter leaves out)
            continue
        info = ((l.get("linkinfo") or {}).get("info_data") or {})
        res.append((l.get("ifname"), l.get("operstate", "?"), (info.get("bittiming") or {}).get("bitrate"),
                    (info.get("data_bittiming") or {}).get("bitrate")))
    return res


def dev_can(ctx, a):
