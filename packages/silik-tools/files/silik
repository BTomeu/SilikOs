def hw_data(name, installed):
    """a data file of silik-tools: $SILIK_HWDATA/NAME, the installed one, or the one next to the command"""
    for p in (os.path.join(os.environ.get("SILIK_HWDATA") or "/nonexistent", name), installed,
              os.path.join(os.path.dirname(os.path.abspath(__file__)), name)):
        if os.path.isfile(p):
            return p
    return ""


def hw_fields(alias):
    m = hw_rx("pci").match(alias)
    if m:
        return "pci", m.groups()
    m = hw_rx("usb").match(alias)
    return ("usb", m.groups()) if m else (None, None)


class HwTable:
    """which module claims which device: the patterns of a modules.alias, by bus and vendor"""

    def __init__(self):
        self.raw = {}       # (bus, vendor) -> the rows as read
        self.by = {}        # (bus, vendor) -> the same, their patterns taken apart: made when a device of that vendor asks
        self.kernel = ""

    def add(self, alias, module, src):
        # (a table is 18 000 rows and a machine has a few dozen devices: a row's pattern is taken apart only when a
        # device of its vendor is looked up. Taking all of them apart was most of the time of `silik hw check`)
        bus = alias[:4]
        if bus == "pci:":
            key = ("pci", "*" if alias[5:6] == "*" else alias[5:13])
        elif bus == "usb:":
            key = ("usb", "*" if alias[5:6] == "*" else alias[5:9])
        else:
            return
        self.raw.setdefault(key, []).append((alias, module, src))
        self.by.pop(key, None)          # (a row added after its vendor was looked up)

    def rows(self, key):
        r = self.by.get(key)
        if r is None:
            r = self.by[key] = []
            for alias, module, src in self.raw.get(key, ()):
                bus, f = hw_fields(alias)
                if bus:
                    r.append((f, module.replace("-", "_"), src))
        return r

    def claim(self, bus, dev, srcs):
        """the modules (of the sources SRCS) whose pattern DEV satisfies. DEV: the fields of the pattern, None for one
        that is not known. (sure, maybe): maybe = a pattern for this very ID that asks for a field DEV does not have"""
        sure, maybe = [], []
        for f, mod, src in self.rows((bus, dev[0])) + self.rows((bus, "*")):
            if src not in srcs:
                continue
            unknown = False
            for i, (p, v) in enumerate(zip(f, dev)):
                if p == "*":
                    continue
                if bus == "usb" and i == 2:           # bcdDevice: a glob (d0[0-3]*)
                    import fnmatch
                    if v is None or fnmatch.fnmatchcase(v, p):
                        continue
                    break
                if v is None:
                    unknown = True
                elif p != v:
                    break
            else:
                if not unknown:
                    if mod not in sure:
                        sure.append(mod)
                elif f[0] != "*" and f[1] != "*" and mod not in maybe:
                    maybe.append(mod)
        return sure, [m for m in maybe if m not in sure]


def hw_tables(arch, local_alias=""):
    """the table for ARCH: sources "el" (EL 9.8's modules, from kernel-aliases.tsv), "builtin", "program" (libfprint),
    "up" (the upstream kernel, for what EL lacks) and, with LOCAL_ALIAS (this kernel's modules.alias), "local".
    Returns (table, {module: package}, the file read or ""); table.kernel: the kernel the shipped table is of"""
    t, pkg = HwTable(), {}
    path = hw_data("kernel-aliases.tsv", KERNEL_ALIASES)
    for l in read(path).splitlines() if path else []:
        if l.startswith("#") or l.startswith("alias\t"):
            m = re.search(r"kernel (5\.14\.0-[\w.]+)", l) if not t.kernel else None
            if m:
                t.kernel = m.group(1)
            continue
        f = l.split("\t")
        if len(f) < 4:
            continue
        if f[2] == "upstream":
            t.add(f[0], f[1], "up")
        elif f[2] in ("both", arch):
            t.add(f[0], f[1], "builtin" if f[3] == "builtin" else "program" if f[3] == "userspace" else "el")
            pkg[f[1]] = f[3]
    for l in read(local_alias).splitlines() if local_alias else []:
        f = l.split()
        if len(f) == 3 and f[0] == "alias" and f[1][:4] in ("pci:", "usb:"):
            t.add(f[1], f[2], "local")
    return t, pkg, path


def hw_families(path=None):
    """pci.tsv: {(bus, id): row}"""
    p = path or hw_data("pci.tsv", PCI_TABLE)
    return {(r["bus"], r["id"]): r for r in hw_known(p)} if p else {}


# ---- the devices: of this machine, or of a saved list
def hw_pci_sysfs(root="/sys/bus/pci/devices"):
    """[{bus, where, id, sub, class, driver}] from sysfs; None when there is no PCI bus to read"""
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return None
    out = []
    for n in names:
        d = os.path.join(root, n)
        ven, dev = sys_read(os.path.join(d, "vendor"))[2:], sys_read(os.path.join(d, "device"))[2:]
        if not ven or not dev:
            continue
        drv = os.path.join(d, "driver")
        out.append({"bus": "pci", "where": n, "id": "%s:%s" % (ven, dev), "class": sys_read(os.path.join(d, "class"))[2:8],
                    "sub": "%s:%s" % (sys_read(os.path.join(d, "subsystem_vendor"))[2:], sys_read(os.path.join(d, "subsystem_device"))[2:]),
                    "driver": os.path.basename(os.path.realpath(drv)) if os.path.exists(drv) else "", "name": ""})
    return out


def hw_usb_sysfs(root="/sys/bus/usb/devices"):
    """[{bus, where, id, class, bcd, name, ifaces: [(class, subclass, protocol, number, driver)]}]; None without USB"""
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return None
    out = []
    for n in names:
        d = os.path.join(root, n)
        vid = sys_read(os.path.join(d, "idVendor"))
        if ":" in n or not vid:
            continue
        ifaces = []
        for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            i = os.path.join(d, f)
            if not f.startswith(n + ":") or not os.path.isdir(i):
                continue
            drv = os.path.join(i, "driver")
            ifaces.append((sys_read(os.path.join(i, "bInterfaceClass")), sys_read(os.path.join(i, "bInterfaceSubClass")),
                           sys_read(os.path.join(i, "bInterfaceProtocol")), sys_read(os.path.join(i, "bInterfaceNumber")),
                           os.path.basename(os.path.realpath(drv)) if os.path.exists(drv) else ""))
        out.append({"bus": "usb", "where": n, "id": "%s:%s" % (vid, sys_read(os.path.join(d, "idProduct"))),
                    "class": sys_read(os.path.join(d, "bDeviceClass")) + sys_read(os.path.join(d, "bDeviceSubClass")) + sys_read(os.path.join(d, "bDeviceProtocol")),
                    "bcd": sys_read(os.path.join(d, "bcdDevice")),
                    "name": " ".join(x for x in (sys_read(os.path.join(d, "manufacturer")), sys_read(os.path.join(d, "product"))) if x),
                    "ifaces": ifaces})
    return out


def hw_parse(text):
    """the devices of a saved list: `lspci -nn` (also -nnk, -nnv, -n), `lsusb` (also -v), or the hardware IDs Windows
    prints (PCI\\VEN_8086&DEV_A0F0&SUBSYS_00748086&REV_20, ...&CC_028000, USB\\VID_0C72&PID_000C). The same shape
    as hw_pci_sysfs / hw_usb_sysfs; driver None = the list does not say (it is another system's anyway)"""
    out, cur, win = [], None, {}
    for l in text.replace("\r", "").replace("﻿", "").splitlines():
        if l.startswith("#"):
            continue
        m = hw_rx("lspci").match(l)
        n = hw_rx("lspci-n").match(l) if not m else None
        if m or n:
            slot, cls, ven, dev, rest = (m.group(1), m.group(3), m.group(5), m.group(6), m.group(7)) if m else n.groups()
            pi = re.search(r"\(prog-if ([0-9a-f]{2})", rest)
            cur = {"bus": "pci", "where": slot, "id": "%s:%s" % (ven, dev), "class": cls + (pi.group(1) if pi else "00"), "sub": "",
                   "driver": None, "name": ("%s: %s" % (m.group(2), m.group(4))) if m else ""}
            out.append(cur)
            continue
        m = hw_rx("lsusb").match(l)
        if m:
            cur = {"bus": "usb", "where": "%s-%s" % (m.group(1), m.group(2)), "id": "%s:%s" % (m.group(3), m.group(4)), "class": "",
                   "bcd": "", "name": m.group(5).strip(), "ifaces": None, "_c": ["", "", ""]}
            out.append(cur)
            continue
        s = l.strip()
        if cur and cur["bus"] == "pci":
            m = re.match(r"^Subsystem: .*\[([0-9a-f]{4}):([0-9a-f]{4})\]$", s)
            if m and not cur["sub"] and l[:1] in ("\t", " "):
                cur["sub"] = "%s:%s" % (m.group(1), m.group(2))
        elif cur and cur["bus"] == "usb":
            m = re.match(r"^(bDeviceClass|bDeviceSubClass|bDeviceProtocol|bInterfaceNumber|bInterfaceClass|bInterfaceSubClass|bInterfaceProtocol)\s+(\d+)", s)
            if m:
                k, v = m.group(1), "%02x" % int(m.group(2))
                if k.startswith("bDevice"):
                    cur["_c"][("bDeviceClass", "bDeviceSubClass", "bDeviceProtocol").index(k)] = v
                    cur["class"] = "".join(cur["_c"]) if all(cur["_c"]) else ""
                elif k == "bInterfaceNumber":
                    cur["ifaces"] = (cur["ifaces"] or []) + [["", "", "", v, None]]
                elif cur["ifaces"]:
                    cur["ifaces"][-1][("bInterfaceClass", "bInterfaceSubClass", "bInterfaceProtocol").index(k)] = v
            m = re.match(r"^bcdDevice\s+(\d+)\.(\d\d)", s)
            if m:
                cur["bcd"] = "%02x%s" % (int(m.group(1)), m.group(2))
        for m in hw_rx("win-pci").finditer(l):
            w = win.setdefault(("pci", m.group(1).lower(), m.group(2).lower()), {"sub": "", "class": ""})
            sub = re.search(r"&SUBSYS_([0-9A-F]{4})([0-9A-F]{4})", m.group(3), re.I)
            cc = re.search(r"&CC_([0-9A-F]{4,6})", m.group(3), re.I)
            if sub:
                w["sub"] = "%s:%s" % (sub.group(2).lower(), sub.group(1).lower())      # (SUBSYS_ is device then vendor)
            if cc and len(cc.group(1)) > len(w["class"]):
                w["class"] = cc.group(1).lower()
        for m in hw_rx("win-usb").finditer(l):
            win.setdefault(("usb", m.group(1).lower(), m.group(2).lower()), {})
    for (bus, ven, dev), w in sorted(win.items()):
        if bus == "pci":
            out.append({"bus": "pci", "where": "", "id": "%s:%s" % (ven, dev), "class": w["class"], "sub": w["sub"], "driver": None, "name": ""})
        else:
            out.append({"bus": "usb", "where": "", "id": "%s:%s" % (ven, dev), "class": "", "bcd": "", "name": "", "ifaces": None})
    for d in out:
        d.pop("_c", None)
        if d["bus"] == "usb" and d["ifaces"]:
            d["ifaces"] = [tuple(i) for i in d["ifaces"]]
    return out


def hw_read_list(path):
    """the text of a saved list; Windows PowerShell writes UTF-16 unless told otherwise"""
    with open(path, "rb") as f:
        b = f.read()
    if b[:2] in (b"\xff\xfe", b"\xfe\xff"):
        return b.decode("utf-16", "replace")
    return b.decode("utf-8", "replace")


# ---- the judgement
def hw_pci_key(d):
    v, p = d["id"].upper().split(":")
    sv, _, sd = d.get("sub", "").upper().partition(":")
    c = d.get("class", "").upper()
    return ("0000" + v, "0000" + p, ("0000" + sv) if sv else None, ("0000" + sd) if sd else None,
            c[0:2] if len(c) >= 2 else None, c[2:4] if len(c) >= 4 else None, c[4:6] if len(c) >= 6 else None)


def hw_usb_keys(d):
    """one key per interface (a USB modalias is an interface's); without interfaces, the ID alone"""
    v, p = d["id"].upper().split(":")
    c = d.get("class", "").upper()
    dc = (c[0:2], c[2:4], c[4:6]) if len(c) == 6 else (None, None, None)
    bcd = d.get("bcd", "").upper() or None
    if not d.get("ifaces"):
        return [(v, p, bcd) + dc + (None, None, None, None)]
    return [(v, p, bcd) + dc + tuple((x.upper() if x else None) for x in i[:4]) for i in d["ifaces"]]


def hw_judge(devs, table, pkg, fams, known, local, kernel="", arch="", mine=None):
    """a row for every device: {bus, id, class, name, state, driver, value, fix}. LOCAL: the devices are this
    machine's (their bound driver is known); else they are a saved list and the answer is what EL's kernel claims.
    states: ok (a driver is bound), driver (the kernel claims the ID), maybe (it claims the ID for some subsystem
    IDs), unbound (claimed, not bound), partial (only the card's bus has a driver), none (no driver in this kernel),
    program (no kernel driver needed: a program opens it), quiet (no driver; devices of this class often have none),
    unknown (the list does not say enough)"""
    rows = []
    mine = mine or (("local", "builtin") if local else ("el", "builtin"))
    # this kernel's own table was read: what EL's packages have beyond it is a package not installed (when this is
    # the kernel the shipped table is of) or a newer kernel of the base
    beyond = ("el",) if local and "local" in mine else ()
    same = bool(table.kernel) and kernel.startswith(table.kernel)

    def missing(r, mods):
        p = pkg.get(mods[0], "modules")
        r["state"], r["driver"] = "unbound", ", ".join(mods)
        if same:
            name = "kernel-modules" + ("-" + p if p in ("core", "extra") else "")
            r["value"] = "its driver %s is in %s, which is not installed for this kernel" % (mods[0], name)
            r["fix"] = ["sudo dnf -y install %s-%s" % (name, kernel)]
        else:
            r["value"] = "no driver in this kernel (%s); the base's kernel %s has %s for it" % (kernel or "?", table.kernel or "of EL 9.8", mods[0])
            r["fix"] = ["silik update   # then restart"]

    for d in devs:
        bus = d["bus"]
        fam = fams.get((bus, d["id"]))
        r = {"bus": bus, "id": d["id"], "class": d.get("class", ""), "where": d.get("where", ""), "driver": "", "fix": [],
             "name": d.get("name") or (fam["name"] if fam else "") or ""}
        if bus == "pci":
            cls = d.get("class", "")
            if not d.get("name") and cls:           # (no name in the list: the class, and pci.tsv's name when it has one)
                r["name"] = ("%s: %s" % (PCI_CLASSES.get(cls[:4], "class " + cls[:4]), r["name"])).rstrip(": ")
            sure, maybe = table.claim("pci", hw_pci_key(d), mine)
            other = table.claim("pci", hw_pci_key(d), beyond)[0] if beyond else []
            up = table.claim("pci", hw_pci_key(d), ("up",))
            bound = d.get("driver")
            if bound:
                r["state"], r["driver"], r["value"] = "ok", bound, "driver %s" % bound
                if bound in HW_BUS_ONLY:
                    r["state"], r["value"] = "partial", "%s drives the card's own bus; the part on it has no driver of its own bound" % bound
                    r["fix"] = hw_todo(fam)
            elif sure:
                r["driver"] = ", ".join(sure)
                if local and cls[:4] in HW_QUIET:
                    # (an error-reporting or telemetry driver that did not take the bridge: nothing a person misses)
                    r["state"], r["value"] = "quiet", "%s claims it and is not bound (a %s often has none bound)" % (r["driver"], PCI_CLASSES.get(cls[:4], "device of this class").lower())
                elif local:
                    r["state"], r["value"], r["fix"] = "unbound", "%s claims it and is not bound" % r["driver"], ["sudo modprobe " + sure[0], "sudo dmesg | grep -i %s   # why" % sure[0]]
                elif set(sure) <= set(HW_BUS_ONLY):
                    r["state"], r["value"] = "partial", "%s drives the card's own bus; EL 9's kernel has no driver for the part on it" % r["driver"]
                    r["fix"] = hw_todo(fam)
                else:
                    where = sorted(set(pkg.get(m, "") for m in sure) - {"", "modules", "core"})
                    r["state"], r["value"] = "driver", r["driver"] + (" (%s)" % ", ".join("built in" if w == "builtin" else "kernel-modules-" + w for w in where) if where else "")
                    if d["id"].startswith("10de:") and cls.startswith("03"):
                        r["value"] += ": the open driver; NVIDIA's own (CUDA): silik hw nvidia install"
            elif other:
                missing(r, other)
            elif maybe and not local:
                r["state"], r["driver"] = "maybe", ", ".join(maybe)
                r["value"] = "%s claims this ID for some subsystem IDs or classes: `lspci -nnk` gives them" % r["driver"]
            elif not cls and not local and not (up[0] or up[1]):
                # (a Windows list without the class codes: storage, USB and graphics drivers bind by class)
                r["state"], r["value"] = "unknown", "no driver names this ID; one may take it by its class, which this list does not give"
            else:
                hint = "; a newer kernel has %s for it" % ", ".join(up[0] or up[1]) if (up[0] or up[1]) else ""
                if cls[:4] in HW_QUIET:
                    r["state"], r["value"] = "quiet", "no driver claims it (a %s often has none)%s" % (PCI_CLASSES.get(cls[:4], "device of this class").lower(), hint)
                else:
                    r["state"], r["value"] = "none", "no driver in %s%s" % ("this kernel" if local else "EL 9's kernel", hint)
                    r["fix"] = hw_todo(fam)
        else:
            vid, pid = d["id"].split(":")
            ifaces = d.get("ifaces")
            keys = hw_usb_keys(d)
            sure, maybe, prog, up, other = [], [], [], [], []
            for k in keys:
                if beyond:
                    o = table.claim("usb", k, beyond)
                    other += [x for x in o[0] + o[1] if x not in other]
                s, m = table.claim("usb", k, mine)
                sure += [x for x in s if x not in sure]
                maybe += [x for x in m if x not in maybe]
                prog += [x for x in table.claim("usb", k, ("program",))[0] + table.claim("usb", k, ("program",))[1] if x not in prog]
                u = table.claim("usb", k, ("up",))
                up += [x for x in u[0] + u[1] if x not in up]
            if ifaces is None:
                # a list without interfaces: a pattern for this very product is taken as the product's driver
                sure, maybe = sure + maybe, []
            kn = hw_match(known, vid, pid, d.get("name", "")) if known else None
            if kn and not r["name"]:
                r["name"] = kn["name"]
            bound = sorted(set(i[4] for i in ifaces or [] if i[4]))
            classes = sorted(set([i[0] for i in ifaces or [] if i[0]] + ([d["class"][:2]] if d.get("class") and d["class"][:2] not in ("00", "ef") else [])))
            what = ", ".join(USB_CLASSES.get(c, "class " + c) for c in classes)
            if vid == "1d6b":
                continue                                    # (the kernel's own root hubs)
            if bound:
                r["state"], r["driver"], r["value"] = "ok", ", ".join(bound), "driver %s" % ", ".join(bound)
            elif sure:
                r["driver"] = ", ".join(sure)
                if local:
                    r["state"], r["value"], r["fix"] = "unbound", "%s claims it and is not bound" % r["driver"], ["sudo modprobe " + sure[0]]
                else:
                    where = sorted(set(pkg.get(m, "") for m in sure) - {"", "modules", "core"})
                    r["state"], r["value"] = "driver", r["driver"] + (" (%s)" % ", ".join("built in" if w == "builtin" else "kernel-modules-" + w for w in where) if where else "")
            elif other:
                missing(r, other)
            elif kn and kn["kind"] in ("probe", "logic", "vm"):
                r["state"], r["driver"] = "program", kn["driver"]
                r["value"] = "no kernel driver needed: %s (silik doctor bench)" % kn["driver"]
            elif kn and kn.get("el9") == "no":
                r["state"], r["value"] = "none", "EL 9's kernel has no %s for this product (newer kernels: %s)" % (kn["driver"], kn["source"])
                r["fix"] = ["another adapter, or Windows in the VM: silik win vm usb attach " + d["id"]]
            elif prog:
                drv = prog[0].split(":", 1)[1]
                if drv == "-":
                    r["state"], r["value"] = "none", "a fingerprint reader libfprint lists as not supported"
                else:
                    r["state"], r["driver"], r["value"] = "program", "libfprint", "fingerprint reader: libfprint's %s driver (fprintd; not a kernel driver)" % drv
            elif maybe and not local:
                r["state"], r["driver"] = "maybe", ", ".join(maybe)
                r["value"] = "%s claims this ID for some of its interfaces: `lsusb -v` gives them" % r["driver"]
            elif ifaces is None and not local:
                r["state"], r["value"] = "unknown", "no driver names this ID; one may take it by its class, which this list does not give: `lsusb -v`"
            else:
                hint = "; a newer kernel has %s for it" % ", ".join(up) if up else ""
                if any(c in USB_KEY for c in classes):
                    r["state"], r["value"] = "none", "no driver in %s for it (%s)%s" % ("this kernel" if local else "EL 9's kernel", what, hint)
                    r["fix"] = hw_todo(fam)
                else:
                    r["state"], r["value"] = "quiet", "no kernel driver (%s: a program may open it itself)%s" % (what or "no class told", hint)
        rows.append(r)
    return rows


def hw_todo(fam):
    """what a person can do, from pci.tsv's row: nothing to add when the row only says there is no driver"""
    t = fam["todo"] if fam else ""
    if t in ("", "-"):
        return []
    if t.startswith("no driver in EL 9's kernel"):
        t = t.partition(": ")[2]
    return [t] if t else []


def hw_summary(rows):
    c = {k: sum(1 for r in rows if r["state"] == k) for k in HW_STATES}
    return {k: v for k, v in c.items() if v}


def hw_local():
    """this machine's devices and tables: (devs or None, table, pkg, kernel, arch, the alias file read, the sources
    of the table that are this kernel's). Without /lib/modules/KERNEL/modules.alias (a container), EL 9.8's shipped
    table stands in for it"""
    kernel, arch = os.uname().release, host_arch()
    alias = os.path.join("/lib/modules", kernel, "modules.alias")
    here = os.path.isfile(alias)
    table, pkg, shipped = hw_tables(arch, alias if here else "")
    pci, usb = hw_pci_sysfs(), hw_usb_sysfs()
    return ((None if pci is None and usb is None else (pci or []) + (usb or [])), table, pkg, kernel, arch, alias if here else shipped,
            ("local", "builtin") if here else ("el", "builtin"))


def hw_names(ctx, devs):
    """the names lspci has for this machine's PCI devices (pciutils), when it is there"""
    if not shutil.which("lspci") or not any(d["bus"] == "pci" for d in devs):
        return
    names = {}
    for l in ctx.query(["lspci", "-D", "-nn"]).splitlines():
        m = hw_rx("lspci").match(l)
        if m:
            names[m.group(1)] = "%s: %s" % (m.group(2), m.group(4))
    for d in devs:
        if d["bus"] == "pci" and d["where"] in names:
            d["name"] = names[d["where"]]


def hw_check(ctx, a):
    fams, known = hw_families(), hw_known()
    if a.from_file:
        try:
            text = hw_read_list(a.from_file)
        except OSError as e:
            die("%s: %s" % (a.from_file, e.strerror), 2)
        devs = hw_parse(text)
        if not devs:
            die("%s: no device found in it. A list is the output of `lspci -nn` or `lsusb` (Linux), or of this in Windows "
                "PowerShell: (Get-PnpDevice -PresentOnly).HardwareID" % a.from_file, 2)
        arch = a.arch or "x86_64"
        table, pkg, src = hw_tables(arch)
        if not src:
            die("the kernel's alias table (%s) is missing: sudo dnf -y reinstall silik-tools" % KERNEL_ALIASES, 2)
        rows = hw_judge(devs, table, pkg, fams, known, False, arch=arch)
        about = {"source": a.from_file, "kernel": "EL 9.8 (%s)" % os.path.basename(src), "arch": arch}
    else:
        devs, table, pkg, kernel, arch, src, mine = hw_local()
        if a.arch and a.arch != arch:
            die("--arch is for a saved list (--from FILE); this machine is %s" % arch, 2)
        if devs is None:
            die("no PCI or USB devices to read in /sys (a container?); a saved list: silik hw check --from FILE", 1)
        hw_names(ctx, devs)
        rows = hw_judge(devs, table, pkg, fams, known, True, kernel, arch, mine)
        about = {"source": "this machine", "kernel": kernel, "arch": arch}
    summ = hw_summary(rows)
    rc = 1 if any(summ.get(k) for k in ("none", "unbound", "partial")) else 0
    if a.json:
        print(json.dumps(dict(about, devices=rows, summary=summ, note=HW_NOTE), indent=1))
        return rc
    # (a device that often has no driver is listed when a newer kernel does have one for it: an NPU, a memory controller)
    show = rows if a.all else [r for r in rows if r["state"] != "quiet" or "newer kernel" in r["value"]]
    for r in show:
        print("%-3s %-9s %-8s %s" % (r["bus"], r["id"], r["state"], (r["name"] or "-")[:70]))
        print("%-22s %s" % ("", r["value"]))
        for f in r["fix"]:
            print("%-22s do: %s" % ("", f))
    n = lambda *ks: sum(summ.get(k, 0) for k in ks)
    print("\n%d devices of %s, kernel %s %s: %d with a driver%s, %d without, %d not told by the list, %d that often have none%s"
          % (len(rows), about["source"], about["kernel"], about["arch"], n("ok", "driver", "program"),
             " (%d only for some variants)" % n("maybe") if n("maybe") else "", n("none", "unbound", "partial"), n("unknown") + n("maybe"),
             n("quiet"), "" if a.all or not n("quiet") else " (--all lists them)"))
    print(HW_NOTE)
    return rc


# `silik hw driver add NAME`: a driver the base's kernel lacks, as a kmod package of ELRepo (a module added beside
# the base's kernel, which stays as it is; never ELRepo's kernel-ml, which would replace it). Only the gaps of
# docs/DRIVERS.md for which ELRepo keeps an EL 9 package: its packaging repository was read on 2026-11-13.
HW_KMODS = {
    "wl": ("kmod-wl", "Broadcom BCM43xx Wi-Fi (BCM4360, BCM4352, BCM4331, BCM43142...): Broadcom's own driver, not open source; "
                      "it switches off the kernel's Broadcom drivers (bcma, brcmfmac, brcmsmac, b43)"),
    "r8127": ("kmod-r8127", "Realtek RTL8127 10G Ethernet: Realtek's driver"),
    "rtw88_usb": ("kmod-rtw88_usb", "USB Wi-Fi adapters with Realtek 802.11ac chips: RTL8723DU, RTL8812AU, RTL8814AU, RTL8821AU, RTL8821CU, RTL8822CU"),
    "rtw89_usb": ("kmod-rtw89_usb", "Realtek Wi-Fi 6 / 7 chips the base lacks: RTL8851BE, RTL8852BE-VT, RTL8922AE (PCIe); RTL8851BU, RTL8852BU (USB)"),
}
ELREPO_KEY = "/etc/pki/elrepo/SECURE-BOOT-KEY-elrepo.org.der"


def hw_driver(ctx, a):
    if a.action == "list" or not a.name:
        for k, (p, what) in sorted(HW_KMODS.items()):
            print("%-10s %-15s %s" % (k, p, what))
        print("silik hw driver add NAME installs one: a package of ELRepo (elrepo.org), a third party, beside the base's kernel")
        return 0
    if a.name not in HW_KMODS:
        die("silik hw driver add NAME: %s (silik hw driver list)" % " | ".join(sorted(HW_KMODS)), 2)
    if not x86():
        die("ELRepo builds these drivers for x86_64 only; this machine is %s" % host_arch(), 2)
    p, what = HW_KMODS[a.name]
    print("%s: %s" % (p, what))
    print("It comes from ELRepo (elrepo.org): a third party, not the base system and not SilikVolt. The base's kernel is\n"
          "not changed: the module is added beside it, and ELRepo rebuilds it when the base's kernel interface changes.")
    # (elrepo-release is in AlmaLinux's own extras repository: ELRepo's repository file and its keys)
    ctx.run(["sudo", "dnf", "-y", "install", "elrepo-release"])
    ctx.run(["sudo", "dnf", "-y", "install", p])
    print("Secure Boot: the kernel loads only modules signed by a key it trusts. ELRepo's is not one until it is enrolled:\n"
          "  sudo mokutil --import %s   # asks for a password; confirmed on the blue screen at the next start\n"
          "Then restart. To take it away: sudo dnf remove %s" % (ELREPO_KEY, p))
    return 0


def doc_probe_hardware():
    devs, table, pkg, kernel, arch, src, mine = hw_local()
    dep = read(os.path.join("/lib/modules", kernel, "modules.dep"), None)
    return {"devs": devs, "table": table, "pkg": pkg, "kernel": kernel, "arch": arch, "alias": src, "mine": mine, "fams": hw_families(),
            "known": hw_known(), "dep": dep, "container": sec_container()}


def doc_check_hardware(st):
    rows = []
    if st["devs"] is None:
        doc_row(rows, "hardware", "devices", "devices", "unknown", "no PCI or USB devices to read in /sys%s" % (" (inside a container)" if st["container"] else ""),
                ["silik hw check --from FILE   # a list saved with lspci -nn / lsusb"])
        return rows
    judged = hw_judge(st["devs"], st["table"], st["pkg"], st["fams"], st["known"], True, st["kernel"], st["arch"], st.get("mine"))
    for r in judged:
        if r["state"] in ("none", "unbound", "partial"):
            label = "%s [%s]" % (r["name"] or r["bus"], r["id"])
            doc_row(rows, "hardware", "%s-%s" % (r["bus"], r["id"]), r["bus"] + " device", "warn", "%s: %s" % (label, r["value"]),
                    r["fix"] or ["silik hw check   # every device and its driver"])
    summ = hw_summary(judged)
    with_drv = sum(summ.get(k, 0) for k in ("ok", "program"))
    if with_drv or not rows:
        doc_row(rows, "hardware", "drivers", "drivers", "ok" if with_drv else "unknown",
                "%d devices with a driver bound%s (silik hw check lists them)" % (with_drv, ", %d that often have none" % summ["quiet"] if summ.get("quiet") else ""),
                ["silik hw check --all"])
    # vcan, slcan and ems_usb are in kernel-modules-extra, which the base's own package set does not install
    if st["dep"] is None:
        doc_row(rows, "hardware", "modules-extra", "extra modules", "unknown", "no /lib/modules/%s/modules.dep to read%s" % (st["kernel"], " (inside a container)" if st["container"] else ""),
                ["rpm -q kernel-modules-extra"])
    elif "/vcan.ko" not in st["dep"]:
        doc_row(rows, "hardware", "modules-extra", "extra modules", "warn", "kernel-modules-extra is not installed for kernel %s: no vcan (the virtual CAN bus), slcan, ems_usb" % st["kernel"],
                ["sudo dnf -y install kernel-modules-extra-" + st["kernel"]])
    else:
        doc_row(rows, "hardware", "modules-extra", "extra modules", "ok", "kernel-modules-extra is installed for this kernel (vcan, slcan, ems_usb)")
    return rows


class DocQuery:
    """the read-only commands of `silik power`, through the doctor's list of what it ran"""

    def query(self, argv, any_rc=False):
        rc, out = doc_cmd(argv)
        return out if rc == 0 or (any_rc and rc is not None) else ""


def doc_probe_power():
    p = power_check_probe(DocQuery())
    p["container"] = sec_container()
    return p


def doc_check_power(p):
    """the power area: the profile, a row for each setting `silik power check` warns of, and one for the rest. A
    setting this machine does not have (a desktop has no battery) is counted, not shown: `silik power check` has
    every row"""
    rows = []
    judged = power_check_rows(p)
    for r in judged:
        if r["id"] == "profile" or r["state"] == "warn":
            doc_row(rows, "power", r["id"], r["name"], r["state"], r["value"], r["change"] or ["silik power check"])
    # (the kernel's settings: the rows about silik's own choices, auto and whose profiles, are not a reading of them)
    rest = [r for r in judged if r["id"] not in ("profile", "auto", "profiles") and r["state"] != "warn"]
    seen = sum(1 for r in rest if r["state"] == "ok")
    absent = len(rest) - seen
    if seen:
        doc_row(rows, "power", "settings", "power settings", "ok", "%d settings read%s (silik power check lists them)" % (
            seen, "; %d this machine does not have" % absent if absent else ""))
    else:
        doc_row(rows, "power", "settings", "power settings", "unknown", "no power setting to read in /sys%s" % (
            " (inside a container)" if p["container"] else ": a virtual machine?"), ["silik power check"])
    return rows


DOCTOR = {"system": (doc_probe_system, doc_check_system), "security": (doc_probe_security, doc_check_security),
          "graphics": (doc_probe_graphics, doc_check_graphics), "hardware": (doc_probe_hardware, doc_check_hardware),
          "power": (doc_probe_power, doc_check_power),
          "bench": (doc_probe_bench, doc_check_bench),
          "eda": (doc_probe_eda, doc_check_eda), "windows": (doc_probe_windows, doc_check_windows),
          "network": (doc_probe_network, doc_check_network)}
DOCTOR["system"] = (doc_probe_rollback(doc_probe_system), doc_check_system)     # (the row "rollback": docs/ROLLBACK.md)


def doctor_rows(areas):
    """the rows of AREAS, read at once (one thread per area), judged in order"""
    probes = par([DOCTOR[a][0] for a in areas])
    rows = []
    for a, st in zip(areas, probes):
        if isinstance(st, BaseException):
            doc_row(rows, a, "error", a, "unknown", "the check failed: %s: %s" % (type(st).__name__, st))
            continue
        try:
            rows += DOCTOR[a][1](st)
        except Exception as e:
            doc_row(rows, a, "error", a, "unknown", "the check failed: %s: %s" % (type(e).__name__, e))
    return rows


def cmd_doctor(ctx, a):
    t0 = time.monotonic()
    areas = []
    for w in a.areas or DOCTOR_AREAS:
        w = DOCTOR_ALIASES.get(w, w)
        if w not in DOCTOR:
            die("silik doctor [AREA...]: the areas are %s" % " ".join(DOCTOR_AREAS), 2)
        if w not in areas:
            areas.append(w)
    del DOC_RAN[:]
    rows = doctor_rows(areas)
    secs = time.monotonic() - t0
    count = {k: sum(1 for r in rows if r["state"] == k) for k in ("ok", "warn", "bad", "unknown")}
    rc = 2 if count["bad"] else 1 if count["warn"] or count["unknown"] else 0
    if a.json:
        print(json.dumps({"areas": areas, "checks": rows, "summary": count, "seconds": round(secs, 3), "commands": DOC_RAN}, indent=1))
        return rc
    lines, last = [], None
    for r in rows:
        if r["area"] != last:
            lines.append(("" if last is None else "\n") + r["area"])
            last = r["area"]
        lines.append("%s %-8s %-18s %s" % (SEC_MARK[r["state"]], r["state"], r["name"], r["value"]))
        lines += ["%-29s %s: %s" % ("", "see" if r["state"] == "unknown" else "fix", f) for f in r["fix"]]
    if a.verbose:
        lines.append("\nread with (nothing was changed):")
        lines += ["$ " + c for c in DOC_RAN] + (["$ silik secure status (its read-only checks)"] if "security" in areas else [])
    lines.append("\n%d ok, %d warn, %d bad, %d unknown (%.2f s)" % (count["ok"], count["warn"], count["bad"], count["unknown"], secs))
    text = "\n".join(lines)
    try:
        print(text)
    except UnicodeEncodeError:      # a terminal without the shapes: the words say the same
        print(text.encode("ascii", "replace").decode("ascii"))
    return rc


# ------------------------------------------------------------------ vendor
# `silik vendor`: is this system ready for a vendor's tool, before its installer is run? The tools are data
# (vendors.conf, package silik-tools: what a published page of the vendor says, how and when it was read); nothing
# of that file is executed: its package names go to rpm and dnf, its check names choose among the fixed checks
# below. As the doctor: vendor_probe() reads the system, vendor_rows() judges what was read and runs nothing (the
# tests feed it made-up systems), and every row that is not ok carries the one command that fixes it:
# `silik vendor prepare TOOL` runs those (each printed), and prints the ones left to the person (a network profile,
# a kernel setting, the vendor's own device rules: never changed here). No vendor software is downloaded or run.
VENDORS = "/usr/share/silikos/vendors.conf"
VENDOR_EL9 = {"yes": "yes: AlmaLinux 9 is named", "rhel": "RHEL 9 only, AlmaLinux not named",
              "unlisted": "EL 9 not named (other systems are)", "kernel": "in EL 9's kernel", "box": "no: use a box",
              "windows": "no: Windows VM", "unknown": "not confirmed"}
VENDOR_READ = {"page": "read on the vendor's page", "extract": "a search engine's extract of the vendor's page [A]",
               "none": "not confirmed [A]"}
VENDOR_CHECKS = ("base", "identity", "lsb", "hostid", "tmp", "locale", "x11", "selinux", "limits", "kernel", "serial",
                 "kvm", "box", "usbtmc", "canmod")
VENDOR_LISTS = ("minors", "more", "repos", "pkgs", "pkgs_a", "minver", "checks", "udev", "arch", "mods_kernel", "mods_vendor")
VENDOR_TEXTS = ("name", "maker", "kind", "el9", "release", "says", "read", "date", "url", "udev_how", "own", "route",
                "note", "disk_gb", "ram_gb")
VENDOR_NEEDS = ("name", "el9", "read", "date", "url")
VENDOR_MARK = dict(SEC_MARK, info="·")
VENDOR_RULE_DIRS = ("/etc/udev/rules.d", "/run/udev/rules.d", "/usr/lib/udev/rules.d", "/lib/udev/rules.d")
VENDOR_SYSCTL = ("fs.file-max", "fs.inotify.max_user_watches", "kernel.shmmax", "vm.max_map_count", "user.max_user_namespaces")
LSB_LOADER = "/lib64/ld-lsb-x86-64.so.3"        # the name FlexNet daemons ask the loader by (EL 9 has no redhat-lsb)
USBTMC_RULES = "70-silikos-usbtmc.rules"        # silik-dev
SERIAL_RULES = "70-silikos-serial.rules"


def vendor_parse(text):
    """vendors.conf as ({tool: {key: value}}, {library: package or '-'}); a list key is a list of words. ValueError
    names the line of what it does not understand: a key it does not know is never passed on"""
    tools, libs, cur, last, where = {}, {}, None, None, 0
    for where, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line[0] in " \t":                # a value continued
            if cur is None or last is None:
                raise ValueError("line %d: a continued value with nothing before it" % where)
            cur[last] = (cur[last] + " " + line.strip()).strip()
            continue
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            name, last = line[1:-1], None
            if name == "=libraries":
                cur = libs
            elif not valid_name(name) or name in tools:
                raise ValueError("line %d: [%s]: a tool's name is letters, digits, - _ . and is used once" % (where, name))
            else:
                cur = tools[name] = {}
            continue
        k, eq, v = line.partition("=")
        k, v = k.strip(), v.strip()
        if not eq or cur is None:
            raise ValueError("line %d: expected `key = value` inside a [tool]" % where)
        if cur is not libs and k not in VENDOR_LISTS + VENDOR_TEXTS:
            raise ValueError("line %d: unknown key %r" % (where, k))
        cur[k], last = v, k
    for t, r in tools.items():
        for k in VENDOR_NEEDS:
            if not r.get(k):
                raise ValueError("[%s]: no %s" % (t, k))
        if r["el9"] not in VENDOR_EL9 or r["read"] not in VENDOR_READ:
            raise ValueError("[%s]: el9 is one of %s and read one of %s" % (t, " ".join(VENDOR_EL9), " ".join(VENDOR_READ)))
        for k in VENDOR_LISTS:
            r[k] = r.get(k, "").split()
        bad = [c for c in r["checks"] if c not in VENDOR_CHECKS]
        if bad:
            raise ValueError("[%s]: unknown check %s" % (t, " ".join(bad)))
        # the words that reach a command line: package names (with an architecture or not), module names
        for k in ("pkgs", "pkgs_a", "mods_kernel", "mods_vendor", "repos"):
            for w in r[k]:
                if not re.match(r"^[A-Za-z0-9][A-Za-z0-9+._-]*$", w):
                    raise ValueError("[%s]: %s: %r is not a package or module name" % (t, k, w))
        for w in r["minver"]:
            if not re.match(r"^[A-Za-z0-9][A-Za-z0-9+._-]*:[0-9][0-9A-Za-z.]*$", w):
                raise ValueError("[%s]: minver: %r is not PACKAGE:VERSION" % (t, w))
        for k in ("disk_gb", "ram_gb"):
            if r.get(k) and not r[k].isdigit():
                raise ValueError("[%s]: %s is a whole number" % (t, k))
    for so, pkg in libs.items():
        if not re.match(r"^[A-Za-z0-9][A-Za-z0-9+._-]*$", so) or not re.match(r"^(-|[A-Za-z0-9][A-Za-z0-9+._-]*)$", pkg):
            raise ValueError("[=libraries]: %s = %s" % (so, pkg))
    return tools, libs


def vendor_load(path=None):
    """(tools, libraries) of vendors.conf: $SILIK_VENDORS, the installed file, or the one beside this script"""
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "vendors.conf")
    for p in [path] if path else [os.environ.get("SILIK_VENDORS"), VENDORS, here]:
        if p and os.path.isfile(p):
            try:
                with open(p, encoding="utf-8") as f:
                    return vendor_parse(f.read())
            except (OSError, ValueError) as e:
                die("%s: %s" % (p, e))
    die("the vendors' data (vendors.conf, package silik-tools) is not on this system")


def rpm_vercmp(a, b):
    """rpm's own comparison of two version (or release) strings: -1, 0, 1 (rpmvercmp: segments of digits or of
    letters; a number is newer than letters; ~ sorts before everything, ^ after the version it follows)"""
    a, b = a or "", b or ""
    if a == b:
        return 0
    i = j = 0
    while i < len(a) or j < len(b):
        while i < len(a) and not (a[i].isalnum() or a[i] in "~^"):
            i += 1
        while j < len(b) and not (b[j].isalnum() or b[j] in "~^"):
            j += 1
        ta, tb = a[i:i + 1] == "~", b[j:j + 1] == "~"
        if ta or tb:
            if not ta:
                return 1
            if not tb:
                return -1
            i, j = i + 1, j + 1
            continue
        ca, cb = a[i:i + 1] == "^", b[j:j + 1] == "^"
        if ca or cb:
            if i >= len(a):
                return -1
            if j >= len(b):
                return 1
            if not ca:
                return 1
            if not cb:
                return -1
            i, j = i + 1, j + 1
            continue
        if i >= len(a) or j >= len(b):
            break
        si, sj = i, j
        num = a[i].isdigit()
        test = str.isdigit if num else str.isalpha
        while i < len(a) and test(a[i]):
            i += 1
        while j < len(b) and test(b[j]):
            j += 1
        x, y = a[si:i], b[sj:j]
        if not y:
            return 1 if num else -1
        if num:
            x, y = x.lstrip("0"), y.lstrip("0")
            if len(x) != len(y):
                return 1 if len(x) > len(y) else -1
        if x != y:
            return 1 if x > y else -1
    if i >= len(a) and j >= len(b):
        return 0
    return 1 if i < len(a) else -1


def vendor_rpm(names):
    """{NAME: version, NAME.ARCH: version} for those of NAMES that are installed, from one rpm call; None when the
    system has no rpm (the answer is then unknown, never "missing")"""
    names = sorted(set(names))
    if not shutil.which("rpm"):
        return None
    if not names:
        return {}
    rc, out = sec_cmd(["rpm", "-q", "--qf", "%{NAME}\t%{ARCH}\t%{VERSION}\n"] + names, timeout=60)
    if rc is None:
        return None
    have = {}
    for l in out.splitlines():          # (a package that is not installed is a line "package X is not installed")
        f = l.split("\t")
        if len(f) == 3:
            have[f[0]] = have[f[0] + "." + f[1]] = f[2]
    return have


def repos_enabled(d="/etc/yum.repos.d"):
    """the ids of the enabled repositories, sorted, from the .repo files (dnf is not asked: it is a second each
    time); None when the folder is not there"""
    try:
        files = sorted(f for f in os.listdir(d) if f.endswith(".repo"))
    except OSError:
        return None
    on = set()
    for fn in files:
        sect, enabled = None, True
        for l in read(os.path.join(d, fn)).splitlines() + ["[]"]:
            l = l.strip()
            if l.startswith("["):
                if sect and enabled:
                    on.add(sect)
                sect, enabled = l.strip("[]"), True
            elif sect and l.replace(" ", "").lower().startswith("enabled="):
                enabled = l.split("=", 1)[1].strip().lower() in ("1", "true", "yes")
    return sorted(on)


def net_cards(root=None):
    """the machine's own network interfaces (Ethernet-type, with a device behind them): [{name, mac, assign, wifi}];
    assign: the kernel's addr_assign_type (0: the hardware's address; 1: random; 2: taken from another device;
    3: set by a program, as NetworkManager's cloned address is)"""
    top = os.path.join(root or SYSFS, "class", "net")
    out = []
    try:
        names = sorted(os.listdir(top))
    except OSError:
        return out
    for n in names:
        d = os.path.join(top, n)
        if read(os.path.join(d, "type")).strip() != "1" or not os.path.exists(os.path.join(d, "device")):
            continue
        a = read(os.path.join(d, "addr_assign_type")).strip()
        out.append({"name": n, "mac": read(os.path.join(d, "address")).strip(), "assign": int(a) if a.isdigit() else None,
                    "wifi": os.path.isdir(os.path.join(d, "wireless")) or os.path.isdir(os.path.join(d, "phy80211"))})
    return out


NM_CONF_DIRS = ("/usr/lib/NetworkManager/conf.d", "/run/NetworkManager/conf.d", "/etc/NetworkManager/conf.d")


def nm_defaults(files=None):
    """NetworkManager's default for a cloned address, where a file sets one: [(file, key, value)] for
    ethernet.cloned-mac-address and wifi.cloned-mac-address"""
    if files is None:
        files = []
        for d in NM_CONF_DIRS:
            try:
                files += [os.path.join(d, f) for f in sorted(os.listdir(d)) if f.endswith(".conf")]
            except OSError:
                pass
        files.append("/etc/NetworkManager/NetworkManager.conf")
    out = []
    for p in files:
        for l in read(p).splitlines():
            k, eq, v = l.partition("=")
            if eq and k.strip() in ("ethernet.cloned-mac-address", "wifi.cloned-mac-address"):
                out.append((p, k.strip(), v.strip()))
    return out


def nm_profiles(run=None):
    """the active wired and Wi-Fi connections and their cloned address: [{conn, device, wifi, cloned}] (cloned: ''
    when the profile sets none); None when NetworkManager does not answer"""
    run = run or sec_cmd
    rc, out = run(["nmcli", "-t", "-f", "NAME,DEVICE,TYPE", "connection", "show", "--active"], timeout=5)
    if rc != 0:
        return None
    res = []
    for l in out.splitlines():
        f = re.split(r"(?<!\\):", l)        # (-t writes a ':' of a name as '\:')
        if len(f) != 3 or not ("ethernet" in f[2] or "wireless" in f[2]):
            continue
        name, wifi = f[0].replace("\\:", ":").replace("\\\\", "\\"), "wireless" in f[2]
        rc2, v = run(["nmcli", "-g", ("802-11-wireless" if wifi else "802-3-ethernet") + ".cloned-mac-address", "connection", "show", name], timeout=5)
        res.append({"conn": name, "device": f[1], "wifi": wifi, "cloned": v.strip() if rc2 == 0 else None})
    return res


def udev_rules(dirs=VENDOR_RULE_DIRS):
    """the names of the device-rule files on the system"""
    names = set()
    for d in dirs:
        try:
            names.update(f for f in os.listdir(d) if f.endswith(".rules"))
        except OSError:
            pass
    return names


def modprobe_blacklist(d="/etc/modprobe.d"):
    """{module: file} for the modules a file of /etc/modprobe.d blacklists"""
    out = {}
    try:
        files = sorted(os.listdir(d))
    except OSError:
        return out
    for fn in files:
        for l in read(os.path.join(d, fn)).splitlines():
            f = l.split("#", 1)[0].split()
            if len(f) == 2 and f[0] == "blacklist":
                out.setdefault(f[1].replace("-", "_"), os.path.join(d, fn))
    return out


def vendor_probe(recipes):
    """what `silik vendor check` reads of this system for RECIPES ({tool: recipe}), once: nothing is changed. Only
    what their checks ask is read (NetworkManager is asked for the licence host id alone)"""
    import resource
    want = set(c for r in recipes.values() for c in r["checks"])
    names = set(n for r in recipes.values() for n in r["pkgs"] + r["pkgs_a"] + [m.split(":")[0] for m in r["minver"]])
    uname = os.uname()
    st = {"arch": host_arch(), "release": read("/etc/redhat-release").strip(), "osr": os_release(),
          "osr_base": os.path.islink("/etc/os-release"), "kernel": uname.release,
          "rpm": vendor_rpm(names), "repos": repos_enabled(), "udev": udev_rules(),
          "session": os.environ.get("XDG_SESSION_TYPE", ""),
          "mem_gb": None, "disk_gb": None}
    m = re.search(r"^MemTotal:\s+(\d+) kB", read("/proc/meminfo"), re.M)
    if m:
        st["mem_gb"] = int(m.group(1)) / 1024.0 ** 2
    try:
        v = os.statvfs(os.path.expanduser("~"))
        st["disk_gb"] = v.f_bavail * v.f_frsize / float(GB)
    except OSError:
        pass
    if "lsb" in want:
        st["lsb"], st["lsb_release"] = os.path.exists(LSB_LOADER), shutil.which("lsb_release") is not None
    if "hostid" in want:
        st["cards"], st["nm"], st["nm_conf"] = net_cards(), nm_profiles(), nm_defaults()
        name = uname.nodename
        rc, out = sec_cmd(["getent", "hosts", name], timeout=5)
        st["host"] = {"name": name, "static": read("/etc/hostname").strip(), "resolves": None if rc is None else rc == 0}
    if "tmp" in want:
        st["usr_tmp"] = os.path.isdir("/usr/tmp")
    if "locale" in want:
        rc, out = sec_cmd(["locale", "-a"])
        st["locales"] = None if rc is None else set(l.strip().lower().replace("-", "") for l in out.splitlines())
    if "selinux" in want:
        rc, out = sec_cmd(["getenforce"])
        st["selinux"] = out if rc == 0 else ""
    if "limits" in want:
        lim = {}
        for k, res in (("nofile", resource.RLIMIT_NOFILE), ("nproc", resource.RLIMIT_NPROC), ("stack", resource.RLIMIT_STACK)):
            lim[k] = [None if x == resource.RLIM_INFINITY else x for x in resource.getrlimit(res)]
        st["limits"] = lim
        st["sysctl"] = {k: read("/proc/sys/" + k.replace(".", "/")).strip() for k in VENDOR_SYSCTL}
        st["vsyscall"] = kernel_vsyscall() if x86() else "n/a"
    if "kernel" in want:
        st["kdevel"] = os.path.isdir("/usr/src/kernels/" + uname.release)
    if "serial" in want:
        import grp
        try:
            st["dialout"] = "dialout" in [grp.getgrgid(g).gr_name for g in os.getgroups()]
        except (KeyError, OSError):
            st["dialout"] = False
    if "kvm" in want:
        st["kvm"] = os.path.exists("/dev/kvm")
    if "box" in want:
        st["podman"] = shutil.which("podman") is not None
    if "usbtmc" in want or "canmod" in want:
        mods = read("/proc/modules")
        st["modules"] = set(l.split()[0] for l in mods.splitlines() if l.split()) if mods else None
        st["blacklist"] = modprobe_blacklist()
    return st


def el9_minor(release):
    """'9.8' from the base's release file ("AlmaLinux release 9.8 (...)"); '' when this is not an EL 9 system"""
    m = re.search(r"release (9)\.(\d+)", release or "")
    return "%s.%s" % m.groups() if m else ""


def vendor_rows(tool, r, st):
    """the rows of `silik vendor check TOOL`, judged from the state ST (vendor_probe): [{tool, id, name, state, value,
    run, hand}]. state: ok / warn (something to do) / bad (not on this machine) / unknown (cannot be seen: never ok)
    / info (reported, not judged). run: the commands `silik vendor prepare` runs (argv lists); hand: what is left
    to the person, as text. Nothing is run here"""
    rows = []

    def row(i, name, state, value, run=(), hand=()):
        rows.append({"tool": tool, "id": i, "name": name, "state": state, "value": value,
                     "run": [list(c) for c in run], "hand": list(hand)})

    a_mark = "" if r["read"] == "page" else " [A]"
    here = el9_minor(st.get("release"))
    rel = (r.get("release") or "").strip()
    said = "%s%s%s" % (VENDOR_EL9[r["el9"]], (" (%s)" % rel) if rel else "", a_mark)
    # ---- what the vendor says of this system
    if not here:
        row("support", "vendor support", "unknown", "%s; this is not an EL 9 system (%s)" % (said, st.get("release") or "no /etc/redhat-release"))
    elif r["el9"] == "unknown":
        row("support", "vendor support", "unknown", "%s: %s" % (said, r.get("says") or "its requirements were not read"),
            hand=["read the vendor's page for the release in use" + (": " + r["url"] if r["url"] != "-" else "")])
    elif r["minors"] and here not in r["minors"]:
        row("support", "vendor support", "warn", "%s; it names %s and this system is %s" % (said, " ".join(r["minors"]), here),
            hand=["the vendor's list decides its support: nothing to change here (an installer that refuses the name: silik identity base)"])
    elif r["el9"] in ("yes", "kernel"):
        row("support", "vendor support", "ok", said + ((": this system is %s" % here) if r["minors"] else ""))
    else:
        row("support", "vendor support", "info", said)
    if r["arch"]:
        if st["arch"] not in r["arch"]:
            row("arch", "architecture", "bad", "the vendor publishes it for %s; this machine is %s" % (" ".join(r["arch"]), st["arch"]))
    elif st["arch"] != "x86_64" and r["el9"] != "kernel":
        row("arch", "architecture", "unknown", "this machine is %s; whether the vendor publishes a build for it was not read" % st["arch"])
    checks = r["checks"]
    if "identity" in checks:
        osr = st.get("osr") or {}
        el = "rhel" in (osr.get("ID_LIKE", "") + " " + osr.get("ID", "")).split()
        row("identity", "names read", "ok" if el else "unknown",
            "ID=%s VERSION_ID=%s, release file \"%s\"%s" % (osr.get("ID", "?"), osr.get("VERSION_ID", "?"), st.get("release") or "-",
                                                         "; os-release is the base's own" if st.get("osr_base") else
                                                         "; the display name says SilikOS (an installer that compares it: silik identity base)"))
    # ---- packages
    pk, pka = r["pkgs"], [n for n in r["pkgs_a"] if n not in r["pkgs"]]
    rpm = st.get("rpm")
    missing = []
    if pk or pka:
        if rpm is None:
            row("packages", "packages", "unknown", "rpm is not on this system: %d names not looked up" % len(pk + pka))
        else:
            missing = [n for n in pk + pka if n not in rpm]
            if missing:
                row("packages", "packages", "warn", "%d of %d installed; missing: %s" % (
                    len(pk + pka) - len(missing), len(pk + pka), " ".join(n + ("[A]" if n in pka else "") for n in missing)),
                    run=[["sudo", "dnf", "-y", "install"] + missing])
            else:
                row("packages", "packages", "ok", "all %d installed%s" % (len(pk + pka), (" (%d of them not from the vendor's list [A])" % len(pka)) if pka else ""))
    if r["repos"]:
        on = st.get("repos")
        if on is None:
            row("repos", "repositories", "unknown", "/etc/yum.repos.d is not readable: %s not looked up" % " ".join(r["repos"]))
        else:
            off = [x for x in r["repos"] if x not in on]
            cmds = [["sudo", "dnf", "-y", "install", "epel-release"] if x == "epel" else ["sudo", "dnf", "config-manager", "--set-enabled", x] for x in off]
            if off and missing:
                rows.insert(len(rows) - 1, {"tool": tool, "id": "repos", "name": "repositories", "state": "warn",
                                            "value": "not enabled: %s (the missing packages come from there)" % " ".join(off),
                                            "run": cmds, "hand": []})
            else:
                row("repos", "repositories", "ok", "%s enabled" % " ".join(r["repos"]) if not off else
                    "%s not enabled, and nothing is missing from there" % " ".join(off))
    if r["minver"] and rpm is not None:
        low, good = [], []
        for w in r["minver"]:
            n, _, v = w.partition(":")
            if n in rpm:
                (low if rpm_vercmp(rpm[n], v) < 0 else good).append("%s %s (asked: %s)" % (n, rpm[n], v))
        if low:
            row("minver", "minimum versions", "warn", "older than the source asks: " + ", ".join(low),
                hand=["a newer one than EL 9's, the way the project's own instructions give" + (": " + r["url"] if r["url"] != "-" else "")])
        elif good:
            row("minver", "minimum versions", "ok", ", ".join(good))
    for k, what, have, unit in (("disk_gb", "free disk (home)", st.get("disk_gb"), "GB"), ("ram_gb", "memory", st.get("mem_gb"), "GB")):
        if r.get(k):
            need = int(r[k])
            if have is None:
                row(k, what, "unknown", "the source's figure is %d %s; not readable here" % (need, unit))
            else:
                row(k, what, "ok" if have >= need else "warn", "%.0f %s; the source's figure is %d %s" % (have, unit, need, unit))
    # ---- licence daemons
    if "lsb" in checks:
        tail = "; lsb_release: %s" % ("present" if st.get("lsb_release") else "absent (an installer that calls it: sudo dnf -y install lsb_release, EPEL 9)")
        if st["arch"] != "x86_64":
            row("lsb", "licence loader", "info", "the name %s is the x86_64 daemons'; this machine is %s" % (LSB_LOADER, st["arch"]))
        elif st.get("lsb"):
            row("lsb", "licence loader", "ok", "%s is there (FlexNet daemons ask the loader by that name; EL 9 has no redhat-lsb-core)%s" % (LSB_LOADER, tail))
        else:
            row("lsb", "licence loader", "warn", "%s is missing: lmgrd and the vendor daemons fail with \"No such file or directory\"%s" % (LSB_LOADER, tail),
                run=[["sudo", "ln", "-s", "ld-linux-x86-64.so.2", "/usr/lib64/ld-lsb-x86-64.so.3"]])
    if "hostid" in checks:
        cards, nm, conf = st.get("cards") or [], st.get("nm"), st.get("nm_conf") or []
        if not cards:
            row("hostid", "licence host id", "unknown", "no network interface of the machine is visible here (a container?): a FlexNet host id is an interface's address")
        else:
            said_, hand, state = [], [], "ok"
            dflt = {k.split(".")[0]: (v, p) for p, k, v in conf}
            for c in cards:
                prof = next((p for p in (nm or []) if p["device"] == c["name"]), None)
                cloned = (prof or {}).get("cloned") or ""
                kind = "wifi" if c["wifi"] else "ethernet"
                rnd = cloned in ("random", "stable") or (not cloned and dflt.get(kind, ("", ""))[0] in ("random", "stable"))
                if rnd:
                    state = "warn"
                    why = "profile \"%s\"" % prof["conn"] if cloned else "NetworkManager's default in %s" % dflt[kind][1]
                    said_.append("%s %s: a %s address (%s): a licence locked to it stops working" % (c["name"], c["mac"], cloned or dflt[kind][0], why))
                    hand.append("nmcli connection modify %s %s.cloned-mac-address permanent && nmcli connection up %s" % (
                        shlex.quote(prof["conn"]) if prof else "PROFILE", "wifi" if c["wifi"] else "ethernet", shlex.quote(prof["conn"]) if prof else "PROFILE"))
                elif c["assign"] in (1, 3) and not cloned:
                    state = "warn" if state == "ok" else state
                    said_.append("%s %s: not the hardware's address (%s)" % (c["name"], c["mac"], "random" if c["assign"] == 1 else "set by a program"))
                    hand.append("find what sets the address of %s (ip -d link show %s); a licence wants the hardware's" % (c["name"], c["name"]))
                else:
