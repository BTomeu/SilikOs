               "1300": "Non-Essential Instrumentation", "ff00": "Unassigned class"}
# PCI devices of these classes are often there with no driver (bridges, memory, system peripherals, telemetry):
# said, not counted as a part without a driver. The SD host (0805) is not one of them.
HW_QUIET = ("0500", "0580", "0600", "0601", "0680", "0800", "0806", "0880", "1180", "1300")
