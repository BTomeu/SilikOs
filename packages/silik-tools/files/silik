# frames and the mark stay ink on paper; NAME-vivid also gives the title bars a deep tone of it. Its colours are silikos-desktop's (tools/gen_accents.py); the extension
# follows the key, GTK programs and the shell's own parts follow the themes SilikOS-<accent> (gtk-theme and
# shell-theme make them on the system), which this sets with the key, and Qt 5 programs the user's qt5ct.conf
# (qt_accent). "ink" is the look without an accent: SilikOS.
ACCENTS = (
    ("ink", "one ink on paper, the original"),
    ("steel", "steel #3e5c76"),
    ("steel-vivid", "steel #3e5c76, the title bars in #2a3846"),
    ("cobalt", "cobalt #2f5fe0"),
    ("cobalt-vivid", "cobalt #2f5fe0, the title bars in #22366c"),
    ("silicon", "silicon indigo #4338b8"),
    ("silicon-vivid", "silicon indigo #4338b8, the title bars in #332c7a"),
    ("volt", "volt violet #6d28d9"),
    ("volt-vivid", "volt violet #6d28d9, the title bars in #482285"),
    ("spark", "spark yellow #f2c230"),
)
THEMES = "/usr/share/themes"
ICONS = "/usr/share/icons"
USER_THEME = "org.gnome.shell.extensions.user-theme"
# Qt 5 programs (KLayout, SavvyCAN, PulseView) take their palette from qt5ct (silikos-desktop 0.15: the session's
# QT_QPA_PLATFORMTHEME); qt5ct reads the user's ~/.config/qt5ct/qt5ct.conf, made from silikos-desktop's
# /etc/xdg/qt5ct/qt5ct.conf. The accent's palette is a file of silikos-desktop (tools/gen_accents.py)
QT_SCHEMES = "/usr/share/silikos/qt"
QT5CT_GLOBAL = "/etc/xdg/qt5ct/qt5ct.conf"
QT5CT_PLUGIN_DIRS = tuple(os.environ.get("SILIK_QT5CT_PLUGIN_DIRS", "/usr/lib64/qt5/plugins/platformthemes").split(":"))


def qt5ct_conf(text, keys):
    """TEXT (a qt5ct.conf) with KEYS ({key: value}) set in its [Appearance], every other line as it was"""
    lines = text.splitlines()
    start = next((i for i, l in enumerate(lines) if l.strip() == "[Appearance]"), None)
    if start is None:
        lines += ([""] if lines and lines[-1].strip() else []) + ["[Appearance]"]
        start = len(lines) - 1
    end = next((i for i in range(start + 1, len(lines)) if lines[i].strip().startswith("[")), len(lines))
    left = dict(keys)
    for i in range(start + 1, end):
        k = lines[i].split("=", 1)[0].strip()
        if k in left:
            lines[i] = "%s=%s" % (k, left.pop(k))
    while end > start + 1 and not lines[end - 1].strip():      # (new keys go after the section's last line)
        end -= 1
    lines[end:end] = ["%s=%s" % kv for kv in left.items()]
    return "\n".join(lines) + "\n"


def qt_accent(ctx, accent, icons):
    """the user's qt5ct.conf takes the accent's palette and the icon theme (from silikos-desktop's file when the user
    has none yet); a running Qt 5 program follows it at once (qt5ct watches the file)"""
    scheme = os.path.join(QT_SCHEMES, accent + ".conf")
    if not os.path.isfile(scheme) or not any(os.path.isfile(os.path.join(d, "libqt5ct.so")) for d in QT5CT_PLUGIN_DIRS):
        return   # (qt5ct is only recommended: without it nothing reads the file)
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "qt5ct", "qt5ct.conf")
    old = read(path, None)
    new = qt5ct_conf(old if old is not None else read(QT5CT_GLOBAL, ""),
                     {"custom_palette": "true", "color_scheme_path": scheme, "icon_theme": icons})
    if new == old:
        return
    if not ctx.quiet:
        print("%s %s  (Qt 5 programs: color_scheme_path=%s icon_theme=%s)" % ("~" if old is not None else "+", path, scheme, icons))
    if ctx.dry:
        return
    try:
        # written beside it and renamed over it: qt5ct watches the folder, whose entries change only so (a file
        # rewritten in place left running programs as they were, seen in the rig 12/11/2026)
        path = os.path.realpath(path)   # (a dotfiles link stays a link)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        import tempfile
        fd, tmp = tempfile.mkstemp(prefix=".qt5ct.conf.", dir=os.path.dirname(path))
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(new)
            os.chmod(tmp, 0o644)
            os.replace(tmp, path)
        except BaseException:
            os.unlink(tmp)
            raise
    except OSError as e:
        die("could not write %s: %s" % (path, e.strerror or e))


# Glass (silikos-desktop): the island (or the bar), Start and the COMMAND bar are translucent paper over a blur of
# what is behind them; their muted text darker, so that it reads at 4.5:1 whatever is behind. The key "glass" is the
# switch; the key "glass-mode" says which glass (a silikos-desktop from before the modes has only the switch: on and
# off). The extension and the COMMAND bar follow the keys. The opacities are tools/gen_accents.py's (the tests hold
# these words to them).
GLASS = (("off", "solid paper"),
         ("on", "paper at 0.86 over the blurred wallpaper"),
         ("clear", "paper at 0.70 over the blurred wallpaper"),
         ("crystal", "paper at 0.72 over the blurred windows behind and the wallpaper"),
         ("crystal-thin", "paper at 0.55 over the windows behind and the wallpaper, blurred more"))


def glass_modes(ctx):
    """is the key "glass-mode" on this system? (silikos-desktop from before the modes: only on and off)"""
    return ctx.query(["gsettings", "get", LOOK_SCHEMA, "glass-mode"]).strip().strip("'") in [k for k, _ in GLASS[1:]]


def glass_now(ctx):
    """the glass in use: 'off', a mode, or '' when the key is not on this system (a silikos-desktop without it)"""
    v = ctx.query(["gsettings", "get", LOOK_SCHEMA, "glass"]).strip()
    if v != "true":
        return {"false": "off"}.get(v, "")
    mode = ctx.query(["gsettings", "get", LOOK_SCHEMA, "glass-mode"]).strip().strip("'")
    return mode if mode in [k for k, _ in GLASS[1:]] else "on"


def glass_saver_now(ctx):
    """does the glass rest while the power profile is saver? True, False, or None when the key is not on this system
    (a silikos-desktop from before it)"""
    return {"true": True, "false": False}.get(ctx.query(["gsettings", "get", LOOK_SCHEMA, "glass-saver"]).strip())


# The background (silikos-branding 0.5): a set of drawing sheets, each a light sheet and its dark twin, all made by
# tools/gen_wallpaper.py. The desktop is ink on paper and has no dark style of its own: NAME puts the light sheet on
# it, NAME-dark its dark twin (to see the glass over a dark ground). The dark twin also goes where the desktop's
# defaults put the dark wafer, the lock screen's key (org.gnome.desktop.screensaver), and to picture-uri-dark where
# the desktop has that key (GNOME 42 and later: the shell then takes the dark sheet itself with the dark style [A]).
# A picture that is not of the set (one chosen in GNOME Settings) is "another picture": said, and replaced only by
# --wallpaper; the lock screen's key is left alone when it holds one. (GNOME Shell 40 draws its lock screen from the
# desktop's background, blurred and dimmed, and does not read the screensaver's picture [A: read in its code]; the
# key is kept in step with the defaults all the same.)
WALLPAPERS = (
    ("wafer", "a wafer map with the SilikVolt mark on it"),
    ("plain", "paper and the frame of a drawing sheet: the quietest"),
    ("grid", "a dot grid with the SilikVolt mark at its centre"),
    ("scope", "an oscilloscope's graticule with two traces"),
    ("pcb", "a printed circuit: four buses leaving a square package"),
    ("mesh", "a finite-element mesh of a plate with a hole"),
    ("schematic", "a three-phase inverter in the standard symbols"),
    ("cells", "rows of standard cells with three macro blocks: the dense one"),
)
WALL_CHOICES = [k + d for k, _ in WALLPAPERS for d in ("", "-dark")]
WALL_DIR = "/usr/share/backgrounds/silikos"
WALL_PAPER = {False: "#f1f0ec", True: "#131416"}        # the sheets' paper (tools/gen_wallpaper.py): shown until the picture is drawn
WALL_SCHEMA, SAVER_SCHEMA = "org.gnome.desktop.background", "org.gnome.desktop.screensaver"


def wall_file(name):
    """the file of a sheet ('pcb', 'pcb-dark'); the wafer keeps the names the first two files had"""
    dark = name.endswith("-dark")
    base = name[:-5] if dark else name
    return os.path.join(WALL_DIR, "silikos-%s%s.svg" % ("" if base == "wafer" else base + "-", "dark" if dark else "light"))


def wall_of(uri):
    """the sheet a picture-uri names, or '' when it is not one of the set"""
    path = uri[len("file://"):] if uri.startswith("file://") else uri
    return next((k for k in WALL_CHOICES if path == wall_file(k)), "")


def gsetting(ctx, schema, key):
    """a string setting's value, or None when the key is not on this system"""
    v = ctx.query(["gsettings", "get", schema, key]).strip()
    if not v:
        return None
    return v[1:-1] if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"" else v


def wallpaper_now(ctx):
    """(the sheet in use or '', the picture's address): ('', None) when the desktop has no background setting,
    ('', ADDRESS) when the picture is not one of the set"""
    uri = gsetting(ctx, WALL_SCHEMA, "picture-uri")
    return ("", None) if uri is None else (wall_of(uri), uri)


def look_now(ctx):
    """the look in use, or '' when the setting is not on this system (silikos-desktop older than 0.11, or no desktop)"""
    v = ctx.query(["gsettings", "get", LOOK_SCHEMA, "look"]).strip().strip("'")
    return v if v in [k for k, _ in LOOKS] else ""


def accent_now(ctx):
    """the accent in use, or '' when the key is not on this system (silikos-desktop older than 0.13)"""
    v = ctx.query(["gsettings", "get", LOOK_SCHEMA, "accent"]).strip().strip("'")
    return v if v in [k for k, _ in ACCENTS] else ""


def accent_theme(ident):
    return "SilikOS" if ident == "ink" else "SilikOS-" + ident


def accent_icons(ctx, accent):
    """the icons: in ink with the ink, with a band of colour per kind of file with an accent (tools/gen_icons.py)"""
    return "SilikOS" if accent == "ink" or (not ctx.dry and not os.path.isdir(os.path.join(ICONS, "SilikOS-Colour"))) else "SilikOS-Colour"


def cmd_look(ctx, a):
    if a.qt:
        # Qt 5 programs brought in line with the accent in use (the shell runs it at login and at each change of the
        # accent: a user's qt5ct.conf seeded from the ink one, or an accent set with gsettings, follows it)
        acc = accent_now(ctx) or "ink"
        qt_accent(ctx, acc, accent_icons(ctx, acc))
        return 0
    now = look_now(ctx)
    if a.which is None and a.accent is None and a.glass is None and a.glass_saver is None and a.wallpaper is None:
        acc = accent_now(ctx) if now else ""
        gl = glass_now(ctx) if now else ""
        gs = glass_saver_now(ctx) if gl else None
        modes = GLASS if gl and glass_modes(ctx) else GLASS[:2]       # (a silikos-desktop from before the modes: off, on)
        wall, picture = wallpaper_now(ctx)
        if a.json:
            print(json.dumps({"look": now or None, "looks": [k for k, _ in LOOKS],
                              "accent": acc or None, "accents": [k for k, _ in ACCENTS],
                              "glass": gl or None, "glass_modes": [k for k, _ in modes] if gl else [], "glass_saver": gs,
                              "wallpaper": wall or None, "wallpapers": WALL_CHOICES if picture is not None else [],
                              "wallpaper_other": picture if picture is not None and not wall else None}))
            return 0 if now else 1
        for k, what in LOOKS:
            print("%s %-7s %s" % ("●" if k == now else " ", k, what))
        if acc:
            for k, what in ACCENTS:
                print("%s %-7s accent: %s" % ("●" if k == acc else " ", k, what))
        if gl:
            for k, what in modes:
                print("%s %-12s glass: %s" % ("●" if k == gl else " ", k, what))
            if gs is not None:
                print("  %-12s %s" % ("glass-saver", "on: solid paper while the power profile is saver (silik power)" if gs
                                      else "off: the glass stays in every power profile"))
        if picture is not None:
            for k, what in WALLPAPERS:
                dark = wall == k + "-dark"
                print("%s %-14s wallpaper: %s%s" % ("●" if dark or wall == k else " ", k + "-dark" if dark else k, what, ", its dark twin" if dark else ""))
            print("  %-14s wallpaper: the dark twin of any of them" % "NAME-dark")
            if not wall:
                print("● %-14s wallpaper: another picture, not one of the set: %s" % ("-", picture or "none"))
        if not now:
            print("silik: no setting %s on this system: the looks come with silikos-desktop 0.11" % LOOK_SCHEMA, file=sys.stderr)
            return 1
        return 0
    if not now and not ctx.dry and (a.which is not None or a.accent is not None or a.glass is not None):
        die("no setting %s on this system: the looks come with silikos-desktop 0.11" % LOOK_SCHEMA)
    if a.wallpaper is not None and not ctx.dry:
        if wallpaper_now(ctx)[1] is None:
            die("no setting %s on this system: the wallpaper is a GNOME desktop's" % WALL_SCHEMA)
        base = a.wallpaper[:-5] if a.wallpaper.endswith("-dark") else a.wallpaper
        missing = [p for p in (wall_file(base), wall_file(base + "-dark")) if not os.path.isfile(p)]
        if missing:
            die("the wallpaper %s is not on this system (%s): the set comes with silikos-branding 0.5" % (base, ", ".join(missing)))
    if a.accent is not None and not ctx.dry:
        if not accent_now(ctx):
            die("no accent on this system: the accents come with silikos-desktop 0.13")
        theme = accent_theme(a.accent)
        missing = [p for p in (os.path.join(THEMES, theme, "gtk-3.0", "gtk.css"), os.path.join(THEMES, theme, "gnome-shell", "gnome-shell.css"))
                   if not os.path.isfile(p)]
        if missing:
            die("the theme %s is not made on this system (%s): sudo /usr/libexec/silikos/gtk-theme; sudo /usr/libexec/silikos/shell-theme"
                % (theme, ", ".join(missing)))
    if a.glass is not None and not ctx.dry:
        if not glass_now(ctx):
            die("no glass on this system: this silikos-desktop has no key glass")
        if a.glass not in ("on", "off") and not glass_modes(ctx):
            die("no glass %s on this system: this silikos-desktop has the glass on and off, not its modes" % a.glass)
    if a.glass_saver is not None and not ctx.dry and glass_saver_now(ctx) is None:
        die("no key glass-saver on this system: it comes with silikos-desktop 0.17")
    if a.which is not None:
        ctx.run(["gsettings", "set", LOOK_SCHEMA, "look", a.which])
        if not ctx.dry and look_now(ctx) != a.which:
            # (gsettings exits 0 when it cannot reach the session's settings service: under sudo, or from a shell
            # without the session's bus, nothing changes)
            die("the look is still %s: run it as the user, in the desktop session (gsettings could not change the setting)" % (look_now(ctx) or "unknown"))
    if a.accent is not None:
        theme = accent_theme(a.accent)
        before = accent_now(ctx)
        ctx.run(["gsettings", "set", LOOK_SCHEMA, "accent", a.accent])
        ctx.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", theme])
        ctx.run(["gsettings", "set", USER_THEME, "name", theme])
        icons = accent_icons(ctx, a.accent)
        ctx.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", icons])
        if not ctx.dry and accent_now(ctx) != a.accent:
            die("the accent is still %s: run it as the user, in the desktop session (gsettings could not change the setting)" % (accent_now(ctx) or "unknown"))
        qt_accent(ctx, a.accent, icons)
        if (before or "ink").endswith("-vivid") != a.accent.endswith("-vivid") and before:
            # (mutter redraws the frames of X11 windows only at the first change of theme of a session: seen 12/11/2026)
            print("silik: the title bars of X11 programs (xterm, Magic, Xschem, Wine) take the new colour at the next login")
    if a.glass is not None:
        # off: the switch alone (the mode stays for the next "on" of an older silik). A mode: the mode, then the switch
        if a.glass != "off" and (ctx.dry or glass_modes(ctx)):
            ctx.run(["gsettings", "set", LOOK_SCHEMA, "glass-mode", a.glass])
        ctx.run(["gsettings", "set", LOOK_SCHEMA, "glass", "false" if a.glass == "off" else "true"])
        if not ctx.dry and glass_now(ctx) != a.glass:
            die("the glass is still %s: run it as the user, in the desktop session (gsettings could not change the setting)" % (glass_now(ctx) or "unknown"))
    if a.glass_saver is not None:
        # the shell and the COMMAND bar follow the key at once: with it on, the panes are solid paper while the power
        # profile is saver, and glass again when it is not
        ctx.run(["gsettings", "set", LOOK_SCHEMA, "glass-saver", "true" if a.glass_saver == "on" else "false"])
        if not ctx.dry and glass_saver_now(ctx) != (a.glass_saver == "on"):
            die("glass-saver did not change: run it as the user, in the desktop session (gsettings could not change the setting)")
    if a.wallpaper is not None:
        dark = a.wallpaper.endswith("-dark")
        base = a.wallpaper[:-5] if dark else a.wallpaper
        twin = "file://" + wall_file(base + "-dark")
        ctx.run(["gsettings", "set", WALL_SCHEMA, "picture-uri", "file://" + wall_file(a.wallpaper)])
        ctx.run(["gsettings", "set", WALL_SCHEMA, "picture-options", "zoom"])       # (a picture of the user's may have left another)
        ctx.run(["gsettings", "set", WALL_SCHEMA, "primary-color", WALL_PAPER[dark]])
        if gsetting(ctx, WALL_SCHEMA, "picture-uri-dark") is not None:               # GNOME 42 and later
            ctx.run(["gsettings", "set", WALL_SCHEMA, "picture-uri-dark", twin])
        saver = gsetting(ctx, SAVER_SCHEMA, "picture-uri")
        if (ctx.dry and saver is None) or (saver is not None and wall_of(saver)):
            ctx.run(["gsettings", "set", SAVER_SCHEMA, "picture-uri", twin])
        elif saver:
            print("silik: the lock screen's picture is another picture (%s): left as it is" % saver)
        if not ctx.dry and wallpaper_now(ctx)[0] != a.wallpaper:
            wall, picture = wallpaper_now(ctx)
            die("the wallpaper is still %s: run it as the user, in the desktop session (gsettings could not change the setting)"
                % (wall or picture or "unknown"))
    return 0


# The session's keys (Start's foot in the bar and island looks, the COMMAND bar's sys/lock, sys/logout, sys/off). The
# screen is locked by the shell's own service; leaving and powering off go through the session's question (it waits
# for an answer and for programs with unsaved work), never around it.
SESSION = {
    "lock": ["gdbus", "call", "--session", "--dest", "org.gnome.ScreenSaver", "--object-path", "/org/gnome/ScreenSaver",
             "--method", "org.gnome.ScreenSaver.Lock"],
    "logout": ["gnome-session-quit", "--logout"],
    "off": ["gnome-session-quit", "--power-off"],
}


def cmd_session(ctx, a):
    if not shutil.which(SESSION[a.what][0]) and not ctx.dry:
        die("%s is not on this system: this is for a desktop session" % SESSION[a.what][0])
    rc, _ = ctx.run(SESSION[a.what], check=False, capture=True)
    if rc:
        die("%s exited %d: is this a desktop session?" % (SESSION[a.what][0], rc), rc)
    return 0


# ------------------------------------------------------------------ power
# `silik power`: one front for the power profile (docs/POWER.md). On EL 9.8 the profiles are tuned's (tuned 2.27, in
# the base set). tuned-ppd (AppStream; gnome-control-center 40 pulls it in, and it conflicts with
# power-profiles-daemon) puts the power-profiles-daemon interface on the system bus, the one the shell's system menu
# and the Settings' Power panel use: a profile is set through it when the system has it, so that the menu shows the
# same, and with tuned-adm otherwise. `auto` is the service silikos-power-auto (package silikos-power): at boot and
# when the mains is plugged or unplugged (a udev rule) it runs `silik power apply`. Nothing here is read through a
# command that starts a service: a look at the profile never changes it. The batteries (what the laptop draws, their
# health) are the kernel's files in /sys/class/power_supply; `check` reads what decides the consumption; `charge` is
# the battery's charge limit; `profiles` puts SilikOS's own tuned profile behind `saver` (docs/POWER.md has what
# the base's leaves out). No watts were measured for any of it: a setting is said, never a saving.
POWER = (("performance", "full speed: the highest clocks and boost"),
         ("balanced", "fast when there is work, saving when idle"),
         ("saver", "the least power: low clocks, no boost"))
POWER_PPD = {"performance": "performance", "balanced": "balanced", "saver": "power-saver"}   # the interface's names
# each one's tuned profile on mains power and on battery: /etc/tuned/ppd.conf of EL 9.8's tuned-ppd, which does the same
POWER_TUNED = {"performance": ("throughput-performance", "throughput-performance"), "balanced": ("balanced", "balanced-battery"),
               "saver": ("powersave", "powersave")}
POWER_WORD = {"throughput-performance": "performance", "balanced": "balanced", "balanced-battery": "balanced",
              "powersave": "saver", "performance": "performance", "power-saver": "saver"}
# SilikOS's own tuned profile behind a word (package silikos-power, /usr/lib/tuned/silikos-saver): the base's and what
# it leaves out on a laptop. `silik power profiles silikos` puts it behind `saver`; `base` puts the base's back
POWER_OWN = {"saver": "silikos-saver"}
# what each word's tuned profiles set for the processor (tuned 2.27's tuned.conf files, read 13/11/2026): the
# governor and the platform profile are the first of these the machine offers
POWER_SETS = {"performance": {"governor": ("performance",), "energy_preference": ("performance",), "platform_profile": ("performance",), "boost": True},
              "balanced": {"governor": ("schedutil", "ondemand", "powersave"), "energy_preference": ("balance_performance", "balance_power"),
                           "platform_profile": ("balanced",), "boost": True},
              "saver": {"governor": ("schedutil", "conservative", "powersave"), "energy_preference": ("power",),
                        "platform_profile": ("low-power", "quiet"), "boost": False}}
POWER_BUS = ["net.hadess.PowerProfiles", "/net/hadess/PowerProfiles", "net.hadess.PowerProfiles", "ActiveProfile"]
POWER_AUTO = "silikos-power-auto.service"
POWER_CHARGE = "silikos-power-charge.service"     # the charge limit of power.conf, written again at each start
POWER_CONF = "/etc/silikos/power.conf"
PPD_CONF = "/etc/tuned/ppd.conf"                  # tuned-ppd's: which tuned profile each of the three names is
TUNED_DIRS = ("/etc/tuned", "/usr/lib/tuned")     # where tuned looks for a profile, the administrator's first
POWER_AUTO_DEFAULT = {"ac": "performance", "battery": "balanced"}
PPD_SERVICE = "/usr/share/dbus-1/system-services/net.hadess.PowerProfiles.service"   # tuned-ppd's or power-profiles-daemon's
TUNED_PPD = "/usr/sbin/tuned-ppd"
TUNED_ACTIVE = "/etc/tuned/active_profile"
UNIT_DIR = "/usr/lib/systemd/system"
SYSFS = os.environ.get("SILIK_SYSFS") or "/sys"
PROCFS = os.environ.get("SILIK_PROCFS") or "/proc"
PROC_SWAPS = "/proc/swaps"
ZRAM_GEN = "/usr/lib/systemd/system-generators/zram-generator"   # zram-generator (AppStream): its config makes zram0
ZRAM_UNITS = ["dev-zram0.swap", "systemd-zram-setup@zram0.service"]


def as_root(argv):
    """sudo, unless this already runs as root (the service of `auto`)"""
    return list(argv) if os.geteuid() == 0 else ["sudo"] + list(argv)


def power_source(root=None):
    """(on battery, mains, batteries) from the kernel's power supplies. mains: True when one is online, False when
    some are and none is online, None when none is reported (a desktop's supply is not). A battery: name, percent,
    status; a device's own battery (a mouse: scope Device) is not the computer's. On battery: a battery discharging
    and no mains online (UPower's rule)"""
    top = os.path.join(root or SYSFS, "class", "power_supply")
    mains, bats = None, []
    try:
        names = sorted(os.listdir(top))
    except OSError:
        names = []
    for n in names:
        d = os.path.join(top, n)
        kind = read(os.path.join(d, "type")).strip()
        if kind == "Battery":
            if read(os.path.join(d, "scope")).strip() == "Device":
                continue
            cap = read(os.path.join(d, "capacity")).strip()
            bats.append({"name": n, "percent": int(cap) if cap.isdigit() else None, "status": read(os.path.join(d, "status")).strip() or None})
        elif kind in ("Mains", "USB", "Wireless"):
            if read(os.path.join(d, "online")).strip() == "1":
                mains = True
            elif mains is None:
                mains = False
    on_battery = bool(bats) and not mains and any(b["status"] == "Discharging" for b in bats)
    return on_battery, mains, bats


def sys_int(path):
    """the number in a kernel file, or None when the file is missing or holds something else"""
    try:
        return int(read(path).strip())
    except ValueError:
        return None


def power_batteries(root=None):
    """the computer's batteries with what the kernel says of each (/sys/class/power_supply, read-only): percent,
    status, the energy now / full / by design in Wh (or the charge in Ah, for a battery that counts that), health
    (full against design), the draw in W (power_now, or current_now x voltage_now), the minutes left at that draw
    (to full while charging without a limit), cycles, the charge limit. None wherever the kernel gives no file:
    nothing is estimated. A device's own battery (a mouse: scope Device) is not the computer's"""
    top = os.path.join(root or SYSFS, "class", "power_supply")
    out = []
    try:
        names = sorted(os.listdir(top))
    except OSError:
        names = []
    for n in names:
        d = os.path.join(top, n)
        if read(os.path.join(d, "type")).strip() != "Battery" or read(os.path.join(d, "scope")).strip() == "Device":
            continue

        def g(f):
            return sys_int(os.path.join(d, f))

        def unit(v):
            return None if v is None else round(v / 1e6, 2)
        e_now, e_full, e_des = g("energy_now"), g("energy_full"), g("energy_full_design")      # µWh
        c_now, c_full, c_des = g("charge_now"), g("charge_full"), g("charge_full_design")      # µAh
        p_now, i_now, v_now = g("power_now"), g("current_now"), g("voltage_now")               # µW, µA, µV
        watts = abs(p_now) / 1e6 if p_now is not None else abs(i_now) * v_now / 1e12 if i_now is not None and v_now is not None else None
        full, des = (e_full, e_des) if e_full is not None and e_des else (c_full, c_des)
        status = read(os.path.join(d, "status")).strip() or None
        limit = g("charge_control_end_threshold")

        def hours(e, c):
            """energy over power, or charge over current (a battery counts one or the other)"""
            if e is not None and p_now:
                return e / abs(p_now)
            if c is not None and i_now:
                return c / abs(i_now)
            if e is not None and i_now and v_now:
                return e / (abs(i_now) * v_now / 1e6)
            return None
        left = to_full = None
        if status == "Discharging":
            left = hours(e_now, c_now)
        elif status == "Charging" and limit in (None, 100):
            to_full = hours(None if e_now is None or e_full is None else max(0, e_full - e_now),
                            None if c_now is None or c_full is None else max(0, c_full - c_now))
        out.append({"name": n, "percent": g("capacity"), "status": status,
                    "energy_now_wh": unit(e_now), "energy_full_wh": unit(e_full), "energy_design_wh": unit(e_des),
                    "charge_now_ah": unit(c_now), "charge_full_ah": unit(c_full), "charge_design_ah": unit(c_des),
                    "health_percent": round(100.0 * full / des, 1) if full is not None and des else None,
                    "power_w": None if watts is None else round(watts, 2),
                    "time_left_min": None if left is None else int(round(left * 60)),
                    "time_to_full_min": None if to_full is None else int(round(to_full * 60)),
                    "cycles": g("cycle_count"), "charge_limit": limit, "charge_start": g("charge_control_start_threshold")})
    return out


def power_battery_line(b):
    """one battery's figures in words; only what the kernel gave"""
    said = []
    if b["power_w"] is not None:
        said.append("%.1f W %s" % (b["power_w"], {"Discharging": "drawn", "Charging": "going in"}.get(b["status"], "")))
    for k, what in (("time_left_min", "left at this draw"), ("time_to_full_min", "to full")):
        if b[k] is not None:
            said.append("%d h %02d min %s" % (b[k] // 60, b[k] % 60, what))
    for k, u in (("energy", "Wh"), ("charge", "Ah")):
        now, full, des = (b["%s_%s_%s" % (k, w, u.lower())] for w in ("now", "full", "design"))
        if full is not None:
            more = " (design %.1f %s: health %.0f %%)" % (des, u, b["health_percent"]) if des and b["health_percent"] is not None else ""
            said.append(("%.1f %s of %.1f %s" % (now, u, full, u) if now is not None else "%.1f %s when full" % (full, u)) + more)
            break
    if b["cycles"]:
        said.append("%d cycles" % b["cycles"])
    if b["charge_limit"] is not None:
        said.append("charge limit %d %%%s" % (b["charge_limit"], " (none)" if b["charge_limit"] >= 100 else ""))
    return "; ".join(s.strip() for s in said) or "the kernel gives no energy, current or power figures for it"


def ini(text):
    """{section: {key: value}} of an ini file's text (tuned-ppd's ppd.conf): `key=value` lines under `[section]`"""
    out, cur = {}, None
    for line in text.splitlines():
        line = line.strip()
        if not line or line[0] in "#;":
            continue
        if line.startswith("[") and line.endswith("]"):
            cur = out.setdefault(line[1:-1].strip(), {})
        elif cur is not None and "=" in line:
            k, v = line.split("=", 1)
            cur[k.strip()] = v.split("#", 1)[0].strip()
    return out


def power_conf_all(path=None):
    """every `key = value` line of /etc/silikos/power.conf"""
    out = {}
    for line in read(path or POWER_CONF).splitlines():
        k, eq, v = line.partition("=")
        if eq and not k.lstrip().startswith("#"):
            out[k.strip()] = v.strip()
    return out


def power_charge_conf(path=None):
    """the charge limit asked for (power.conf: charge_limit = N, 1 to 100), or None"""
    v = power_conf_all(path).get("charge_limit", "")
    return int(v) if v.isdigit() and 1 <= int(v) <= 100 else None


def power_ppd_map(path=None):
    """tuned-ppd's map as it reads its ppd.conf: {power-profiles name: (tuned profile on mains power, on battery)};
    {} without the file or its [profiles]"""
    cf = ini(read(path or PPD_CONF))
    ac = cf.get("profiles") or {}
    detect = (cf.get("main") or {}).get("battery_detection")
    on = detect.lower() in ("1", "true", "yes", "on") if detect is not None else "battery" in cf
    dc = dict(ac, **(cf.get("battery") or {})) if on else ac
    return {k: (v, dc.get(k, v)) for k, v in ac.items()}


def power_profile_dir(name):
    """the folder tuned would read the profile NAME from, or None when the system has no such profile"""
    for d in TUNED_DIRS:
        if os.path.exists(os.path.join(d, name, "tuned.conf")):
            return os.path.join(d, name)
    return None


def power_tuned(ppd=None, conf=None):
    """{silik's word: (tuned profile on mains power, on battery)} on this system: tuned-ppd's own map when it has
    its ppd.conf; without it the base's names, with SilikOS's own profile behind a word when power.conf says
    `profiles = silikos` and the profile is installed"""
    m = dict(POWER_TUNED)
    pm = power_ppd_map(ppd)
    if pm:
        for w, p in POWER_PPD.items():
            if p in pm:
                m[w] = pm[p]
    elif power_conf_all(conf).get("profiles") == "silikos":
        for w, n in POWER_OWN.items():
            if power_profile_dir(n):
                m[w] = (n, n)
    return m


def power_word(name, tmap=None):
    """silik's word for a tuned profile or a power-profiles name; None for one outside the three"""
    if not name:
        return None
    if name in POWER_WORD:
        return POWER_WORD[name]
    for w, own in POWER_OWN.items():
        if name == own:
            return w
    for w, pair in (tmap or power_tuned()).items():
        if name in pair:
            return w
    return None


def power_profiles_now(tmap=None):
    """whose tuned profiles are behind the words: silikos, base, or other (a ppd.conf changed by hand)"""
    tmap = tmap or power_tuned()
    if all(tmap[w][0] == n for w, n in POWER_OWN.items()):
        return "silikos"
    return "base" if all(tmap[w] == POWER_TUNED[w] for w in POWER_OWN) else "other"


def power_driver():
    """what carries the profiles: tuned-ppd or power-profiles-daemon (they conflict: one at most), tuned alone, or ''"""
    if os.path.exists(PPD_SERVICE):
        return "tuned-ppd" if os.path.exists(TUNED_PPD) else "power-profiles-daemon"
    return "tuned" if shutil.which("tuned-adm") else ""


def power_conf(path=None):
    """auto's choice: the profile on mains power and on battery (/etc/silikos/power.conf, `key = value` lines)"""
    conf = dict(POWER_AUTO_DEFAULT)
    for line in read(path or POWER_CONF).splitlines():
        k, _, v = line.partition("=")
        k, v = k.strip(), v.strip()
        if k in conf and v in POWER_PPD:
            conf[k] = v
    return conf


def power_cpu(root=None):
    """what the processor was told (read-only, from sysfs): frequency driver, governor, energy preference, boost,
    and the firmware's platform profile. None where the machine does not say (a virtual machine, a container)"""
    r = root or SYSFS
    c = os.path.join(r, "devices/system/cpu/cpu0/cpufreq")
    out = {k: read(os.path.join(c, f)).strip() or None for k, f in
           (("driver", "scaling_driver"), ("governor", "scaling_governor"), ("energy_preference", "energy_performance_preference"))}
    out["platform_profile"] = read(os.path.join(r, "firmware/acpi/platform_profile")).strip() or None
    boost = read(os.path.join(r, "devices/system/cpu/cpufreq/boost")).strip()
    no_turbo = read(os.path.join(r, "devices/system/cpu/intel_pstate/no_turbo")).strip()
    out["boost"] = (boost == "1") if boost else (no_turbo == "0") if no_turbo else None
    return out


def power_zram(path=None):
    """the zram swap devices in use: name, size and used in MiB (/proc/swaps)"""
    out = []
    for line in read(path or PROC_SWAPS).splitlines()[1:]:
        f = line.split()
        if len(f) >= 4 and "/zram" in f[0] and f[2].isdigit() and f[3].isdigit():
            out.append({"device": f[0], "size_mib": int(f[2]) // 1024, "used_mib": int(f[3]) // 1024})
    return out


def power_ppd_now(ctx):
    """the profile the power-profiles interface has, when its service runs ('' otherwise: not started for asking)"""
    out = ctx.query(["busctl", "--auto-start=no", "get-property"] + POWER_BUS).strip()     # s "balanced"
    return out[3:-1] if out.startswith('s "') and out.endswith('"') else ""


def power_state(ctx):
    on_battery, mains, _ = power_source()
    bats = power_batteries()
    tmap = power_tuned()
    draw = [b["power_w"] for b in bats if b["status"] == "Discharging" and b["power_w"] is not None]
    driver = power_driver()
    ppd = power_ppd_now(ctx) if driver in ("tuned-ppd", "power-profiles-daemon") else ""
    # (tuned-ppd answering means tuned runs: it requires it)
    tuned_runs = (driver == "tuned-ppd" and bool(ppd)) or ctx.query(["systemctl", "is-active", "tuned.service"]).strip() == "active"
    tuned = read(TUNED_ACTIVE).strip() if tuned_runs and driver != "power-profiles-daemon" else ""
    auto = ctx.query(["systemctl", "is-enabled", POWER_AUTO], any_rc=True).strip()
    return {"profile": POWER_WORD.get(ppd) or power_word(tuned, tmap), "ppd": ppd or None, "tuned": tuned or None,
            "tuned_running": tuned_runs, "driver": driver or None,
            "tuned_profiles": {w: list(v) for w, v in tmap.items()}, "profiles": power_profiles_now(tmap),
            "auto": True if auto == "enabled" else False if auto else None, "auto_profiles": power_conf(),
            "on_battery": on_battery, "mains": mains, "batteries": bats, "draw_w": round(sum(draw), 2) if draw else None,
            "charge_limit": power_charge_conf(), "cpu": power_cpu(), "zram": power_zram(),
            "zram_generator": os.path.exists(ZRAM_GEN), "trim": ctx.query(["systemctl", "is-enabled", "fstrim.timer"], any_rc=True).strip() or None}


def power_print(st):
    for k, what in POWER:
        ac, dc = st["tuned_profiles"][k]
        print("%s %-12s %s (tuned %s%s)" % ("●" if k == st["profile"] else " ", k, what, ac, "; %s on battery" % dc if dc != ac else ""))
    ap = st["auto_profiles"]
    if st["auto"] is None:
        print("  %-12s not on this system: sudo dnf install silikos-power" % "auto")
    else:
        print("%s %-12s %s on mains power, %s on battery, chosen at each plug and unplug" % ("●" if st["auto"] else " ", "auto", ap["ac"], ap["battery"]))
    if st["batteries"]:
        src = ", ".join("battery %s%% (%s)" % (b["percent"] if b["percent"] is not None else "?", (b["status"] or "?").lower()) for b in st["batteries"])
        src = ("on battery: " if st["on_battery"] else "mains, " if st["mains"] else "") + src
    else:
        src = "mains (no battery)" if st["mains"] is not False else "no battery reported"
    print("%-14s %s" % ("power source", src))
    for b in st["batteries"]:
        print("%-14s %s" % (b["name"], power_battery_line(b)))
    drv = {"tuned-ppd": "tuned through tuned-ppd (the system menu's power profiles)", "power-profiles-daemon": "power-profiles-daemon",
           "tuned": "tuned (no power-profiles service: the system menu shows no profiles)"}.get(st["driver"] or "", "none: sudo dnf install tuned tuned-ppd")
    print("%-14s %s" % ("driver", drv))
    if st["driver"] in ("tuned", "tuned-ppd"):
        print("%-14s %s" % ("tuned", st["tuned"] or "not running: sudo systemctl enable --now tuned"))
    cpu = st["cpu"]
    said = ["%s %s" % (k, cpu[f]) for k, f in (("governor", "governor"), ("energy preference", "energy_preference"), ("platform", "platform_profile")) if cpu[f]]
    if cpu["boost"] is not None:
        said.append("boost " + ("on" if cpu["boost"] else "off"))
    print("%-14s %s" % ("processor", (", ".join(said) + (" (%s)" % cpu["driver"] if cpu["driver"] else "")) if said else "the machine does not say (no cpufreq: a virtual machine?)"))
    z = st["zram"]
    print("%-14s %s" % ("zram swap", ", ".join("%s %d MiB, %d MiB used" % (d["device"], d["size_mib"], d["used_mib"]) for d in z) if z
                        else "set up at the next start (zram-generator)" if st["zram_generator"] else "off: silik power zram on"))
    print("%-14s %s" % ("trim", "weekly (fstrim.timer)" if st["trim"] == "enabled" else "off: silik power trim on" if st["trim"] else "unknown"))


def power_show(ctx, a):
    st = power_state(ctx)
    if getattr(a, "json", False):
        print(json.dumps(st, indent=1))
    else:
        power_print(st)
    return 0 if st["profile"] else 1


def power_set(ctx, word):
    """sets the profile WORD; through the power-profiles interface when the system has it (the session at the screen
    may: polkit's allow_active; from elsewhere it asks for root), with tuned-adm otherwise"""
    driver = power_driver()
    if driver in ("tuned-ppd", "power-profiles-daemon"):
        argv = ["busctl", "set-property"] + POWER_BUS + ["s", POWER_PPD[word]]
        rc, _ = ctx.run(argv, check=False)
        if rc and os.geteuid() != 0:
            ctx.run(["sudo"] + argv)
        elif rc:
            die("busctl exited %d" % rc, rc)
    elif driver == "tuned":
        if ctx.query(["systemctl", "is-active", "tuned.service"]).strip() != "active" and not ctx.dry:
            die("tuned is not running: sudo systemctl enable --now tuned")
        ctx.run(as_root(["tuned-adm", "profile", power_tuned()[word][1 if power_source()[0] else 0]]))
    else:
        die("no power profiles on this system: sudo dnf install tuned tuned-ppd")
    if ctx.dry:
        return 0
    now = power_state(ctx)["profile"]
    if now != word:
        print("silik: the profile reads %s, not %s" % (now or "unknown", word), file=sys.stderr)
        return 1
    return 0


def power_profile(ctx, a):
    """a profile chosen by hand: the automatic choice stops (it would change it at the next plug or unplug)"""
    if ctx.query(["systemctl", "is-enabled", POWER_AUTO], any_rc=True).strip() == "enabled":
        ctx.run(as_root(["systemctl", "disable", "--now", POWER_AUTO]))
    return power_set(ctx, a.cmd)


def power_auto(ctx, a):
    if not os.path.exists(os.path.join(UNIT_DIR, POWER_AUTO)) and not ctx.dry:
        die("the automatic choice comes with the package silikos-power: sudo dnf install silikos-power")
    conf = power_conf()
    want = {"ac": a.ac or conf["ac"], "battery": a.battery or conf["battery"]}
    if want != conf:
        ctx.run(as_root(["sed", "-i", "-e", "s/^ac *=.*/ac = %s/" % want["ac"], "-e", "s/^battery *=.*/battery = %s/" % want["battery"], POWER_CONF]))
    ctx.run(as_root(["systemctl", "enable", POWER_AUTO]))
    ctx.run(as_root(["systemctl", "restart", POWER_AUTO]))     # (a oneshot: this runs `silik power apply` now)
    return 0


def power_apply(ctx, a):
    """the profile auto chooses for the power source now (what silikos-power-auto runs)"""
    on_battery = power_source()[0]
    word = power_conf()["battery" if on_battery else "ac"]
    st = power_state(ctx)
    # (with the power-profiles interface, what it says: tuned-ppd not started yet would, when it starts, put back the
    # profile it keeps, whatever tuned's file says; so it is set through it, which starts it)
    now = POWER_WORD.get(st["ppd"] or "") if st["driver"] in ("tuned-ppd", "power-profiles-daemon") else st["profile"]
    print("silik: on %s: %s%s" % ("battery" if on_battery else "mains power", word, " (already)" if now == word else ""))
    return 0 if now == word else power_set(ctx, word)


def power_tee(ctx, path, value):
    """VALUE written to a kernel file as root, printed as the shell line that does the same; the exit code of tee"""
    argv = as_root(["tee", path])
    if not ctx.quiet:
        print("$ echo %s | %s" % (shlex.quote(value), " ".join(shlex.quote(x) for x in argv)), flush=True)
    if ctx.dry:
        return 0
    ctx.note(argv)
    try:
        return subprocess.run(argv, input=value + "\n", universal_newlines=True, stdout=subprocess.DEVNULL).returncode
    except FileNotFoundError:
        die("%s is not installed" % argv[0])


def power_conf_set(ctx, key, value):
    """KEY = VALUE in /etc/silikos/power.conf, whether or not the file had the line (one sed, printed: the new line
    after the last one, the old one taken out; in that order, so that an old line that is the last one is replaced too)"""
    ctx.run(as_root(["sed", "-i", "-e", "$a %s = %s" % (key, value), "-e", "/^%s *=/d" % key, POWER_CONF]))


def power_charge(ctx, a):
    """the battery's charge limit, for its life: the percent it charges to, written to charge_control_end_threshold
    of the batteries whose driver gives the kernel one (it is the laptop's firmware that stops the charge). Kept in
    power.conf and written again at each start by silikos-power-charge.service, since firmware often forgets it
    [A]. apply: what that service runs. A laptop without the file: said, nothing written"""
    apply = a.limit == "apply"
    bats = power_batteries()
    asked = power_charge_conf()

    def end(b):
        return os.path.join(SYSFS, "class", "power_supply", b["name"], "charge_control_end_threshold")
    with_limit = [b for b in bats if b["charge_limit"] is not None]
    if a.limit is None:
        for b in bats:
            print("%-14s %s" % (b["name"], "no charge limit: the kernel gives none for this battery (no charge_control_end_threshold)" if b["charge_limit"] is None
                                else "charges to %d %%%s%s" % (b["charge_limit"], " (no limit)" if b["charge_limit"] >= 100 else "",
                                                               "; starts charging below %d %%" % b["charge_start"] if b["charge_start"] else "")))
        if not bats:
            print("%-14s %s" % ("battery", "none here: no charge limit to set"))
        unit = ctx.query(["systemctl", "is-enabled", POWER_CHARGE], any_rc=True).strip()
        print("%-14s %s" % ("asked", "nothing: silik power charge 80" if asked is None else "%d %%, %s" % (
            asked, "written again at each start (%s)" % POWER_CHARGE if unit == "enabled" else "not written again at a start: silik power charge %d" % asked)))
        return 0 if with_limit else 1
    if apply:
        if asked is None:
            print("silik: no charge limit was asked for (silik power charge 80)")
            return 0
        n = asked
    else:
        if not a.limit.isdigit() or not 1 <= int(a.limit) <= 100:
            die("silik power charge [N | apply]: N is the percent the battery charges to, 1 to 100 (80 for its life, 100 for no limit)", 2)
        n = int(a.limit)
    if not bats:
        print("silik: no battery here: no charge limit to set; nothing written")
        return 0 if apply else 1
    if not with_limit:
        print("silik: %s: the kernel gives no charge limit for this laptop (no charge_control_end_threshold: its driver has none); nothing written"
              % ", ".join(b["name"] for b in bats))
        return 0 if apply else 1
    rc = 0
    for b in with_limit:
        if b["charge_start"] is not None and b["charge_start"] > n:
            print("silik: %s starts charging below %d %% (charge_control_start_threshold), above the limit asked: the kernel may refuse it until that one is lowered"
                  % (b["name"], b["charge_start"]))
        if power_tee(ctx, end(b), str(n)):
            print("silik: the kernel did not take %d for %s" % (n, b["name"]), file=sys.stderr)
            rc = 1
    if not apply:
        if os.path.exists(os.path.join(UNIT_DIR, POWER_CHARGE)) or ctx.dry:
            if asked != n:
                power_conf_set(ctx, "charge_limit", n)
            if ctx.query(["systemctl", "is-enabled", POWER_CHARGE], any_rc=True).strip() != "enabled":
                ctx.run(as_root(["systemctl", "enable", POWER_CHARGE]))
        else:
            print("silik: a laptop's firmware may forget the limit when it is switched off; the package silikos-power writes it again at each start: "
                  "sudo dnf install silikos-power, then this command again")
    if ctx.dry:
        return 0
    for b in with_limit:
        now = sys_int(end(b))
        if now != n:
            print("silik: %s reads %s, not %d" % (b["name"], "nothing" if now is None else now, n), file=sys.stderr)
            rc = 1
        else:
            print("silik: %s charges to %d %%%s" % (b["name"], n, " (no limit)" if n >= 100 else ""))
    return rc


def power_profiles_cmd(ctx, a):
    """the tuned profiles behind the words: `silikos` puts SilikOS's own saver (silikos-saver: the base's powersave
    and what it leaves out on a laptop) behind `saver`, `base` puts the base's back. With tuned-ppd it is one line of
    its /etc/tuned/ppd.conf (the base's configuration file: changed here, printed, never by a package script), read
    when tuned-ppd starts; without it, a line of power.conf that `silik power saver` reads"""
    tmap = power_tuned()
    if a.which is None:
        now = power_profiles_now(tmap)
        for k, what in (("base", ", ".join("%s = tuned %s" % (w, POWER_TUNED[w][0]) for w in POWER_OWN)),
                        ("silikos", ", ".join("%s = tuned %s" % (w, n) for w, n in POWER_OWN.items())
                         + ": the base's and, left out by it, USB autosuspend, PCI runtime power management, Wi-Fi power save")):
            print("%s %-12s %s" % ("●" if k == now else " ", k, what))
        if now == "other":
            print("  %-12s %s" % ("now", ", ".join("%s = tuned %s" % (w, tmap[w][0]) for w in POWER_OWN) + " (%s, changed by hand)" % PPD_CONF))
        missing = [n for n in POWER_OWN.values() if not power_profile_dir(n)]
        if missing:
            print("  %-12s %s" % ("", "tuned profile %s is not on this system: sudo dnf install silikos-power" % ", ".join(missing)))
        return 0
    own = a.which == "silikos"
    missing = [n for n in POWER_OWN.values() if not power_profile_dir(n)]
    if own and missing and not ctx.dry:
        die("the tuned profile %s comes with the package silikos-power: sudo dnf install silikos-power" % ", ".join(missing))
    want = {w: (n if own else POWER_TUNED[w][0]) for w, n in POWER_OWN.items()}
    st = power_state(ctx)
    if os.path.exists(PPD_CONF):
        script = []
        for w, name in sorted(want.items()):
            script += ["-e", r"/^\[profiles\]/,/^\[/s/^%s *=.*/%s=%s/" % (POWER_PPD[w], POWER_PPD[w], name)]
        ctx.run(as_root(["sed", "-i"] + script + [PPD_CONF]))
        # (tuned-ppd reads its file when it starts; started again, it sets the profile it had, by the new map. Not
        # running, it is left so: the bus starts it when it is next asked)
        if ctx.run(as_root(["systemctl", "try-restart", "tuned-ppd.service"]), check=False)[0]:
            print("silik: tuned-ppd was not started again: it reads the new map at its next start", file=sys.stderr)
    if os.path.exists(POWER_CONF):
        power_conf_set(ctx, "profiles", a.which)
    if not os.path.exists(PPD_CONF) and st["driver"] == "tuned" and st["tuned_running"] and st["profile"] in want and st["tuned"] != want[st["profile"]]:
        ctx.run(as_root(["tuned-adm", "profile", want[st["profile"]]]))      # (the profile in use is one that changed)
    if ctx.dry:
        return 0
    now = power_profiles_now()
    if now != a.which:
        print("silik: the profiles read %s, not %s" % (now, a.which), file=sys.stderr)
        return 1
    print("silik: %s" % ", ".join("%s is tuned %s" % (w, n) for w, n in sorted(want.items())))
    return 0


def power_usb_disk_in_use(n):
    """the USB device N carries a disk the running system uses: a mounted file system, swap, or a volume made on it
    (LVM, LUKS). The saver profile never puts such a disk to sleep (silikos-saver's script.sh, usb_disk_in_use): with
    the system itself on an external disk, a bridge that wakes badly would take the system with it"""
    import glob
    used = set()
    for f in ("self/mounts", "swaps"):
        try:
            with open(os.path.join(PROCFS, f), encoding="utf-8", errors="replace") as fh:
                used.update(l.split(" ", 1)[0].split("\t", 1)[0] for l in fh)
        except OSError:
            pass
    for b in glob.glob(os.path.join(SYSFS, "bus/usb/devices", n, "*:*", "host*", "target*", "*", "block", "*")):
        for part in [b] + sorted(glob.glob(os.path.join(b, "*"))):
            if not os.path.exists(os.path.join(part, "dev")):
                continue
            try:
                if os.listdir(os.path.join(part, "holders")):
                    return True
            except OSError:
                pass
            if "/dev/" + os.path.basename(part) in used:
                return True
    return False


# `silik power check`: what decides a laptop's consumption on this machine, read from /sys and /proc (and the
# profile, as `silik power` reads it; the Wi-Fi's power save from `iw`, which the kernel gives no file for).
# power_check_probe reads, power_check_rows judges what was read and runs nothing (the tests feed it made-up
# machines). A row: ok, warn (the value costs power while the machine is on battery or in the saver profile, or is
# not what the profile in use sets), unknown (no file to read: never ok), the value, and the commands that change
# it. Nothing is measured here: a row says what a setting is, not how many watts it is worth.
def power_check_probe(ctx):
    st = power_state(ctx)

    def ls(*rel):
        try:
            return sorted(os.listdir(os.path.join(SYSFS, *rel)))
        except OSError:
            return []

    def rd(*rel):
        return read(os.path.join(SYSFS, *rel)).strip()
    govs, epps = {}, {}
    for n in ls("devices/system/cpu"):
        if not (n.startswith("cpu") and n[3:].isdigit()):
            continue
        g = rd("devices/system/cpu", n, "cpufreq/scaling_governor")
        if g:
            govs[g] = govs.get(g, 0) + 1
            e = rd("devices/system/cpu", n, "cpufreq/energy_performance_preference")
            if e:
                epps[e] = epps.get(e, 0) + 1
    wifi = []
    for i in ls("class/net"):
        if os.path.exists(os.path.join(SYSFS, "class/net", i, "wireless")) or os.path.exists(os.path.join(SYSFS, "class/net", i, "phy80211")):
            out = ctx.query(["iw", "dev", i, "get", "power_save"]).strip().lower()          # "Power save: on"
            wifi.append({"iface": i, "power_save": True if out.endswith(": on") else False if out.endswith(": off") else None})
    sata = [{"host": h, "policy": rd("class/scsi_host", h, "link_power_management_policy")} for h in ls("class/scsi_host")]
    aspm = rd("module/pcie_aspm/parameters/policy")                                         # "[default] performance powersave powersupersave"
    usb = []
    for n in ls("bus/usb/devices"):
        vid = rd("bus/usb/devices", n, "idVendor")
        if not vid:
            continue                                                                        # (an interface, not a device)
        classes = set(rd("bus/usb/devices", n, i, "bInterfaceClass").lower() for i in ls("bus/usb/devices", n) if ":" in i)
        usb.append({"dev": n, "id": "%s:%s" % (vid, rd("bus/usb/devices", n, "idProduct")), "name": rd("bus/usb/devices", n, "product") or None,
                    "control": rd("bus/usb/devices", n, "power/control") or None,
                    "kept": "input" if "03" in classes else "audio" if "01" in classes else "printer" if "07" in classes else
                            "a disk in use" if power_usb_disk_in_use(n) else None})
    gpus = []
    for n in ls("bus/pci/devices"):
        if not rd("bus/pci/devices", n, "class").startswith("0x03"):
            continue
        drv = os.path.join(SYSFS, "bus/pci/devices", n, "driver")
        boot = rd("bus/pci/devices", n, "boot_vga")
        gpus.append({"slot": n, "driver": os.path.basename(os.path.realpath(drv)) if os.path.exists(drv) else None,
                     "boot": boot == "1" if boot else None, "control": rd("bus/pci/devices", n, "power/control") or None,
                     "status": rd("bus/pci/devices", n, "power/runtime_status") or None})
    backlight = [{"name": n, "now": sys_int(os.path.join(SYSFS, "class/backlight", n, "brightness")),
                  "max": sys_int(os.path.join(SYSFS, "class/backlight", n, "max_brightness"))} for n in ls("class/backlight")]
    ppd = power_ppd_map()
    return {"state": st, "governors": govs, "energy_preferences": epps,
            "platform_choices": rd("firmware/acpi/platform_profile_choices").split(),
            "mem_sleep": rd("power/mem_sleep") or None, "wifi": wifi,
            "audio": sys_int(os.path.join(SYSFS, "module/snd_hda_intel/parameters/power_save")),
            "sata": [h for h in sata if h["policy"]],
            "aspm": aspm[aspm.index("[") + 1:aspm.index("]")] if "[" in aspm and "]" in aspm else aspm or None,
            "aspm_choices": aspm.replace("[", "").replace("]", "").split(),
            "usb": usb, "nmi_watchdog": sys_int(os.path.join(PROCFS, "sys/kernel/nmi_watchdog")), "backlight": backlight, "gpus": gpus,
            "charge_unit": ctx.query(["systemctl", "is-enabled", POWER_CHARGE], any_rc=True).strip() or None,
            "own_profiles": {n: bool(power_profile_dir(n)) for n in POWER_OWN.values()},
            "ppd_missing": sorted(set(t for pair in ppd.values() for t in pair if not power_profile_dir(t))) if any(os.path.isdir(d) for d in TUNED_DIRS) else []}


def power_check_rows(p, battery=False):
    """the rows of `silik power check` for what power_check_probe read. BATTERY: judged as on battery"""
    st, rows = p["state"], []
    prof, cpu = st["profile"], st["cpu"]
    on_battery = st["on_battery"] or battery
    save = on_battery or prof == "saver"            # a setting that costs power is a warning
    why = "on battery" if st["on_battery"] else "judged as on battery" if battery else "the profile is saver"
    # what the profile in use sets for the processor: only for tuned's own three, read from their files
    sets = POWER_SETS.get(prof) if st["driver"] in ("tuned", "tuned-ppd") and (st["tuned"] in POWER_WORD or st["tuned"] in POWER_OWN.values()) else None

    def row(i, name, state, value, change=()):
        rows.append({"id": i, "name": name, "state": state, "value": value, "change": list(change)})
    again = ["silik power %s   # sets it again" % prof] if prof else ["silik power balanced"]

    # the batteries: what the laptop draws
    for b in st["batteries"]:
        row("battery-" + b["name"], "battery", "ok", "%s %s %%, %s; %s" % (b["name"], "?" if b["percent"] is None else b["percent"],
                                                                         (b["status"] or "status unknown").lower(), power_battery_line(b)))
    if not st["batteries"]:
        row("battery", "battery", "unknown", "none in /sys/class/power_supply: a desktop, or a virtual machine")

    # the profile, and the automatic choice
    tuned = " (tuned %s)" % st["tuned"] if st["tuned"] else ""
    if not st["driver"]:
        row("profile", "profile", "unknown", "no power profiles on this system", ["sudo dnf install tuned tuned-ppd"])
    elif not prof:
        row("profile", "profile", "unknown", "tuned's profile is %s, not one of the three" % st["tuned"] if st["tuned"] else "none set (is tuned running?)",
            ["silik power balanced"] if st["tuned_running"] else ["sudo systemctl enable --now tuned"])
    elif prof == "performance" and (st["on_battery"] or (battery and not st["auto"])):
        row("profile", "profile", "warn", "performance%s %s: full speed, the most power" % (tuned, "on battery" if st["on_battery"] else "and it stays on battery (auto is off)"),
            ["silik power auto", "silik power balanced"])
    else:
        row("profile", "profile", "ok", prof + tuned, ["silik power performance | balanced | saver"])
    ap = st["auto_profiles"]
    if st["auto"] is None:
        row("auto", "auto", "unknown", "the package silikos-power is not installed", ["sudo dnf install silikos-power"])
    elif st["auto"]:
        row("auto", "auto", "ok", "on: %s on mains power, %s on battery" % (ap["ac"], ap["battery"]), ["silik power auto --ac P --battery P"])
    else:
        row("auto", "auto", "ok", "off: the profile stays as it is on mains power and on battery", ["silik power auto"])
    own = ", ".join("%s is tuned %s" % (w, st["tuned_profiles"][w][0]) for w in sorted(POWER_OWN))
    if p["ppd_missing"]:
        row("profiles", "tuned profiles", "warn", "%s names %s, not on this system: tuned-ppd does not start with that" % (PPD_CONF, ", ".join(p["ppd_missing"])),
            ["silik power profiles base"])
    else:
        row("profiles", "tuned profiles", "ok", "%s (%s)" % (own, {"silikos": "SilikOS's", "base": "the base's", "other": "set by hand"}[st["profiles"]]),
            ["silik power profiles silikos | base"])

    # the processor: against what the profile in use sets
    def cpu_row(i, name, value, counts, missing):
        if not value and not counts:
            return row(i, name, "unknown", missing)
        said = ", ".join("%s on %d" % kv for kv in sorted(counts.items())) if len(counts) > 1 else value
        want = sets[i.replace("-", "_")] if sets else None
        vals = set(counts) or {value}
        if want and not vals <= set(want):
            return row(i, name, "warn", "%s: the profile %s sets %s" % (said, prof, " or ".join(want)), again)
        if not want and save and "performance" in vals:
            return row(i, name, "warn", "%s (%s)" % (said, why), ["silik power saver", "silik power balanced"])
        row(i, name, "ok", said, ["silik power performance | balanced | saver"])
    cpu_row("governor", "governor", cpu["governor"], p["governors"], "no cpufreq in /sys: a virtual machine, or a container")
    cpu_row("energy-preference", "energy preference", cpu["energy_preference"], p["energy_preferences"],
            "%s gives none (no energy_performance_preference)" % (cpu["driver"] or "this machine"))
    pp, choices = cpu["platform_profile"], p["platform_choices"]
    if not pp:
        row("platform-profile", "platform profile", "unknown", "this firmware gives none (no /sys/firmware/acpi/platform_profile)")
    elif sets and set(sets["platform_profile"]) & set(choices) and pp not in sets["platform_profile"]:
        row("platform-profile", "platform profile", "warn", "%s: the profile %s sets %s (the firmware has: %s)" % (
            pp, prof, " or ".join(sets["platform_profile"]), " ".join(choices)), again)
    else:
        row("platform-profile", "platform profile", "ok", pp + (" (the firmware has: %s)" % " ".join(choices) if choices else ""),
            ["silik power performance | balanced | saver"])
    if cpu["boost"] is None:
        row("boost", "boost", "unknown", "the machine does not say (no cpufreq/boost, no intel_pstate/no_turbo)")
    elif sets and cpu["boost"] != sets["boost"]:
        row("boost", "boost", "warn", "%s: the profile %s turns it %s" % ("on" if cpu["boost"] else "off", prof, "on" if sets["boost"] else "off"), again)
    else:
        row("boost", "boost", "ok", "on" if cpu["boost"] else "off", ["silik power performance | balanced | saver"])

    # suspend: the kernel takes the firmware's word for which one; it is said, not judged
    ms = p["mem_sleep"]
    if not ms:
        row("suspend", "suspend", "unknown", "no /sys/power/mem_sleep")
    else:
        now = ms[ms.index("[") + 1:ms.index("]")] if "[" in ms and "]" in ms else ms
        others = [w for w in ms.replace("[", "").replace("]", "").split() if w != now]
        what = {"s2idle": "s2idle (suspend to idle: the processor idles, the devices are in their low-power states)",
                "deep": "deep (suspend to RAM: everything but the memory is powered down)"}.get(now, now)
        row("suspend", "suspend", "ok", what + ("; also offered: %s" % " ".join(others) if others else "; the only one this firmware offers"),
            ["echo %s | sudo tee /sys/power/mem_sleep   # until the next start" % o for o in others if o in ("deep", "s2idle")])

    # the devices
    if not p["wifi"]:
        row("wifi", "Wi-Fi power save", "unknown", "no Wi-Fi interface in /sys/class/net")
    for w in p["wifi"]:
        on = ["sudo iw dev %s set power_save on" % w["iface"]]
        if w["power_save"] is None:
            row("wifi-" + w["iface"], "Wi-Fi power save", "unknown", "%s: iw did not say" % w["iface"], ["iw dev %s get power_save   # sudo dnf install iw" % w["iface"]])
        elif w["power_save"]:
            row("wifi-" + w["iface"], "Wi-Fi power save", "ok", "%s: on" % w["iface"], ["sudo iw dev %s set power_save off" % w["iface"]])
        else:
            row("wifi-" + w["iface"], "Wi-Fi power save", "warn" if save else "ok", "%s: off%s" % (w["iface"], " (%s)" % why if save else ""), on)
    hda = "/sys/module/snd_hda_intel/parameters/power_save"
    if p["audio"] is None:
        row("audio", "audio power save", "unknown", "no snd_hda_intel loaded (no %s)" % hda)
    elif p["audio"] <= 0:
        row("audio", "audio power save", "warn" if save else "ok", "off: the sound card's codec never sleeps%s" % (" (%s)" % why if save else ""),
            ["echo 1 | sudo tee %s   # seconds idle; 1 is this kernel's own default" % hda])
    else:
        row("audio", "audio power save", "ok", "the codec sleeps after %d s idle" % p["audio"], ["echo N | sudo tee %s   # seconds idle; 0: never" % hda])
    alpm = "/sys/class/scsi_host/host*/link_power_management_policy"
    if not p["sata"]:
        row("sata", "SATA link power", "unknown", "no SATA host with a link power policy (a machine with only NVMe disks has none)")
    else:
        pol = {}
        for h in p["sata"]:
            pol.setdefault(h["policy"], []).append(h["host"])
        said = ", ".join("%s (%s)" % (k, " ".join(v)) for k, v in sorted(pol.items()))
        bad = save and "max_performance" in pol
        row("sata", "SATA link power", "warn" if bad else "ok", said + (" (%s)" % why if bad else ""), ["echo med_power_with_dipm | sudo tee %s" % alpm])
    if not p["aspm"]:
        row("aspm", "PCIe ASPM", "unknown", "no /sys/module/pcie_aspm/parameters/policy")
    else:
        bad = save and p["aspm"] == "performance"
        row("aspm", "PCIe ASPM", "warn" if bad else "ok", "%s%s%s" % (p["aspm"], " (as the firmware set each link)" if p["aspm"] == "default" else "",
                                                                    " (%s)" % why if bad else ""),
            ["echo powersave | sudo tee /sys/module/pcie_aspm/parameters/policy   # one of: %s" % " ".join(p["aspm_choices"])])
    usb = [u for u in p["usb"] if u["control"]]
    if not usb:
        row("usb", "USB autosuspend", "unknown", "no USB device in /sys/bus/usb/devices")
    else:
        awake = [u for u in usb if u["control"] != "auto"]
        costly = [u for u in awake if not u["kept"]]
        said = "%d of %d devices may sleep when idle" % (len(usb) - len(awake), len(usb))
        if awake:
            said += "; kept awake: " + ", ".join("%s %s%s" % (u["dev"], u["id"], " (%s)" % u["kept"] if u["kept"] else "") for u in awake)
        fix = ["echo auto | sudo tee /sys/bus/usb/devices/%s/power/control" % u["dev"] for u in costly]
        if costly and all(p["own_profiles"].values()):
            fix = ["silik power profiles silikos   # then `silik power saver` does it"] + fix if st["profiles"] != "silikos" else ["silik power saver"] + fix
        bad = save and bool(costly)
        row("usb", "USB autosuspend", "warn" if bad else "ok", said + (" (%s)" % why if bad else ""), fix)
    nmi = p["nmi_watchdog"]
    if nmi is None:
        row("nmi-watchdog", "NMI watchdog", "unknown", "no /proc/sys/kernel/nmi_watchdog")
    else:
        bad = save and nmi != 0
        row("nmi-watchdog", "NMI watchdog", "warn" if bad else "ok", ("on" if nmi else "off") + (" (%s)" % why if bad else ""),
            ["sudo sysctl kernel.nmi_watchdog=%d" % (0 if nmi else 1)])
    lit = [b for b in p["backlight"] if b["now"] is not None and b["max"]]
    if not lit:
        row("brightness", "brightness", "unknown", "no backlight in /sys/class/backlight (an external display has none)")
    for b in lit:
        row("brightness-" + b["name"], "brightness", "ok", "%s: %d %% (%d of %d)" % (b["name"], round(100.0 * b["now"] / b["max"]), b["now"], b["max"]),
            ["echo N | sudo tee /sys/class/backlight/%s/brightness   # 0 to %d; or the brightness keys" % (b["name"], b["max"])])
    if not p["gpus"]:
        row("graphics", "graphics card", "unknown", "no display device in /sys/bus/pci/devices")
    for g in p["gpus"]:
        i, name = "graphics-" + g["slot"], "graphics card"
        said = "%s %s: " % (g["slot"], g["driver"] or "no driver")
        ctl = "/sys/bus/pci/devices/%s/power/control" % g["slot"]
        if not g["control"]:
            row(i, name, "unknown", said + "no power/control")
        elif g["control"] == "auto":
            row(i, name, "ok", said + "may sleep when idle (runtime power management auto)%s" % (", now %s" % g["status"] if g["status"] else ""),
                ["echo on | sudo tee " + ctl])
        else:
            # the card the firmware started the display on is in use anyway; a second one kept awake is the cost
            bad = save and g["boot"] is False
            row(i, name, "warn" if bad else "ok", said + "kept awake (runtime power management on)%s%s" % (
                ", the display's card" if g["boot"] else "", " (%s)" % why if bad else ""), ["echo auto | sudo tee " + ctl])

    # the charge limit
    asked = st["charge_limit"]
    for b in st["batteries"]:
        i = "charge-limit-" + b["name"]
        if b["charge_limit"] is None:
            row(i, "charge limit", "unknown", "%s: the kernel gives none for this laptop (no charge_control_end_threshold)" % b["name"])
        elif asked is not None and b["charge_limit"] != asked:
            row(i, "charge limit", "warn", "%s reads %d %%; %d %% was asked for" % (b["name"], b["charge_limit"], asked), ["silik power charge %d" % asked])
        elif asked is not None and p["charge_unit"] != "enabled":
            row(i, "charge limit", "warn", "%s: %d %%, not written again at a start (%s is %s)" % (b["name"], asked, POWER_CHARGE, p["charge_unit"] or "not installed"),
                ["silik power charge %d" % asked])
        else:
            row(i, "charge limit", "ok", "%s: %d %%%s" % (b["name"], b["charge_limit"], " (no limit)" if b["charge_limit"] >= 100 else ""),
                ["silik power charge 80 | 100"])
    if not st["batteries"]:
        row("charge-limit", "charge limit", "unknown", "no battery")
    return rows


def power_check(ctx, a):
    rows = power_check_rows(power_check_probe(ctx), battery=a.battery)
    count = {k: sum(1 for r in rows if r["state"] == k) for k in ("ok", "warn", "unknown")}
    rc = 1 if count["warn"] or count["unknown"] else 0
    if a.json:
        print(json.dumps({"checks": rows, "summary": count}, indent=1))
        return rc
    for r in rows:
        print("%s %-8s %-18s %s" % (SEC_MARK[r["state"]], r["state"], r["name"], r["value"]))
        for c in r["change"]:
            print("%-29s %s: %s" % ("", {"ok": "change", "warn": "fix", "unknown": "see"}[r["state"]], c))
    print("\n%d ok, %d warn, %d unknown: settings as they are now, not watts (nothing was measured or changed)" % (count["ok"], count["warn"], count["unknown"]))
    return rc


def power_zram_cmd(ctx, a):
    """swap in compressed memory (zram-generator, AppStream): the kernel compresses pages instead of writing them to
    disk. Its configuration (the package's) makes /dev/zram0 as large as the memory, at most 8 GiB, used before a disk
    swap. Never on by itself: installing the package is what turns it on, so nothing of SilikOS asks for it"""
    if a.action == "on":
        if not os.path.exists(ZRAM_GEN) or ctx.dry:
            ctx.run(as_root(["dnf", "-y", "install", "zram-generator"]))
        ctx.run(as_root(["systemctl", "daemon-reload"]))         # (the generator writes the units)
        ctx.run(as_root(["systemctl", "start", ZRAM_UNITS[0]]))
    elif a.action == "off":
        # (the pages in it come back to memory first: that needs the free memory, and takes a moment)
        ctx.run(as_root(["systemctl", "stop"] + ZRAM_UNITS), check=False)
        ctx.run(as_root(["dnf", "-y", "remove", "zram-generator"]))
        ctx.run(as_root(["systemctl", "daemon-reload"]))
    if ctx.dry:
        return 0
    z = power_zram()
    print("%-14s %s" % ("zram swap", ", ".join("%s %d MiB, %d MiB used" % (d["device"], d["size_mib"], d["used_mib"]) for d in z)
                        if z else "set up at the next start (zram-generator)" if os.path.exists(ZRAM_GEN) else "off"))
    return 0 if bool(z) == (a.action != "off") or a.action is None else 1


def power_trim(ctx, a):
    """fstrim.timer (util-linux): once a week the file systems tell the SSD which blocks are free. Off on EL 9.8 by
    default; the SilikOS kickstart turns it on"""
    if a.action:
        ctx.run(as_root(["systemctl", "enable" if a.action == "on" else "disable", "--now", "fstrim.timer"]))
    if ctx.dry:
        return 0
    st = ctx.query(["systemctl", "is-enabled", "fstrim.timer"], any_rc=True).strip()
    print("%-14s %s" % ("trim", "weekly (fstrim.timer)" if st == "enabled" else "off" if st else "unknown"))
    return 0


# ------------------------------------------------------------------ speed
# `silik speed`: what an installed EL 9 Workstation starts or runs in the background that an engineer's workstation
# does not need, turned off (docs/SPEED.md has each one: what it is, what stops working without it, why). Like
# `silik secure`: speed_probe reads the system, speed_rows judges what was read and runs nothing (the tests feed it
# made-up systems), speed_plan lists the commands. `apply` turns off what is on, through the base's own tools
# (systemctl disable, a dconf defaults file, an autostart entry that hides the base's), and writes down what it
# changed (SPEED_STATE); `undo` puts back exactly that. Nothing is removed or masked: a unit that is off still starts
# when asked by name, by its socket or by D-Bus. Nothing of docs/SECURITY.md is in the list (firewalld, SELinux,
# auditd, the update timers, chronyd, fstrim stay). The kernel's parameters are not touched.
SPEED_STATE = os.environ.get("SILIK_SPEED_STATE") or "/var/lib/silikos/speed.json"
SPEED_DCONF = "/etc/dconf/db/local.d/30-silikos-speed"     # system defaults (a user's own setting wins); `dconf update`
# gnome-session reads <data dir>/gnome/autostart before /etc/xdg/autostart, and an entry seen first wins: one with
# Hidden=true here keeps the base's entry of the same name from starting, without touching the base's file
SPEED_AUTOSTART = "/usr/local/share/gnome/autostart"
SPEED_SYSROOT = ""          # (the tests' made-up systems live in a folder)
SPEED_FSTAB = "/etc/fstab"
SPEED_MULTIPATH = "/etc/multipath.conf"
SPEED_HIDDEN = "[Desktop Entry]\nType=Application\nName=%s\nComment=not started with the session (silik speed); `silik speed undo %s` puts it back\nHidden=true\n"
SPEED = (
    {"id": "kdump", "name": "crash dumps", "units": ("kdump.service",),
     "what": "kdump.service arms a second kernel at every start and builds its initramfs again after each kernel update",
     "lose": "no memory dump is kept after a kernel crash (the memory set aside for it is the kernel's crashkernel= argument: docs/SPEED.md)"},
    {"id": "modem", "name": "mobile broadband", "units": ("ModemManager.service",), "keep": "modem",
     "what": "ModemManager runs from the start and asks every serial device that is plugged in whether it is a modem",
     "lose": "a mobile broadband modem (4G / 5G) is not managed"},
    {"id": "storage-arrays", "name": "storage arrays", "units": ("libstoragemgmt.service",),
     "what": "libstoragemgmt's daemon (lsmd) runs from the start, for external storage arrays",
     "lose": "lsmcli, and what GNOME Disks shows of an external storage array"},
    {"id": "multipath", "name": "multipath storage", "units": ("multipathd.service", "multipathd.socket"), "keep": "multipath",
     "what": "multipathd.service cannot start without /etc/multipath.conf, but while it is enabled every start waits for udev to settle (systemd-udev-settle.service)",
     "lose": "nothing while there is no /etc/multipath.conf; multipath storage set up later needs it on again"},
    {"id": "rpcbind", "name": "RPC port mapper", "units": ("rpcbind.service",), "keep": "nfs",
     "what": "rpcbind runs from the start; its socket (rpcbind.socket; off on a new SilikOS: silik listen) starts it when an NFS v3 mount or rpcinfo asks",
     "lose": "nothing: it starts on demand"},
    {"id": "makecache", "name": "hourly package metadata", "units": ("dnf-makecache.timer",),
     "what": "dnf downloads the repositories' metadata every hour, from ten minutes after each start",
     "lose": "the first dnf command of a day reads the metadata first; the daily update (silik update --auto) reads it anyway"},
    {"id": "locate", "name": "locate database", "units": ("mlocate-updatedb.timer",),
     "what": "updatedb walks every folder of the disks once a day (right after the start when the machine was off at night)",
     "lose": "`locate` has no database, or an old one, until `sudo updatedb` is run"},
    {"id": "indexer", "name": "file indexer", "installed": "/usr/libexec/tracker-miner-fs-3",
     "dconf": (("org/freedesktop/tracker/miner/files", (("index-recursive-directories", "@as []"), ("index-single-directories", "@as []"))),),
     "what": "Tracker's miner reads the documents of the home folder to index their content, and again when they change",
     "lose": "search by content in Files (names are still found); a user's own setting wins"},
    {"id": "software", "name": "GNOME Software in the background", "installed": "/etc/xdg/autostart/org.gnome.Software.desktop",
     "autostart": ("org.gnome.Software.desktop",), "dconf": (("org/gnome/software", (("download-updates", "false"),)),),
     "what": "GNOME Software starts with every session, stays in memory, checks for updates and downloads them (PackageKit)",
     "lose": "Software's own notices of updates: the updates are the daily timer's (silik update --auto); Software opens from Start as before"},
)
SPEED_IDS = tuple(i["id"] for i in SPEED)
# what a start of this system does not need to wait for or run, read and kept on purpose (docs/SPEED.md says why)
SPEED_KEPT = (
    ("NetworkManager-wait-online.service", "the daily update, NFS mounts and remote logging start after the network is up; the login screen does not wait for it"),
    ("plymouth-quit-wait.service", "it only waits for the boot splash to hand over to the login screen: the quiet boot is the brand's"),
    ("virtqemud.service", "it starts virtual machines marked to start with the system, and leaves by itself after two idle minutes"),
    ("tuned.service", "the power profiles (silik power)"),
    ("firewalld.service auditd.service chronyd.service fstrim.timer silikos-update.timer", "security (docs/SECURITY.md)"),
)


def speed_online():
    """True when systemd runs this system and can stop or start a unit now; False in an installer's %post (a chroot)
    and in a container without it, where `systemctl disable` still changes what the next start does. SYSTEMD_OFFLINE=1
    (systemd's own variable for package and installer scripts; systemctl obeys it too) says so outright"""
    if os.environ.get("SYSTEMD_OFFLINE", "").lower() in ("1", "true", "yes", "on") or not os.path.isdir("/run/systemd/system"):
        return False
    try:
        a, b = os.stat("/"), os.stat("/proc/1/root/")
        return (a.st_dev, a.st_ino) == (b.st_dev, b.st_ino)
    except OSError:
        return True         # (not root: PID 1's root is not ours to read; a user's shell is not an installer's chroot)


def speed_keep():
    """{reason id: why}: what this machine has that an item of the profile serves; the item is then left on"""
    keep = {}
    try:
        ww = sorted(n for n in os.listdir(os.path.join(SYSFS, "class/net")) if n.startswith("ww"))
    except OSError:
        ww = []
    try:
        ww += sorted(os.listdir(os.path.join(SYSFS, "class/wwan")))
    except OSError:
        pass
    if ww:
        keep["modem"] = "a mobile broadband modem is in this machine (%s)" % ww[0]
    if os.path.exists(SPEED_MULTIPATH):
        keep["multipath"] = "%s exists" % SPEED_MULTIPATH
    for line in read(SPEED_FSTAB).splitlines():
        f = line.split("#", 1)[0].split()
        if len(f) >= 3 and f[2] in ("nfs", "nfs4"):
            keep["nfs"] = "an NFS mount in %s (%s)" % (SPEED_FSTAB, f[1])
            break
    return keep


def speed_units(out):
    """{unit: state} from `systemctl list-unit-files --no-legend UNIT...` (UNIT STATE [PRESET]; a unit that is not
    installed has no line)"""
    res = {}
    for l in out.splitlines():
        f = l.split()
        if len(f) >= 2 and "." in f[0]:
            res[f[0]] = f[1]
    return res


def speed_state(path=None):
    """what `silik speed apply` wrote down: {"items": {id: {"units": {unit: {"enabled", "active"}}, "dconf", "files"}},
    "undone": [ids turned back on by name]}"""
    try:
        st = json.loads(read(path or SPEED_STATE) or "{}")
    except ValueError:
        st = {}
    if not isinstance(st, dict):
        st = {}
    st["items"] = st["items"] if isinstance(st.get("items"), dict) else {}
    st["undone"] = [x for x in st.get("undone", []) if x in SPEED_IDS] if isinstance(st.get("undone"), list) else []
    return st


def speed_dconf_text(ids):
    """the dconf defaults file of the items IDS (keyfile), '' when none of them has a setting"""
    sec = {}
    for it in SPEED:
        if it["id"] in ids:
            for path, keys in it.get("dconf", ()):
                sec.setdefault(path, []).extend(keys)
    if not sec:
        return ""
    out = ["# SilikOS: written by `silik speed apply`, removed by `silik speed undo` (docs/SPEED.md). System defaults:",
           "# a user's own setting wins."]
    for path in sorted(sec):
        out += ["", "[%s]" % path] + ["%s=%s" % kv for kv in sec[path]]
    return "\n".join(out) + "\n"


def speed_dconf_has(text, it):
    """True when the dconf defaults file TEXT sets every key of the item as the profile does"""
    have, sec = set(), None
    for l in text.splitlines():
        l = l.strip()
        if l.startswith("[") and l.endswith("]"):
            sec = l[1:-1]
        elif "=" in l and not l.startswith("#"):
            k, v = l.split("=", 1)
            have.add((sec, k.strip(), v.strip()))
    return all((path, k, v) in have for path, keys in it.get("dconf", ()) for k, v in keys)


def speed_probe(cmd=None):
    """what `silik speed` reads (nothing is changed). CMD: the read-only command runner (silik doctor's notes them)"""
    cmd = cmd or sec_cmd
    units = sorted(set(u for it in SPEED for u in it.get("units", ())))
    rc, out = cmd(["systemctl", "list-unit-files", "--no-legend", "--no-pager"] + units)
    online = speed_online()
    active = {}
    if online and rc == 0:
        _, aout = cmd(["systemctl", "is-active"] + units)        # one word per unit, in order
        words = aout.split()
        if len(words) == len(units):
            active = {u: w in ("active", "activating", "reloading") for u, w in zip(units, words)}
    hidden = {}
    for it in SPEED:
        for n in it.get("autostart", ()):
            t = read(os.path.join(SPEED_AUTOSTART, n), None)
            hidden[n] = None if t is None else any(l.strip().replace(" ", "").lower() == "hidden=true" for l in t.splitlines())
    return {"systemctl": rc, "units": speed_units(out) if rc == 0 else {}, "active": active, "online": online,
            "installed": {it["id"]: os.path.exists(SPEED_SYSROOT + it["installed"]) for it in SPEED if it.get("installed")},
            "dconf": read(SPEED_DCONF), "hidden": hidden, "keep": speed_keep(), "state": speed_state()}


def speed_rows(st):
    """one row per item of the profile: state off (as the profile has it) | on (as the base has it) | kept (on, and
    `silik speed apply` leaves it: why) | absent (not on this system) | unknown; nothing is run"""
    rows = []
    for it in SPEED:
        r = {"id": it["id"], "name": it["name"], "what": it["what"], "lose": it["lose"], "units": list(it.get("units", ())), "why": ""}
        on, parts, absent = False, [], False
        if it.get("units"):
            have = {u: st["units"][u] for u in it["units"] if u in st["units"]}
            if st["systemctl"] != 0:
                r["state"], r["value"] = "unknown", "systemd's unit files are not readable here"
                rows.append(r)
                continue
            absent = not have
            on = any(v.startswith("enabled") for v in have.values())
            # (a unit just turned off in an installer, or by hand without --now, runs until the next start)
            run = [u for u in have if st["active"].get(u)]
            parts.append(", ".join("%s %s" % (u, have[u]) for u in sorted(have)) + (" (%s still runs until the next start)" % ", ".join(run) if run and not on else ""))
        else:
            absent = not st["installed"].get(it["id"], True)
            for n in it.get("autostart", ()):
                if not st["hidden"].get(n):
                    on = True
                parts.append("%s %s" % (n, "not started with the session" if st["hidden"].get(n) else "starts with every session"))
            if it.get("dconf"):
                ok = speed_dconf_has(st["dconf"], it)
                on = on or not ok
                parts.append(", ".join("%s=%s" % kv for _, keys in it["dconf"] for kv in keys) if ok else "the base's defaults")
        if absent:
            r["state"], r["value"] = "absent", "not on this system"
        elif not on:
            r["state"], r["value"] = "off", "; ".join(parts)
        else:
            why = st["keep"].get(it.get("keep", "")) or ("turned back on by name (silik speed undo %s)" % it["id"] if it["id"] in st["state"]["undone"] else "")
            r["state"], r["value"], r["why"] = ("kept" if why else "on"), "; ".join(parts), why
        rows.append(r)
    return rows


def speed_applied(rows):
    """True when nothing of the profile is left to turn off (off, kept for a reason, or not on this system)"""
    return all(r["state"] in ("off", "kept", "absent") for r in rows)


def speed_pick(ids):
    bad = [i for i in ids if i not in SPEED_IDS]
    if bad:
        die("silik speed: no item %s; the items are %s" % (" ".join(bad), " ".join(SPEED_IDS)), 2)
    return [it for it in SPEED if not ids or it["id"] in ids]


def speed_write(ctx, path, text, say=None):
    """a file of the system written as root, with what goes in it (or SAY, a line about it) printed after the command"""
    argv = as_root(["install", "-D", "-m", "0644", "/dev/stdin", path])
    ctx.echo(argv)
    if not ctx.quiet:
        print("".join("    | %s\n" % l for l in (text if say is None else say).splitlines()), end="", flush=True)
    if ctx.dry:
        return 0
    ctx.note(argv)
    try:
        return subprocess.run(argv, input=text, universal_newlines=True).returncode
    except OSError:
        return 127


def speed_plan(st, ids=()):
    """(steps, notes) of `silik speed apply [ID...]` on the system `st`. A step: ("run", argv) | ("write", path, text)
    | ("state", new state). Without IDS: every item that is on, but for those kept for a reason (this machine has
    what the item serves, or it was turned back on by name); an item named is turned off whatever the reason"""
    steps, notes = [], []
    rows = {r["id"]: r for r in speed_rows(st)}
    state = json.loads(json.dumps(st["state"]))
    now_off, dconf_before = [], set(i for i, rec in state["items"].items() if rec.get("dconf"))
    for it in speed_pick(ids):
        r = rows[it["id"]]
        if r["state"] == "unknown":
            notes.append("%s: %s, nothing changed" % (it["id"], r["value"]))
            continue
        if r["state"] == "absent" or r["state"] == "off":
            continue
        if r["state"] == "kept" and not ids:
            notes.append("%s: left on, %s" % (it["id"], r["why"]))
            continue
        rec = state["items"].setdefault(it["id"], {})
        if it.get("units"):
            on = [u for u in it["units"] if st["units"].get(u, "").startswith("enabled")]
            if on:
                steps.append(("run", as_root(["systemctl", "disable"] + (["--now"] if st["online"] else []) + on)))
                for u in on:        # (the first record of a unit is what it was before any apply)
                    rec.setdefault("units", {}).setdefault(u, {"enabled": True, "active": st["active"].get(u)})
        for n in it.get("autostart", ()):
            if not st["hidden"].get(n):
                path = os.path.join(SPEED_AUTOSTART, n)
                steps.append(("write", path, SPEED_HIDDEN % (it["name"], it["id"])))
                if path not in rec.setdefault("files", []):
                    rec["files"].append(path)
        if it.get("dconf"):
            rec["dconf"] = True
        if it["id"] in state["undone"]:
            state["undone"].remove(it["id"])
        now_off.append(it["id"])
    dconf_after = set(i for i, rec in state["items"].items() if rec.get("dconf"))
    if dconf_after != dconf_before or any(not speed_dconf_has(st["dconf"], it) for it in SPEED if it["id"] in dconf_after and it["id"] in now_off):
        steps.append(("write", SPEED_DCONF, speed_dconf_text(dconf_after)))
        steps.append(("run", as_root(["dconf", "update"])))
    if now_off:
        state["applied"] = time.strftime("%Y-%m-%dT%H:%M:%S")
        steps.append(("state", state))
    return steps, notes


def speed_unplan(st, ids=()):
    """(steps, notes) of `silik speed undo [ID...]`: what apply wrote down, put back; nothing else is touched. An
    item named is remembered as the user's choice (a later `silik speed apply` leaves it on)"""
    steps, notes = [], []
    state = json.loads(json.dumps(st["state"]))
    dconf_before = set(i for i, rec in state["items"].items() if rec.get("dconf"))
    done = []
    for it in speed_pick(ids):
        rec = state["items"].get(it["id"])
        if rec is None:
            if ids:
                notes.append("%s: `silik speed apply` did not change it on this system, nothing to put back" % it["id"])
                if it["id"] not in state["undone"]:
                    state["undone"].append(it["id"])
                    done.append(it["id"])
            continue
        units = rec.get("units") or {}
        # (a unit turned off in an installer was not seen running or not: it is started, as a start of the base does)
        start = sorted(u for u, was in units.items() if was.get("enabled") and was.get("active") is not False and st["online"])
        only = sorted(u for u, was in units.items() if was.get("enabled") and u not in start)
        if start:
            steps.append(("run", as_root(["systemctl", "enable", "--now"] + start)))
        if only:
            steps.append(("run", as_root(["systemctl", "enable"] + only)))
        for path in rec.get("files") or []:
            if path.startswith(SPEED_AUTOSTART + "/"):          # (only what apply itself made)
                steps.append(("run", as_root(["rm", "-f", path])))
        del state["items"][it["id"]]
        if ids and it["id"] not in state["undone"]:
            state["undone"].append(it["id"])
        done.append(it["id"])
    dconf_after = set(i for i, rec in state["items"].items() if rec.get("dconf"))
    if dconf_after != dconf_before:
        text = speed_dconf_text(dconf_after)
        steps.append(("write", SPEED_DCONF, text) if text else ("run", as_root(["rm", "-f", SPEED_DCONF])))
        steps.append(("run", as_root(["dconf", "update"])))
    if done:
        if not state["items"]:
            state.pop("applied", None)
        steps.append(("state", state))
    return steps, notes


def speed_do(ctx, steps, undo=False):
    """runs the steps in order; the commands that failed. What apply meant to change is written down even when a
    command failed (putting back a unit that stayed on changes nothing); an undo with a failure keeps the note as it
    was, so that it can be run again"""
    failed = []
    for s in steps:
        if s[0] == "run":
            rc, _ = ctx.run(s[1], check=False)
            if rc != 0:
                failed.append(" ".join(shlex.quote(x) for x in s[1]))
        elif s[0] == "write":
            if speed_write(ctx, s[1], s[2]) != 0:
                failed.append("write " + s[1])
        elif s[0] == "state":
            if failed and undo:
                print("silik: %s is left as it was: a command above failed; run `silik speed undo` again" % SPEED_STATE, file=sys.stderr)
            elif speed_write(ctx, SPEED_STATE, json.dumps(s[1], indent=1, sort_keys=True) + "\n",
                             "what apply changed, for undo: %s" % (" ".join(sorted(s[1]["items"])) or "nothing")) != 0:
                failed.append("write " + SPEED_STATE)
    return failed


def speed_print(rows, st):
    lines = []
    for r in rows:
        lines.append("%s %-7s %-15s %s: %s" % ("●" if r["state"] == "off" else " ", r["state"], r["id"], r["name"],
                                                r["value"] + ("; kept: " + r["why"] if r["why"] else "")))
        if r["state"] in ("on", "kept", "unknown"):
            lines.append("%-25s %s" % ("", r["what"]))
            lines.append("%-25s off: %s" % ("", r["lose"]))
    n = {k: sum(1 for r in rows if r["state"] == k) for k in ("off", "on", "kept", "absent", "unknown")}
    lines.append("%d off, %d on, %d kept, %d not on this system%s" % (n["off"], n["on"], n["kept"], n["absent"], ", %d unknown" % n["unknown"] if n["unknown"] else ""))
    lines.append("`silik speed apply [ITEM...]` turns off what is on; `silik speed undo [ITEM...]` puts back what apply changed%s"
                 % (" (it changed: %s)" % " ".join(sorted(st["state"]["items"])) if st["state"]["items"] else ""))
    text = "\n".join(lines)
    try:
        print(text)
    except UnicodeEncodeError:
        print(text.encode("ascii", "replace").decode("ascii"))


def speed_show(ctx, a):
    st = speed_probe()
    rows = speed_rows(st)
    if getattr(a, "json", False):
        print(json.dumps({"items": rows, "applied": speed_applied(rows), "online": st["online"], "changed": sorted(st["state"]["items"]),
                          "undone": st["state"]["undone"], "state_file": SPEED_STATE}, indent=1))
    else:
        speed_print(rows, st)
    return 1 if any(r["state"] == "unknown" for r in rows) else 0


def speed_apply(ctx, a):
    st = speed_probe()
    steps, notes = speed_plan(st, a.items)
    failed = speed_do(ctx, steps)
    for n in notes:
        print(n)
    for f in failed:
        print("silik: failed: " + f, file=sys.stderr)
    if not steps and not any("nothing changed" in n for n in notes):
        print("nothing to turn off: the items%s are off, kept for a reason or not on this system" % (" named" if a.items else " of the profile"))
    elif not st["online"] and not ctx.dry:
        print("systemd does not run here (an installer, a container): the units are off from the next start")
    print("`silik speed` shows each item; `silik bench system` measures the start and the memory")
    return 1 if failed else 0


def speed_undo(ctx, a):
    st = speed_probe()
    steps, notes = speed_unplan(st, a.items)
    failed = speed_do(ctx, steps, undo=True)
    for n in notes:
        print(n)
    for f in failed:
        print("silik: failed: " + f, file=sys.stderr)
    if not any(s[0] != "state" for s in steps):
        print("nothing to put back: `silik speed apply` has changed nothing%s on this system" % (" of these" if a.items else ""))
    else:
        print("put back as it was before `silik speed apply`; what belongs to the session takes effect at the next login")
    return 1 if failed else 0


def doc_speed(st, rows):
    """the row of `silik doctor system`: is the speed profile applied"""
    sp = st.get("speed")
    if sp is None:
        return
    items = speed_rows(sp)
    n = {k: [r["id"] for r in items if r["state"] == k] for k in ("off", "on", "kept", "absent", "unknown")}
    if n["unknown"] and not n["on"]:
        doc_row(rows, "system", "speed", "speed profile", "unknown", "systemd's unit files are not readable here%s" % (" (inside a container)" if st.get("container") else ""),
                ["silik speed"])
    elif n["on"]:
        doc_row(rows, "system", "speed", "speed profile", "warn", "%d of %d background services run as the base has them: %s" % (len(n["on"]), len(items) - len(n["absent"]), " ".join(n["on"])),
                ["silik speed apply", "silik speed   # what each one is, and what stops working without it"])
    else:
        doc_row(rows, "system", "speed", "speed profile", "ok", "%d off%s%s" % (len(n["off"]), ", %d kept (%s)" % (len(n["kept"]), " ".join(n["kept"])) if n["kept"] else "",
                                                                             ", %d not on this system" % len(n["absent"]) if n["absent"] else ""))


# ------------------------------------------------------------------ bench
# `silik bench system`: how this system started and what it holds at rest, measured with the base's own tools and
# read from /proc: systemd-analyze (firmware, loader, kernel, initrd, userspace), its blame and the chain to
# graphical.target, when the login screen and the session were up, memory, the largest processes, units, disk,
# packages. One capture is one sample: `silik bench compare A.json B.json ...` puts several side by side (the CI's
# installation test takes them on an installed system with the speed profile and without it: docs/SPEED.md). The
# parsers are of systemd 252's output (EL 9): tests/test_bench_system.py.
BENCH_SPANS = {"y": 31557600.0, "month": 2629800.0, "w": 604800.0, "d": 86400.0, "h": 3600.0, "min": 60.0, "s": 1.0, "ms": 1e-3, "us": 1e-6,
               "\u03bcs": 1e-6, "\u00b5s": 1e-6}


def bench_span(text):
    """seconds of a systemd time span ("1min 2.345s", "934ms", "12us"), None when it is not one"""
    total, seen = 0.0, False
    for num, unit in re.findall(r"([0-9]+(?:\.[0-9]+)?)\s*([a-z\u03bc\u00b5]+)", text.strip()):
        if unit not in BENCH_SPANS:
            return None
        total += float(num) * BENCH_SPANS[unit]
        seen = True
    return round(total, 6) if seen and re.fullmatch(r"(?:\s*[0-9]+(?:\.[0-9]+)?\s*[a-z\u03bc\u00b5]+)+\s*", text) else None


def bench_time(text):
    """`systemd-analyze time`: {"finished": True, "firmware_s", "loader_s", "kernel_s", "initrd_s", "userspace_s",
    "total_s", "target", "target_s"} (a part the machine does not report is absent); {"finished": False} before the
    start is over; {} when the text is something else"""
    if "not yet finished" in text:
        return {"finished": False}
    m = re.search(r"Startup finished in (.+)", text)
    if not m:
        return {}
    out = {"finished": True}
    line = m.group(1)
    head, eq, tot = line.partition("=")
    for part in head.split("+"):
        pm = re.match(r"\s*(.+?)\s*\((firmware|loader|kernel|initrd|userspace)\)\s*$", part)
        if pm and bench_span(pm.group(1)) is not None:
            out[pm.group(2) + "_s"] = bench_span(pm.group(1))
    if eq and bench_span(tot) is not None:
        out["total_s"] = bench_span(tot)
    m = re.search(r"^(\S+) reached after (.+?) in userspace", text, re.M)
    if m and bench_span(m.group(2)) is not None:
        out["target"], out["target_s"] = m.group(1), bench_span(m.group(2))
    return out


def bench_blame(text, top=25):
    """`systemd-analyze blame`: [{"unit", "s"}], the slowest first (its order), at most TOP"""
    out = []
    for l in text.splitlines():
        f = l.split()
        if len(f) >= 2 and bench_span(" ".join(f[:-1])) is not None:
            out.append({"unit": f[-1], "s": bench_span(" ".join(f[:-1]))})
    return out[:top]


def bench_chain(text):
    """`systemd-analyze critical-chain UNIT`: [{"unit", "at_s", "took_s", "depth"}] from the unit down to what it
    waited for (at_s: when it was up or started, after the "@"; took_s: how long it took to start, after the "+")"""
    out = []
    for l in text.splitlines():
        m = re.match(r"^([\s│└├─]*)(\S+\.[a-z]+)((?:\s+[@+][^@+]*)+)$", l)
        if not m:
            continue
        row = {"unit": m.group(2), "at_s": None, "took_s": None, "depth": len(m.group(1)) // 2}
        for sign, span in re.findall(r"([@+])([^@+]+)", m.group(3)):
            row["at_s" if sign == "@" else "took_s"] = bench_span(span)
        out.append(row)
    return out


def bench_meminfo(text):
    """/proc/meminfo as `free -m` shows it, in MB: total, used, free, buff_cache, available, swap_total, swap_used;
    {} when it is not readable. used is total - available, as EL 9.8's free gives it (procps-ng 3.3.17, seen beside
    this on 13/11/2026: not the older total - free - buffers - cache, which is what it is when the kernel gives no
    MemAvailable)"""
    kb = {}
    for l in text.splitlines():
        k, _, v = l.partition(":")
        if v.split() and v.split()[0].isdigit():
            kb[k.strip()] = int(v.split()[0])
    if "MemTotal" not in kb:
        return {}
    cache = kb.get("Buffers", 0) + kb.get("Cached", 0) + kb.get("SReclaimable", 0)
    mb = lambda x: int(round(x / 1024.0))
    used = kb["MemTotal"] - kb["MemAvailable"] if "MemAvailable" in kb else kb["MemTotal"] - kb.get("MemFree", 0) - cache
    return {"total_mb": mb(kb["MemTotal"]), "used_mb": mb(used), "free_mb": mb(kb.get("MemFree", 0)),
            "buff_cache_mb": mb(cache), "available_mb": mb(kb["MemAvailable"]) if "MemAvailable" in kb else None,
            "swap_total_mb": mb(kb.get("SwapTotal", 0)), "swap_used_mb": mb(kb.get("SwapTotal", 0) - kb.get("SwapFree", 0))}


def bench_processes(root="/proc", skip=None):
    """(processes, kernel threads): each process {"pid", "name", "user", "rss_kb", "pss_kb" (None when its memory map
    is not ours to read), "cmd"}, the largest resident set first; a kernel thread has no memory of its own. SKIP: a
    process id left out (the one that measures)"""
    import pwd
    procs, kthreads, names = [], 0, {}
    try:
        pids = [p for p in os.listdir(root) if p.isdigit() and p != str(skip)]
    except OSError:
        return [], 0
    for pid in pids:
        d = os.path.join(root, pid)
        st = {}
        for l in read(os.path.join(d, "status")).splitlines():
            k, _, v = l.partition(":")
            st[k] = v.strip()
        if "Name" not in st:
            continue                    # (gone meanwhile)
        if "VmRSS" not in st:
            kthreads += 1
            continue
        uid = st.get("Uid", "").split()[0] if st.get("Uid") else ""
        if uid not in names:
            try:
                names[uid] = pwd.getpwuid(int(uid)).pw_name
            except (KeyError, ValueError):
                names[uid] = uid
        pss = None
        for l in read(os.path.join(d, "smaps_rollup")).splitlines():
            if l.startswith("Pss:") and l.split()[1].isdigit():
                pss = int(l.split()[1])
                break
        argv = read(os.path.join(d, "cmdline")).split("\0")
        cmd = " ".join(argv).strip()
        full = os.path.basename(argv[0]) if argv and argv[0] else ""
        if full.startswith(st["Name"]) and len(st["Name"]) == 15:      # (the kernel keeps 15 letters of a name)
            st["Name"] = full
        procs.append({"pid": int(pid), "name": st["Name"], "user": names[uid], "rss_kb": int(st["VmRSS"].split()[0]) if st["VmRSS"].split()[0].isdigit() else 0,
                      "pss_kb": pss, "cmd": cmd[:160]})
    procs.sort(key=lambda p: (-p["rss_kb"], p["pid"]))
    return procs, kthreads


def bench_usec(text):
    """seconds of a `systemctl show -p ...TimestampMonotonic --value` answer (microseconds; 0: never), or None"""
    t = text.strip()
    return round(int(t) / 1e6, 3) if t.isdigit() and int(t) > 0 else None


def bench_session(cmd):
    """(user, seconds after the kernel started at which that user's graphical session was up), from the user's own
    systemd: graphical-session.target. As root: the first user with a session folder in /run/user whose systemd
    answers. (None, None) when there is none"""
    import pwd
    prop = ["show", "graphical-session.target", "-p", "ActiveEnterTimestampMonotonic", "--value"]
    if os.geteuid() != 0:
        rc, out = cmd(["systemctl", "--user"] + prop) if user_bus() else (None, "")
        try:
            me = pwd.getpwuid(os.geteuid()).pw_name
        except KeyError:
            me = str(os.geteuid())
        return (me, bench_usec(out)) if rc == 0 and bench_usec(out) is not None else (None, None)
    try:
        uids = sorted(int(u) for u in os.listdir("/run/user") if u.isdigit() and int(u) >= 1000)
    except OSError:
        uids = []
    for uid in uids:
        try:
            name = pwd.getpwuid(uid).pw_name
        except KeyError:
            continue
        rc, out = cmd(["systemctl", "--user", "--machine=%s@.host" % name] + prop)
        if rc == 0 and bench_usec(out) is not None:
            return name, bench_usec(out)
    return None, None


def bench_disk(mp):
    """size, used and free MB of the file system at MP; None when it is not one of its own (/boot inside /)"""
    try:
        s = os.statvfs(mp)
        if mp != "/" and os.stat(mp).st_dev == os.stat("/").st_dev:
            return None
    except OSError:
        return None
    mb = 1024 * 1024
    return {"size_mb": s.f_blocks * s.f_frsize // mb, "used_mb": (s.f_blocks - s.f_bfree) * s.f_frsize // mb, "free_mb": s.f_bavail * s.f_frsize // mb}


def bench_capture(label=""):
    """one capture of this system, as `silik bench system --json` prints it; what cannot be read is None or absent,
    never a guess"""
    cmd = sec_cmd
    osr = os_release()
    cap = {"label": label, "date": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "silik": VERSION,
           "system": {"name": osr.get("PRETTY_NAME") or None, "base": read("/etc/redhat-release").strip() or None, "kernel": os.uname().release,
                      "arch": host_arch(), "cpus": os.cpu_count(), "virt": (cmd(["systemd-detect-virt"])[1] or None)}}
    up = read("/proc/uptime").split()
    cap["uptime_s"] = float(up[0]) if up else None
    rc, out = cmd(["systemd-analyze", "time"])
    boot = bench_time(out) if rc is not None else {}
    cap["boot"] = boot or {"finished": None}
    cap["boot"]["login_screen_s"] = bench_usec(cmd(["systemctl", "show", "gdm.service", "-p", "ActiveEnterTimestampMonotonic", "--value"])[1])
    user, at = bench_session(cmd)
    cap["boot"]["desktop_s"], cap["boot"]["desktop_user"] = at, user
    cap["blame"] = bench_blame(cmd(["systemd-analyze", "blame", "--no-pager"])[1])
    cap["chain"] = bench_chain(cmd(["systemd-analyze", "critical-chain", "graphical.target", "--no-pager"])[1])
    cap["memory"] = bench_meminfo(read("/proc/meminfo"))
    crash = read("/sys/kernel/kexec_crash_size").strip()
    cap["kernel"] = {"cmdline": read("/proc/cmdline").strip() or None, "crash_reserved_mb": int(crash) // (1024 * 1024) if crash.isdigit() else None,
                     "crash_loaded": {"1": True, "0": False}.get(read("/sys/kernel/kexec_crash_loaded").strip())}
    procs, kthreads = bench_processes(skip=os.getpid())
    pss = [p["pss_kb"] for p in procs]
    cap["processes"] = {"count": len(procs), "kernel_threads": kthreads, "rss_sum_mb": sum(p["rss_kb"] for p in procs) // 1024,
                        "pss_sum_mb": sum(pss) // 1024 if procs and all(x is not None for x in pss) else None, "largest": procs[:25],
                        "names": sorted(set(p["name"] for p in procs))}
    rc, out = cmd(["systemctl", "list-units", "--state=running", "--no-legend", "--no-pager", "--plain"])
    run = [l.split()[0] for l in out.splitlines() if l.split()] if rc == 0 else None
    rc2, out2 = cmd(["systemctl", "list-unit-files", "--state=enabled", "--no-legend", "--no-pager"])
    rc3, out3 = cmd(["systemctl", "list-units", "--failed", "--no-legend", "--no-pager", "--plain"])
    cap["units"] = {"running": len(run) if run is not None else None, "running_services": len([u for u in run if u.endswith(".service")]) if run is not None else None,
                    "running_names": run, "enabled_files": len([l for l in out2.splitlines() if l.split()]) if rc2 == 0 else None,
                    "failed": [l.split()[0] for l in out3.splitlines() if l.split()] if rc3 == 0 else None}
    cap["disk"] = {"/": bench_disk("/"), "/boot": bench_disk("/boot")}
    try:
        cap["disk"]["initramfs_mb"] = sum(os.path.getsize(os.path.join("/boot", f)) for f in os.listdir("/boot") if f.startswith("initramfs-")) // (1024 * 1024)
    except OSError:
        cap["disk"]["initramfs_mb"] = None
    rc, out = cmd(["rpm", "-qa", "--qf", "%{SIZE}\n"], timeout=60) if shutil.which("rpm") else (None, "")
    sizes = [int(x) for x in out.split() if x.isdigit()] if rc == 0 else []
    cap["packages"] = {"count": len(sizes) if sizes else None, "size_mb": sum(sizes) // (1024 * 1024) if sizes else None}
    rows = speed_rows(speed_probe(cmd))
    cap["speed"] = {"applied": speed_applied(rows), "items": {r["id"]: r["state"] for r in rows}}
    return cap


def bench_s(v, unit=" s"):
    return "?" if v is None else ("%.3f" % v).rstrip("0").rstrip(".") + unit if isinstance(v, float) else "%s%s" % (v, unit)


def bench_print(cap, top=12):
    s, b, m, k, p, u, d = cap["system"], cap["boot"], cap["memory"], cap["kernel"], cap["processes"], cap["units"], cap["disk"]
    L = []
    L.append("%-14s %s, kernel %s, %s CPUs%s; %s, up %s%s" % ("system", s["name"] or s["base"] or "?", s["kernel"], s["cpus"], ", " + s["virt"] if s["virt"] and s["virt"] != "none" else "",
                                                             cap["date"], ago(cap["uptime_s"] or 0), "; label " + cap["label"] if cap["label"] else ""))
    if b.get("finished"):
        parts = ["%s %s" % (w, bench_s(b[w + "_s"])) for w in ("firmware", "loader", "kernel", "initrd", "userspace") if b.get(w + "_s") is not None]
        L.append("%-14s %s = %s%s" % ("start", " + ".join(parts), bench_s(b.get("total_s")),
                                      "; %s after %s of userspace" % (b["target"], bench_s(b["target_s"])) if b.get("target") else ""))
    else:
        L.append("%-14s %s" % ("start", "not over yet (jobs still run: systemctl list-jobs)" if b.get("finished") is False else "systemd-analyze gives no times here"))
    L.append("%-14s %s" % ("login screen", "%s after the kernel started (gdm.service)" % bench_s(b["login_screen_s"]) if b.get("login_screen_s") is not None else "not seen (no gdm.service up)"))
    L.append("%-14s %s" % ("desktop", "%s after the kernel started (%s's session, graphical-session.target)" % (bench_s(b["desktop_s"]), b["desktop_user"]) if b.get("desktop_s") is not None
                           else "not seen (no graphical session whose systemd answers)"))
    for i, r in enumerate(cap["blame"][:10]):
        L.append("%-14s %9s  %s" % ("slowest units" if i == 0 else "", bench_s(r["s"]), r["unit"]))
    for i, r in enumerate(cap["chain"]):
        L.append("%-14s %s%s%s%s" % ("chain" if i == 0 else "", "  " * r["depth"], r["unit"], " @" + bench_s(r["at_s"], "s") if r["at_s"] is not None else "",
                                     " +" + bench_s(r["took_s"], "s") if r["took_s"] is not None else ""))
    if m:
        L.append("%-14s %d MB: %d used, %d buffers and cache, %s available; swap %d of %d MB used%s" % (
            "memory", m["total_mb"], m["used_mb"], m["buff_cache_mb"], m["available_mb"] if m["available_mb"] is not None else "?", m["swap_used_mb"], m["swap_total_mb"],
            "; %d MB set aside for a crash kernel (%s)" % (k["crash_reserved_mb"], "armed" if k["crash_loaded"] else "not armed") if k["crash_reserved_mb"] else ""))
    L.append("%-14s %d (and %d kernel threads); resident %d MB%s" % ("processes", p["count"], p["kernel_threads"], p["rss_sum_mb"],
                                                                    ", proportional %d MB" % p["pss_sum_mb"] if p["pss_sum_mb"] is not None else " (shared pages counted in each)"))
    L.append("%-14s %s running (%s services), %s enabled unit files, failed: %s" % ("units", bench_s(u["running"], ""), bench_s(u["running_services"], ""), bench_s(u["enabled_files"], ""),
                                                                                   "?" if u["failed"] is None else " ".join(u["failed"]) or "none"))
    for i, r in enumerate(p["largest"][:top]):
        L.append("%-14s %6d MB  %-10s %s" % ("largest" if i == 0 else "", r["rss_kb"] // 1024, r["user"][:10], r["name"]))
    for mp in ("/", "/boot"):
        if d.get(mp):
            L.append("%-14s %d MB used of %d" % ("disk " + mp, d[mp]["used_mb"], d[mp]["size_mb"]))
    if d.get("initramfs_mb"):
        L.append("%-14s %d MB of initramfs images in /boot" % ("", d["initramfs_mb"]))
    pk = cap["packages"]
    L.append("%-14s %s" % ("packages", "%d, %d MB (rpm's sizes)" % (pk["count"], pk["size_mb"]) if pk["count"] else "rpm does not answer"))
    sp = cap["speed"]["items"]
    L.append("%-14s %s: %s" % ("speed profile", "applied" if cap["speed"]["applied"] else "not applied", ", ".join("%d %s" % (sum(1 for v in sp.values() if v == w), w)
                                                                                                           for w in ("off", "on", "kept", "absent", "unknown") if w in sp.values())))
    text = "\n".join(L)
    try:
        print(text)
    except UnicodeEncodeError:
        print(text.encode("ascii", "replace").decode("ascii"))


def bench_system(ctx, a):
    if a.wait:
        # until the session has been up for WAIT seconds (so that captures are taken at the same moment of a start)
        _, at = bench_session(sec_cmd)
        up = read("/proc/uptime").split()
        left = (at + a.wait - float(up[0])) if at is not None and up else 0
        if left > 0:
            if not a.json:
                print("waiting %d s: until the session has been up for %d s" % (left, a.wait), flush=True)
            time.sleep(left)
    cap = bench_capture(a.label or "")
    if a.json:
        print(json.dumps(cap, indent=1))
    else:
        bench_print(cap, a.top)
    return 0


BENCH_ROWS = (   # what `silik bench compare` shows of each capture: title, path in the capture, unit
    ("start: firmware", ("boot", "firmware_s"), "s"), ("start: loader", ("boot", "loader_s"), "s"), ("start: kernel", ("boot", "kernel_s"), "s"),
    ("start: initrd", ("boot", "initrd_s"), "s"), ("start: userspace", ("boot", "userspace_s"), "s"), ("start: total", ("boot", "total_s"), "s"),
    ("login screen at", ("boot", "login_screen_s"), "s"), ("desktop at", ("boot", "desktop_s"), "s"),
    ("memory total", ("memory", "total_mb"), "MB"), ("memory used", ("memory", "used_mb"), "MB"), ("memory available", ("memory", "available_mb"), "MB"),
    ("swap used", ("memory", "swap_used_mb"), "MB"), ("crash kernel reserve", ("kernel", "crash_reserved_mb"), "MB"),
    ("processes", ("processes", "count"), ""), ("processes, proportional", ("processes", "pss_sum_mb"), "MB"), ("processes, resident", ("processes", "rss_sum_mb"), "MB"),
    ("units running", ("units", "running"), ""), ("services running", ("units", "running_services"), ""), ("unit files enabled", ("units", "enabled_files"), ""),
    ("disk / used", ("disk", "/", "used_mb"), "MB"), ("disk /boot used", ("disk", "/boot", "used_mb"), "MB"),
    ("packages", ("packages", "count"), ""), ("packages, installed size", ("packages", "size_mb"), "MB"),
    ("seconds up at capture", ("uptime_s",), "s"),
)


def bench_get(cap, path):
    v = cap
    for k in path:
        v = v.get(k) if isinstance(v, dict) else None
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) else None


def bench_table(caps):
    """the rows of `silik bench compare`: [(title, unit, [value or None per capture])], rows no capture has left out"""
    rows = []
    for title, path, unit in BENCH_ROWS:
        vals = [bench_get(c, path) for c in caps]
        if any(v is not None for v in vals):
            rows.append((title, unit, vals))
    return rows


def bench_compare(ctx, a):
    caps = []
    for f in a.files:
        try:
            with open(f) as fh:
                c = json.load(fh)
        except (OSError, ValueError) as e:
            die("silik bench compare: %s: %s" % (f, e), 2)
        if not isinstance(c, dict) or "boot" not in c or "memory" not in c:
            die("silik bench compare: %s is not a capture of `silik bench system --json`" % f, 2)
        c.setdefault("label", "")
        c["label"] = c["label"] or os.path.splitext(os.path.basename(f))[0]
        caps.append(c)
    rows = bench_table(caps)
    if a.json:
        print(json.dumps({"captures": [c["label"] for c in caps], "rows": [{"what": t, "unit": u, "values": v} for t, u, v in rows]}, indent=1))
        return 0
    w = max([12] + [len(c["label"]) for c in caps])
    fmt = lambda v: "-" if v is None else ("%.2f" % v if isinstance(v, float) else "%d" % v)
    print("%-26s %-3s %s" % ("", "", " ".join("%*s" % (w, c["label"]) for c in caps)))
    for t, u, vals in rows:
        print("%-26s %-3s %s" % (t, u, " ".join("%*s" % (w, fmt(v)) for v in vals)))
    print("%-26s %-3s %s" % ("speed profile", "", " ".join("%*s" % (w, "applied" if (c.get("speed") or {}).get("applied") else "not applied") for c in caps)))
    first, last = caps[0], caps[-1]
    if len(caps) > 1:
        for x, y in ((first, last), (last, first)):
            only = sorted(set((x.get("processes") or {}).get("names") or []) - set((y.get("processes") or {}).get("names") or []))
            print("%-30s %s" % ("runs in %s, not in %s:" % (x["label"], y["label"]), " ".join(only) or "-"))
    print("each column is one capture (one start of the system): the difference between two starts of the same system is the measure's noise")
    return 0


# ------------------------------------------------------------------ snapshot, rollback
# "What happens when an update breaks this machine": `silik rollback`. docs/ROLLBACK.md is the design.
# / on an LVM thin volume (the installer's Automatic partitioning on SilikOS), `snapm` and `boom-boot` of the base:
# before every update a snapshot of / with two boot entries, "Snapshot ..." (starts the system as it was) and
# "Revert ..." (the kernel of that day on the reverted /). `silik rollback` reverts and names the Revert entry for the
# next start; it never restarts. `silik rollback finish` (by itself, on that start) puts /boot back in step with the
# reverted package database. /home is another volume and is never touched.
# What was read of the tools, and where (docs/ROLLBACK.md has the list): snapm 0.7.0 (its command line, the JSON of
# `snapset list`, the kernel arguments of its boot entries), boom 1.6.8 (entry file names), grubby 8.40, grub2 2.06,
# systemd 252's kernel-install, lvm2 2.03.33, dnf 4.14 of EL 9.8. Nothing here was run on LVM: this machine has none.
# As elsewhere: snap_root(), snap_refusal(), snap_prune() and finish_plan() judge what was read and run nothing.
SNAP_AUTO = "silikos-update"     # the snapshots made before an update: silikos-update.N (snapm's --autoindex)
SNAP_MANUAL = "manual"           # `silik snapshot create` without a name: manual.N
SNAP_CONF = "/etc/silikos/snapshot.conf"
# PROPOSAL values (docs/ROLLBACK.md): the snapshots kept, the days they are kept, the pool's limits for a new one.
# size_policy: snapm's own default asks the pool for twice what / holds (200%USED), which a pool half full never has;
# 100%FREE is refused by its rounding up to a sector (run with snapm 0.7.0's SizePolicy). A thin snapshot takes no
# space when made: 50%FREE always passes, and what guards the pool are the two limits and its autoextension
SNAP_DEFAULTS = {"keep": 5, "days": 14, "pool_data_max": 70.0, "pool_meta_max": 50.0, "size_policy": "50%FREE"}
SNAP_PROFILE = "silikos-thin"    # /etc/lvm/profile/silikos-thin.profile (silikos-security): the pool grows by itself
SNAP_CMDLINE = "/proc/cmdline"
SNAP_BOOT = "/boot"
SNAP_MODULES = "/lib/modules"
SNAP_FLAG = "/run/silikos/no-snapshot"       # the last update was made without a snapshot: why (the status bar reads it)
SNAP_HOLD = "/etc/silikos/update.hold"       # automatic updates wait since a rollback (the update units' condition)
SNAP_HOOK = "/usr/libexec/silikos/pre-update-snapshot"
SNAP_ARG, SNAP_REVERT_ARG = "snapm.snapset", "snapm.revert"   # on the kernel line of the entries snapm makes
SNAP_FIELDS = "name,uuid,timestamp,status,bootable,bootentry,revertentry"
LVS_FIELDS = "vg_name,lv_name,lv_attr,pool_lv,lv_size,data_percent,metadata_percent,lv_profile"
SNAP_PACKAGES = "silik rollback --packages   # undoes the packages of the last update (dnf history undo)"
SNAP_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9+.-]*$")      # snapm's rule: letters, digits, + . - (no underscore)
SNAP_POLICY_RE = re.compile(r"^([0-9]+(\.[0-9]+)?%(FREE|USED|SIZE)|[0-9]+([KMGTkmgt]i?)?[Bb]?)$")


def snap_conf(path=None):
    """/etc/silikos/snapshot.conf (`key = value` lines) over the defaults; a value that is not one is left out"""
    conf = dict(SNAP_DEFAULTS)
    for line in read(path or SNAP_CONF).splitlines():
        k, _, v = line.split("#")[0].partition("=")
        k, v = k.strip(), v.strip()
        if k not in conf or not v:
            continue
        try:
            if k == "size_policy":
                if SNAP_POLICY_RE.match(v):
                    conf[k] = v
            elif k in ("keep", "days"):
                conf[k] = max(1, int(v))
            elif 0 < float(v) <= 100:
                conf[k] = float(v)
        except ValueError:
            pass
    return conf


def snap_booted(text=None):
    """how this system was started: ("snapshot", UUID) from a snapshot's entry, ("revert", UUID) from a Revert entry,
    ("", "") normally"""
    for w in (read(SNAP_CMDLINE) if text is None else text).split():
        k, _, v = w.partition("=")
        if k == SNAP_ARG:
            return "snapshot", v
        if k == SNAP_REVERT_ARG:
            return "revert", v
    return "", ""


def snap_devno():
    d = os.stat("/").st_dev
    return "%d:%d" % (os.major(d), os.minor(d))


def snap_kernel():
    return os.uname().release


def snap_root(devno=None):
    """what / is on, from sysfs alone (no command, no root): {"dm": the device-mapper name, "lvm", "thin", "what":
    in words}; None when it cannot be seen (a container's overlay has no block device). An LVM thin volume is a
    device-mapper device with an LVM- uuid that sits on its pool's "-tpool" device [A: lvm2's layout, not seen on a
    machine here]; a LUKS layer above it is looked through"""
    try:
        devno = devno or snap_devno()
    except OSError:
        return None
    d = os.path.join(SYSFS, "dev/block", devno)
    if not os.path.isdir(d):
        return None
    out = {"dm": "", "lvm": False, "thin": False, "what": "a disk partition"}
    for _ in range(3):
        uuid, name = read(os.path.join(d, "dm/uuid")).strip(), read(os.path.join(d, "dm/name")).strip()
        try:
            slaves = sorted(os.listdir(os.path.join(d, "slaves")))
        except OSError:
            slaves = []
        if uuid.startswith("CRYPT-") and len(slaves) == 1:      # an encrypted volume: what it is made on
            d = os.path.join(d, "slaves", slaves[0])
            continue
        if not uuid:
            return out
        out["dm"] = name
        if not uuid.startswith("LVM-"):
            out["what"] = "a device-mapper device that is not LVM (%s)" % name
            return out
        out["lvm"] = True
        out["thin"] = any(read(os.path.join(d, "slaves", s, "dm/name")).strip().endswith("-tpool") for s in slaves)
        out["what"] = "an LVM thin volume (%s)" % name if out["thin"] else "an LVM volume that is not thin (%s)" % name
        return out
    return out


def snap_refuse(msg, alt=(), rc=1):
    """no: the reason, then what to do instead"""
    print("silik: " + msg, file=sys.stderr)
    for a in alt:
        print("       " + a, file=sys.stderr)
    sys.exit(rc)


def snap_unavailable(root, snapm):
    """why this system has no snapshots: (reason, [what to do instead]); None when it has them"""
    if root is None:
        return ("snapshots are not available: what / is on cannot be seen%s" % (" (inside a container)" if sec_container() else ""), [SNAP_PACKAGES])
    if not root["thin"]:
        return ("snapshots are not available: / is on %s, not on an LVM thin volume" % root["what"],
                [SNAP_PACKAGES, "a new installation with the installer's Automatic partitioning puts / on a thin volume"])
    if not snapm:
        return ("snapshots are not available: snapm is not installed", ["silik snapshot setup   # installs snapm and boom-boot (the base's packages)", SNAP_PACKAGES])
    return None


def snap_need(ctx):
    """the root volume when this system has snapshots; says why and stops when it has not"""
    root = snap_root()
    no = snap_unavailable(root, bool(shutil.which("snapm")))
    if no:
        snap_refuse(*no)
    return root


def snap_read(ctx, argv):
    """a read-only command that needs root, printed like the others: (exit code, stdout). Under --dry-run it runs
    only when this is root already (a dry run asks for no password): (None, "") otherwise"""
    argv = as_root(argv)
    ctx.echo(argv)
    if ctx.dry and argv[0] == "sudo":
        return None, ""
    env = dict(os.environ)
    env["LC_ALL"] = "C"
    try:
        p = subprocess.run(argv, stdout=subprocess.PIPE, stdin=subprocess.DEVNULL, universal_newlines=True, env=env)
    except OSError:
        return 127, ""
    return p.returncode, p.stdout


def lvs_rows(text):
    """the rows of `lvs --reportformat json` ({"report": [{"lv": [...]}]}); None when the text is not that"""
    try:
        rows = json.loads(text)["report"][0]["lv"]
    except (ValueError, KeyError, IndexError, TypeError):
        return None
    return rows if isinstance(rows, list) else None


def lvs_num(v):
    try:
        return float(str(v).replace(",", "."))
    except ValueError:
        return None


def snap_pool(ctx, root):
    """the thin pool / is in, asked of lvs (root): {"vg", "lv", "pool", "size" (bytes), "data" and "meta" (percent
    used), "profile"}; None when lvs does not say; {} when it was not asked (a dry run without root)"""
    ask = ["lvs", "--reportformat", "json", "--units", "b", "--nosuffix", "-o", LVS_FIELDS]
    rc, out = snap_read(ctx, ask + ["/dev/mapper/" + root["dm"]])
    if rc is None:
        return {}
    rows = lvs_rows(out) if rc == 0 else None
    if not rows or not rows[0].get("pool_lv"):
        return None
    vg, lv, pool = rows[0].get("vg_name", ""), rows[0].get("lv_name", ""), rows[0]["pool_lv"]
    rc, out = snap_read(ctx, ask + ["%s/%s" % (vg, pool)])
    rows = lvs_rows(out) if rc == 0 else None
    if not rows:
        return None
    p = rows[0]
    size = lvs_num(p.get("lv_size"))
    return {"vg": vg, "lv": lv, "pool": pool, "size": int(size) if size else 0, "data": lvs_num(p.get("data_percent")),
            "meta": lvs_num(p.get("metadata_percent")), "profile": p.get("lv_profile") or ""}


def snap_sets_parse(text):
    """the snapshot sets in `snapm snapset list --json -o SNAP_FIELDS` (snapm 0.7.0: {"Snapsets": [{"snapset_name":
    ..., "snapset_timestamp": 1763013600, "snapset_status": "Active", "snapset_bootable": true, ...}]}), oldest
    first; None when the text is not that"""
    try:
        rows = json.loads(text)["Snapsets"]
        out = []
        for r in rows:
            ts = str(r.get("snapset_timestamp", ""))
            out.append({"name": str(r["snapset_name"]), "uuid": str(r.get("snapset_uuid") or ""), "time": int(ts) if ts.isdigit() else 0,
                        "status": str(r.get("snapset_status") or ""), "bootable": r.get("snapset_bootable") in (True, "yes"),
                        "boot_entry": str(r.get("snapset_bootentry") or ""), "revert_entry": str(r.get("snapset_revertentry") or ""),
                        "auto": snap_is_auto(str(r["snapset_name"]))})
    except (ValueError, KeyError, TypeError, AttributeError):
        return None
    return sorted(out, key=lambda s: (s["time"], s["name"]))


def snap_is_auto(name):
    b, _, i = name.rpartition(".")
    return b == SNAP_AUTO and i.isdigit()


def snap_sets(ctx):
    """(asked, the snapshot sets): asked is False for a dry run without root; the sets are None when snapm fails"""
    rc, out = snap_read(ctx, ["snapm", "snapset", "list", "--json", "-o", SNAP_FIELDS])
    if rc is None:
        return False, None
    return True, snap_sets_parse(out) if rc == 0 else None


def snap_prune(sets, keep, days, now):
    """the names of the automatic snapshots to delete, oldest first: all but the KEEP newest, and those older than
    DAYS days. The newest is always kept; one being reverted is left alone; a snapshot made by hand is never here"""
    auto = sorted((s for s in sets if s["auto"] and s["status"] != "Reverting"), key=lambda s: (s["time"], s["name"]), reverse=True)
    out = [s for i, s in enumerate(auto) if i >= keep or (i > 0 and now - s["time"] > days * 86400)]
    return [s["name"] for s in reversed(out)]


def boot_image_need(boot=None, kernel=None):
    """the bytes a bootable snapshot of the running kernel adds to /boot: boom (1.6.8, cache.py) keeps a copy of the
    kernel and of its initramfs named by its SHA-1 in /boot/boom/cache, and a second one beside the original
    (vmlinuz-VERSION.boom0); nothing for an image it already has. None when the kernel's files are not readable"""
    import hashlib
    boot = boot or SNAP_BOOT
    kernel = kernel or snap_kernel()
    need = 0
    for f in ("vmlinuz-%s" % kernel, "initramfs-%s.img" % kernel):
        p = os.path.join(boot, f)
        try:
            h = hashlib.sha1()
            with open(p, "rb") as fh:
                for chunk in iter(lambda: fh.read(1 << 20), b""):
                    h.update(chunk)
            if not os.path.exists(os.path.join(boot, "boom/cache", h.hexdigest() + ".img")):
                need += 2 * os.path.getsize(p)
        except OSError:
            return None
    return need + (1 << 20 if need else 0)      # (and room for the two entries and boom's index)


def boot_free(boot=None):
    try:
        s = os.statvfs(boot or SNAP_BOOT)
        return s.f_bavail * s.f_frsize
    except OSError:
        return None


def snap_refusal(st, conf):
    """why a new snapshot may not be made now: (reason, [what to do]); None when it may. ST: {"pool": snap_pool()'s,
    "boot_free", "boot_need"}. What was not asked (a dry run) or cannot be read does not refuse: snapm checks again"""
    p = st.get("pool")
    if p:
        over = [(k, p[k], conf[m]) for k, m in (("data", "pool_data_max"), ("meta", "pool_meta_max")) if p.get(k) is not None and p[k] >= conf[m]]
        if over:
            k, used, lim = over[0]
            return ("no snapshot: the thin pool %s/%s has %.1f %% of its %s used (a new snapshot is made below %g %%)"
                    % (p["vg"], p["pool"], used, "data" if k == "data" else "metadata", lim),
                    ["silik snapshot list   # then: silik snapshot delete NAME", "sudo fstrim -av   # deleted files give their blocks back to the pool",
                     "sudo lvextend -l +100%%FREE %s/%s   # when the volume group has free space" % (p["vg"], p["pool"])])
    free, need = st.get("boot_free"), st.get("boot_need")
    if free is not None and need and free < need:
        return ("no snapshot: /boot has %s free; a snapshot that can be started needs %s there (two copies of this kernel and its initramfs)"
                % (size(free), size(need)),
                ["silik snapshot list   # then: silik snapshot delete NAME (frees their kernel copies)",
                 "sudo dnf remove --oldinstallonly   # the kernels that are not the newest ones"])
    return None


def snap_guard(ctx, root, conf, prune=True):
    """the reads and the judgement before a snapshot: the pool's use and the room in /boot. Over a limit: the old
    automatic snapshots are deleted first (the policy of snapshot.conf, leaving room for one more), then it is judged
    again. Returns (refusal or None, the pool)"""
    pool = snap_pool(ctx, root)
    st = {"pool": pool, "boot_free": boot_free(), "boot_need": boot_image_need()}
    no = snap_refusal(st, conf)
    if no and prune:
        asked, sets = snap_sets(ctx)
        old = snap_prune(sets or [], max(0, conf["keep"] - 1), conf["days"], time.time())
        if old:
            for n in old:
                ctx.run(as_root(["snapm", "snapset", "delete", n]), check=False)
            st = {"pool": snap_pool(ctx, root), "boot_free": boot_free(), "boot_need": boot_image_need()}
            no = snap_refusal(st, conf)
    return no, st["pool"]


def boom_profile_missing(boot=None, kernel=None):
    """whether boom has no OS profile for the running kernel (/boot/boom/profiles/*.profile, a line
    BOOM_OS_UNAME_PATTERN="el9" that the kernel's release matches). True also when the folder cannot be read (it
    is root's): making the profile again changes nothing"""
    d = os.path.join(boot or SNAP_BOOT, "boom/profiles")
    try:
        names = os.listdir(d)
    except OSError:
        return True
    for n in names:
        m = re.search(r'^BOOM_OS_UNAME_PATTERN="([^"]+)"', read(os.path.join(d, n)), re.M)
        try:
            if m and re.search(m.group(1), kernel or snap_kernel()):
                return False
        except re.error:
            pass
    return True


def boom_profile(ctx):
    """boom's OS profile for this system, made before the first snapshot that can be started. snapm makes one by
    itself only for the names boom knows (Red Hat Enterprise Linux, CentOS Stream, Fedora); for any other its
    snapshot fails after the volume is made: "Could not determine uname pattern for 'SilikOS'" (run with snapm 0.7.0
    and boom 1.6.8 on EL 9.8). boom's own command makes the same profile when told the pattern, from /etc/os-release
    and this start's kernel line: so only on a normal start (a snapshot's or a Revert entry's line carries snapm's
    own argument, which every later entry would inherit)"""
    if snap_booted()[0] or not boom_profile_missing():
        return
    m = re.search(r"\.(el[0-9]+)", snap_kernel())
    if m:
        ctx.run(as_root(["boom", "profile", "create", "--from-host", "--uname-pattern", m.group(1)]), check=False)


def snap_make(ctx, name, conf, autoindex):
    """snapm makes the snapshot of / with its two boot entries; its name (with the index snapm gave it), or '' when
    snapm failed (it says why itself)"""
    boom_profile(ctx)
    argv = ["snapm", "snapset", "create", "--bootable", "--revert", "--size-policy", conf["size_policy"]] + (["--autoindex"] if autoindex else []) + ["--json", name, "/"]
    rc, out = ctx.run(as_root(argv), check=False, capture=True)
    if ctx.dry:
        return name + (".N" if autoindex else "")
    if rc != 0:
        return ""
    try:
        return str(json.loads(out)["SnapsetName"])       # (snapm 0.7.0: SnapshotSet.to_dict)
    except (ValueError, KeyError, TypeError):
        return name


def snap_note(ctx, why):
    """the note the status bar reads: the update that follows has no snapshot, and why (gone after the next one that
    has, or at the next start)"""
    print("silik: " + why, file=sys.stderr)
    if ctx.dry:
        return
    try:
        os.makedirs(os.path.dirname(SNAP_FLAG), exist_ok=True)
        with open(SNAP_FLAG, "w") as f:
            f.write(why.splitlines()[0] + "\n")
    except OSError:
        pass                                              # (not root: said above, not noted)


def snap_auto(ctx, a):
    """what the update hook runs (as root) when there is something to update: a snapshot of /, then the old ones
    pruned. It never fails the update: a system without snapshots is passed over; a snapshot that cannot be made is
    said and noted for the status bar ("update: no snapshot")"""
    root = snap_root()
    if snap_unavailable(root, bool(shutil.which("snapm"))):
        print("silik: no snapshot before this update (silik snapshot status says why); the way back is: silik rollback --packages")
        return 0
    if snap_booted()[0] == "snapshot":
        snap_note(ctx, "no snapshot: this system is started from a snapshot")
        return 0
    conf = snap_conf()
    no, _ = snap_guard(ctx, root, conf)
    if no:
        snap_note(ctx, no[0])
        return 0
    name = snap_make(ctx, SNAP_AUTO, conf, True)
    if not name:
        snap_note(ctx, "no snapshot: snapm could not make it (journalctl -u silikos-update -n 30)")
        return 0
    if not ctx.dry:
        print("silik: snapshot %s of / made before the update; to go back: silik rollback" % name)
        try:
            os.unlink(SNAP_FLAG)
        except OSError:
            pass
    asked, sets = snap_sets(ctx)
    for n in snap_prune(sets or [], conf["keep"], conf["days"], time.time()):
        ctx.run(as_root(["snapm", "snapset", "delete", n]), check=False)
    return 0


def snap_create(ctx, a):
    name = a.name or SNAP_MANUAL
    if not SNAP_NAME_RE.match(name) or len(name) > 60 or name == "finish" or (a.name and snap_is_auto(name)):
        die("a snapshot's name: letters, digits, + . - (not `finish`, not %s.N: those are the updates' own)" % SNAP_AUTO, 2)
    root = snap_need(ctx)
    kind, uuid = snap_booted()
    if kind == "snapshot":
        snap_refuse("no snapshot of a snapshot: this system is started from one (%s=%s)" % (SNAP_ARG, uuid),
                    ["restart and choose the normal entry, then: silik snapshot create", "silik rollback   # makes this state the system"])
    conf = snap_conf()
    no, _ = snap_guard(ctx, root, conf)
    if no:
        snap_refuse(*no)
    made = snap_make(ctx, name, conf, not a.name)
    if ctx.dry:
        return 0
    if not made:
        die("snapm did not make the snapshot (its reason is above)")
    print("silik: snapshot %s of / made, with its entries in the boot menu; to go back to it: silik rollback %s" % (made, made))
    return 0


def snap_delete(ctx, a):
    snap_need(ctx)
    confirm(ctx, a, "the snapshot %s" % a.name)
    ctx.run(as_root(["snapm", "snapset", "delete", a.name]))
    return 0


def snap_when(t, now):
    return "%s (%s ago)" % (time.strftime("%Y-%m-%d %H:%M", time.localtime(t)), ago(now - t)) if t else "?"


def snap_list(ctx, a):
    root = snap_root()
    no = snap_unavailable(root, bool(shutil.which("snapm")))
    if no:
        if getattr(a, "json", False):
            print(json.dumps({"available": False, "reason": no[0], "snapshots": []}, indent=1))
            return 1
        snap_refuse(*no)
    quiet = Ctx(ctx.dry, True) if getattr(a, "json", False) else ctx
    asked, sets = snap_sets(quiet)
    if not asked:
        return 0
    if sets is None:
        die("snapm did not list the snapshots (its reason is above)")
    if getattr(a, "json", False):
        print(json.dumps({"available": True, "snapshots": sets}, indent=1))
        return 0
    now = time.time()
    if not sets:
        print("no snapshot yet: one is made before each update; by hand: silik snapshot create [NAME]")
    for s in reversed(sets):
        print("%-22s %-30s %-9s %s" % (s["name"], snap_when(s["time"], now), s["status"].lower() or "?",
                                       ("before an update" if s["auto"] else "made by hand") + ("" if s["revert_entry"] else "; no Revert entry")))
    return 0


def snap_copies(boot=None):
    """the bytes of the kernel copies boom keeps in /boot for the snapshots' entries"""
    import glob
    boot = boot or SNAP_BOOT
    n = 0
    for p in glob.glob(os.path.join(boot, "boom/cache/*.img")) + glob.glob(os.path.join(boot, "*.boom[0-9]*")):
        try:
            n += os.path.getsize(p)
        except OSError:
            pass
    return n


def snap_status_rows(st, conf, now):
    """the rows of `silik snapshot status` from what was read: [(id, state, name, value, [fix])]. ST: {"root",
    "snapm", "booted": (kind, uuid), "pool", "vg_free", "sets", "boot_free", "boot_size", "boot_need", "copies",
    "flag", "hold"}; a key that is None was not readable"""
    rows = []
    no = snap_unavailable(st["root"], st["snapm"])
    if no:
        rows.append(("available", "unknown" if st["root"] is None else "warn", "snapshots", no[0].replace("snapshots are ", ""), no[1]))
    else:
        rows.append(("available", "ok", "snapshots", "/ is on %s; snapm is installed" % st["root"]["what"], []))
    kind, uuid = st["booted"]
    if kind == "snapshot":
        rows.append(("booted", "warn", "started from", "a snapshot (%s): nothing is updated; a snapshot of it cannot be made" % uuid,
                     ["silik rollback   # makes this state the system", "systemctl reboot   # and the normal entry: back to the system as it is"]))
    elif kind == "revert":
        rows.append(("booted", "ok", "started from", "a Revert entry: this is the system as the snapshot had it", []))
    if st.get("hold") is not None:
        rows.append(("hold", "warn", "updates", "the automatic updates wait since the rollback%s" % (" of %s" % st["hold"].strip()[:16].replace("T", " ") if st["hold"].strip() else ""),
                     ["silik update   # updates now, with a snapshot first; the automatic updates go on after it"]))
    if st.get("flag") is not None:
        rows.append(("last", "warn", "last update", "made without a snapshot: %s" % (st["flag"].strip() or "the reason was not noted"), [SNAP_PACKAGES]))
    if no:
        return rows
    p = st.get("pool")
    if not p:
        rows.append(("pool", "unknown", "thin pool", "lvs did not say (as root: sudo silik snapshot status)" if p is None else "not asked", []))
    else:
        for k, m, what in (("data", "pool_data_max", "data"), ("meta", "pool_meta_max", "metadata")):
            if p.get(k) is None:
                rows.append(("pool-" + k, "unknown", "pool " + what, "lvs did not say", []))
                continue
            over = p[k] >= conf[m]
            val = "%.1f %% used" % p[k] + (" of %s" % size(p["size"]) if k == "data" and p["size"] else "") + " in %s/%s; a new snapshot is made below %g %%" % (p["vg"], p["pool"], conf[m])
            rows.append(("pool-" + k, "warn" if over else "ok", "pool " + what, val,
                         ["silik snapshot list   # then: silik snapshot delete NAME", "sudo fstrim -av   # deleted files give their blocks back to the pool"]))
        grows = p["profile"] == SNAP_PROFILE
        free = st.get("vg_free")
        val = ("at 70 %% used the pool grows by 20 %% (profile %s)" % SNAP_PROFILE if grows else
               "the pool does not grow by itself (its profile is %s, not %s)" % (p["profile"] or "none", SNAP_PROFILE))
        val += "; %s free in the volume group %s for it" % (size(free), p["vg"]) if free is not None else ""
        rows.append(("grow", "ok" if grows and (free is None or free > 0) else "warn", "pool growth", val,
                     ["silik snapshot setup   # applies the profile to the pool"] if not grows else ["the volume group has no free space: the pool cannot grow; delete snapshots as it fills"]))
    sets = st.get("sets")
    if sets is None:
        rows.append(("sets", "unknown", "snapshots kept", "snapm did not list them (as root: sudo silik snapshot status)", []))
    else:
        auto = [s for s in sets if s["auto"]]
        mine = [s for s in sets if not s["auto"]]
        val = "%d made before updates (the last %d are kept, %d days)" % (len(auto), conf["keep"], conf["days"])
        val += "; %d made by hand (kept until deleted)" % len(mine) if mine else ""
        val += "; the newest: %s, %s" % (sets[-1]["name"], snap_when(sets[-1]["time"], now)) if sets else ""
        bad = [s["name"] for s in sets if s["status"] in ("Invalid", "Reverting")]
        rows.append(("sets", "warn" if bad else "ok", "snapshots kept", val + ("; %s: %s" % (", ".join(bad), "being reverted or invalid") if bad else ""),
                     ["silik snapshot list", "systemctl reboot   # a revert ends at the next start (silik rollback says which entry)"]))
    free, total, need = st.get("boot_free"), st.get("boot_size"), st.get("boot_need")
    if free is None:
        rows.append(("boot", "unknown", "/boot", "not readable", []))
    else:
        short = bool(need) and free < need
        val = "%s free%s; the snapshots' kernel copies take %s" % (size(free), " of %s" % size(total) if total else "", size(st.get("copies") or 0))
        val += "; the next snapshot needs %s" % size(need) if need else ""
        rows.append(("boot", "warn" if short else "ok", "/boot", val,
                     ["silik snapshot delete NAME   # frees its kernel copies", "sudo dnf remove --oldinstallonly"]))
    return rows


def snap_status(ctx, a):
    js = getattr(a, "json", False)
    quiet = Ctx(ctx.dry, True) if js else ctx
    root = snap_root()
    snapm = bool(shutil.which("snapm"))
    st = {"root": root, "snapm": snapm, "booted": snap_booted(), "flag": read(SNAP_FLAG, None), "hold": read(SNAP_HOLD, None)}
    conf = snap_conf()
    if not snap_unavailable(root, snapm):
        st["pool"] = snap_pool(quiet, root)
        if st["pool"]:
            rc, out = snap_read(quiet, ["vgs", "--reportformat", "json", "--units", "b", "--nosuffix", "-o", "vg_name,vg_free", st["pool"]["vg"]])
            try:
                st["vg_free"] = int(lvs_num(json.loads(out)["report"][0]["vg"][0]["vg_free"])) if rc == 0 else None
            except (ValueError, KeyError, IndexError, TypeError):
                st["vg_free"] = None
        st["sets"] = snap_sets(quiet)[1]
        st["boot_free"], st["boot_need"], st["copies"] = boot_free(), boot_image_need(), snap_copies()
        try:
            s = os.statvfs(SNAP_BOOT)
            st["boot_size"] = s.f_blocks * s.f_frsize
        except OSError:
            st["boot_size"] = None
    rows = snap_status_rows(st, conf, time.time())
    count = {k: sum(1 for r in rows if r[1] == k) for k in ("ok", "warn", "bad", "unknown")}
    rc = 2 if count["bad"] else 1 if count["warn"] or count["unknown"] else 0
    if js:
        print(json.dumps({"available": rows[0][1] == "ok", "checks": [{"id": i, "state": s, "name": n, "value": v, "fix": f if s != "ok" else []} for i, s, n, v, f in rows],
                          "snapshots": st.get("sets") or [], "policy": conf, "summary": count}, indent=1))
        return rc
    lines = []
    for i, s, n, v, f in rows:
        lines.append("%s %-8s %-15s %s" % (SEC_MARK[s], s, n, v))
        lines += ["%-26s %s: %s" % ("", "see" if s == "unknown" else "do", x) for x in (f if s != "ok" else [])]
    text = "\n".join(lines)
    try:
        print(text)
    except UnicodeEncodeError:
        print(text.encode("ascii", "replace").decode("ascii"))
    return rc


def snap_setup(ctx, a):
    """what the kickstart does on a new installation, on a running system: the tools, the pool's profile (it grows
    by itself), its monitoring, the weekly trim. Every command printed; nothing of a disk is created or erased"""
    root = snap_root()
    no = snap_unavailable(root, True)
    if no:
        snap_refuse(*no)
    if not shutil.which("snapm") or not shutil.which("boom") or ctx.dry:
        ctx.run(as_root(["dnf", "-y", "install", "snapm", "boom-boot"]))
    pool = snap_pool(ctx, root)
    if pool is None:
        die("lvs did not say which pool / is in (its reason is above)")
    name = "%s/%s" % (pool["vg"], pool["pool"]) if pool else "VG/POOL"
    if not pool or pool["profile"] != SNAP_PROFILE:
        ctx.run(as_root(["lvchange", "--metadataprofile", SNAP_PROFILE, name]))
    ctx.run(as_root(["lvchange", "--monitor", "y", name]))            # (dmeventd watches the pool: it is what extends it)
    boom_profile(ctx)
    if ctx.query(["systemctl", "is-enabled", "fstrim.timer"], any_rc=True).strip() != "enabled":
        ctx.run(as_root(["systemctl", "enable", "--now", "fstrim.timer"]))
    if not ctx.dry:
        print("silik: a snapshot of / is made before each update from now on; `silik snapshot status` reads it back")
    return 0


# ---- rollback
def bls_entries(boot=None):
    """the boot menu's entries (/boot/loader/entries/*.conf, BLS): [{"id": the file's name without .conf, which is
    the entry's id for grub2 and grubby, "title", "version", "linux", "options", "snapm": (kind, uuid) for an entry
    snapm made, "boom": its boot id}]; None when the folder is not readable"""
    d = os.path.join(boot or SNAP_BOOT, "loader/entries")
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".conf"))
    except OSError:
        return None
    out = []
    for n in names:
        e = {"id": n[:-5], "title": "", "version": "", "linux": "", "options": ""}
        for line in read(os.path.join(d, n)).splitlines():
            k, _, v = line.strip().partition(" ")
            if k in e and k != "id" and not e[k]:
                e[k] = v.strip()
        e["snapm"] = snap_booted(e["options"])
        m = re.match(r"^\w*-([0-9a-f]{7,})-.+$", e["id"])      # (boom 1.6.8: MACHINEID-BOOTID7-VERSION.conf)
        e["boom"] = m.group(1) if m and e["snapm"][0] else ""
        out.append(e)
    return out


def rpm_vercmp_key(v):
    """a sort key that orders kernel versions as rpm does for the forms they take (5.14.0-611.5.1.el9_7.x86_64):
    runs of digits as numbers, the rest as text"""
    return [(1, int(p)) if p.isdigit() else (0, p) for p in re.findall(r"[0-9]+|[A-Za-z]+", v)]


def finish_plan(entries, kernels, have_modules, live, booted):
    """what `silik rollback finish` does, from what was read (it runs nothing). ENTRIES: bls_entries(); KERNELS: the
    kernel-core versions of the package database (as uname -r has them); HAVE_MODULES: those of them whose
    /lib/modules/V/vmlinuz is there; LIVE: {UUID: status} of the snapshot sets that exist, None when snapm did not
    say; BOOTED: snap_booted(). Returns {"remove": versions in the boot menu the packages do not know, "add":
    versions the packages know that have no entry, "default": the version to start by default, "entries": boot ids
    of snapm's entries whose snapshot is gone, "reverted": this start is the one after a revert (from a Revert entry
    whose snapshot is gone or being merged; one that is still there untouched was only chosen in the menu)}"""
    own = [e for e in entries if not e["snapm"][0] and e["version"] and not e["version"].startswith("0-rescue")]
    in_menu = []
    for e in own:
        v = e["version"].split("~")[0]                      # (VERSION~debug is the same kernel's debug entry)
        if v not in in_menu:
            in_menu.append(v)
    remove = [v for v in in_menu if v not in kernels]
    add = [v for v in kernels if v not in in_menu and v in have_modules]
    usable = sorted((v for v in kernels if v in in_menu or v in add), key=rpm_vercmp_key)
    gone = []
    if live is not None:
        gone = [e["boom"] for e in entries if e["snapm"][0] and e["boom"] and e["snapm"][1] not in live]
    reverted = booted[0] == "revert" and (live is None or live.get(booted[1], "Reverting") == "Reverting")
    return {"remove": remove, "add": add, "default": usable[-1] if usable else "", "entries": gone, "reverted": reverted}


def rollback_finish(ctx, a):
    """after the start from a Revert entry: / is as the snapshot had it, /boot is not (it is not in the snapshot).
    The kernels the reverted package database does not know leave the boot menu (their modules went with the
    revert: such an entry would not start), those it knows and /boot lost come back, the default is the newest of
    them, the entries of the snapshot that is gone are removed, and the automatic updates wait for `silik update`"""
    booted = snap_booted()
    entries = bls_entries()
    if entries is None:
        die("the boot menu's entries (%s/loader/entries) are not readable: sudo silik rollback finish" % SNAP_BOOT)
    rc, out = sec_cmd(["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}.%{ARCH}\n", "kernel-core"])
    kernels = [l.strip() for l in out.splitlines() if l.strip() and " " not in l.strip()] if rc == 0 else []
    if not kernels:
        die("the package database names no kernel (rpm -q kernel-core): nothing is changed")
    have = [v for v in kernels if os.path.exists(os.path.join(SNAP_MODULES, v, "vmlinuz"))]
    live = None
    if shutil.which("snapm") or ctx.dry:
        asked, sets = snap_sets(ctx)
        live = {s["uuid"]: s["status"] for s in sets} if sets is not None else None
        if live and live.get(booted[1]) == "Reverting":
            print("silik: the revert of / is still going on; its entries stay until it ends (silik rollback finish, later)")
    plan = finish_plan(entries, kernels, have, live, booted)
    for v in plan["remove"]:
        print("silik: kernel %s is in the boot menu and not in the package database: its entry and files leave /boot" % v)
        ctx.run(as_root(["kernel-install", "remove", v]), check=False)
        ctx.run(as_root(["rm", "-f", os.path.join(SNAP_BOOT, "initramfs-%skdump.img" % v)]), check=False)
    for v in plan["add"]:
        print("silik: kernel %s is installed and has no boot entry: it gets one again" % v)
        ctx.run(as_root(["kernel-install", "add", v, os.path.join(SNAP_MODULES, v, "vmlinuz")]), check=False)
    if plan["default"]:
        ctx.run(as_root(["grubby", "--set-default=" + os.path.join(SNAP_BOOT, "vmlinuz-" + plan["default"])]), check=False)
    else:
        print("silik: no installed kernel has a boot entry: sudo dnf reinstall kernel-core", file=sys.stderr)
    for b in plan["entries"]:
        ctx.run(as_root(["boom", "entry", "delete", "--boot-id", b]), check=False)
    if plan["reverted"]:
        argv = as_root(["tee", SNAP_HOLD])
        ctx.echo(argv)
        if not ctx.dry:
            subprocess.run(argv, input=time.strftime("%Y-%m-%dT%H:%M:%S") + "\n", universal_newlines=True, stdout=subprocess.DEVNULL)
        print("silik: the system is as the snapshot had it. The automatic updates wait: `silik update` updates now (a snapshot first) and they go on")
    elif booted[0] == "revert":
        print("silik: this Revert entry was chosen in the boot menu, but no revert was asked: / is the system as it was (silik rollback asks for one)")
    if not ctx.dry and not (plan["remove"] or plan["add"] or plan["entries"]):
        print("silik: the boot menu and the package database agree; the default kernel is %s" % (plan["default"] or "unknown"))
    return 0 if plan["default"] else 1


DNF_UPGRADE = ("upgrade", "u", "upgraded")


def dnf_history_parse(text):
    """the transactions of `dnf history list` (dnf 4.14: "  8 |  | 2026-11-13 07:26 | Upgrade | 10"), newest first:
    [{"id", "command", "date", "actions": lower-case words, "altered"}]"""
    out = []
    for l in text.splitlines():
        p = [x.strip() for x in l.split("|")]
        if len(p) >= 5 and p[0].isdigit():
            out.append({"id": int(p[0]), "command": p[1], "date": p[2], "actions": [x.strip().lower() for x in p[3].split(",")], "altered": p[4]})
    return out


def rollback_packages(ctx, a):
    """the way back without snapshots: dnf undoes the last transaction that upgraded packages. Its limits are said"""
    if a.name and not a.name.isdigit():
        die("silik rollback --packages [ID]: ID is a transaction of `sudo dnf history list`", 2)
    tid = a.name
    if not tid:
        rc, out = snap_read(ctx, ["dnf", "history", "list"])
        if rc is None:
            tid = "ID"
        else:
            ups = [t for t in dnf_history_parse(out) if any(x in DNF_UPGRADE for x in t["actions"])] if rc == 0 else []
            if not ups:
                snap_refuse("dnf's history has no transaction that upgraded packages: nothing to undo", ["sudo dnf history list"])
            t = ups[0]
            tid = str(t["id"])
            print("silik: the last update is transaction %s of %s (%s; %s packages)" % (tid, t["date"], t["command"] or "the automatic update", t["altered"].split()[0]))
    print("silik: what this does not do: it needs the old versions in the repositories (after a new minor release of the base they are gone); "
          "it does not put back configuration files or what package scripts did; a kernel is only removed; after glibc or systemd: restart")
    ctx.run(as_root(["dnf", "history", "info", tid]), check=False)
    ctx.run(as_root(["dnf"] + (["-y"] if a.yes else []) + ["history", "undo", tid]))
    return 0


def cmd_rollback(ctx, a):
    if a.packages:
        return rollback_packages(ctx, a)
    if a.name == "finish":
        return rollback_finish(ctx, a)
    snap_need(ctx)
    kind, uuid = snap_booted()
    asked, sets = snap_sets(ctx)
    if asked and sets is None:
        die("snapm did not list the snapshots (its reason is above)")
    if not asked:
        sets = [{"name": a.name or SNAP_AUTO + ".N", "uuid": "UUID", "time": 0, "status": "Active", "revert_entry": "x", "auto": True}]
    target = None
    if kind == "snapshot":
        target = next((s for s in sets if s["uuid"] == uuid), None) if asked else sets[0]
        if target is None:
            snap_refuse("this system is started from a snapshot that snapm does not list (%s)" % uuid, ["silik snapshot list", "systemctl reboot   # and the normal entry"])
        if a.name and a.name != target["name"]:
            snap_refuse("this system is started from the snapshot %s: from here only it can become the system" % target["name"],
                        ["silik rollback   # makes %s the system" % target["name"], "systemctl reboot   # and the normal entry; then: silik rollback %s" % a.name])
    elif a.name:
        target = next((s for s in sets if s["name"] == a.name), None)
        if target is None:
            snap_refuse("no snapshot is named %s" % a.name, ["silik snapshot list"])
    else:
        auto = [s for s in sets if s["auto"]]
        if not auto:
            snap_refuse("no snapshot made before an update to go back to", ["silik snapshot list   # one made by hand: silik rollback NAME", SNAP_PACKAGES])
        target = auto[-1]
    if not target["revert_entry"]:
        snap_refuse("the snapshot %s has no Revert entry in the boot menu (it was not made by silik)" % target["name"],
                    ["sudo snapm snapset revert %s   # by hand: start the kernel of the snapshot's day afterwards" % target["name"]])
    if target["status"] == "Invalid":
        snap_refuse("the snapshot %s is invalid (the pool ran out of room for it): it cannot be reverted" % target["name"], ["silik snapshot list", SNAP_PACKAGES])
    when = snap_when(target["time"], time.time())
    if target["status"] != "Reverting":
        if not ctx.dry and not a.yes:
            if not sys.stdin.isatty():
                die("going back discards what was written to / since %s: add --yes" % when, 2)
            print("silik: / goes back to the snapshot %s of %s. What was written to / since then is discarded: packages, /etc, /var, /opt. /home is kept as it is now." % (target["name"], when))
            try:
                ok = input("silik: go back? [y/N] ").strip().lower() in ("y", "yes", "s", "si", "sí")
            except EOFError:
                ok = False
            if not ok:
                die("nothing changed", 1)
        ctx.run(as_root(["snapm", "snapset", "revert", target["name"]]))
    else:
        print("silik: the revert of %s has started already" % target["name"])
    entries = bls_entries() or []
    entry = next((e for e in entries if e["snapm"] == ("revert", target["uuid"])), None)
    if entry or ctx.dry:
        ctx.run(as_root(["grub2-reboot", entry["id"] if entry else "MACHINEID-BOOTID-VERSION"]), check=False)
        if ctx.dry:
            return 0
        print("silik: restart to finish: systemctl reboot   (the entry \"%s\" starts, once; nothing is restarted by silik)" % (entry["title"] if entry else "Revert ..."))
    else:
        print("silik: restart to finish, and choose the entry \"Revert %s ...\" in the boot menu (its entry was not found in %s/loader/entries)" % (target["name"], SNAP_BOOT))
    print("silik: on that start / is as it was on %s, and `silik rollback finish` puts the boot menu in step by itself" % when)
    return 0


def snap_doc_probe():
    """what the doctor's row reads: files alone, no command"""
    return {"root": snap_root(), "snapm": bool(shutil.which("snapm")), "booted": snap_booted(),
            "flag": read(SNAP_FLAG, None), "hold": read(SNAP_HOLD, None)}


def doc_probe_rollback(probe):
    """the system area's probe, with what the row "rollback" reads beside it (kept apart from doc_probe_system)"""
    def both():
        st = probe()
        st["rollback"] = snap_doc_probe()
        return st
    return both


def doc_rollback(st, rows):
    """the row "rollback" of `silik doctor system`: is there a way back from an update that breaks the machine.
    ST["rollback"] is what snap_doc_probe() read (doc_probe_rollback puts it there; the tests give made-up ones);
    a system that was not asked gets no row"""
    r = st.get("rollback")
    if r is None:
        return
    kind, uuid = r["booted"]
    no = snap_unavailable(r["root"], r["snapm"])
    if kind == "snapshot":
