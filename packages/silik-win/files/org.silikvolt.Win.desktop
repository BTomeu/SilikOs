[Desktop Entry]
Type=Application
Name=Windows program
Name[ca]=Programa de Windows
Name[es]=Programa de Windows
Comment=Run a Windows program (.exe .msi .lnk .bat) with Wine, in its sandbox
Comment[ca]=Executa un programa de Windows (.exe .msi .lnk .bat) amb Wine, dins el seu entorn aïllat
Comment[es]=Ejecuta un programa de Windows (.exe .msi .lnk .bat) con Wine, en su entorno aislado
Exec=silik win open %f
Icon=org.silikvolt.Win
Terminal=false
NoDisplay=true
StartupNotify=false
MimeType=application/x-ms-dos-executable;application/x-msdos-program;application/x-msdownload;application/vnd.microsoft.portable-executable;application/x-msi;application/x-ms-shortcut;application/x-bat;
