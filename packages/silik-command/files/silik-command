def silik_json_start(args):
    """`silik -q ARGS` started (silik_json_read takes its answer); None when it cannot start"""
    try:
        return subprocess.Popen([SILIK, "-q"] + args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, universal_newlines=True)
    except OSError:
        return None


def silik_json_read(p, timeout=5):
    """the JSON a started silik printed; [] when it failed, printed nothing or took more than TIMEOUT s (then ended)"""
    if p is None:
        return []
    try:
        out, _ = p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        p.kill()
        p.communicate()
        return []
    try:
        return json.loads(out) if p.returncode == 0 and out.strip() else []
    except ValueError:
        return []


def silik_json(args):
    return silik_json_read(silik_json_start(args))


