    try:
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, "session.log"), "a") as f:
            f.write("%s  %s\n$ %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), item.address, item.twin))
    except OSError:
        pass


def held(argv, t):
    """ARGV in a terminal that stays open after it ends (GNOME Terminal's profile closes the window when the command
    exits: an answer, a sudo prompt's outcome or an error would vanish), with its exit status; Enter closes it"""
    msg = (t or TEXT["en"])["held"].replace("%", "%%").replace("%%s", "%s")
    return [TERMINAL, "--", "sh", "-c", '"$@"; rc=$?; echo; printf "%s" "$rc"; read -r _' % msg.replace('"', "'"), "silik-command"] + argv


def launch(item, t=None):
    argv = held(item.argv, t) if item.terminal else item.argv
    log_line(item)
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError:
        return False


def all_items(lang, started=None):
    """every entry; STARTED: the SILIK_LISTS calls already started (silik_json_start), else they start here"""
    started = [silik_json_start(a) for a in SILIK_LISTS] if started is None else started
    apps = app_items(desktop_dirs(), lang)       # read while silik answers
    boxes, prefixes, programs = (silik_json_read(p) for p in started)
    return system_items(TEXT[lang], boxes, prefixes, programs) + apps


# ------------------------------------------------------------------ window
# One radius for the floating panes (the island, Start, this bar: 6 px; the shell's glass is cut to it, extension.js
# CMD_R), the inner one (the foot, inside the 1 px frame) one less, the rows the keys' 4 px.
CSS = """
window.silik { background: %(bg)s; border: 1px solid %(frame)s; border-radius: %(radius)s; }
.silik * { font-family: "Cascadia Mono", "DejaVu Sans Mono", monospace; font-size: 11pt; color: %(ink)s; }
.silik .prompt { font-weight: 600; padding: 0 2px 0 14px; }
.silik entry { background: transparent; border: none; box-shadow: none; padding: 12px 8px; caret-color: %(ink)s; }
.silik entry:focus { box-shadow: none; }
.silik .rule { background: %(rule)s; min-height: 1px; }
.silik list { background: transparent; padding: 4px; }
.silik row { padding: 5px 10px; border-radius: %(rowr)s; }
.silik row:selected { background: %(ink)s; }
.silik row:selected label { color: %(paper)s; }
.silik row:selected label.meta { color: %(selmu)s; }
.silik label.meta { color: %(muted)s; }
.silik .foot { background: %(bg2)s; border-radius: 0 0 %(inner)s %(inner)s; padding: 6px 14px; }
.silik .foot label { font-size: 9.5pt; color: %(muted)s; }
.silik .foot label.twin { color: %(ink)s; }
"""
THEMES = {
    "light": {"paper": "#f7f6f3", "paper2": "#eeede9", "ink": "#1a1b1e", "muted": "#6b6d72", "rule": "#dcdad5", "frame": "#1a1b1e", "selmu": "#b9b8b3"},
    "dark": {"paper": "#17181b", "paper2": "#1f2024", "ink": "#ecebe7", "muted": "#9a9b9f", "rule": "#33353a", "frame": "#ecebe7", "selmu": "#5c5e63"},
}
# Glass (the key "glass" of com.silikvolt.silikos.shell, `silik look --glass on|off`): the window's paper at 0.86, the
# foot a breath of ink, the muted text the grey that reads at 4.5:1 with black (dark: white) behind the paper; the
# shell puts the blurred wallpaper under the window (extension.js). From tools/gen_accents.py's glass(): the tests
# hold them equal.
GLASS = {
    "light": {"bg": "rgba(247, 246, 243, 0.86)", "bg2": "rgba(26, 27, 30, 0.04)", "muted": "#54565a"},
    "dark": {"bg": "rgba(23, 24, 27, 0.86)", "bg2": "rgba(236, 235, 231, 0.04)", "muted": "#a1a1a5"},
}
RADIUS = 6


def glass_on():
    """the key "glass" of the desktop's settings (False when the schema or the key is not on this system)"""
    try:
        from gi.repository import Gio
        src = Gio.SettingsSchemaSource.get_default()
        schema = src.lookup("com.silikvolt.silikos.shell", True) if src else None
        return bool(schema and schema.has_key("glass") and Gio.Settings.new("com.silikvolt.silikos.shell").get_boolean("glass"))
    except Exception:       # (no GLib bindings, no settings service: solid paper)
        return False


def css_values(theme, composited, glass):
    """the stylesheet's values: rounded corners need a compositing window manager (GNOME has one), square without it;
    glass too (a translucent window without one is drawn over black)"""
    v = dict(THEMES[theme], bg=THEMES[theme]["paper"], bg2=THEMES[theme]["paper2"])
    v.update(radius="%dpx" % RADIUS if composited else "0", inner="%dpx" % (RADIUS - 1) if composited else "0", rowr="4px")
    if glass and composited:
        v.update(GLASS[theme])
    return v


def run_window(query, theme, lang, started=None):
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, Gtk, Pango

    t = TEXT[lang]
    items = all_items(lang, started)
    css = Gtk.CssProvider()
    vals = css_values(theme, Gdk.Screen.get_default().is_composited(), glass_on())
    css.load_from_data((CSS % vals).encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    win = Gtk.Window(title="SilikOS COMMAND")
    win.set_decorated(False)
    win.set_default_size(820, -1)
    win.set_resizable(False)
    win.set_keep_above(True)
    win.set_skip_taskbar_hint(True)
    win.set_type_hint(Gdk.WindowTypeHint.DIALOG)
    win.set_position(Gtk.WindowPosition.CENTER)
    win.get_style_context().add_class("silik")
    visual = win.get_screen().get_rgba_visual()
    if visual:
        win.set_visual(visual)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    top = Gtk.Box()
    prompt = Gtk.Label(label="›")
    prompt.get_style_context().add_class("prompt")
    entry = Gtk.Entry()
    entry.set_placeholder_text(t["placeholder"])
    entry.set_hexpand(True)
    top.pack_start(prompt, False, False, 0)
    top.pack_start(entry, True, True, 0)
    rule = Gtk.Box()
    rule.get_style_context().add_class("rule")
    lst = Gtk.ListBox()
    lst.set_selection_mode(Gtk.SelectionMode.BROWSE)
    foot = Gtk.Box(spacing=18)
    foot.get_style_context().add_class("foot")
    twin = Gtk.Label(xalign=0)
    twin.get_style_context().add_class("twin")
    twin.set_ellipsize(Pango.EllipsizeMode.END)
    twin.set_hexpand(True)
    keys = Gtk.Label(label="Enter %s   Tab %s   Esc %s" % (t["run"], t["complete"], t["close"]))
    foot.pack_start(twin, True, True, 0)
    foot.pack_end(keys, False, False, 0)
    for w in (top, rule, lst, foot):
        box.pack_start(w, False, False, 0)
    win.add(box)
    shown = []

    def refresh(*_):
        for r in lst.get_children():
            lst.remove(r)
        shown[:] = match(items, entry.get_text(), t)
        for it in shown:
            row = Gtk.Box(spacing=16)
            a = Gtk.Label(label=it.address, xalign=0)
            a.set_width_chars(26)
            a.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
            b = Gtk.Label(label=it.title, xalign=0)
            b.get_style_context().add_class("meta")
            b.set_ellipsize(Pango.EllipsizeMode.END)
            row.pack_start(a, False, False, 0)
            row.pack_start(b, True, True, 0)
            lst.add(row)
        if not shown:
            n = Gtk.Label(label=t["none"], xalign=0)
            n.get_style_context().add_class("meta")
            lst.add(n)
            lst.get_row_at_index(0).set_selectable(False)
        lst.show_all()
        if shown:
            lst.select_row(lst.get_row_at_index(0))
        selected()

    def current():
        r = lst.get_selected_row()
        return shown[r.get_index()] if r is not None and r.get_index() < len(shown) else None

    def selected(*_):
        it = current()
        twin.set_text("$ " + it.twin if it else "")

    def key(_w, ev):
        k = ev.keyval
        if k == Gdk.KEY_Escape:
            Gtk.main_quit()
            return True
        if k in (Gdk.KEY_Down, Gdk.KEY_Up) and shown:
            r = lst.get_selected_row()
            i = (r.get_index() if r else 0) + (1 if k == Gdk.KEY_Down else -1)
            lst.select_row(lst.get_row_at_index(max(0, min(len(shown) - 1, i))))
            return True
        if k in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
            it = current()
            if it:
                entry.set_text(it.address + (" " if it.takes else ""))
                entry.set_position(-1)
            return True
        if k in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            it = current()
            if it and launch(it, TEXT[lang]):
                Gtk.main_quit()
            return True
        return False

    entry.connect("changed", refresh)
    lst.connect("row-selected", selected)
    win.connect("key-press-event", key)
    win.connect("destroy", Gtk.main_quit)
    win.connect("focus-out-event", lambda *_: Gtk.main_quit() if not os.environ.get("SILIK_COMMAND_STAY") else False)
    entry.set_text(query)
    refresh()
    win.show_all()
    entry.grab_focus()
    entry.set_position(-1)
    Gtk.main()


def main(argv):
    query, theme, lang, list_only = "", os.environ.get("SILIK_THEME", ""), lang_of(), None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--query", "--theme", "--lang", "--list") and i + 1 < len(argv):
            v = argv[i + 1]
            i += 1
            if a == "--query":
                query = v
            elif a == "--theme":
                theme = v
            elif a == "--lang":
                lang = v if v in TEXT else lang
            else:
                list_only = v
        elif a in ("-h", "--help"):
            print(__doc__ or "silik-command [--query TEXT] [--theme light|dark] [--list TEXT] [--lang en|ca|es]")
            return 0
        else:
            print("silik-command: unknown option " + a, file=sys.stderr)
            return 2
        i += 1
    if list_only is not None:
        for it in match(all_items(lang), list_only, TEXT[lang], limit=50):
            print("%s\t%s" % (it.address, it.twin))
        return 0
    started = [silik_json_start(a) for a in SILIK_LISTS]     # they answer while the theme is read and GTK loads
    if theme not in THEMES:
        theme = "light"
        try:
            out = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "gtk-theme"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, universal_newlines=True, timeout=3).stdout
            if "dark" in out.lower():
                theme = "dark"
        except (OSError, subprocess.TimeoutExpired):
            pass
    run_window(query, theme, lang, started)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
