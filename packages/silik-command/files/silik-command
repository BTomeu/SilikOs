        self.address, self.title, self.argv, self.terminal = address, title, list(argv), terminal
        self.takes = takes      # a box or a prefix: `address COMMAND...` runs a command inside it
        self.ask = ask          # a question for `silik ask`: Enter lists its answers
        self.fill = fill        # an answer: Enter puts this text in the bar and runs nothing
        self.line = line        # the command line as it is shown, when it is not ARGV word for word

    @property
    def twin(self):
        if self.line is not None:
            return self.line
        argv = ["silik"] + self.argv[1:] if self.argv and self.argv[0] == SILIK else self.argv   # as typed in a terminal
        return " ".join(shlex.quote(a) for a in argv)


def slug(s):
    out = "".join(c.lower() if c.isalnum() else "-" for c in s)
    while "--" in out:
        out = out.replace("--", "-")
    return out.strip("-")


def desktop_dirs(env=None):
    env = os.environ if env is None else env
    dirs = [os.path.join(env.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "applications")]
    for d in (env.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":"):
        if d:
            dirs.append(os.path.join(d, "applications"))
    return dirs


# programs the bar does not list (the shell extension's HIDDEN_APPS, the same): qt5ct is how Qt 5 programs take the
# accent, which `silik look --accent` and `silik look --qt` set
HIDDEN_APPS = ("qt5ct.desktop",)


def exec_argv(line):
    """the Exec= line of a desktop entry without its field codes (%f %U ...)"""
    try:
        parts = shlex.split(line)
    except ValueError:
        parts = line.split()
    return [p for p in parts if not (len(p) == 2 and p[0] == "%")]


def desktop_entry(path):
    """the [Desktop Entry] group of a desktop file as {key: value}, or None (no file, not text, no such group). Read by
    hand: configparser took 0.4 ms a file, and the bar reads every one of them before its window opens
    (docs/STATUS.md). As configparser read it: the group may come in pieces, the last value of a key stands"""
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError):
        return None
    e, inside = None, False
    for line in text.split("\n"):
        if line[:1] == "[":
            inside = line.rstrip() == "[Desktop Entry]"
            if inside and e is None:
                e = {}
        elif inside and line[:1] not in ("#", ";", ""):
            k, sep, v = line.partition("=")
            if sep:
                e[k.strip()] = v.strip()
    return e


def app_items(dirs, lang="en"):
    seen, out = set(), []
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for fn in names:
            if not fn.endswith(".desktop") or fn in seen or fn in HIDDEN_APPS:
                continue
            seen.add(fn)
            e = desktop_entry(os.path.join(d, fn))
            if e is None:
                continue
            if e.get("Type", "Application") != "Application" or e.get("NoDisplay", "false").lower() == "true" or e.get("Hidden", "false").lower() == "true":
                continue
            if e.get("X-SilikOS-Prefix"):       # an installed Windows program: listed as win/... (system_items)
                continue
            argv = exec_argv(e.get("Exec", ""))
            if not argv:
                continue
            name = e.get("Name[%s]" % lang) or e.get("Name") or fn[:-8]
            out.append(Item("app/" + slug(fn[:-8].split(".")[-1] if fn.count(".") > 1 else fn[:-8]), name, argv, e.get("Terminal", "false").lower() == "true"))
    return out


