def held(argv, t):
    """ARGV in a terminal that stays open after it ends (GNOME Terminal's profile closes the window when the command
    exits: an answer, a sudo prompt's outcome or an error would vanish), with its exit status; Enter closes it"""
    msg = (t or TEXT["en"])["held"].replace("%", "%%").replace("%%s", "%s")
    return [TERMINAL, "--", "sh", "-c", '"$@"; rc=$?; echo; printf "%s" "$rc"; read -r _' % msg.replace('"', "'"), "silik-command"] + argv


def launch(item, t=None):
    if not item.argv:           # (an answer of `silik ask`: it fills the bar, it is not run)
        return False
    argv = held(item.argv, t) if item.terminal else item.argv
    log_line(item)
    try:
        p = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return False
    # (the bar stays, and the program is its child: someone must take its end, or it is a zombie until the bar next
    # starts a program. Seen in the rig: `Zs gnome-terminal <defunct>`)
    import threading
    threading.Thread(target=p.wait, daemon=True).start()
    return True


PLUGIN_DIR = os.environ.get("SILIK_PLUGIN_DIR") or "/usr/share/silikos/python/plugins"
ADDRESS = re.compile(r"^[a-z][a-z0-9-]*/[a-z0-9][a-z0-9./-]*$")


def plugin_items(lang, d=None):
    """the addresses of silik's plugins: plugins/NAME.cmd.json, a list of {"address": "group/word", "argv": [...],
    "en": ..., "ca": ..., "es": ..., "terminal": true}. ARGV is what follows `silik`: an entry runs silik, nothing
    else. A file that does not read, or an entry that is not of that shape, is left out"""
    out, d = [], d or PLUGIN_DIR
    try:
        names = sorted(f for f in os.listdir(d) if f.endswith(".cmd.json"))
    except OSError:
        return out
    for f in names:
        try:
            with open(os.path.join(d, f), encoding="utf-8") as fh:
                rows = json.load(fh)
        except (OSError, ValueError):
            continue
        for r in rows if isinstance(rows, list) else []:
            try:
                a, argv, title = r["address"], r["argv"], r.get(lang) or r["en"]
                if not (ADDRESS.match(a) and isinstance(argv, list) and argv and all(isinstance(x, str) for x in argv)
                        and isinstance(title, str) and not argv[0].startswith("-")):
                    continue
                out.append(Item(a, title, [SILIK] + argv, bool(r.get("terminal", True))))
            except (KeyError, TypeError, AttributeError):
                continue
    return out


def all_items(lang, started=None):
    """every entry; STARTED: the SILIK_LISTS calls already started (silik_json_start), else they start here"""
    started = [silik_json_start(a) for a in SILIK_LISTS] if started is None else started
    apps = app_items(desktop_dirs(), lang)       # read while silik answers
    boxes, prefixes, programs = (silik_json_read(p) for p in started)
    return system_items(TEXT[lang], boxes, prefixes, programs, vendor_tools()) + plugin_items(lang) + apps


# ------------------------------------------------------------------ the bar that stays
# One line over a socket in the user's runtime folder (theirs alone, mode 0700; the socket 0600, one per display): HELLO, the
# desktop's startup id, then the words of the command line, NUL between them. The answer is "ok" (the window is being
# shown) or anything else (this bar cannot serve it: the caller opens its own). A request shows the bar with a query
# in it and nothing else: nothing typed into the socket is ever run. /usr/bin/silik-command (silik-command-launch)
# speaks the same line without loading this file; the tests hold the two equal.
SOCKET = "silik-command%s.sock"
HELLO = "silik-command 1"


def socket_name(env=None):
    """the socket's name: one per display. The runtime folder is the user's, not the display's: a second session of
    the same user (ssh -X, VNC, a remote desktop: common where the EDA tools run) must not be answered by the bar
    of the first, which would show itself on the other screen"""
    env = os.environ if env is None else env
    key = "".join(c if c.isalnum() or c == "." else "_" for c in (env.get("WAYLAND_DISPLAY") or "") + (env.get("DISPLAY") or ""))
    return SOCKET % ("-" + key if key else "")


def socket_path(env=None):
    """where a bar that stays listens, or None: no runtime folder (a bare X session, a test), or SILIK_COMMAND_ONCE"""
    env = os.environ if env is None else env
    d = env.get("XDG_RUNTIME_DIR")
    return os.path.join(d, socket_name(env)) if d and os.path.isdir(d) and not env.get("SILIK_COMMAND_ONCE") else None


def request_line(argv, startup_id=""):
    return b"\0".join(x.encode("utf-8", "surrogateescape") for x in [HELLO, startup_id] + list(argv)) + b"\n"


def request_read(data):
    """(startup id, the words) of a request line, or None when it is not one"""
    parts = [x.decode("utf-8", "surrogateescape") for x in data.rstrip(b"\n").split(b"\0")]
    return (parts[1], parts[2:]) if len(parts) >= 2 and parts[0] == HELLO and data.endswith(b"\n") else None


def hand_over(path, argv, startup_id="", timeout=1.0):
    """ask the bar that stays to show itself; True when it said it does"""
    import socket
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.settimeout(timeout)
        s.connect(path)
        s.sendall(request_line(argv, startup_id))
        return s.recv(8)[:2] == b"ok"
    except OSError:
        return False
    finally:
        s.close()


def listen(path):
    """the listening socket at PATH, or None: another bar holds it (it answers), or it cannot be made. A socket file
    nobody answers at (a bar that was killed) is replaced"""
    import socket
    for again in (True, False):
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            old = os.umask(0o177)
            try:
                srv.bind(path)
            finally:
                os.umask(old)
            srv.listen(4)
            srv.setblocking(False)
            return srv
        except OSError:
            srv.close()
            probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                probe.settimeout(0.5)
                probe.connect(path)
                return None                 # (someone answers: that bar stays, this one is a window of its own)
            except OSError:
                if not again:
                    return None
                try:
                    os.unlink(path)
                except OSError:
                    return None
            finally:
                probe.close()
    return None


def arguments(argv):
    """the command line read: {"query", "theme", "lang", "list"} (theme and lang None when not given), or, for a line
    that is help or wrong, (exit status, what to say)"""
    o = {"query": "", "theme": None, "lang": None, "list": None}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--query", "--theme", "--lang", "--list") and i + 1 < len(argv):
            o[a[2:]] = argv[i + 1]
            i += 1
        elif a in ("-h", "--help"):
            return 0, "silik-command [--query TEXT] [--theme light|dark] [--list TEXT] [--lang en|ca|es]"
        else:
            return 2, "silik-command: unknown option " + a
        i += 1
    return o


# ------------------------------------------------------------------ window
# One radius for the floating panes (the island, Start, this bar: 6 px; the shell's glass is cut to it, extension.js
# CMD_R), the inner one (the foot, inside the 1 px frame) one less, the rows the keys' 4 px.
CSS = """
window.silik { background: %(bg)s; border: 1px solid %(frame)s; border-radius: %(radius)s; }
.silik * { font-family: "Cascadia Mono", "DejaVu Sans Mono", monospace; font-size: 11pt; color: %(ink)s; }
.silik .prompt { font-weight: 600; padding: 0 2px 0 14px; }
.silik entry { background: transparent; border: none; box-shadow: none; padding: 12px 8px; caret-color: %(ink)s; }
.silik entry:focus { box-shadow: none; }
.silik .rule { background: %(rule)s; min-height: 1px; }
.silik list { background: transparent; padding: 4px; }
.silik row { padding: 5px 10px; border-radius: %(rowr)s; }
.silik row:selected { background: %(ink)s; }
.silik row:selected label { color: %(paper)s; }
.silik row:selected label.meta { color: %(selmu)s; }
.silik label.meta { color: %(muted)s; }
.silik .foot { background: %(bg2)s; border-radius: 0 0 %(inner)s %(inner)s; padding: 6px 14px; }
.silik .foot label { font-size: 9.5pt; color: %(muted)s; }
.silik .foot label.twin { color: %(ink)s; }
"""
THEMES = {
    "light": {"paper": "#f7f6f3", "paper2": "#eeede9", "ink": "#1a1b1e", "muted": "#6b6d72", "rule": "#dcdad5", "frame": "#1a1b1e", "selmu": "#b9b8b3"},
    "dark": {"paper": "#17181b", "paper2": "#1f2024", "ink": "#ecebe7", "muted": "#9a9b9f", "rule": "#33353a", "frame": "#ecebe7", "selmu": "#5c5e63"},
}
# Glass (the keys "glass" and "glass-mode" of com.silikvolt.silikos.shell, `silik look --glass off|on|clear|crystal|
# crystal-thin`): the window's paper at the mode's opacity, the foot a breath of ink, the muted text the grey that
# reads at 4.5:1 with black (dark: white) behind the paper; the shell puts the blurred wallpaper, in the crystal modes
# the windows behind too, under the window (extension.js). From tools/gen_accents.py's glass(MODE): the tests hold
# them equal. (The dark paper of the thinnest mode is more opaque than the light one: a white window behind it is a
# real case, and its text must read.)
GLASS = {
    "on": {"light": {"bg": "rgba(247, 246, 243, 0.86)", "bg2": "rgba(26, 27, 30, 0.04)", "muted": "#54565a"},
           "dark": {"bg": "rgba(23, 24, 27, 0.86)", "bg2": "rgba(236, 235, 231, 0.04)", "muted": "#aaabad"}},
    "clear": {"light": {"bg": "rgba(247, 246, 243, 0.7)", "bg2": "rgba(26, 27, 30, 0.04)", "muted": "#3a3c40"},
              "dark": {"bg": "rgba(23, 24, 27, 0.7)", "bg2": "rgba(236, 235, 231, 0.04)", "muted": "#e1e0dd"}},
    "crystal": {"light": {"bg": "rgba(247, 246, 243, 0.72)", "bg2": "rgba(26, 27, 30, 0.04)", "muted": "#3e3f43"},
                "dark": {"bg": "rgba(23, 24, 27, 0.72)", "bg2": "rgba(236, 235, 231, 0.04)", "muted": "#dad9d7"}},
    "crystal-thin": {"light": {"bg": "rgba(247, 246, 243, 0.55)", "bg2": "rgba(26, 27, 30, 0.04)", "muted": "#1a1b1e"},
                     "dark": {"bg": "rgba(23, 24, 27, 0.67)", "bg2": "rgba(236, 235, 231, 0.04)", "muted": "#eae9e6"}},
}
RADIUS = 6
# The window is WIDTH wide. A label that may be cut (a title, the command line at the foot) would otherwise ask for
# the width of its whole text, and the window, which is not resizable, would grow to it: with the long titles of
# 13/11/2026 it was 1232 px on a 1280 px screen. Such a label asks for WIDE characters and is given the room left.
WIDTH = 820
WIDE = 20


TUNED_ACTIVE = "/etc/tuned/active_profile"      # the profile in use, as tuned writes it at each change
SAVER_PROFILES = ("powersave", "silikos-saver")    # saver: the base's, and silikos-power's own (`silik power profiles silikos`)
PPD_DAEMON = "/usr/libexec/power-profiles-daemon"   # (that one instead of tuned: tuned's file would be stale)


def power_saver(path=None, other=None):
    """True while the power profile is saver (tuned's powersave), read as the shell extension reads it: no command"""
    if os.path.exists(PPD_DAEMON if other is None else other):
        return False
    try:
        with open(TUNED_ACTIVE if path is None else path, encoding="utf-8") as f:
            return f.read().strip() in SAVER_PROFILES
    except (OSError, UnicodeDecodeError):
        return False


def glass_mode():
    """the glass in use: None (off, or no schema, no key, no settings service: solid paper) or a key of GLASS. The key
    "glass" is the switch, "glass-mode" which glass (a desktop from before the modes has only the switch: "on")"""
    try:
        from gi.repository import Gio
        src = Gio.SettingsSchemaSource.get_default()
        schema = src.lookup("com.silikvolt.silikos.shell", True) if src else None
        if not schema or not schema.has_key("glass"):
            return None
        settings = Gio.Settings.new("com.silikvolt.silikos.shell")
        if not settings.get_boolean("glass"):
            return None
        if schema.has_key("glass-saver") and settings.get_boolean("glass-saver") and power_saver():
            return None         # (the power profile saver: solid paper, as the shell's panes; extension.js _watchSaver)
        mode = settings.get_string("glass-mode") if schema.has_key("glass-mode") else "on"
        return mode if mode in GLASS else "on"
    except Exception:       # (no GLib bindings, no settings service: solid paper)
        return None


def desktop_theme():
    """light or dark: the desktop's GTK theme, by its name (SilikOS, SilikOS-dark, SilikOS-cobalt-dark ...). Read in
    this process once GTK is loaded: `gsettings get` was one more program to start before the window"""
    try:
        from gi.repository import Gio
        src = Gio.SettingsSchemaSource.get_default()
        schema = src.lookup("org.gnome.desktop.interface", True) if src else None
        if schema and schema.has_key("gtk-theme") and "dark" in Gio.Settings.new("org.gnome.desktop.interface").get_string("gtk-theme").lower():
            return "dark"
    except Exception:       # (no GLib bindings, no settings service)
        pass
    return "light"


def css_values(theme, composited, glass):
    """the stylesheet's values. GLASS: None or a key of GLASS. Rounded corners need a compositing window manager
    (GNOME has one), square without it; glass too (a translucent window without one is drawn over black)"""
    v = dict(THEMES[theme], bg=THEMES[theme]["paper"], bg2=THEMES[theme]["paper2"])
    v.update(radius="%dpx" % RADIUS if composited else "0", inner="%dpx" % (RADIUS - 1) if composited else "0", rowr="4px")
    if glass and composited:
        v.update(GLASS[glass][theme])
    return v


def run_window(query, theme, lang, started=None, path=None, given=(None, None)):
    """the window. PATH: the socket to stay at (None: the bar ends when its window closes). GIVEN: the --theme and
    --lang of this bar's own command line: a request with others is not served (its caller opens its own window)"""
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk, Pango

    t = TEXT[lang]
    fixed = theme in THEMES     # (--theme, SILIK_THEME: kept. Else the desktop's, read again at each showing)
    items = all_items(lang, started)
    css = Gtk.CssProvider()
    screen = Gdk.Screen.get_default()
    style = {}

    def restyle():
        vals = css_values(theme if fixed else desktop_theme(), screen.is_composited(), glass_mode())
        if vals == style.get("vals"):
            return
        sheet = (CSS % vals).encode()
        try:
            css.load_from_data(sheet)
        except GLib.Error:
            # (seen in the rig, 13/11/2026, about once in thirty openings on a busy machine: GTK refused this stylesheet
            # with "Invalid number for color value" at its first number, and the bar did not open. The sheet is valid
            # and the next reading takes it; why the first did not is not known [A])
            css.load_from_data(sheet)
        style["vals"] = vals

    restyle()
    Gtk.StyleContext.add_provider_for_screen(screen, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    win = Gtk.Window(title="SilikOS COMMAND")
    win.set_decorated(False)
    win.set_default_size(WIDTH, -1)
    win.set_resizable(False)
    win.set_keep_above(True)
    win.set_skip_taskbar_hint(True)
    win.set_type_hint(Gdk.WindowTypeHint.DIALOG)
    win.set_position(Gtk.WindowPosition.CENTER)
    win.get_style_context().add_class("silik")
    visual = win.get_screen().get_rgba_visual()
    if visual:
        win.set_visual(visual)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    top = Gtk.Box()
    prompt = Gtk.Label(label="›")
    prompt.get_style_context().add_class("prompt")
    entry = Gtk.Entry()
    entry.set_placeholder_text(t["placeholder"])
    entry.set_hexpand(True)
    top.pack_start(prompt, False, False, 0)
    top.pack_start(entry, True, True, 0)
    rule = Gtk.Box()
    rule.get_style_context().add_class("rule")
    lst = Gtk.ListBox()
    lst.set_selection_mode(Gtk.SelectionMode.BROWSE)
    foot = Gtk.Box(spacing=18)
    foot.get_style_context().add_class("foot")
    twin = Gtk.Label(xalign=0)
    twin.get_style_context().add_class("twin")
    twin.set_ellipsize(Pango.EllipsizeMode.END)
    twin.set_max_width_chars(WIDE)
    twin.set_hexpand(True)
    keys = Gtk.Label(label="Enter %s   Tab %s   Esc %s" % (t["run"], t["complete"], t["close"]))
    foot.pack_start(twin, True, True, 0)
    foot.pack_end(keys, False, False, 0)
    for w in (top, rule, lst, foot):
        box.pack_start(w, False, False, 0)
    win.add(box)
    shown, asked = [], []

    def refresh(*_):
        for r in lst.get_children():
            lst.remove(r)
        shown[:] = match(items, entry.get_text(), t, asked=asked or None)
        for it in shown:
            row = Gtk.Box(spacing=16)
            a = Gtk.Label(label=it.address, xalign=0)
            a.set_width_chars(26)
            a.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
            b = Gtk.Label(label=it.title, xalign=0)
            b.get_style_context().add_class("meta")
            b.set_ellipsize(Pango.EllipsizeMode.END)
            b.set_max_width_chars(WIDE)     # (it takes the room the row has, and asks for little: see WIDE)
            row.pack_start(a, False, False, 0)
            row.pack_start(b, True, True, 0)
            lst.add(row)
        if not shown:
            n = Gtk.Label(label=t["none"], xalign=0)
            n.get_style_context().add_class("meta")
            lst.add(n)
            lst.get_row_at_index(0).set_selectable(False)
        lst.show_all()
        if shown:
            lst.select_row(lst.get_row_at_index(0))
        selected()

    def current():
        r = lst.get_selected_row()
        return shown[r.get_index()] if r is not None and r.get_index() < len(shown) else None

    def selected(*_):
        it = current()
        twin.set_text("$ " + it.twin if it else "")
        keys.set_text("Enter %s   Tab %s   Esc %s" % (t["fill"] if it and it.fill else t["run"], t["complete"], t["close"]))

    # ---- the bar that stays: its window hides, a request shows it again
    srv = listen(path) if path else None
    stay = {"on": srv is not None}
    try:
        born = os.stat(__file__).st_mtime_ns
    except OSError:
        born = None

    def close(*_):
        if not stay["on"]:
            Gtk.main_quit()
            return
        win.hide()
        asked[:] = []

    def leave():
        """no longer the bar that stays: the socket is given up at once, the process ends when its window closes"""
        stay["on"] = False
        try:
            srv.close()
            os.unlink(path)
        except OSError:
            pass
        if not win.get_visible():
            GLib.idle_add(Gtk.main_quit)

    def reload():
        """the lists again (boxes, prefixes, programs, desktop entries), asked with the window already on the screen
        and taken when the three have answered; the rows are drawn again only when something changed"""
        calls = [silik_json_start(a) for a in SILIK_LISTS]
        until = time.time() + 5

        def ready():
            if time.time() < until and any(p is not None and p.poll() is None for p in calls):
                return True
            new = all_items(lang, calls)
            if [(i.address, i.title, i.argv, i.terminal) for i in new] != [(i.address, i.title, i.argv, i.terminal) for i in items]:
                items[:] = new
                refresh()
            return False

        GLib.timeout_add(20, ready)

    def now():
        """the X server's time: a window shown again with it takes the focus (with the time of the last key this
        window saw, the window manager may leave the focus where it is)"""
        try:
            gi.require_version("GdkX11", "3.0")
            from gi.repository import GdkX11
            w = win.get_window()
            if isinstance(w, GdkX11.X11Window):
                return GdkX11.x11_get_server_time(w)
        except Exception:       # (not an X11 window, no GdkX11)
            pass
        return Gdk.CURRENT_TIME

    def show(q, startup_id=""):
        restyle()
        asked[:] = []
        if entry.get_text() == q:
            refresh()
        else:
            entry.set_text(q)       # ("changed": refresh)
        if startup_id:
            win.set_startup_id(startup_id)
        win.show_all()
        win.present_with_time(now())
        entry.grab_focus()
        entry.set_position(-1)
        GLib.timeout_add(60, lambda: reload() and False)        # (not while the window is being put on the screen)

    def request(_fd, _cond):
        try:
            c, _ = srv.accept()
        except OSError:
            return stay["on"]
        answer = b"no\n"
        try:
            c.settimeout(0.5)
            r = request_read(c.recv(65536))
            o = arguments(r[1]) if r is not None else None
            try:
                same = born is not None and os.stat(__file__).st_mtime_ns == born
            except OSError:
                same = False
            if not same:        # (the package was updated under this bar: the caller opens the new one, which stays)
                leave()
            elif isinstance(o, dict) and o["list"] is None and (o["theme"], o["lang"]) == tuple(given):
                answer = b"ok\n"
            c.sendall(answer)       # (said before the window is drawn: the caller is not kept waiting for it)
        except OSError:
            answer = b""
        finally:
            c.close()
        if answer[:2] == b"ok":
            show(o["query"], r[0])
        return stay["on"]

    def key(_w, ev):
        k = ev.keyval
        if k == Gdk.KEY_Escape:
            close()
            return True
        if k in (Gdk.KEY_Down, Gdk.KEY_Up) and shown:
            r = lst.get_selected_row()
            i = (r.get_index() if r else 0) + (1 if k == Gdk.KEY_Down else -1)
            lst.select_row(lst.get_row_at_index(max(0, min(len(shown) - 1, i))))
            return True
        if k in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
            it = current()
            if it:
                entry.set_text(it.address + (" " if it.takes else ""))
                entry.set_position(-1)
            return True
        if k in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            it = current()
            if it and it.ask is not None:       # ?question: its answers take the list (silik ask, offline)
                if it.ask:
                    asked[:] = [it.ask, ask_items(it.ask, lang)]
                    refresh()
                return True
            if it and it.fill is not None:      # an answer: its command goes to the bar, nothing runs
                entry.set_text(it.fill)
                entry.set_position(-1)
                return True
            if it and launch(it, TEXT[lang]):
                close()
            return True
        return False

    entry.connect("changed", refresh)
    lst.connect("row-selected", selected)
    win.connect("key-press-event", key)
    win.connect("destroy", Gtk.main_quit)
    win.connect("delete-event", lambda *_: bool(close()) or stay["on"])
    win.connect("focus-out-event", lambda *_: bool(close()) if not os.environ.get("SILIK_COMMAND_STAY") else False)
    if srv is not None:
        GLib.io_add_watch(srv.fileno(), GLib.PRIORITY_DEFAULT, GLib.IO_IN, request)
    entry.set_text(query)
    refresh()
    win.show_all()
    entry.grab_focus()
    entry.set_position(-1)
    try:
        Gtk.main()
    finally:
        if stay["on"]:
            try:
                os.unlink(path)
            except OSError:
                pass


def main(argv):
    o = arguments(argv)
    if isinstance(o, tuple):
        print(o[1], file=sys.stderr if o[0] else sys.stdout)
        return o[0]
    lang = o["lang"] if o["lang"] in TEXT else lang_of()
    if o["list"] is not None:
        q = o["list"].strip()
        asked = (q[1:].strip(), ask_items(q[1:].strip(), lang)) if q[:1] == "?" and q[1:].strip() else None
        for it in match(all_items(lang) if asked is None else [], o["list"], TEXT[lang], limit=50, asked=asked):
            print("%s\t%s" % (it.address, it.twin))
        return 0
    path = socket_path()
    if path and hand_over(path, argv, os.environ.get("DESKTOP_STARTUP_ID", "")):
        return 0                # the bar that stays shows itself
    started = [silik_json_start(a) for a in SILIK_LISTS]     # they answer while GTK loads
    theme = o["theme"] if o["theme"] is not None else os.environ.get("SILIK_THEME", "")
    run_window(o["query"], theme, lang, started, path, (o["theme"], o["lang"]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
