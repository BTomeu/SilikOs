def score(item, q):
    """lower is better; None = no match. Address prefix, then address substring, then every word in the title."""
    a, ti = item.address.lower(), item.title.lower()
    if not q:
        return (3, a)
    if a.startswith(q):
        return (0, a)
    tail = a.split("/", 1)[-1]
    if tail.startswith(q):
        return (1, a)
    if q in a:
        return (2, a)
    if all(w in ti for w in q.split()):
        return (4, a)
    return None


def match(items, query, t, limit=9):
    """the entries for what is typed. `eda/BOX CMD…` and `win/PREFIX PROG…` run a command inside; a path opens."""
    q = query.strip()
    if not q:
        return [i for i in items if i.address.startswith("sys/")][:limit]
    head, _, rest = q.partition(" ")
    fixed = set(i.address for i in items if not i.takes)     # eda/check, win/vm, an installed program: no command inside
    if rest and head.startswith("eda/") and head not in fixed:
        try:
            words = shlex.split(rest)
        except ValueError:              # (a quote not closed yet, while typing)
            return []
        return [Item(head, t["run_in_box"] + ": " + rest, [SILIK, "eda", "run", head[4:], "--"] + words)]
    if rest and head.startswith("win/") and head not in fixed:
        # a Windows path keeps its backslashes (C:\windows\notepad.exe); double quotes group words
        words = [w[1:-1] if len(w) > 1 and w[0] == w[-1] == '"' else w for w in re.findall(r'"[^"]*"?|\S+', rest)]
        return [Item(head, t["run_in_prefix"] + ": " + rest, [SILIK, "win", "run", head[4:], "--"] + words)]
    if q[0] in "/~":
        def opens(shown, full):     # a Windows file opens the way a double-click on it does
            if full.lower().endswith(WIN_FILES) and os.path.isfile(full):
                return Item(shown, t["win_open" if wine_here() else "win_open_arm"], [SILIK, "win", "open", full])
            return Item(shown, t["open"], ["xdg-open", full])
        p = os.path.expanduser(q)
        out = [opens(q, p)] if os.path.exists(p) else []
        d, base = (p, "") if p.endswith("/") else os.path.split(p)
        try:
            for n in sorted(os.listdir(d or "/")):
                if n.startswith(base) and not n.startswith(".") and len(out) < limit and os.path.join(d, n) != p:
                    full = os.path.join(d, n)
                    out.append(opens(full + ("/" if os.path.isdir(full) else ""), full))
        except OSError:
            pass
        return out
    ql = q.lower()
    scored = [(score(i, ql), i) for i in items]
    return [i for s, i in sorted(((s, i) for s, i in scored if s is not None), key=lambda x: x[0])][:limit]


