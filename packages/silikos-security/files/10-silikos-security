# SilikOS security defaults of the desktop (dconf system database "local"; a user's own settings win: these are
# defaults, not locks). A separate file from silikos-desktop's 00-silikos.

# The screen goes blank after 5 minutes without input and is locked at once. These three are GNOME's own defaults
# on EL 9.8 (gsettings-desktop-schemas 40.0), written down so that the system states them.
[org/gnome/desktop/session]
idle-delay=uint32 300

[org/gnome/desktop/screensaver]
lock-enabled=true
lock-delay=uint32 0

# What a notification says is not shown on the locked screen (GNOME's default shows it: a message, a calendar entry
# or a build's result is read by whoever passes by). That something arrived is still shown.
[org/gnome/desktop/notifications]
show-in-lock-screen=false

# A USB stick or a disc that is plugged in never starts a program by itself (GNOME's default asks; this never does).
[org/gnome/desktop/media-handling]
autorun-never=true

# Updates go through `silik update` (and the daily automatic one): that is where SilikOS's repository is checked
# against old metadata served again and where the snapshot for the way back is taken. GNOME Software asks
# PackageKit, which goes around both (the second pass of 14/11/2026: it installed what dnf refused). So Software
# does not manage updates: its updates page is hidden and it downloads none; installing an application there works
# as before. For one user, back: gsettings set org.gnome.software allow-updates true
[org/gnome/software]
allow-updates=false
download-updates=false
