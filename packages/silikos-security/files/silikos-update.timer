# SilikOS: every update, once a day; a day missed while the machine was off is caught up after the next start.
[Unit]
Description=SilikOS automatic updates, daily
ConditionPathExists=!/run/ostree-booted
Wants=network-online.target

[Timer]
OnCalendar=*-*-* 6:00
RandomizedDelaySec=60m
Persistent=true

[Install]
WantedBy=timers.target
