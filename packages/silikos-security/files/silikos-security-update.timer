# SilikOS: once a day (the base's dnf-automatic-install.timer schedule); a day missed while the machine was off is
# caught up after the next start.
[Unit]
Description=SilikOS automatic security updates, daily
ConditionPathExists=!/run/ostree-booted
Wants=network-online.target

[Timer]
OnCalendar=*-*-* 6:00
RandomizedDelaySec=60m
Persistent=true

[Install]
WantedBy=timers.target
