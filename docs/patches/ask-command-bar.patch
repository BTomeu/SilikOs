+def ask_items(question, lang, timeout=10):
+    """the answers of `silik ask QUESTION` (offline: a search over what this system knows about itself, nothing is
+    sent anywhere) as entries. Enter on one puts its command in the bar as `$ COMMAND` and runs nothing: the person
+    reads it, changes it, and Enter again runs it in a terminal"""
+    env = dict(os.environ, SILIK_LANG=lang)
+    try:
+        p = subprocess.run([SILIK, "-q", "ask", "--json", "--", question], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+                           stdin=subprocess.DEVNULL, universal_newlines=True, timeout=timeout, env=env)
+        answers = json.loads(p.stdout)["answers"] if p.stdout.strip() else []
+    except (OSError, subprocess.TimeoutExpired, ValueError, KeyError, TypeError):
+        return []
+    out = []
+    for n, a in enumerate(answers if isinstance(answers, list) else [], 1):
+        try:
+            c, what = str(a["command"]), str(a.get("what") or "")
+        except (KeyError, TypeError, AttributeError):
+            continue
+        out.append(Item("?%d" % n, c + ("  \u2014  " + what if what else ""), [], fill="$ " + c, line=c))
+    return out
+
